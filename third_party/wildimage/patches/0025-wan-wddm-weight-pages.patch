+// Quantized GGUF weights were already read once. Keep a read-only view of
+// the same cached file pages instead of allocating a private copy and
+// copying it back over PCIe. The OS may reclaim clean pages under pressure.
+bool ModelManager::bind_clean_wan_weight(const TensorState& state, HostWeight& host) {
+#ifdef _WIN32
+    if (state.source_file || state.sources.size() != 1) return false;
+    const auto& raw = state.sources.front();
+    if (!ggml_is_quantized(raw.type) || raw.type != state.tensor->type ||
+        raw.index_in_zip >= 0 || raw.file_index >= model_loader_.file_data.size() ||
+        raw.is_f64 || raw.is_i64 || raw.is_f8_e4m3 || raw.is_f8_e5m2 ||
+        raw.is_int8_tensorwise || raw.w4_convrot_kind || raw.int8_convrot ||
+        !std::equal(state.tensor->ne, state.tensor->ne + GGML_MAX_DIMS, raw.ne) ||
+        raw.nbytes_to_read() != static_cast<int64_t>(host.ram.bytes())) return false;
+    const auto& file = model_loader_.file_data[raw.file_index];
+    if (file.is_zip || file.mapping_writable) return false;
+    auto& entry = wan_sources_[raw.file_index];
+    auto mapping = entry.lock();
+    if (!mapping) {
+        mapping = MmapWrapper::create(file.path, false);
+        if (!mapping) return false;
+        entry = mapping;
+    }
+    if (raw.offset > mapping->size() || host.ram.bytes() > mapping->size() - raw.offset) return false;
+    host.offset = raw.offset;
+    host.source = std::move(mapping);
+    return true;
+#else
+    return false;
+#endif
+}
