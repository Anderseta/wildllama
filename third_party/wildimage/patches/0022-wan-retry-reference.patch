+    // The parent owns a fresh, anonymous shared-memory object per job.
+    // Publish the rank last so a killed writer cannot publish a partial payload.
+    struct WanReferenceMemory {
+        unsigned char* data = nullptr;
+        size_t bytes;
+        explicit WanReferenceMemory(const char* name, size_t size) : bytes(size) {
+            if (!name || size == 0) return;
+#if defined(_WIN32)
+            if (std::strncmp(name, "Local\\wildllama-wan-", sizeof("Local\\wildllama-wan-") - 1) != 0) return;
+            HANDLE mapping = OpenFileMappingA(FILE_MAP_READ | FILE_MAP_WRITE, FALSE, name);
+            if (mapping) {
+                data = static_cast<unsigned char*>(MapViewOfFile(mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, size));
+                CloseHandle(mapping);
+            }
+#elif defined(__linux__)
+            struct stat info{};
+            if (std::strcmp(name, "fd:3") != 0 || fstat(3, &info) || info.st_size != static_cast<off_t>(size)) return;
+            void* view = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, 3, 0);
+            if (view != MAP_FAILED) data = static_cast<unsigned char*>(view);
+#endif
+        }
+        ~WanReferenceMemory() {
+            if (!data) return;
+#if defined(_WIN32)
+            UnmapViewOfFile(data);
+#elif defined(__linux__)
+            munmap(data, bytes);
+#endif
+        }
+        WanReferenceMemory(const WanReferenceMemory&) = delete;
+        WanReferenceMemory& operator=(const WanReferenceMemory&) = delete;
+    };
+
+    static sd::Tensor<float> restore_wan_reference(const WanReferenceMemory& mem, std::vector<int64_t> shape) {
+        if (!mem.data) return {};
+        const int rank = mem.data[0];
+        if (rank != 4 && rank != 5) return {};
+        shape.resize(rank);
+        sd::Tensor<float> result(shape);
+        if (result.numel() * sizeof(float) != mem.bytes - 1) return {};
+        std::memcpy(result.data(), mem.data + 1, mem.bytes - 1);
+        return result;
+    }
+
+    static void save_wan_reference(WanReferenceMemory& mem, const sd::Tensor<float>& value,
+                                   const std::vector<int64_t>& expected) {
+        if (!mem.data || (value.dim() != 4 && value.dim() != 5) ||
+            !std::equal(value.shape().begin(), value.shape().end(), expected.begin()) ||
+            value.numel() * sizeof(float) != mem.bytes - 1) return;
+        std::memcpy(mem.data + 1, value.data(), mem.bytes - 1);
+        std::atomic_thread_fence(std::memory_order_release);
+        mem.data[0] = static_cast<unsigned char>(value.dim());
     }
 
