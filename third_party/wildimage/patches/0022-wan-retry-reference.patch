+    // The parent gives GPU attempts of one request the same private directory.
+    // Shape, components and reference stay fixed for its entire lifetime.
+    static sd::Tensor<float> restore_wan_reference(const std::filesystem::path& path, std::vector<int64_t> shape) {
+        if (path.empty()) return {};
+        std::ifstream in(path, std::ios::binary | std::ios::ate);
+        int64_t n = 1;
+        for (auto axis : shape) n *= axis;
+        if (!in || in.tellg() != static_cast<std::streamoff>(1 + n * sizeof(float))) return {};
+        in.seekg(0);
+        int rank = in.get();
+        if (rank != 4 && rank != 5) return {};
+        shape.resize(rank);
+        sd::Tensor<float> result(shape);
+        if (!in.read(reinterpret_cast<char*>(result.data()), n * sizeof(float))) return {};
+        return result;
+    }
+
+    static void save_wan_reference(const std::filesystem::path& path, const sd::Tensor<float>& value,
+                                   const std::vector<int64_t>& expected) {
+        if (path.empty() || (value.dim() != 4 && value.dim() != 5) ||
+            !std::equal(value.shape().begin(), value.shape().end(), expected.begin())) return;
+        std::error_code ec;
+        const auto bytes = static_cast<uintmax_t>(value.numel()) * sizeof(float);
+        auto disk = std::filesystem::space(path.parent_path(), ec);
+        if (ec || disk.available < bytes + (uintmax_t{256} << 20)) return;
+        auto part = path;
+        part += ".part";
+        std::ofstream out(part, std::ios::binary | std::ios::trunc);
+        out.put(static_cast<char>(value.dim()));
+        out.write(reinterpret_cast<const char*>(value.data()), bytes);
+        out.close();
+        if (out) std::filesystem::rename(part, path, ec);
+        std::filesystem::remove(part, ec);
     }
 
