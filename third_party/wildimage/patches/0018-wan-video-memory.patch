+static void open_model_mapping(ModelFileData& fdata, bool writable_mmap) {
+    LOG_VERBOSE("using mmap for I/O");
+    std::unique_ptr<MmapWrapper> mmapped = MmapWrapper::create(fdata.path, writable_mmap);
+    if (mmapped) {
+        uint8_t* mmap_data             = static_cast<uint8_t*>(mmapped->writable_data());
+        ggml_backend_buffer_t buf_mmap = ggml_backend_cpu_buffer_from_ptr(mmap_data, mmapped->size());
+        if (buf_mmap) {
+            LOG_INFO("using mmap for '%s'", fdata.path.c_str());
+            fdata.mmbuffer = std::shared_ptr<struct ggml_backend_buffer>(buf_mmap, ggml_backend_buffer_free);
+        } else {
+            LOG_WARN("mmap: failed to create backend buffer for file %s", fdata.path.c_str());
+        }
+        fdata.mapping_writable = writable_mmap;
+        fdata.mmapped = std::shared_ptr<MmapWrapper>(std::move(mmapped));
+    } else {
+        LOG_WARN("failed to memory-map '%s' (falling back to read())", fdata.path.c_str());
+    }
+}
+
+void ModelLoader::release_unused_readonly_maps() {
+    for (auto& file : file_data) {
+        // Each live tensor store owns both its mapping and its backend wrapper.
+        if (file.mapping_writable || file.mmapped.use_count() != 1 || file.mmbuffer.use_count() > 1 ||
+            std::any_of(file.device_mmbuffers.begin(), file.device_mmbuffers.end(),
+                        [](const auto& entry) { return entry.second.use_count() > 1; })) {
+            continue;
+        }
+        file.device_mmbuffers.clear();
+        file.mmbuffer.reset();
+        file.mmapped.reset();
+        file.reopen_readonly_map = true;
+    }
+}
