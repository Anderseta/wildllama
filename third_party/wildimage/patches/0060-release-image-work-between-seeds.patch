+// Test Windows commit at the same boundary, after the PNG's last owner
+// has released it. Reuse a stable session without retaining unbounded
+// driver/heap allocations across a long series of reference edits.
+struct SeriesMemory {
+#ifdef _WIN32
+    uint64_t lowest_private = UINT64_MAX;
+    bool should_reopen() {
+        MEMORYSTATUSEX system{};
+        system.dwLength = sizeof(system);
+        PROCESS_MEMORY_COUNTERS_EX process{};
+        if (!GlobalMemoryStatusEx(&system) ||
+            !K32GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&process), sizeof(process)))
+            return false;
+        const uint64_t current = process.PrivateUsage;
+        lowest_private = std::min(lowest_private, current);
+        const uint64_t transient = process.PeakPagefileUsage > current ? process.PeakPagefileUsage - current : 0;
+        constexpr uint64_t margin = 512ULL << 20;
+        return current - lowest_private > margin || system.ullAvailPageFile < transient + margin;
+    }
+#else
+    bool should_reopen() const { return false; }
+#endif
+};
