diff --git a/src/model/te/t5.hpp b/src/model/te/t5.hpp
--- a/src/model/te/t5.hpp
+++ b/src/model/te/t5.hpp
@@ -242,8 +242,14 @@
         }
         if (past_bias != nullptr) {
             if (mask != nullptr) {
-                mask = ggml_repeat(ctx->ggml_ctx, mask, past_bias);
-                mask = ggml_add(ctx->ggml_ctx, mask, past_bias);
+                // ADD broadcasts its second operand. Avoid writing a dense mask per head.
+                if (mask->type == GGML_TYPE_F32 && past_bias->type == GGML_TYPE_F32 &&
+                    sd_backend_is(ctx->backend, "CUDA")) {
+                    mask = ggml_add(ctx->ggml_ctx, past_bias, mask);
+                } else {
+                    mask = ggml_repeat(ctx->ggml_ctx, mask, past_bias);
+                    mask = ggml_add(ctx->ggml_ctx, mask, past_bias);
+                }
             } else {
                 mask = past_bias;
             }
