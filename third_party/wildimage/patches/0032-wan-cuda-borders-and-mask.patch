             return ggml_ext_conv_3d(ctx, x, w, b, in_channels,
                                     std::get<2>(stride), std::get<1>(stride), std::get<0>(stride),
-                                    0, 0, 0,
+                                    implicit_border ? lp0 : 0, implicit_border ? lp1 : 0, 0,
