+template <typename Fn>
+inline sd::Tensor<float> process_vae_temporal_tiles(const sd::Tensor<float>& input,
+                                                    const VAETemporalTilePlan& plan,
+                                                    Fn&& on_processing,
+                                                    int64_t expected_frames = 0) {
+    return assemble_vae_temporal_tiles(plan, [&](const VAETemporalTile& tile) {
+        if (tile.start == 0 && tile.end == input.shape()[2]) {
+            return on_processing(input, tile);
+        }
+        return on_processing(sd::ops::slice(input, 2, tile.start, tile.end), tile);
+    }, expected_frames);
