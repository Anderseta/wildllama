+// Wan I2V represents an initial image followed by neutral frames. Only the
+// first window contains pixels. In VAE space every other value is exactly +0.
+inline sd::Tensor<float> wan_reference_window(const sd::Tensor<float>& first,
+                                              int64_t start, int64_t end) {
+    GGML_ASSERT(first.dim() == 5 && first.shape()[2] == 1 && start >= 0 && end > start);
+    auto shape = first.shape();
+    shape[2] = end - start;
+    sd::Tensor<float> window(shape);
+    if (start == 0) {
+        const int64_t plane = shape[0] * shape[1];
+        for (int64_t c = 0; c < first.numel() / plane; ++c) {
+            std::copy_n(first.data() + c * plane, plane, window.data() + c * shape[2] * plane);
+        }
+    }
+    return window;
+}
