diff --git a/src/core/wan_shared_memory.h b/src/core/wan_shared_memory.h
new file mode 100644
--- /dev/null
+++ b/src/core/wan_shared_memory.h
@@ -0,0 +1,43 @@
+#pragma once
+#include <cstddef>
+#include <cstring>
+#if defined(_WIN32)
+#include "core/wildimage_ram_budget.h"
+#elif defined(__linux__)
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+// The parent owns a fresh, anonymous shared-memory object per job.
+struct WanSharedMemory {
+    unsigned char* data = nullptr;
+    size_t bytes;
+    explicit WanSharedMemory(const char* name, size_t size) : bytes(size) {
+        if (!name || size == 0) return;
+#if defined(_WIN32)
+        if (std::strncmp(name, "Local\\wildllama-wan-", sizeof("Local\\wildllama-wan-") - 1) != 0) return;
+        HANDLE mapping = OpenFileMappingA(FILE_MAP_READ | FILE_MAP_WRITE, FALSE, name);
+        if (mapping) {
+            data = static_cast<unsigned char*>(MapViewOfFile(mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, size));
+            CloseHandle(mapping);
+        }
+#elif defined(__linux__)
+        struct stat info{};
+        int fd = std::strcmp(name, "fd:3") == 0 ? 3 : std::strcmp(name, "fd:4") == 0 ? 4 : -1;
+        if (fd < 0 || fstat(fd, &info) || info.st_size != static_cast<off_t>(size)) return;
+        void* view = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        if (view != MAP_FAILED) data = static_cast<unsigned char*>(view);
+#endif
+    }
+    ~WanSharedMemory() {
+        if (!data) return;
+#if defined(_WIN32)
+        UnmapViewOfFile(data);
+#elif defined(__linux__)
+        munmap(data, bytes);
+#endif
+    }
+    WanSharedMemory(const WanSharedMemory&) = delete;
+    WanSharedMemory& operator=(const WanSharedMemory&) = delete;
+};
diff --git a/src/runtime/wan_step_checkpoint.hpp b/src/runtime/wan_step_checkpoint.hpp
new file mode 100644
--- /dev/null
+++ b/src/runtime/wan_step_checkpoint.hpp
@@ -0,0 +1,62 @@
+#pragma once
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include "core/tensor.hpp"
+#include "core/wan_shared_memory.h"
+
+// The parent creates this mapping for one immutable job and waits for each
+// runner to exit before starting its successor. The aligned step is published
+// only after the other slot has received the complete, native float tensor.
+class WanStepCheckpoint {
+    size_t bytes_;
+    WanSharedMemory memory_;
+    uint32_t signature_ = 2166136261u;
+
+    uint32_t step() const {
+        uint32_t n = 0;
+        std::memcpy(&n, memory_.data, sizeof(n));
+        return n;
+    }
+    void publish(uint32_t n) {
+#if defined(_WIN32)
+        InterlockedExchange(reinterpret_cast<volatile LONG*>(memory_.data), static_cast<LONG>(n));
+#elif defined(__linux__)
+        __atomic_store_n(reinterpret_cast<uint32_t*>(memory_.data), n, __ATOMIC_RELEASE);
+#endif
+    }
+    void sign(const void* input, size_t count) {
+        auto data = static_cast<const unsigned char*>(input);
+        for (size_t i = 0; i < count; ++i) signature_ = (signature_ ^ data[i]) * 16777619u;
+    }
+
+public:
+    WanStepCheckpoint(const char* name, const sd::Tensor<float>& x, const std::vector<float>& sigmas, float eta)
+        : bytes_(x.numel() * sizeof(float)), memory_(name, bytes_ <= (size_t{128} << 20) ? 16 + 2 * bytes_ : 0) {
+        if (!memory_.data) return;
+        const auto& shape = x.shape();
+        sign(shape.data(), shape.size() * sizeof(shape[0]));
+        sign(sigmas.data(), sigmas.size() * sizeof(float));
+        sign(&eta, sizeof(eta));
+        uint32_t stored = 0;
+        std::memcpy(&stored, memory_.data + 4, sizeof(stored));
+        if (stored != signature_) {
+            publish(0);
+            std::memcpy(memory_.data + 4, &signature_, sizeof(signature_));
+        }
+    }
+    int restore(sd::Tensor<float>& x, int steps) const {
+        if (!memory_.data) return 0;
+        const uint32_t n = step();
+        if (n == 0 || n > static_cast<uint32_t>(steps)) return 0;
+        std::memcpy(x.data(), memory_.data + 16 + (n % 2) * bytes_, bytes_);
+        LOG_INFO("wildvideo resumed step %u/%d", n, steps);
+        return static_cast<int>(n);
+    }
+    void save(const sd::Tensor<float>& x, int n, int total) {
+        if (!memory_.data || x.numel() * sizeof(float) != bytes_) return;
+        std::memcpy(memory_.data + 16 + (n % 2) * bytes_, x.data(), bytes_);
+        publish(static_cast<uint32_t>(n));
+        LOG_INFO("wildvideo saved step %d/%d in RAM", n, total);
+    }
+};
