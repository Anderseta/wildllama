+
+bool sd_plan_wan_decode_tiles(sd_tiling_params_t& params, int64_t latent_w, int64_t latent_h,
+                              int scale, uint64_t gpu_bytes, uint64_t host_bytes) {
+    constexpr uint64_t gib = uint64_t(1) << 30;
+    if (!params.enabled || !params.temporal_tiling || params.tile_size_w || params.tile_size_h ||
+        params.rel_size_w || params.rel_size_h || (params.extra_tiling_args && *params.extra_tiling_args) ||
+        scale <= 0 || scale > 256 || latent_w < 1 || latent_h < 1 ||
+        latent_w > INT_MAX / scale || latent_h > INT_MAX / scale || !std::isfinite(params.target_overlap) ||
+        gpu_bytes < 6 * gib || host_bytes < gib) return false;
+
+    const int w = static_cast<int>(latent_w), h = static_cast<int>(latent_h);
+    const int base_w = std::min(w, 256 / scale), base_h = std::min(h, 256 / scale);
+    const float overlap = std::clamp(params.target_overlap, 0.f, 0.5f);
+    auto work = [&](int dimension, int tile) {
+        return static_cast<uint64_t>(sd_tiling_plan_axis(dimension, tile, overlap, false).size()) * tile;
+    };
+    const auto base_x = work(w, base_w), base_y = work(h, base_h);
+    const int wide = std::min(w, 512 / scale), tall = std::min(h, 512 / scale);
+    const double x_ratio = double(work(w, wide)) / base_x, y_ratio = double(work(h, tall)) / base_y;
+    if (x_ratio >= 1 && y_ratio >= 1) return false;
+    params.tile_size_w = scale * (x_ratio <= y_ratio ? wide : base_w);
+    params.tile_size_h = scale * (x_ratio <= y_ratio ? base_h : tall);
+    if (gpu_bytes < 10 * gib || host_bytes < 2 * gib) params.extra_tiling_args = "temporal_tile_frames=2";
+    return true;
 }
 
