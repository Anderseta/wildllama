+void ModelManager::hint_next_disk_weights(const std::vector<ggml_tensor*>& tensors) {
+#ifdef _WIN32
+    static const bool trace = std::getenv("WILDLLAMA_WAN_TIMINGS") != nullptr;
+    if (wan_file_hint_.valid() && wan_file_hint_.wait_for(std::chrono::seconds(0)) != std::future_status::ready) return;
+    struct Range { void* address; SIZE_T bytes; };
+    using Hint = BOOL (WINAPI *)(HANDLE, ULONG_PTR, Range*, ULONG);
+    static const auto hint = reinterpret_cast<Hint>(GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "PrefetchVirtualMemory"));
+    if (!hint) return;
+    const uint64_t headroom = std::min(wan_host_space(), wildimage_ram::budget().remaining());
+    size_t left = static_cast<size_t>(std::min<uint64_t>(32ULL << 20, headroom / 16));
+    if (left < (4U << 20)) {
+        static std::atomic<bool> reported{false};
+        if (trace && !reported.exchange(true)) LOG_INFO("Wan read-ahead: skipped under host memory pressure");
+        return;
+    }
+    // Keep one look-ahead window on one ordinary, read-only weight shard.
+    std::vector<std::pair<size_t, size_t>> spans;
+    std::string path;
+    for (auto* tensor : tensors) {
+        auto it = tensor_states_by_tensor_.find(tensor);
+        if (it == tensor_states_by_tensor_.end()) continue;
+        const auto& state = *it->second;
+        if (state.residency_mode != ResidencyMode::Disk || state.host_weight ||
+            state.loaded_to_params_backend || state.staged_to_compute_backend || state.sources.size() != 1) continue;
+        const auto& raw = state.sources.front();
+        const auto bytes = raw.nbytes_to_read();
+        if (raw.index_in_zip >= 0 || bytes <= 0 || !ggml_is_quantized(raw.type)) continue;
+        // A hint reads a fresh read-only mapping. Writable/source-conversion metadata
+        // used to bind weight tensors is unnecessary for this advisory operation.
+        const auto& loader = state.source_file ? source_loader(state.source_file) : model_loader_;
+        auto file = loader.plain_weight_path(raw);
+        if (file.empty() || (!path.empty() && file != path)) continue;
+        path = std::move(file);
+        spans.emplace_back(raw.offset, static_cast<size_t>(bytes));
+    }
+    if (spans.empty()) {
+        static std::atomic<bool> reported{false};
+        if (trace && !reported.exchange(true)) LOG_INFO("Wan read-ahead: no eligible file ranges in segment");
+        return;
+    }
+    try {
+        wan_file_hint_ = std::async(std::launch::async, [path = std::move(path), spans = std::move(spans), left]() mutable {
+            // MSVC may reuse a worker thread. Restore its priority on every exit.
+            struct BackgroundPriority {
+                bool active = SetThreadPriority(GetCurrentThread(), THREAD_MODE_BACKGROUND_BEGIN) != 0;
+                ~BackgroundPriority() {
+                    if (active) SetThreadPriority(GetCurrentThread(), THREAD_MODE_BACKGROUND_END);
+                }
+            } priority;
+            // Auto-fit may explicitly disable whole-file mappings under WDDM.
+            // A short-lived read-only window also warms the cache for buffered reads.
+            using Handle = std::unique_ptr<void, decltype(&CloseHandle)>;
+            const auto fd = CreateFileW(std::filesystem::u8path(path).c_str(), GENERIC_READ,
+                                        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
+                                        OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+            if (fd == INVALID_HANDLE_VALUE) return;
+            Handle file(fd, CloseHandle);
+            LARGE_INTEGER file_size{};
+            if (!GetFileSizeEx(fd, &file_size) || file_size.QuadPart <= 0) return;
+            Handle mapping(CreateFileMappingW(fd, nullptr, PAGE_READONLY, 0, 0, nullptr), CloseHandle);
+            if (!mapping) return;
+            SYSTEM_INFO system{};
+            GetSystemInfo(&system);
+            const size_t alignment = system.dwAllocationGranularity;
+            if (!alignment) return;
+            const auto size = static_cast<size_t>(file_size.QuadPart);
+            std::sort(spans.begin(), spans.end());
+            size_t previous_end = 0, accepted = 0, windows = 0;
+            for (const auto& span : spans) {
+                if (!left || windows == 8) break;
+                if (span.first >= size) continue;
+                const auto end = span.first + std::min(span.second, size - span.first);
+                if (end <= previous_end) continue;
+                const auto first = std::max(previous_end, span.first);
+                const auto offset = first - first % alignment;
+                const auto length = std::min(left, end - offset);
+                if (length <= first - offset) break;
+                auto* view = MapViewOfFile(mapping.get(), FILE_MAP_READ, DWORD(uint64_t(offset) >> 32),
+                                           DWORD(offset), length);
+                if (!view) break;
+                Range range{view, length};
+                const bool ok = hint(GetCurrentProcess(), 1, &range, 0);
+                UnmapViewOfFile(view);
+                if (!ok) break;
+                accepted += length;
+                left -= length;
+                previous_end = offset + length;
+                ++windows;
+            }
+            if (trace && accepted) {
+                static std::atomic<bool> reported{false};
+                if (!reported.exchange(true))
+                    std::fprintf(stderr, "Wan read-ahead: first accepted file-page hint %.1f MiB\n", accepted / 1048576.);
+            }
+        });
+    } catch (const std::system_error&) {
+        // A denied worker is equivalent to an unsupported page hint.
+    }
+#endif
+}
