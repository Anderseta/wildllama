+        // The temporal coordinate is constant across an image. Each row and column
+        // also shares a rotation. Write each distinct axis rotation once in the final
+        // tensor, including the periodic coordinate convention for seamless images.
+        sd::Tensor<float> position_tensor(bool target_only, const std::vector<int>& axes, int64_t head_dim,
+                                          bool circular_x, bool circular_y) const {
+            GGML_ASSERT(axes.size() == 3 && axes[0] + axes[1] + axes[2] == head_dim);
+            const int64_t offset = target_only ? prefix_length : 0;
+            sd::Tensor<float> output({2, 2, head_dim / 2, token_count - offset});
+            const std::array<std::vector<float>, 3> omega = {Rope::rope_frequencies(axes[0], 10000.f),
+                                                             Rope::rope_frequencies(axes[1], 10000.f),
+                                                             Rope::rope_frequencies(axes[2], 10000.f)};
+            const int64_t stride = 2 * head_dim, y_offset = 2 * axes[0], x_offset = y_offset + 2 * axes[1];
+            auto write_axis = [&](float* dst, int axis, float pos, float period = 0.f) {
+                constexpr float two_pi = 6.28318530717958647692f;
+                for (float frequency : omega[axis]) {
+                    const float angle = period > 0.f ? pos * two_pi * std::round(frequency * period / two_pi) / period
+                                                     : pos * frequency;
+                    const float c = std::cos(angle), sn = std::sin(angle);
+                    dst[0] = c; dst[1] = -sn; dst[2] = sn; dst[3] = c;
+                    dst += 4;
+                }
+            };
+            for (const auto& segment : segments) {
+                if (segment.start < offset) continue;
+                float* first = output.data() + (segment.start - offset) * stride;
+                if (segment.image_index < 0) {
+                    for (int64_t j = 0; j < segment.end - segment.start; ++j) {
+                        float* dst = first + j * stride;
+                        const float pos = static_cast<float>(segment.position + j);
+                        write_axis(dst, 0, pos);
+                        write_axis(dst + y_offset, 1, pos);
+                        write_axis(dst + x_offset, 2, pos);
+                    }
+                    continue;
+                }
+                write_axis(first, 0, static_cast<float>(segment.position));
+                for (int64_t y = 0; y < segment.height; ++y) {
+                    float* row = first + y * segment.width * stride;
+                    write_axis(row + y_offset, 1, static_cast<float>(y - (segment.height - segment.height / 2)),
+                               circular_y ? static_cast<float>(segment.height) : 0.f);
+                    for (int64_t x = 0; x < segment.width; ++x) {
+                        float* dst = row + x * stride;
