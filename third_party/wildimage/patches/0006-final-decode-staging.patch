+void ModelManager::evict_inactive_components(const std::set<ModelComponent>& components) {
+    // Called at a completed pipeline phase, after every runner has released its use.
+    clear_all_prefetched_params();
+    std::unordered_set<TensorState*> targets;
+    for (const auto& state : tensor_states_) {
+        if (components.count(state->component) && state->pin_count == 0 && !state->sources.empty())
+            targets.insert(state.get());
+    }
+    release_compute_staging_blocks(false, &targets);
+    size_t gpu_bytes = 0, host_bytes = 0;
+    for (auto it = params_storage_blocks_.begin(); it != params_storage_blocks_.end();) {
+        auto& block = **it;
+        const bool eligible = !block.states.empty() && std::all_of(block.states.begin(), block.states.end(), [&](TensorState* state) {
+            return state && targets.count(state) && state->pin_count == 0 && !state->staged_to_compute_backend;
+        });
+        if (!eligible) {
+            ++it;
+            continue;
+        }
+        if (block.buffer) {
+            auto& bytes = ggml_backend_buffer_is_host(block.buffer) ? host_bytes : gpu_bytes;
+            bytes += ggml_backend_buffer_get_size(block.buffer);
+        }
+        free_params_storage_block(block);
+        it = params_storage_blocks_.erase(it);
+    }
+    if (gpu_bytes || host_bytes)
+        LOG_INFO("staged final decode: released inactive weights (%.2f MiB VRAM, %.2f MiB RAM)",
+                 gpu_bytes / (1024.0 * 1024.0), host_bytes / (1024.0 * 1024.0));
+}
