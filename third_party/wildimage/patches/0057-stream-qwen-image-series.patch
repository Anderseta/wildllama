+// Qwen Image 2.1 produces one RGB image per latent. Other formats keep
+// their existing output layout, including multi-layer and animated images.
+extern "C" SD_API bool wildimage_has_qwen_series(sd_ctx_t* ctx) {
+    return ctx && ctx->sd && ctx->sd->version == VERSION_QWEN_IMAGE_2_1;
+}
+
+extern "C" SD_API bool wildimage_stream_qwen_series(sd_ctx_t* ctx, const sd_img_gen_params_t* params,
+                                                     const int64_t* seeds, sd::pipeline::SeriesSink sink, void* user) {
+    if (!wildimage_has_qwen_series(ctx) || !params || !seeds || !sink) return false;
+    StableDiffusionGGML::ExecutionScope execution(*ctx->sd);
+    if (!execution.ready) return false;
+    try {
+        return sd::pipeline::generate_image(ctx->sd, params, nullptr, nullptr, nullptr, seeds, sink, user);
+    } catch (const std::exception& e) {
+        if (dynamic_cast<const wildimage_ram::Exceeded*>(&e) || dynamic_cast<const std::bad_alloc*>(&e))
+            wildimage_ram::budget().fail();
+        LOG_ERROR("image series failed: %s", e.what());
+        return false;
+    }
+}
+
 SD_API bool generate_image(sd_ctx_t* sd_ctx, const sd_img_gen_params_t* params, sd_image_generation_result_t** result_out) {
     return wildimage_generate_seeded(sd_ctx, params, nullptr, result_out);
 }
