+// Encode and rename one PNG while the GPU decodes the next latent. Back
+// pressure bounds raster memory. Emit notifications on the inference thread
+// so CUDA progress cannot interrupt a marker on stdout.
+struct SeriesPNGWriter {
+    fs::path directory;
+    const SDContextParams& settings;
+    const SDGenerationParams& gen;
+    int quality, first;
+    int pending_index = -1;
+    std::future<bool> pending;
+
+    bool finish() {
+        if (!pending.valid()) return true;
+        if (!pending.get()) return false;
+        std::cout << "WILDIMAGE_SAVED " << pending_index << std::endl;
+        return true;
+    }
+
+    static bool submit(void* user, int offset, sd_image_t* img, const char* info) noexcept {
+        auto& self = *static_cast<SeriesPNGWriter*>(user);
+        try {
+            if (!self.finish()) return false;
+            SDImageOwner owner(*img);
+            img->data = nullptr;
+            const int index = self.first + offset;
+            const auto metadata = self.gen.embed_image_metadata
+                                      ? generation_info_with_relative_lora_paths(info, self.settings.lora_model_dir)
+                                      : std::string{};
+            auto save = [owner = std::move(owner), directory = self.directory, index,
+                         metadata, quality = self.quality]() {
+                const auto& image = owner.get();
+                const auto tmp = directory / "writing.png";
+                if (!write_image_to_file(tmp.u8string(), image.data, image.width, image.height,
+                                         image.channel, metadata, quality)) return false;
+                fs::rename(tmp, directory / (std::to_string(index) + ".png"));
+                return true;
+            };
+            self.pending_index = index;
+            self.pending = std::async(std::launch::async, std::move(save));
+            return true;
+        } catch (const std::exception& e) {
+            std::cerr << "image series PNG: " << e.what() << std::endl;
+            return false;
+        }
+    }
+};
