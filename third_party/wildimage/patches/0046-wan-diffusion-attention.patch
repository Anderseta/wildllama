+    // Coalesced, tiled first pass for long sequences. Store both partials in
+    // the not-yet-written INT8 key buffer. The second pass runs on the same stream.
+    static constexpr int sage_rows_per_tile = 256;
+    template <int D>
+    static __global__ void sage_partial_stats(const float* keys, const half* values, float2* partials, int length) {
+        const int channel = blockIdx.x * 32 + threadIdx.x % 32;
+        const int row = threadIdx.x / 32;
+        const int start = blockIdx.z * sage_rows_per_tile;
+        const int end = min(length, start + sage_rows_per_tile);
+        const size_t base = size_t(blockIdx.y) * length * D + channel;
+        float sum = 0.f, peak = 1e-7f;
+        for (int t = start + row; t < end; t += 8) {
+            sum += keys[base + size_t(t) * D];
+            peak = fmaxf(peak, fabsf(__half2float(values[base + size_t(t) * D])));
+        }
+        __shared__ float sums[256], peaks[256];
+        sums[threadIdx.x] = sum;
+        peaks[threadIdx.x] = peak;
+        __syncthreads();
+        if (row == 0) {
+            for (int i = 1; i < 8; ++i) {
+                sum += sums[threadIdx.x + i * 32];
+                peak = fmaxf(peak, peaks[threadIdx.x + i * 32]);
+            }
+            partials[(size_t(blockIdx.y) * gridDim.z + blockIdx.z) * D + channel] = make_float2(sum, peak);
+        }
+    }
+
+    template <int D>
+    static __global__ void sage_finish_stats(const float2* partials, float* means, float* scales, int tiles, int length) {
+        const int index = blockIdx.y * D + threadIdx.x;
+        // One independent channel per lane. Accumulate the short list of FP32
+        // partial sums in FP64 to limit rounding error even for offset keys.
+        const size_t begin = size_t(index / D) * tiles * D + index % D;
+        double sum = 0.;
+        float peak = 1e-7f;
+        for (int tile = 0; tile < tiles; ++tile) {
+            const float2 part = partials[begin + size_t(tile) * D];
+            sum += part.x;
+            peak = fmaxf(peak, part.y);
+        }
+        means[index] = static_cast<float>(sum / length);
+        scales[index] = peak / 448.f;
+    }
