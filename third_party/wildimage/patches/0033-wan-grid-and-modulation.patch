+        // Wan stores one contiguous spatial/time slab per channel and batch.
+        // Traverse it directly instead of broadcasting statistics twice over the clip.
+        template<bool encode>
+        static sd::Tensor<float> unit_scale_latents(const sd::Tensor<float>& input, const sd::Tensor<float>& mean,
+                                                    const sd::Tensor<float>& deviation) {
+            sd::Tensor<float> output(input.shape());
+            if (input.empty()) return output;
+            const int64_t channels = mean.numel();
+            const int64_t span = input.numel() / (channels * input.shape().back());
+            sd::parallel_for(0, input.numel(), 65536, [&](int64_t begin, int64_t end) {
+                while (begin < end) {
+                    const auto group = begin / span;
+                    const int64_t stop = std::min(end, (group + 1) * span);
+                    const float m = mean.data()[group % channels], s = deviation.data()[group % channels];
+                    for (; begin < stop; ++begin) {
+                        if constexpr (encode) {
+                            output.data()[begin] = (input.data()[begin] - m) / s;
+                        } else {
+                            // Preserve the separate FP32 multiply on hosts that contract multiply/add.
+#if defined(__FMA__) || defined(__ARM_FEATURE_FMA) || defined(__AVX2__) || defined(_M_ARM64) || defined(_M_FP_FAST)
+                            const volatile float scaled = input.data()[begin] * s;
+#else
+                            const float scaled = input.data()[begin] * s;
+#endif
+                            output.data()[begin] = scaled + m;
+                        }
+                    }
+                }
+            });
+            return output;
+        }
