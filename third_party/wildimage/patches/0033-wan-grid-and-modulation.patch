+        const auto table = [&](int count, int offset, int dim) {
+            return rope(linspace<float>(static_cast<float>(offset), 1.f * count - 1 + offset, count),
+                        dim, static_cast<float>(theta));
+        };
+        const auto times = table(nt, t_offset, axes_dim[0]);
+        const auto rows = table(nh, 0, axes_dim[1]);
+        const auto cols = table(nw, 0, axes_dim[2]);
+        const size_t stride = times.front().size() + rows.front().size() + cols.front().size();
+        const size_t batch_size = size_t(nt) * nh * nw * stride;
+        std::vector<float> result(batch_size * bs);
+        auto dst = result.begin();
+        for (const auto& time : times) {
+            for (const auto& row : rows) {
+                for (const auto& col : cols) {
+                    dst = std::copy(time.begin(), time.end(), dst);
+                    dst = std::copy(row.begin(), row.end(), dst);
+                    dst = std::copy(col.begin(), col.end(), dst);
+                }
+            }
+        }
+        for (int batch = 1; batch < bs; ++batch) {
+            dst = std::copy_n(result.begin(), batch_size, dst);
+        }
