+        static __global__ void modulate_rows(const float* x, const float* scale, const float* shift, float* dst,
+                                             int width, int64_t rows) {
+            const int c = blockIdx.x * blockDim.x + threadIdx.x;
+            if (c >= width) return;
+            const float s = scale[c], h = shift[c];
+            for (int64_t row = blockIdx.y; row < rows; row += gridDim.y) {
+                const int64_t i = row * width + c;
