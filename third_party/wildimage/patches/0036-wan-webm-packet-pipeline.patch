@@ -25,6 +25,12 @@
 }
 SD_API int sd_get_memory_failure_code(void) { return wildimage_ram::budget().failure_code(); }
 SD_API bool sd_host_reserve(size_t bytes) { if(wildimage_ram::budget().try_acquire(bytes)) return true; wildimage_ram::budget().fail(); return false; }
+SD_API bool sd_try_host_workspace(size_t bytes) {
+    const auto memory = wildimage_ram::system_memory();
+    // Leave OS headroom as well as room for the primary codec worker.
+    return bytes <= wildimage_ram::effective_limit(0, memory) / 2 &&
+           bytes <= wildimage_ram::budget().remaining() / 2 && wildimage_ram::budget().try_acquire(bytes);
+}
 SD_API void sd_host_release(size_t bytes) { wildimage_ram::budget().release(bytes); }
 SD_API void* sd_host_malloc(size_t bytes) { return wildimage_ram::raw_malloc(bytes); }
 SD_API void* sd_host_realloc(void* ptr,size_t bytes) { return wildimage_ram::raw_realloc(ptr,bytes); }
