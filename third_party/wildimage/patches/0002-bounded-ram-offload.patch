+
+bool ModelManager::reclaim_ram(size_t pending, const std::vector<TensorState*>& protected_states) {
+    if(pending<=wildimage_ram::budget().remaining()) return true;
+    std::unordered_set<TensorState*> protected_set(protected_states.begin(),protected_states.end());
+    clear_all_prefetched_params();
+    std::unordered_set<TensorState*> candidates;
+    for(const auto& state:tensor_states_) if(state && state->pin_count==0 && !protected_set.count(state.get())) candidates.insert(state.get());
+    release_compute_staging_blocks(false,&candidates);
+    for(auto it=params_storage_blocks_.begin(); it!=params_storage_blocks_.end();) {
+        auto& block=**it;
+        const bool evict=block.buffer && ggml_backend_buffer_is_host(block.buffer) && block.mmap_tensor_stores.empty() &&
+            std::all_of(block.states.begin(),block.states.end(),[&](TensorState* state) {
+                return state && state->pin_count==0 && !state->staged_to_compute_backend && !protected_set.count(state);
+            });
+        if(evict) { free_params_storage_block(block); it=params_storage_blocks_.erase(it); }
+        else ++it;
+        if(pending<=wildimage_ram::budget().remaining()) return true;
+    }
+    return pending<=wildimage_ram::budget().remaining();
+}
