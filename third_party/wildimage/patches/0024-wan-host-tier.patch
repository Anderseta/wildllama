+// A file-backed weight that must leave the GPU can stay in ordinary host RAM.
+// Budget for Windows commit as well as physical RAM. Driver allocations also
+// consume commit, even when the process working set looks small.
+static uint64_t wan_host_space() {
+    const auto memory = wildimage_ram::system_memory();
+    uint64_t available = memory.available;
+#ifdef _WIN32
+    MEMORYSTATUSEX state{};
+    state.dwLength = sizeof(state);
+    if (!GlobalMemoryStatusEx(&state)) return 0;
+    available = std::min<uint64_t>(available, state.ullAvailPageFile);
+#endif
+    const uint64_t reserve = std::max<uint64_t>(5 * wildimage_ram::GiB, memory.total / 10);
+    return available > reserve ? available - reserve : 0;
+}
+
+void ModelManager::retain_wan_weights(const ParamsStorageBlock& block) {
+    if (!wan_weight_tiering_ || !loras_.empty() || block.states.empty()) return;
+    uint64_t space = std::min(wan_host_space(), wildimage_ram::budget().remaining());
+    for (auto* state : block.states) {
+        if (!state || (state->component != ModelComponent::Diffusion && state->component != ModelComponent::HighNoiseDiffusion) ||
+            !state->tensor || state->sources.empty() || state->applied_lora_epoch != UINT64_MAX ||
+            state->tensor->view_src || !ggml_is_contiguous(state->tensor) ||
+            sd_backend_is_cpu(state->compute_backend) || state->split_buffer_type) continue;
+        const size_t bytes = ggml_nbytes(state->tensor);
+        if (!bytes || bytes > space) continue;
+        auto host = std::unique_ptr<HostWeight>(new (std::nothrow) HostWeight);
+        if (!host || !host->ram.try_reset(bytes)) continue;
+        host->bytes.reset(new (std::nothrow) uint8_t[bytes]);
+        if (!host->bytes) continue;
+        ggml_backend_tensor_get(state->tensor, host->bytes.get(), 0, bytes);
+        state->host_weight = std::move(host);
+        space -= bytes;
+    }
+}
+
+void ModelManager::trim_wan_weights(size_t pending) {
+    if (!wan_weight_tiering_) return;
+    auto space = std::min(wan_host_space(), wildimage_ram::budget().remaining());
+    if (space >= pending) return;
+    for (const auto& state : tensor_states_) {
+        if (!state->host_weight) continue;
+        const auto bytes = state->host_weight->ram.bytes();
+        state->host_weight.reset();
+        space += bytes;
+        if (space >= pending) break;
+    }
+}
