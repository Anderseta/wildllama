+extern "C" SD_API bool wildimage_generate_seeded(sd_ctx_t*, const sd_img_gen_params_t*, const int64_t*, sd_image_generation_result_t**);
+
+// Keep one context across bounded groups. Each group conditions once, samples
+// one latent at a time, and decodes while the VAE is resident. A rename marks
+// a complete PNG even if the parent cancels before reading the notification.
+static bool generate_series(sd_ctx_t* ctx, sd_img_gen_params_t params, const SDCliParams& cli,
+                            const SDContextParams& settings, const SDGenerationParams& gen) {
+    int first, count, group;
+    if (!(std::cin >> first >> count >> group) || first < 0 || count < 1 || count > 1000 ||
+        first > 1000 - count || group < 1 || group > 32) return false;
+    const auto directory = fs::u8path(cli.output_path).parent_path();
+    for (int i = first; i < first + count;) {
+        params.batch_count = std::min(group, first + count - i);
+        std::vector<int64_t> seeds(params.batch_count);
+        for (auto& seed : seeds) {
+            if (!(std::cin >> seed) || seed < 0) return false;
+        }
+        params.seed = seeds.front();
+        std::cout << "WILDIMAGE_GROUP " << i << ' ' << params.batch_count << std::endl;
+        sd_image_generation_result_t* generated = nullptr;
+        const bool ok = wildimage_generate_seeded(ctx, &params, seeds.data(), &generated);
+        SDImageVec results;
+        results.adopt(generated, settings.lora_model_dir);
+        if (!ok || results.count() != params.batch_count) return false;
+        for (int j = 0; j < params.batch_count; ++j) {
+            const auto& img = results[j];
+            auto path = directory / (std::to_string(i + j) + ".png");
+            auto tmp = directory / "writing.png";
+            const auto info = gen.embed_image_metadata ? results.generation_info(j) : "";
+            if (!img.data || !write_image_to_file(tmp.u8string(), img.data, img.width, img.height,
+                                                   img.channel, info, cli.compression_quality)) return false;
+            fs::rename(tmp, path);
+            std::cout << "WILDIMAGE_SAVED " << i + j << std::endl;
+        }
+        i += params.batch_count;
+    }
+    return true;
+}
