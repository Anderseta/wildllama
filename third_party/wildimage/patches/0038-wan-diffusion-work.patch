+ggml_tensor* ggml_ext_attention_key_f16(GGMLRunnerContext* runner_ctx, ggml_tensor* key) {
+#ifndef SD_USE_UPSTREAM_GGML
+    // The Wan flash path already rounds the rotated key to half. Store it directly
