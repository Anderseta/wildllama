+        ggml_ext_op_get(key) == sd_ggml_rope_op() && std::getenv("WILDLLAMA_VIDEO_PROGRESS") &&
+        sd_backend_is(runner_ctx->backend, "CUDA")) {
+        ggml_tensor* inputs[] = {key->src[0], key->src[1]};
+        auto fused = ggml_ext_op_create(runner_ctx->ggml_ctx, sd_ggml_rope_f16_op(), inputs, 2, ggml_ext_op_attributes(key));
+        if (fused && ggml_backend_supports_op(runner_ctx->backend, fused)) {
+            return fused;
+        }
+    }
+#endif
+    return ggml_cast(runner_ctx->ggml_ctx, key, GGML_TYPE_F16);
