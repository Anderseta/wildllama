+    // For long CUDA clips, keep one shared Flash Attention K/V bank. Each query
+    // tile sees the complete key sequence. Rotary positions are sliced in the
+    // original coordinate system, and normalization still spans all channels.
+    inline ggml_tensor* wan_flash_query_tiles(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* pe,
+                                              ggml_tensor* k, ggml_tensor* v, Linear& q_proj, UnaryBlock& norm_q) {
+        constexpr int64_t tile = 8192;
+        auto c = ctx->ggml_ctx;
+        const int64_t dim = x->ne[0], tokens = x->ne[1], heads = k->ne[1], head_dim = k->ne[0];
+        k = ggml_cast(c, Rope::apply_rope(ctx, k, pe), GGML_TYPE_F16);
+        auto permuted_v = ggml_permute(c, v, 0, 2, 1, 3);
+        v = ggml_cast(c, permuted_v, GGML_TYPE_F16);
+        if (!ggml_backend_supports_op(ctx->backend, v)) {
+            v = ggml_cast(c, ggml_ext_cont(ctx, permuted_v), GGML_TYPE_F16);
+        }
+        v = ggml_reshape_3d(c, v, head_dim, tokens, heads);
+        auto range = [&](auto&& self, int64_t first, int64_t count) -> ggml_tensor* {
+            if (count > tile) {
+                const int64_t left = ((count + tile - 1) / tile / 2) * tile;
+                auto a = self(self, first, left);
+                if (!a) return nullptr;
+                auto b = self(self, first + left, count - left);
+                return b ? ggml_concat(c, a, b, 1) : nullptr;
+            }
+            auto input = ggml_view_2d(c, x, dim, count, x->nb[1], first * x->nb[1]);
+            auto pos = ggml_view_4d(c, pe, pe->ne[0], pe->ne[1], pe->ne[2], count,
+                                    pe->nb[1], pe->nb[2], pe->nb[3], first * pe->nb[3]);
+            auto q = norm_q.forward(ctx, q_proj.forward(ctx, input));
+            q = Rope::apply_rope(ctx, ggml_reshape_4d(c, q, head_dim, heads, count, 1), pos);
+            auto out = ggml_flash_attn_ext(c, q, k, v, nullptr, 1.0f / sqrt((float)head_dim), 0, 0);
+            if (!ggml_backend_supports_op(ctx->backend, out)) return nullptr;
+            ggml_prec_set_acc(out, GGML_PREC_F32);
+            return ggml_reshape_3d(c, out, dim, count, 1);
+        };
+        return range(range, 0, tokens);
+    }
+
