 #include <algorithm>
 #include <cstdint>
 #include <iterator>
+#include <fstream>
+#include <filesystem>
 #include <mutex>
 #include <tuple>
 #include <unordered_set>
@@ -2073,6 +2075,43 @@
 // Quantized GGUF weights were already read once. Keep a read-only view of
 // the same cached file pages instead of allocating a private copy and
 // copying it back over PCIe. The OS may reclaim clean pages under pressure.
+bool ModelManager::read_prompt_rows(const ggml_tensor* weight, const std::vector<int32_t>& rows, PromptRowBytes& data) const {
+    if (!weight || weight->type != GGML_TYPE_F16 || !ggml_is_contiguous(weight) ||
+        !loras_.empty() || rows.empty()) return false;
+    const auto it = tensor_states_by_tensor_.find(weight);
+    if (it == tensor_states_by_tensor_.end()) return false;
+    const auto& state = *it->second;
+    if (state.source_file || state.sources.size() != 1 || state.loaded_to_params_backend ||
+        (state.usage_op != GGML_OP_NONE && state.usage_op != GGML_OP_GET_ROWS)) return false;
+    const auto& raw = state.sources.front();
+    if (raw.type != weight->type || raw.index_in_zip >= 0 || raw.n_dims != 2 ||
+        raw.is_f64 || raw.is_i64 || raw.is_f8_e4m3 || raw.is_f8_e5m2 || raw.is_int8_tensorwise ||
+        !std::equal(weight->ne, weight->ne + GGML_MAX_DIMS, raw.ne) ||
+        raw.nbytes_to_read() != static_cast<int64_t>(ggml_nbytes(weight))) return false;
+    const auto path = model_loader_.plain_weight_path(raw);
+    const std::set<std::string> names{raw.name};
+    if (path.empty() || !model_loader_.validate_sources(&names)) return false;
+    std::ifstream file(std::filesystem::u8path(path), std::ios::binary | std::ios::ate);
+    const std::streamoff end = file.tellg();
+    if (end < 0 || raw.offset > static_cast<uint64_t>(end) ||
+        ggml_nbytes(weight) > static_cast<uint64_t>(end) - raw.offset) return false;
+    const size_t stride = weight->nb[1];
+    // Limit optional scratch independently of the total vocabulary size.
+    if (!stride || rows.size() > (8U << 20) / stride ||
+        std::any_of(rows.begin(), rows.end(), [&](int32_t id) { return id < 0 || id >= weight->ne[1]; })) return false;
+    if (rows.size() * stride > wildimage_ram::budget().remaining()) return false;
+    PromptRowBytes result(rows.size() * stride);
+    for (size_t i = 0; i < rows.size();) {
+        size_t next = i + 1;
+        while (next < rows.size() && int64_t(rows[next]) == int64_t(rows[next - 1]) + 1) ++next;
+        file.seekg(static_cast<std::streamoff>(raw.offset + size_t(rows[i]) * stride));
+        if (!file.read(reinterpret_cast<char*>(result.data() + i * stride), (next - i) * stride)) return false;
+        i = next;
+    }
+    data.swap(result);
+    return true;
+}
