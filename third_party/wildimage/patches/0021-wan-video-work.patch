+    // Wan 2.1's causal encoder sees at most 113 source frames: two
+    // temporal stride-2 convolutions, four residual stages and the middle
+    // blocks. At source frames 120 and 124 the first image is outside
+    // this window. Verify the stationary latent bitwise before extending it.
+    static bool extend_constant_wan_tail(sd::Tensor<float>& latent, int64_t frames) {
+        auto shape = latent.shape();
+        if (shape.size() < 4 || shape[2] != 32) return false;
+        const size_t plane = shape[0] * shape[1], times = shape[2];
+        const size_t channels = latent.numel() / (plane * times);
+        for (size_t c = 0; c < channels; ++c) {
+            auto last = latent.data() + ((c + 1) * times - 1) * plane;
+            if (std::memcmp(last, last - plane, plane * sizeof(float)) != 0) return false;
+        }
+        shape[2] = 1 + (frames - 1) / 4;
+        sd::Tensor<float> full(shape);
+        for (size_t c = 0; c < channels; ++c) {
+            auto dst = full.data() + c * shape[2] * plane;
+            auto in = latent.data() + c * times * plane;
+            std::copy_n(in, times * plane, dst);
+            for (int64_t i = times; i < shape[2]; ++i)
+                std::copy_n(in + (times - 1) * plane, plane, dst + i * plane);
+        }
+        latent = std::move(full);
+        return true;
+    }
 
