 EncodeResult T5UniGramTokenizer::EncodeOptimized(const std::string& normalized) const {
+    if (first_extra_id_ < 0 || status() != OK) return encode_ordinary(normalized);
+    // SentencePiece USER_DEFINED symbols are atomic, including inside a larger word.
+    // Split after metaspace preprocessing so ordinary spans receive no extra prefix.
+    EncodeResult out;
+    size_t span = 0;
+    auto flush = [&](size_t end) {
+        if (end == span) return;
+        auto part = encode_ordinary(normalized.substr(span, end - span));
+        out.insert(out.end(), part.begin(), part.end());
+    };
+    for (size_t pos = 0; pos < normalized.size();) {
+        size_t node = 0, key = pos, end = pos;
+        int match = -1;
+        while (key < normalized.size()) {
+            int id = trie_->traverse(normalized.data(), node, key, key + 1);
+            if (id == -2) break;
+            if (id >= first_extra_id_) { match = id; end = key; }
+        }
+        if (match >= 0) {
+            flush(pos);
+            out.emplace_back(piece_score_pairs[match].first, match);
+            span = pos = end;
+        } else {
+            pos += std::min(OneCharLen(normalized.data() + pos), normalized.size() - pos);
+        }
+    }
+    flush(normalized.size());
+    return out;
+}
