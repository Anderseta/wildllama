+// Bucket only host/scheduler metadata capacity. Actual token counts and tensor
+// shapes are never rounded or padded. Fixed slots retain these allocations.
+inline unsigned metadata_tokens(unsigned tokens) {
+    if (!tokens || tokens > max_tokens) { return 0; }
+    unsigned capacity = max_decode_tokens;
+    while (capacity < tokens) { capacity *= 2; }
+    return capacity;
+}
+
+struct prefill_shape {
+    uint32_t tokens;
+    uint32_t outputs;
+    uint32_t position_bucket;
+    uint32_t sequences;
+    uint32_t graph_type;
+
+    bool operator==(const prefill_shape & other) const {
+        return tokens == other.tokens && outputs == other.outputs && position_bucket == other.position_bucket &&
+            sequences == other.sequences && graph_type == other.graph_type;
+    }
+};
+
+// Large one-off prompts must not allocate another graph arena merely because
+// a cache budget was supplied. Observe a bounded set of exact coarse shapes;
+// the complete can_reuse contract remains mandatory on every real cache hit.
+// This is host metadata only. No padding, device allocation, or budget increase.
+class prefill_admission {
+    struct entry {
+        prefill_shape shape = {};
+        bool occupied = false;
+        bool denied = false;
+    };
+    std::array<entry, 8> entries = {};
+    size_t next = 0;
+
+public:
+    bool observe(const prefill_shape & shape) {
+        if (!shape.tokens || shape.tokens > max_tokens || shape.outputs > shape.tokens ||
+                !shape.sequences || shape.sequences > shape.tokens) { return false; }
+        if (shape.tokens <= max_decode_tokens) { return true; }
+        for (const auto & item : entries) {
+            if (item.occupied && item.shape == shape) { return !item.denied; }
+        }
+        entries[next] = {shape, true, false};
+        next = (next + 1) % entries.size();
+        return false;
+    }
+
+    // An optional allocation/preflight failure retains the primary path. Avoid
+    // retrying the same expensive failure until invalidation or bounded aging.
+    void deny(const prefill_shape & shape) {
+        if (shape.tokens <= max_decode_tokens) { return; }
+        for (auto & item : entries) {
+            if (item.occupied && item.shape == shape) { item.denied = true; return; }
+        }
+    }
+
+    void clear() { entries = {}; next = 0; }
+};
+
+static_assert(sizeof(prefill_admission) <= 512, "prefill admission metadata must stay bounded");
 
