@@ -0,0 +1,34 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+inline bool ggml_kv_paging_enabled(const char * value) {
+    return value && std::strcmp(value, "1") == 0;
+}
+
+// Limit optional map descriptors to at most one per minimum physical page.
+// Larger reservations retain the original whole-run mapping policy.
+inline size_t ggml_kv_paging_segment_pages(size_t capacity, size_t granularity, bool enabled) {
+    if (!enabled || !capacity || !granularity || capacity % granularity || capacity/granularity > 65536) { return 0; }
+    return std::max<size_t>(1, (2 * 1024 * 1024)/granularity);
+}
+
+template <typename Pages>
+size_t ggml_kv_paging_run_end(const Pages & pages, size_t first, size_t end, size_t segment_pages) {
+    size_t stop = end;
+    if (segment_pages) { stop = std::min(stop, first + segment_pages - first % segment_pages); }
+    while (first < stop && !pages[first]) { ++first; }
+    return first;
+}
+
+// Dense attention can read masked holes. Keep the entire padded physical span,
+// not just the logically occupied cells within it.
+inline uint32_t ggml_kv_paging_keep_tokens(uint32_t capacity, uint32_t initial,
+        uint32_t live_end, uint32_t alignment) {
+    if (!capacity || !initial || initial > capacity || live_end > capacity || !alignment) { return capacity; }
+    const uint64_t needed = std::max(initial, live_end);
+    return uint32_t(std::min<uint64_t>(capacity, ((needed + alignment - 1)/alignment)*alignment));
+}
