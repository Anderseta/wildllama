+
+static std::atomic<uint64_t> paged_attn_submissions{0};
+
+uint64_t ggml_cuda_paged_attn_submissions() {
+    return paged_attn_submissions.load(std::memory_order_relaxed);
+}
+
+bool ggml_cuda_flash_attn_paged_supported(int device, const ggml_tensor * dst) {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    GGML_UNUSED_VARS(device, dst);
+    return false;
+#else
+    if (!ggml_paged_attn_valid(dst) || !GGML_CUDA_CC_IS_NVIDIA(ggml_cuda_info().devices[device].cc)) { return false; }
+    const auto * q = dst->src[0];
+    const auto * k = dst->src[1];
+    const auto * v = dst->src[2];
+    if (q->ne[0] < 32 || q->ne[0] > 256 || q->ne[0] % 32 ||
+        v->ne[0] < 32 || v->ne[0] > 256 || v->ne[0] % 32 || k->ne[1] > INT32_MAX) { return false; }
+    int64_t rows = 1;
+    for (int dimension = 1; dimension < GGML_MAX_DIMS; ++dimension) {
+        if (q->ne[dimension] > INT32_MAX / rows) { return false; }
+        rows *= q->ne[dimension];
+    }
+    for (int source = 0; source < 7; ++source) {
+        const auto * tensor = dst->src[source];
+        if (!tensor) { continue; }
+        const size_t alignment = tensor->type == GGML_TYPE_F16 || tensor->type == GGML_TYPE_Q8_0 ?
+            alignof(ggml_half) : alignof(float);
+        if (tensor->view_offs % alignment) { return false; }
+        for (int dimension = 0; dimension < GGML_MAX_DIMS; ++dimension) {
+            if (tensor->ne[dimension] > 1 && tensor->nb[dimension] % alignment) { return false; }
+        }
+    }
+    return q->nb[0] == sizeof(float) && k->nb[0] == ggml_type_size(k->type) &&
+        v->nb[0] == ggml_type_size(v->type);
+#endif
+}
+
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+template<ggml_type Type>
+static __device__ __forceinline__ float paged_component(const char * row, int column) {
+    if constexpr (Type == GGML_TYPE_F32) {
+        return reinterpret_cast<const float *>(row)[column];
+    } else if constexpr (Type == GGML_TYPE_F16) {
+        return __half2float(reinterpret_cast<const half *>(row)[column]);
+    } else {
+        const auto & block = reinterpret_cast<const block_q8_0 *>(row)[column / QK8_0];
+        return __half2float(block.d) * float(block.qs[column % QK8_0]);
+    }
+}
+
+struct paged_attention_args {
+    const char * q;
+    const char * k;
+    const char * v;
+    const char * mask;
+    const float * sinks;
+    const int32_t * table;
+    const int32_t * lengths;
+    float * output;
+    int d_qk, d_v, queries, query_heads, kv_heads, sequences, physical_sequences;
+    int physical_rows, logical_blocks, page_tokens;
+    int mask_heads, mask_sequences;
+    size_t q_stride[3], k_stride[3], v_stride[3], mask_stride[3];
+    float scale, max_bias, logit_softcap, m0, m1;
+    uint32_t head_power;
+    uint3 page_divisor;
+    bool mask_f32;
+};
+
+template<ggml_type TypeK, ggml_type TypeV>
+static __global__ __launch_bounds__(128, 2) void paged_attention(paged_attention_args args) {
+    ggml_cuda_pdl_lc();
+    ggml_cuda_pdl_sync();
+    constexpr int warps = 4;
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int warp = threadIdx.x / WARP_SIZE;
+    const int query = blockIdx.x % args.queries;
+    const int head = (blockIdx.x / args.queries) % args.query_heads;
+    const int sequence = blockIdx.x / (args.queries * args.query_heads);
+    const int physical_sequence = args.physical_sequences == 1 ? 0 : sequence;
+    const int kv_head = head / (args.query_heads / args.kv_heads);
+    const int64_t logical_capacity = int64_t(args.logical_blocks) * args.page_tokens;
+    const int64_t length = args.lengths ? args.lengths[sequence] : logical_capacity;
+    const char * q_row = args.q + sequence * args.q_stride[2] + head * args.q_stride[1] + query * args.q_stride[0];
+    const char * k_base = args.k + physical_sequence * args.k_stride[2] + kv_head * args.k_stride[1];
+    const char * v_base = args.v + physical_sequence * args.v_stride[2] + kv_head * args.v_stride[1];
+    const char * mask_row = args.mask ? args.mask +
+        (sequence % args.mask_sequences) * args.mask_stride[2] +
+        (head % args.mask_heads) * args.mask_stride[1] + query * args.mask_stride[0] : nullptr;
+    const float slope = get_alibi_slope(args.max_bias, head, args.head_power, args.m0, args.m1);
+    float q_values[8] = {};
+    float accumulator[8] = {};
+    float maximum = -INFINITY;
+    float mass = 0.0f;
+    bool invalid = length < 0 || length > logical_capacity;
+#pragma unroll
+    for (int part = 0; part < 8; ++part) {
+        const int column = lane + part * WARP_SIZE;
+        if (column < args.d_qk) { q_values[part] = reinterpret_cast<const float *>(q_row)[column]; }
+    }
+    for (int64_t logical = warp; !invalid && logical < length; logical += warps) {
+        float mask_value = 0.0f;
+        if (mask_row) {
+            mask_value = args.mask_f32 ? reinterpret_cast<const float *>(mask_row)[logical] :
+                __half2float(reinterpret_cast<const half *>(mask_row)[logical]);
+            if (mask_value == -INFINITY) { continue; }
+        }
+        const auto page = fast_div_modulo(uint32_t(logical), args.page_divisor);
+        const int block = args.table[int64_t(sequence) * args.logical_blocks + page.x];
+        const int64_t physical = int64_t(block) * args.page_tokens + page.y;
+        if (block < 0 || physical < 0 || physical >= args.physical_rows) { invalid = true; break; }
+        const char * k_row = k_base + physical * args.k_stride[0];
+        const char * v_row = v_base + physical * args.v_stride[0];
+        float dot = 0.0f;
+#pragma unroll
+        for (int part = 0; part < 8; ++part) {
+            const int column = lane + part * WARP_SIZE;
+            if (column < args.d_qk) { dot += q_values[part] * paged_component<TypeK>(k_row, column); }
+        }
+        dot = warp_reduce_sum(dot);
+        float score = dot * args.scale;
+        if (args.logit_softcap > 0.0f) { score = args.logit_softcap * tanhf(score); }
+        score += slope * mask_value;
+        if (score == -INFINITY) { continue; }
+        if (!isfinite(score)) { invalid = true; break; }
+        const float next_maximum = fmaxf(maximum, score);
+        const float previous_scale = mass == 0.0f ? 0.0f : expf(maximum - next_maximum);
+        const float weight = expf(score - next_maximum);
+        maximum = next_maximum;
+        mass = mass * previous_scale + weight;
+#pragma unroll
+        for (int part = 0; part < 8; ++part) {
+            const int column = lane + part * WARP_SIZE;
+            if (column < args.d_v) {
+                accumulator[part] = accumulator[part] * previous_scale + weight * paged_component<TypeV>(v_row, column);
+            }
+        }
+    }
+    __shared__ float partial[warps][256];
+    __shared__ float maxima[warps], masses[warps];
+    __shared__ int failures[warps];
+#pragma unroll
+    for (int part = 0; part < 8; ++part) {
+        const int column = lane + part * WARP_SIZE;
+        if (column < args.d_v) { partial[warp][column] = accumulator[part]; }
+    }
+    if (lane == 0) { maxima[warp] = maximum; masses[warp] = mass; failures[warp] = invalid; }
+    __syncthreads();
+    float global_maximum = -INFINITY;
+    bool failure = false;
+#pragma unroll
+    for (int i = 0; i < warps; ++i) { global_maximum = fmaxf(global_maximum, maxima[i]); failure |= failures[i] != 0; }
+    float sink = -INFINITY;
+    if (args.sinks) {
+        sink = args.sinks[head];
+        failure |= isnan(sink) || sink == INFINITY;
+        global_maximum = fmaxf(global_maximum, sink);
+    }
+    float scales[warps], normalizer = 0.0f;
+#pragma unroll
+    for (int i = 0; i < warps; ++i) {
+        scales[i] = masses[i] == 0.0f ? 0.0f : expf(maxima[i] - global_maximum);
+        normalizer += masses[i] * scales[i];
+    }
+    if (sink != -INFINITY) { normalizer += expf(sink - global_maximum); }
+    const int64_t output_row = (int64_t(sequence) * args.queries + query) * args.query_heads + head;
+    for (int column = threadIdx.x; column < args.d_v; column += blockDim.x) {
+        float value = 0.0f;
+#pragma unroll
+        for (int i = 0; i < warps; ++i) { value += partial[i][column] * scales[i]; }
+        args.output[output_row * args.d_v + column] = failure ? NAN : normalizer > 0.0f ? value / normalizer : 0.0f;
+    }
+}
+
+template<ggml_type TypeK>
+static void paged_attention_launch_v(ggml_backend_cuda_context & ctx, const ggml_tensor * dst,
+        const paged_attention_args & args, dim3 blocks) {
+    const ggml_cuda_kernel_launch_params launch{blocks, dim3(128), 0, ctx.stream()};
+    switch (dst->src[2]->type) {
+        case GGML_TYPE_F32: ggml_cuda_kernel_launch(paged_attention<TypeK, GGML_TYPE_F32>, launch, args); break;
+        case GGML_TYPE_F16: ggml_cuda_kernel_launch(paged_attention<TypeK, GGML_TYPE_F16>, launch, args); break;
+        case GGML_TYPE_Q8_0: ggml_cuda_kernel_launch(paged_attention<TypeK, GGML_TYPE_Q8_0>, launch, args); break;
+        default: GGML_ABORT("unsupported paged V type");
+    }
+}
+#endif
+
+void ggml_cuda_flash_attn_paged(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    GGML_UNUSED_VARS(ctx, dst);
+    GGML_ABORT("paged attention CUDA execution is unavailable on this backend");
+#else
+    GGML_ASSERT(ggml_cuda_flash_attn_paged_supported(ctx.device, dst));
+    const auto * q = dst->src[0];
+    const auto * k = dst->src[1];
+    const auto * v = dst->src[2];
+    const auto * mask = dst->src[3];
+    const auto params = ggml_paged_attn_get_params(dst);
+    paged_attention_args args{};
+    args.q = static_cast<const char *>(q->data); args.k = static_cast<const char *>(k->data);
+    args.v = static_cast<const char *>(v->data); args.mask = mask ? static_cast<const char *>(mask->data) : nullptr;
+    args.sinks = dst->src[4] ? static_cast<const float *>(dst->src[4]->data) : nullptr;
+    args.table = static_cast<const int32_t *>(dst->src[5]->data);
+    args.lengths = dst->src[6] ? static_cast<const int32_t *>(dst->src[6]->data) : nullptr;
+    args.output = static_cast<float *>(dst->data);
+    args.d_qk = int(q->ne[0]); args.d_v = int(v->ne[0]); args.queries = int(q->ne[1]);
+    args.query_heads = int(q->ne[2]); args.kv_heads = int(k->ne[2]);
+    args.sequences = int(q->ne[3]); args.physical_sequences = int(k->ne[3]);
+    args.physical_rows = int(k->ne[1]); args.logical_blocks = int(dst->src[5]->ne[0]);
+    args.page_tokens = params.page_tokens;
+    args.page_divisor = init_fastdiv_values(params.page_tokens);
+    args.mask_heads = mask ? int(mask->ne[2]) : 1; args.mask_sequences = mask ? int(mask->ne[3]) : 1;
+    args.mask_f32 = mask && mask->type == GGML_TYPE_F32;
+    for (int i = 0; i < 3; ++i) {
+        args.q_stride[i] = q->nb[i + 1]; args.k_stride[i] = k->nb[i + 1]; args.v_stride[i] = v->nb[i + 1];
+        args.mask_stride[i] = mask ? mask->nb[i + 1] : 0;
+    }
+    args.scale = params.logit_softcap > 0.0f ? params.scale / params.logit_softcap : params.scale;
+    args.max_bias = params.max_bias; args.logit_softcap = params.logit_softcap;
+    args.head_power = 1;
+    while (args.head_power <= uint32_t(args.query_heads) / 2) { args.head_power *= 2; }
+    args.m0 = powf(2.0f, -args.max_bias / args.head_power);
+    args.m1 = powf(2.0f, -(args.max_bias / 2.0f) / args.head_power);
+    const dim3 blocks(uint32_t(q->ne[1] * q->ne[2] * q->ne[3]));
+    switch (k->type) {
+        case GGML_TYPE_F32: paged_attention_launch_v<GGML_TYPE_F32>(ctx, dst, args, blocks); break;
+        case GGML_TYPE_F16: paged_attention_launch_v<GGML_TYPE_F16>(ctx, dst, args, blocks); break;
+        case GGML_TYPE_Q8_0: paged_attention_launch_v<GGML_TYPE_Q8_0>(ctx, dst, args, blocks); break;
+        default: GGML_ABORT("unsupported paged K type");
+    }
+    CUDA_CHECK(cudaGetLastError());
+    paged_attn_submissions.fetch_add(1, std::memory_order_relaxed);
+#endif
+}
