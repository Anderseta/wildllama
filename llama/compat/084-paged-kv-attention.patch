diff --git a/src/llama-paged-kv-pool.h b/src/llama-paged-kv-pool.h
new file mode 100644
--- /dev/null
+++ b/src/llama-paged-kv-pool.h
@@ -0,0 +1,212 @@
+#pragma once
+
+#include <algorithm>
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <new>
+#include <utility>
+#include <vector>
+
+// A preallocated hierarchical bitmap. Updating a cell/page and locating a free
+// page never allocates or scans the configured token capacity.
+class llama_paged_kv_bitmap {
+public:
+    static constexpr uint32_t none = UINT32_MAX;
+
+    void reset(uint32_t count) {
+        std::vector<std::vector<uint64_t>> next;
+        for (uint64_t bits = count; bits;) {
+            const uint64_t words = (bits + 63) / 64;
+            next.emplace_back(size_t(words), 0);
+            if (words == 1) { break; }
+            bits = words;
+        }
+        levels.swap(next);
+        size = count;
+    }
+
+    void clear() {
+        for (auto & level : levels) { std::fill(level.begin(), level.end(), 0); }
+    }
+
+    bool test(uint32_t index) const {
+        return index < size && (levels[0][index / 64] & (UINT64_C(1) << (index % 64))) != 0;
+    }
+
+    void set(uint32_t index, bool value) {
+        assert(index < size);
+        size_t word = index / 64;
+        const uint64_t bit = UINT64_C(1) << (index % 64);
+        const uint64_t before = levels[0][word];
+        const uint64_t after = value ? before | bit : before & ~bit;
+        levels[0][word] = after;
+        bool old_nonempty = before != 0, new_nonempty = after != 0;
+        for (size_t level = 1; level < levels.size() && old_nonempty != new_nonempty; ++level) {
+            const size_t parent = word / 64;
+            const uint64_t parent_bit = UINT64_C(1) << (word % 64);
+            const uint64_t old_parent = levels[level][parent];
+            const uint64_t new_parent = new_nonempty ? old_parent | parent_bit : old_parent & ~parent_bit;
+            levels[level][parent] = new_parent;
+            old_nonempty = old_parent != 0; new_nonempty = new_parent != 0;
+            word = parent;
+        }
+    }
+
+    uint32_t first() const {
+        if (levels.empty() || !levels.back()[0]) { return none; }
+        size_t index = 0;
+        for (size_t level = levels.size(); level-- > 0;) {
+            const uint64_t bits = levels[level][index];
+            index = index * 64 + trailing(bits);
+        }
+        return uint32_t(index);
+    }
+
+    template<typename Visit>
+    bool each(Visit && visit) const {
+        return levels.empty() || walk(levels.size() - 1, 0, visit);
+    }
+
+    static uint32_t trailing(uint64_t bits) {
+        assert(bits);
+        uint32_t count = 0;
+        // Constant bounded work and portable C++17; compilers recognize this
+        // idiom without exposing CUDA/Windows intrinsics in the cache header.
+        while ((bits & 1) == 0) { bits >>= 1; ++count; }
+        return count;
+    }
+
+private:
+    template<typename Visit>
+    bool walk(size_t level, size_t word, Visit & visit) const {
+        uint64_t bits = levels[level][word];
+        while (bits) {
+            const size_t index = word * 64 + trailing(bits);
+            bits &= bits - 1;
+            if (level ? !walk(level - 1, index, visit) : !visit(uint32_t(index))) { return false; }
+        }
+        return true;
+    }
+
+    uint32_t size = 0;
+    std::vector<std::vector<uint64_t>> levels;
+};
+
+// Physical P32 pages are shared at cell granularity. Logical sequence/position
+// ownership remains in llama_kv_cells: removing one alias cannot release a cell
+// or page still referenced by another sequence. The attention block table maps
+// compact logical read pages directly to these noncontiguous physical pages.
+class llama_paged_kv_pool {
+public:
+    static constexpr uint32_t page_tokens = 32;
+    static constexpr uint64_t max_metadata_bytes = 16 * 1024 * 1024;
+
+    bool configure(uint32_t cells) {
+        const uint64_t pages = (uint64_t(cells) + page_tokens - 1) / page_tokens;
+        // Includes both occupied masks and worst-case cached table capacity,
+        // plus conservative bitmap/vector bookkeeping. Denial leaves the
+        // existing layout untouched and lets the caller use ordinary storage.
+        if (!cells || pages * 10 + 4096 > max_metadata_bytes) { return false; }
+        try {
+            llama_paged_kv_pool next;
+            next.capacity = cells;
+            next.occupied.resize(size_t(pages), 0);
+            next.cached_table.reserve(size_t(pages));
+            next.active.reset(uint32_t(pages));
+            next.partial.reset(uint32_t(pages));
+            next.empty.reset(uint32_t(pages));
+            for (uint32_t page = 0; page < pages; ++page) { next.empty.set(page, true); }
+            *this = std::move(next);
+            return true;
+        } catch (const std::bad_alloc &) {
+            return false;
+        }
+    }
+
+    bool enabled() const { return capacity != 0; }
+    uint32_t size() const { return capacity; }
+    uint32_t used() const { return used_cells; }
+    uint32_t free() const { return capacity - used_cells; }
+
+    void clear() {
+        if (!enabled()) { return; }
+        std::fill(occupied.begin(), occupied.end(), 0);
+        active.clear(); partial.clear(); empty.clear();
+        for (uint32_t page = 0; page < occupied.size(); ++page) { empty.set(page, true); }
+        used_cells = 0;
+        cached_table.clear();
+        table_dirty = false;
+    }
+
+    bool claim(uint32_t cell) {
+        if (cell >= capacity) { return false; }
+        const uint32_t page = cell / page_tokens, bit = UINT32_C(1) << (cell % page_tokens);
+        if (occupied[page] & bit) { return false; }
+        const bool was_empty = occupied[page] == 0;
+        occupied[page] |= bit;
+        ++used_cells;
+        empty.set(page, false);
+        partial.set(page, occupied[page] != valid_mask(page));
+        if (was_empty) { active.set(page, true); table_dirty = true; }
+        return true;
+    }
+
+    bool release(uint32_t cell) {
+        if (cell >= capacity) { return false; }
+        const uint32_t page = cell / page_tokens, bit = UINT32_C(1) << (cell % page_tokens);
+        if (!(occupied[page] & bit)) { return false; }
+        occupied[page] &= ~bit;
+        --used_cells;
+        const bool now_empty = occupied[page] == 0;
+        empty.set(page, now_empty);
+        partial.set(page, !now_empty && occupied[page] != valid_mask(page));
+        if (now_empty) { active.set(page, false); table_dirty = true; }
+        return true;
+    }
+
+    bool contains(uint32_t cell) const {
+        return cell < capacity && (occupied[cell / page_tokens] & (UINT32_C(1) << (cell % page_tokens))) != 0;
+    }
+
+    // Nonmutating reservation: prepare() can emulate the selected cells and
+    // rewind them through the normal cell transaction before real application.
+    bool select(uint32_t count, std::vector<uint32_t> & destination) const {
+        if (!enabled() || count > free()) { return false; }
+        destination.clear();
+        destination.reserve(count);
+        auto choose = [&](uint32_t page) {
+            uint32_t bits = valid_mask(page) & ~occupied[page];
+            while (bits && destination.size() < count) {
+                const uint32_t offset = llama_paged_kv_bitmap::trailing(bits);
+                bits &= bits - 1;
+                destination.push_back(page * page_tokens + offset);
+            }
+            return destination.size() < count;
+        };
+        if (count && partial.each(choose)) { empty.each(choose); }
+        return destination.size() == count;
+    }
+
+    const std::vector<uint32_t> & table() const {
+        if (table_dirty) {
+            cached_table.clear();
+            active.each([&](uint32_t page) { cached_table.push_back(page); return true; });
+            table_dirty = false;
+        }
+        return cached_table;
+    }
+
+private:
+    uint32_t valid_mask(uint32_t page) const {
+        const uint32_t remaining = capacity - page * page_tokens;
+        return remaining >= page_tokens ? UINT32_MAX : (UINT32_C(1) << remaining) - 1;
+    }
+
+    uint32_t capacity = 0, used_cells = 0;
+    std::vector<uint32_t> occupied;
+    llama_paged_kv_bitmap active, partial, empty;
+    mutable std::vector<uint32_t> cached_table;
+    mutable bool table_dirty = true;
+};
