diff --git a/ggml/src/ggml-paged-attn.h b/ggml/src/ggml-paged-attn.h
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-paged-attn.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <float.h>
+#include <limits.h>
+#include <string.h>
+
+struct ggml_paged_attn_params {
+    float scale;
+    float max_bias;
+    float logit_softcap;
+    int32_t page_tokens;
+};
+
+static inline struct ggml_paged_attn_params ggml_paged_attn_get_params(const struct ggml_tensor * dst) {
+    struct ggml_paged_attn_params params;
+    memcpy(&params, dst->op_params, sizeof(params));
+    return params;
+}
+
+static inline bool ggml_paged_attn_storage_type(enum ggml_type type) {
+    return type == GGML_TYPE_F16 || type == GGML_TYPE_F32 || type == GGML_TYPE_Q8_0;
+}
+
+static inline bool ggml_paged_attn_layout_valid(const struct ggml_tensor * tensor) {
+    if (!tensor || tensor->type < 0 || tensor->type >= GGML_TYPE_COUNT) { return false; }
+    const int64_t block = ggml_blck_size(tensor->type);
+    const size_t element = ggml_type_size(tensor->type);
+    if (block <= 0 || !element || tensor->ne[0] <= 0 || tensor->ne[0] % block) { return false; }
+    const size_t alignment = tensor->type == GGML_TYPE_Q8_0 || tensor->type == GGML_TYPE_F16 ? 2 :
+            tensor->type == GGML_TYPE_F32 || tensor->type == GGML_TYPE_I32 ? 4 : 1;
+    if (tensor->view_offs % alignment || (tensor->data && (uintptr_t) tensor->data % alignment)) { return false; }
+    uint64_t elements = 1;
+    size_t span = element;
+    for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+        if (tensor->ne[i] <= 0 || (uint64_t) tensor->ne[i] > (uint64_t) INT64_MAX / elements) { return false; }
+        if (tensor->nb[i] % alignment) { return false; }
+        elements *= (uint64_t) tensor->ne[i];
+        const uint64_t steps = (uint64_t) (tensor->ne[i] / (i == 0 ? block : 1) - 1);
+        if (steps > SIZE_MAX || (tensor->nb[i] && steps > (SIZE_MAX - span) / tensor->nb[i])) { return false; }
+        span += (size_t) steps * tensor->nb[i];
+    }
+    return tensor->view_offs <= SIZE_MAX - span;
+}
+
+// Metadata-only validation: backend capability probes have no tensor data yet.
+// Page IDs and optional lengths are validated by the cache owner before upload
+// and checked again by each compute implementation before a physical read.
+static inline bool ggml_paged_attn_valid(const struct ggml_tensor * dst) {
+    if (!dst || dst->op != GGML_OP_FLASH_ATTN_PAGED || dst->type != GGML_TYPE_F32) { return false; }
+    const struct ggml_tensor * q = dst->src[0];
+    const struct ggml_tensor * k = dst->src[1];
+    const struct ggml_tensor * v = dst->src[2];
+    const struct ggml_tensor * mask = dst->src[3];
+    const struct ggml_tensor * sinks = dst->src[4];
+    const struct ggml_tensor * table = dst->src[5];
+    const struct ggml_tensor * lengths = dst->src[6];
+    if (!q || !k || !v || !table || q->type != GGML_TYPE_F32 ||
+            !ggml_paged_attn_storage_type(k->type) || !ggml_paged_attn_storage_type(v->type)) { return false; }
+    for (int i = 0; i <= 6; ++i) {
+        if (dst->src[i] && !ggml_paged_attn_layout_valid(dst->src[i])) { return false; }
+    }
+    if (!ggml_paged_attn_layout_valid(dst)) { return false; }
+    const struct ggml_paged_attn_params params = ggml_paged_attn_get_params(dst);
+    if (params.page_tokens <= 0 || !(params.scale >= -FLT_MAX && params.scale <= FLT_MAX) ||
+            !(params.max_bias >= 0.f && params.max_bias <= FLT_MAX) ||
+            !(params.logit_softcap >= 0.f && params.logit_softcap <= FLT_MAX)) { return false; }
+    if (params.max_bias > 0.f && !mask) { return false; }
+    if (q->ne[0] <= 0 || q->ne[0] > INT32_MAX || q->ne[1] <= 0 || q->ne[2] <= 0 || q->ne[2] > INT32_MAX || q->ne[3] <= 0 || q->ne[3] > INT32_MAX ||
+            k->ne[0] != q->ne[0] || k->ne[1] <= 0 || k->ne[2] <= 0 || v->ne[0] <= 0 || v->ne[0] > INT32_MAX ||
+            v->ne[1] != k->ne[1] || v->ne[2] != k->ne[2] || v->ne[3] != k->ne[3] ||
+            (k->ne[3] != 1 && k->ne[3] != q->ne[3]) || q->ne[2] % k->ne[2] != 0 ||
+            q->nb[0] != sizeof(float) || k->nb[0] != ggml_type_size(k->type) ||
+            v->nb[0] != ggml_type_size(v->type) || k->ne[0] % ggml_blck_size(k->type) != 0 ||
+            v->ne[0] % ggml_blck_size(v->type) != 0) { return false; }
+    if (table->type != GGML_TYPE_I32 || !ggml_is_contiguous(table) || table->ne[0] <= 0 ||
+            table->ne[0] > INT32_MAX / params.page_tokens || table->ne[1] != q->ne[3] ||
+            table->ne[2] != 1 || table->ne[3] != 1) { return false; }
+    if (lengths && (lengths->type != GGML_TYPE_I32 || !ggml_is_contiguous(lengths) ||
+            lengths->ne[0] != q->ne[3] || lengths->ne[1] != 1 || lengths->ne[2] != 1 || lengths->ne[3] != 1)) { return false; }
+    const int64_t logical_capacity = table->ne[0] * params.page_tokens;
+    if (mask && ((mask->type != GGML_TYPE_F16 && mask->type != GGML_TYPE_F32) ||
+            mask->ne[0] < logical_capacity || mask->ne[1] < q->ne[1] || mask->ne[2] <= 0 || mask->ne[3] <= 0 ||
+            q->ne[2] % mask->ne[2] || q->ne[3] % mask->ne[3] ||
+            mask->nb[0] != ggml_type_size(mask->type))) { return false; }
+    if (sinks && (sinks->type != GGML_TYPE_F32 || sinks->ne[0] != q->ne[2] ||
+            sinks->ne[1] != 1 || sinks->ne[2] != 1 || sinks->ne[3] != 1 || sinks->nb[0] != sizeof(float))) { return false; }
+    if (dst->ne[0] != v->ne[0] || dst->ne[1] != q->ne[2] ||
+            dst->ne[2] != q->ne[1] || dst->ne[3] != q->ne[3] || !ggml_is_contiguous(dst)) { return false; }
+    for (int i = 7; i < GGML_MAX_SRC; ++i) { if (dst->src[i]) { return false; } }
+    return true;
+}
