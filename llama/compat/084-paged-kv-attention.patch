+    invalid = *fixture.output; wrong = *fixture.mask; wrong.ne[2] = 3; invalid.src[3] = &wrong;
+    require(!ggml_paged_attn_valid(&invalid), "invalid mask head broadcasting admitted");
+    invalid = *fixture.output; wrong = *fixture.query; wrong.nb[1] = SIZE_MAX; invalid.src[0] = &wrong;
+    require(!ggml_paged_attn_valid(&invalid), "overflowing query span admitted");
+    invalid = *fixture.output; wrong = *fixture.query; wrong.nb[1] += 1; invalid.src[0] = &wrong;
+    require(!ggml_paged_attn_valid(&invalid), "unaligned query rows admitted");
+}
+
+static void run_cases(ggml_backend_t backend) {
+    size_t values = 0;
+    for (const auto key : {GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_Q8_0}) for (const auto value : {GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_Q8_0}) {
+        paged_case options; options.key_type = key; options.value_type = value;
+        paged_fixture fixture(backend, options); values += fixture.check(backend, "strided GQA, page holes, ALiBi, softcap and sinks");
+    }
+    for (int scenario = 0; scenario < 11; ++scenario) {
+        paged_case options;
+        const char * name = "";
+        if (scenario == 0) { options.queries = 65; options.blocks = 3; name = "arbitrary prefill larger than 32 queries"; }
+        if (scenario == 1) { options.shared_stream = true; name = "shared physical KV stream"; }
+        if (scenario == 2) { options.zero_length = true; name = "zero-length sink-only rows"; }
+        if (scenario == 3) { options.all_masked = true; options.sinks = false; name = "fully masked rows"; }
+        if (scenario == 4) { options.mask = options.sinks = options.lengths = false; name = "full pages without length or mask tensors"; }
+        if (scenario == 5) { options.mask = false; options.invalid_page = true; name = "invalid page IDs fail closed"; }
+        if (scenario == 6) { options.mask = false; options.invalid_length = true; name = "invalid lengths fail closed"; }
+        if (scenario == 7) { options.mask_type = GGML_TYPE_F32; options.shared_mask_stream = true; name = "F32 mask with head and stream broadcasting"; }
+        if (scenario == 8) { options.key_width = 128; options.softcap = 0.f; name = "128-dimensional keys without softcap"; }
+        if (scenario == 9) { options.key_width = options.value_width = 256; options.key_type = options.value_type = GGML_TYPE_Q8_0; name = "256-dimensional original Q8_0 keys and values"; }
+        if (scenario == 10) { options.key_width = options.value_width = 256; options.key_type = GGML_TYPE_F16; name = "256-dimensional mixed F16 keys and F32 values"; }
+        paged_fixture fixture(backend, options); values += fixture.check(backend, name);
+    }
+    metadata_cases(backend);
+    std::printf("PASS paged attention: independent dense double values=%zu, nine original-storage combinations, no dense KV gather\n", values);
+}
+
+#ifndef GGML_TEST_PAGED_NO_MAIN
+int main() {
+    try {
+        require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH), "explicit CPU backend unavailable");
+        auto * device = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+        ggml_backend_ptr backend(device ? ggml_backend_dev_init(device, nullptr) : nullptr);
+        require(bool(backend), "CPU backend unavailable");
+        auto set_threads = reinterpret_cast<void (*)(ggml_backend_t, int)>(ggml_backend_reg_get_proc_address(
+                ggml_backend_dev_backend_reg(device), "ggml_backend_set_n_threads"));
+        if (set_threads) { set_threads(backend.get(), 2); }
+        run_cases(backend.get());
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL paged attention: %s\n", error.what()); return 1;
+    }
+}
+#endif
diff --git a/tests/test-paged-kv-pool.cpp b/tests/test-paged-kv-pool.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-paged-kv-pool.cpp
@@ -0,0 +1,117 @@
+#include "../src/llama-paged-kv-pool.h"
+#include "../src/llama-kv-cells.h"
+
+#include <cstdio>
+#include <set>
+#include <stdexcept>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+static void bitmap() {
+    llama_paged_kv_bitmap bits;
+    bits.reset(65537);
+    std::set<uint32_t> reference;
+    for (uint32_t index : {0u, 31u, 32u, 63u, 64u, 4095u, 4096u, 65535u, 65536u}) {
+        bits.set(index, true); reference.insert(index);
+    }
+    uint32_t state = 92134567;
+    for (int step = 0; step < 6000; ++step) {
+        state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+        const auto index = state % 65537;
+        const bool enabled = (state & 1024) != 0;
+        bits.set(index, enabled);
+        if (enabled) { reference.insert(index); } else { reference.erase(index); }
+        require(bits.first() == (reference.empty() ? UINT32_MAX : *reference.begin()), "hierarchical free-page lookup disagrees with independent set");
+        require(bits.test(index) == (reference.count(index) != 0), "page membership changed");
+    }
+    std::vector<uint32_t> enumerated;
+    bits.each([&](uint32_t index) { enumerated.push_back(index); return true; });
+    require(enumerated == std::vector<uint32_t>(reference.begin(), reference.end()), "sparse page enumeration lost or duplicated a page");
+    size_t visits = 0;
+    bits.each([&](uint32_t) { return ++visits < 3; });
+    require(visits == 3, "bounded page selection ignored early completion");
+    bits.clear(); require(bits.first() == UINT32_MAX, "clear retained a live summary bit");
+}
+
+static void pool() {
+    llama_paged_kv_pool value;
+    require(value.configure(8193), "cannot initialize bounded physical pool");
+    std::vector<bool> reference(8193, false);
+    uint32_t state = 912345, count = 0;
+    for (int step = 0; step < 10000; ++step) {
+        state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+        const uint32_t index = state % reference.size();
+        if (state & 256) {
+            require(value.claim(index) == !reference[index], "duplicate claim changed physical ownership");
+            if (!reference[index]) { reference[index] = true; ++count; }
+        } else {
+            require(value.release(index) == reference[index], "duplicate release changed physical ownership");
+            if (reference[index]) { reference[index] = false; --count; }
+        }
+        require(value.used() == count && value.free() == reference.size() - count, "physical cell accounting drifted");
+        if (step % 97 == 0) {
+            std::set<uint32_t> active;
+            for (uint32_t cell = 0; cell < reference.size(); ++cell) {
+                require(value.contains(cell) == reference[cell], "physical occupancy disagrees with independent bitmap");
+                if (reference[cell]) { active.insert(cell / 32); }
+            }
+            require(value.table() == std::vector<uint32_t>(active.begin(), active.end()), "compact logical-to-physical page table disagrees with occupied cells");
+            std::vector<uint32_t> selected;
+            const uint32_t requested = std::min<uint32_t>(71, value.free());
+            require(value.select(requested, selected) && selected.size() == requested, "nonmutating write reservation failed");
+            std::set<uint32_t> unique(selected.begin(), selected.end());
+            require(unique.size() == selected.size(), "one physical row was reserved twice");
+            for (const uint32_t cell : selected) { require(cell < reference.size() && !reference[cell], "reservation overwrote a live row"); }
+            require(value.used() == count, "planning published a physical allocation before apply");
+        }
+    }
+    const auto table = value.table();
+    require(!value.configure(UINT32_MAX) && value.used() == count && value.table() == table,
+        "metadata admission denial destroyed the current valid pool");
+    std::vector<uint32_t> unchanged = {42};
+    require(!value.select(value.free() + 1, unchanged) && unchanged == std::vector<uint32_t>{42}, "over-budget reservation partially published rows");
+    require(!value.claim(8193) && !value.release(8193), "out-of-range row was accepted");
+    value.clear();
+    require(value.used() == 0 && value.table().empty() && value.select(8193, unchanged) && unchanged.size() == 8193,
+        "clear leaked a physical page or the partial final page");
+}
+
+static void ownership() {
+    llama_kv_cells cells;
+    cells.resize(256);
+    cells.pos_set(65, 0); cells.seq_add(65, 0);
+    require(cells.enable_page_pool(), "cannot enable pool over an existing valid cache");
+    cells.seq_add(65, 1);
+    require(cells.get_page_pool().used() == 1 && cells.get_page_pool().table() == std::vector<uint32_t>{2},
+        "shared prefix duplicated physical storage");
+    require(!cells.seq_rm(65, 0) && cells.get_page_pool().used() == 1, "removing one branch freed another branch's page");
+    require(cells.seq_rm(65, 1) && cells.get_page_pool().table().empty(), "last branch failed to free its physical page");
+
+    cells.pos_set(0, 0); cells.seq_add(0, 0);
+    cells.pos_set(128, 32); cells.seq_add(128, 0);
+    const std::vector<uint32_t> indices = {0, 1, 128, 129};
+    const auto saved = cells.cp(indices);
+    cells.rm(0); cells.pos_set(1, 1); cells.seq_add(1, 0);
+    cells.pos_set(129, 33); cells.seq_add(129, 0);
+    cells.set(indices, saved);
+    require(cells.get_page_pool().used() == 2 && cells.get_page_pool().contains(0) &&
+            cells.get_page_pool().contains(128) && !cells.get_page_pool().contains(1) &&
+            !cells.get_page_pool().contains(129) && cells.seq_pos_get(0).size() == 2,
+        "prepare/rollback changed physical page ownership or logical token mapping");
+    require(cells.pos_add(128, -33) && cells.get_page_pool().table() == std::vector<uint32_t>{0},
+        "negative shift failed to release its now-empty page");
+    cells.reset(); require(cells.get_page_pool().table().empty(), "cache reset leaked physical pages");
+}
+
+int main() {
+    try {
+        bitmap(); pool(); ownership();
+        std::puts("PAGED_KV_POOL hierarchical_lookup=1 sparse_block_table=1 nonmutating_reservations=1 alias_refcounts=1 rollback=1 shift_release=1 bounded_metadata=1 arbitrary_physical_pages=1 PASS");
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        return 1;
+    }
+}
