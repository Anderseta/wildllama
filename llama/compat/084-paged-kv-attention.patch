diff --git a/tests/test-kv-page-ranges.cpp b/tests/test-kv-page-ranges.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-kv-page-ranges.cpp
@@ -0,0 +1,47 @@
+#include "../src/llama-kv-page-ranges.h"
+
+#include <cstdio>
+#include <limits>
+
+static bool require(bool value, const char * what) {
+    if (!value) { std::fprintf(stderr, "FAIL: %s\n", what); }
+    return value;
+}
+
+int main() {
+    bool ok = true;
+    std::vector<ggml_kv_trim_range> ranges;
+    const size_t stride = 128, bytes = stride*4096;
+    const std::vector<llama_kv_page_tensor> tensors = {{0, stride, 4096, bytes + 256},
+        {bytes + 4096, stride, 4096, bytes + 256}};
+    const size_t capacity = 2*bytes + 8192;
+    const std::vector<uint32_t> pages = {1, 3, 4, 37, 127};
+    ok &= require(llama_kv_page_ranges(capacity, tensors, pages, 32, 64, ranges), "valid scattered pages");
+    for (const auto & t : tensors) {
+        for (uint32_t row = 0; row < t.rows; ++row) {
+            const bool expected = row < 64 || std::binary_search(pages.begin(), pages.end(), row/32);
+            const bool kept = ggml_kv_trim_keep(t.offset + row*stride, stride, ranges.data(), ranges.size());
+            ok &= require(kept == expected, "exact live/floor row coverage");
+            ok &= require(ggml_kv_trim_keep_sorted(t.offset + row*stride, stride, ranges.data(), ranges.size()) == kept,
+                "binary mapping protection matches full scan");
+        }
+        ok &= require(ggml_kv_trim_keep(t.offset + bytes, 256, ranges.data(), ranges.size()), "quantized tail padding");
+        ok &= require(!ggml_kv_trim_keep(t.offset + bytes + 256, 256, ranges.data(), ranges.size()), "unused alignment gap");
+    }
+    ok &= require(!llama_kv_page_ranges(capacity, tensors, {2, 2}, 32, 64, ranges), "duplicate table rejection");
+    ok &= require(!llama_kv_page_ranges(capacity, tensors, {4, 1}, 32, 64, ranges), "unsorted table rejection");
+    ok &= require(!llama_kv_page_ranges(capacity, tensors, {128}, 32, 64, ranges), "out of capacity page rejection");
+    ok &= require(!llama_kv_page_ranges(capacity, tensors, {}, 0, 64, ranges), "zero page size rejection");
+    ok &= require(!llama_kv_page_ranges(capacity, tensors, {}, 32, 4097, ranges), "invalid initial floor rejection");
+    ok &= require(!llama_kv_page_ranges(SIZE_MAX, {{1, SIZE_MAX, 2, SIZE_MAX - 1}}, {}, 32, 0, ranges), "row-byte overflow rejection");
+    ok &= require(!llama_kv_page_ranges(128, {{100, 1, 32, 32}}, {}, 32, 0, ranges), "allocation bound rejection");
+    ok &= require(llama_kv_page_ranges(257, {{0, 1, 257, 257}}, {8}, 32, 0, ranges) &&
+        ranges.size() == 1 && ranges[0].offset == 256 && ranges[0].size == 1, "partial final page clamped");
+
+    std::vector<uint32_t> fragmented;
+    for (uint32_t p = 0; p < 131074; p += 2) { fragmented.push_back(p); }
+    ok &= require(!llama_kv_page_ranges(4194368, {{0, 1, 4194368, 4194368}}, fragmented, 32, 0, ranges),
+        "bounded metadata rejects excessive fragmentation safely");
+    std::printf("KV page ranges: %s (live holes, floor, padding, bounds, metadata cap)\n", ok ? "PASS" : "FAIL");
+    return ok ? 0 : 1;
+}
