+                        std::cos(double(r * 3 + d + phase) * .07) * .03);
+            }
+            auto * destination = bytes.data() + r * row_bytes;
+            if (tensor->type == GGML_TYPE_F32) { std::memcpy(destination, row.data(), row_bytes); }
+            else if (tensor->type == GGML_TYPE_F16) { ggml_fp32_to_fp16_row(row.data(), reinterpret_cast<ggml_fp16_t *>(destination), row.size()); }
+            else { quantize_row_q8_0_ref(row.data(), reinterpret_cast<block_q8_0 *>(destination), row.size()); }
