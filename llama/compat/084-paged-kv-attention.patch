+void ggml_compute_forward_flash_attn_paged(const ggml_compute_params * params, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_paged_attn_valid(dst));
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const ggml_tensor * v = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+    const ggml_tensor * table = dst->src[5];
+    const ggml_tensor * lengths = dst->src[6];
+    const auto options = ggml_paged_attn_get_params(dst);
+    const int64_t dk = q->ne[0], dv = v->ne[0];
+    const int64_t rows = q->ne[1] * q->ne[2] * q->ne[3];
+    const int64_t logical_capacity = table->ne[0] * options.page_tokens;
+    const size_t scratch_stride = size_t(dk + 2 * dv) + CACHE_LINE_SIZE_F32;
+    GGML_ASSERT(params->wdata && params->wsize >= scratch_stride * params->nth * sizeof(float));
+    float * accumulator = static_cast<float *>(params->wdata) + params->ith * scratch_stride;
+    float * decoded_key = accumulator + dv;
+    float * decoded_value = decoded_key + dk;
+    const auto key_to_float = ggml_get_type_traits(k->type)->to_float;
+    const auto value_to_float = ggml_get_type_traits(v->type)->to_float;
+    const uint32_t head_power = 1u << uint32_t(std::floor(std::log2(double(q->ne[2]))));
+    const float m0 = std::pow(2.f, -options.max_bias / head_power);
+    const float m1 = std::pow(2.f, -(options.max_bias / 2.f) / head_power);
+
+    for (int64_t row = params->ith; row < rows; row += params->nth) {
+        const int64_t query = row % q->ne[1];
+        const int64_t head = (row / q->ne[1]) % q->ne[2];
+        const int64_t stream = row / (q->ne[1] * q->ne[2]);
+        const int64_t kv_head = head / (q->ne[2] / k->ne[2]);
+        const int64_t kv_stream = k->ne[3] == 1 ? 0 : stream;
+        const int64_t length = lengths ? static_cast<const int32_t *>(lengths->data)[stream] : logical_capacity;
+        float * output = reinterpret_cast<float *>(static_cast<char *>(dst->data) +
+                head * dst->nb[1] + query * dst->nb[2] + stream * dst->nb[3]);
+        if (length < 0 || length > logical_capacity) {
+            std::fill(output, output + dv, NAN);
+            continue;
+        }
+        const auto * blocks = reinterpret_cast<const int32_t *>(static_cast<const char *>(table->data) + stream * table->nb[1]);
+        const float * query_data = reinterpret_cast<const float *>(static_cast<const char *>(q->data) +
+                query * q->nb[1] + head * q->nb[2] + stream * q->nb[3]);
+        const char * mask_data = mask ? static_cast<const char *>(mask->data) +
+                query * mask->nb[1] + (head % mask->ne[2]) * mask->nb[2] + (stream % mask->ne[3]) * mask->nb[3] : nullptr;
+        const float slope = options.max_bias > 0.f ? head < head_power ? std::pow(m0, head + 1) :
+                std::pow(m1, 2 * (head - head_power) + 1) : 1.f;
+        float maximum = -INFINITY, sum = 0.f;
+        bool invalid_page = false;
+        std::fill(accumulator, accumulator + dv, 0.f);
+
+        for (int64_t logical = 0; logical < length; ++logical) {
+            float bias = 0.f;
+            if (mask_data) {
+                bias = mask->type == GGML_TYPE_F16 ? GGML_CPU_FP16_TO_FP32(reinterpret_cast<const ggml_fp16_t *>(mask_data)[logical]) :
+                        reinterpret_cast<const float *>(mask_data)[logical];
+                if (bias == -INFINITY) { continue; }
+                bias *= slope;
+            }
+            const int32_t block = blocks[logical / options.page_tokens];
+            const int64_t physical = int64_t(block) * options.page_tokens + logical % options.page_tokens;
+            if (block < 0 || physical < 0 || physical >= k->ne[1]) { invalid_page = true; break; }
+            const char * key_data = static_cast<const char *>(k->data) +
+                    physical * k->nb[1] + kv_head * k->nb[2] + kv_stream * k->nb[3];
+            const char * value_data = static_cast<const char *>(v->data) +
+                    physical * v->nb[1] + kv_head * v->nb[2] + kv_stream * v->nb[3];
+            const float * key = reinterpret_cast<const float *>(key_data);
+            const float * value = reinterpret_cast<const float *>(value_data);
+            if (k->type != GGML_TYPE_F32) { key_to_float(key_data, decoded_key, dk); key = decoded_key; }
+            if (v->type != GGML_TYPE_F32) { value_to_float(value_data, decoded_value, dv); value = decoded_value; }
+            float score;
+            ggml_vec_dot_f32(int(dk), &score, 0, query_data, 0, key, 0, 1);
+            score *= options.logit_softcap != 0.f ? options.scale / options.logit_softcap : options.scale;
+            if (options.logit_softcap != 0.f) { score = options.logit_softcap * std::tanh(score); }
+            score += bias;
+            const float next_maximum = std::max(maximum, score);
+            const float rescale = std::exp(maximum - next_maximum);
+            const float probability = std::exp(score - next_maximum);
+            ggml_vec_scale_f32(int(dv), accumulator, rescale);
+            ggml_vec_mad_f32(int(dv), accumulator, value, probability);
+            sum = sum * rescale + probability;
+            maximum = next_maximum;
+        }
+        if (invalid_page) { std::fill(output, output + dv, NAN); continue; }
+        if (sinks) {
+            const float sink = static_cast<const float *>(sinks->data)[head];
+            if (sink != -INFINITY) {
+                const float next_maximum = std::max(maximum, sink);
+                const float rescale = std::exp(maximum - next_maximum);
+                ggml_vec_scale_f32(int(dv), accumulator, rescale);
+                sum = sum * rescale + std::exp(sink - next_maximum);
+            }
+        }
+        const float inverse = sum == 0.f ? 0.f : 1.f / sum;
+        ggml_vec_scale_f32(int(dv), accumulator, inverse);
+        memcpy(output, accumulator, size_t(dv) * sizeof(float));
+    }
+}
