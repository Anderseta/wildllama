+        if (k_type == ggml_backend_cpu_buffer_type() && v_type == k_type) {
+            // The canonical host buffer deliberately has no owning device;
+            // probe the actual CPU execution device rather than rejecting all
+            // CPU caches. Noncanonical host/CUDA buffers keep strict identity.
+            device = model.dev_layer(layer.il);
+            if (!device || ggml_backend_dev_type(device) != GGML_BACKEND_DEVICE_TYPE_CPU) { return false; }
+        } else if (!device || ggml_backend_buft_get_device(v_type) != device || model.dev_layer(layer.il) != device) {
+            return false;
