+inline bool llama_kv_growth_page_ranges(ggml_context * ctx, ggml_backend_buffer_t buffer,
+        const std::vector<uint32_t> & pages, uint32_t page_tokens, uint32_t initial_tokens,
+        std::vector<ggml_kv_trim_range> & ranges) {
+    const uintptr_t base = reinterpret_cast<uintptr_t>(ggml_backend_buffer_get_base(buffer));
+    const size_t capacity = ggml_backend_buffer_get_size(buffer);
+    const auto buft = ggml_backend_buffer_get_type(buffer);
+    std::vector<llama_kv_page_tensor> tensors;
+    for (auto * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+        if (t->view_src) { continue; }
+        const uintptr_t address = reinterpret_cast<uintptr_t>(t->data);
+        if (t->buffer != buffer || address < base || address - base > capacity ||
+            t->ne[1] <= 0 || uint64_t(t->ne[1]) > UINT32_MAX || t->ne[2] != 1 || t->ne[3] != 1) {
+            return false;
+        }
+        tensors.push_back({size_t(address - base), t->nb[1], uint32_t(t->ne[1]),
+                           ggml_backend_buft_get_alloc_size(buft, t)});
+    }
+    return !tensors.empty() && llama_kv_page_ranges(capacity, tensors, pages, page_tokens, initial_tokens, ranges);
+}
+
+// Only incoming or previously unmapped pages should be passed here. Existing
+// CUDA quotas are charged by commit(); logical virtual size is unchanged.
+inline bool llama_kv_growth_commit_pages(ggml_context * ctx, ggml_backend_buffer_t buffer,
+        const std::vector<uint32_t> & pages, uint32_t page_tokens, uint32_t initial_tokens,
+        bool * grew = nullptr) {
+    if (grew) { *grew = false; }
+    const auto buft = ggml_backend_buffer_get_type(buffer);
+    const auto * api = llama_kv_growth_api(buft);
+    if (!api) { return true; }
+    std::vector<ggml_kv_trim_range> ranges;
+    if (!llama_kv_growth_page_ranges(ctx, buffer, pages, page_tokens, initial_tokens, ranges)) { return false; }
+    auto * reg = ggml_backend_dev_backend_reg(ggml_backend_buft_get_device(buft));
+    const auto resident = reinterpret_cast<ggml_backend_cuda_kv_range_committed_t>(
+        ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kv_range_committed"));
+    for (const auto & r : ranges) {
+        if (resident && resident(buffer, r.offset, r.size)) { continue; }
+        if (!api->commit(buffer, r.offset, r.size)) { return false; }
+        if (grew) { *grew = true; }
+    }
+    return true;
+}
+
+// Caller fences all users and proves every attention consumer uses the page
+// table before reclaiming interior holes. Coarser CUDA mappings may be retained.
+inline size_t llama_kv_growth_trim_pages(ggml_context * ctx, ggml_backend_buffer_t buffer,
+        const std::vector<uint32_t> & pages, uint32_t page_tokens, uint32_t initial_tokens) {
+    const auto buft = ggml_backend_buffer_get_type(buffer);
+    const auto * api = llama_kv_growth_api(buft);
+    if (!api) { return 0; }
+    std::vector<ggml_kv_trim_range> ranges;
+    if (!llama_kv_growth_page_ranges(ctx, buffer, pages, page_tokens, initial_tokens, ranges)) { return 0; }
+    auto * reg = ggml_backend_dev_backend_reg(ggml_backend_buft_get_device(buft));
+    const auto trim = reinterpret_cast<ggml_backend_cuda_kv_trim_unused_t>(
+        ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_kv_trim_unused"));
+    if (!trim) { return 0; }
+    const size_t before = api->committed(buffer);
+    // A driver error may leave a subset reclaimed. Its accounting remains
+    // authoritative; never report unreleased bytes as available capacity.
+    trim(buffer, ranges.data(), ranges.size());
+    const size_t after = api->committed(buffer);
+    return before > after ? before - after : 0;
+}
diff --git a/src/llama-kv-page-ranges.h b/src/llama-kv-page-ranges.h
new file mode 100644
--- /dev/null
+++ b/src/llama-kv-page-ranges.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include "ggml-kv-trim.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+// Tensor rows are physical KV cells; logical attention pages need not be
+// adjacent in this address space. Metadata is capped independently of context.
+struct llama_kv_page_tensor {
+    size_t offset;
+    size_t row_bytes;
+    uint32_t rows;
+    size_t allocated_bytes;
+};
+
+inline bool llama_kv_page_ranges(size_t capacity,
+        const std::vector<llama_kv_page_tensor> & tensors,
+        const std::vector<uint32_t> & pages, uint32_t page_tokens,
+        uint32_t initial_tokens, std::vector<ggml_kv_trim_range> & ranges) {
+    constexpr size_t max_ranges = 65536;
+    ranges.clear();
+    if (!page_tokens || !capacity) { return false; }
+    for (size_t i = 0; i < pages.size(); ++i) {
+        if (i && pages[i] <= pages[i - 1]) { return false; }
+    }
+    auto add = [&](size_t offset, size_t size) {
+        if (!size) { return true; }
+        if (offset > capacity || size > capacity - offset || ranges.size() == max_ranges) { return false; }
+        ranges.push_back({offset, size});
+        return true;
+    };
+    for (const auto & t : tensors) {
+        if (!t.rows || !t.row_bytes || t.row_bytes > SIZE_MAX/t.rows ||
+            initial_tokens > t.rows || t.offset > capacity ||
+            t.allocated_bytes > capacity - t.offset) { return false; }
+        const size_t actual = t.row_bytes*t.rows;
+        if (actual > t.allocated_bytes || !add(t.offset, t.row_bytes*initial_tokens)) { return false; }
+        for (size_t i = 0; i < pages.size();) {
+            const uint64_t first = uint64_t(pages[i])*page_tokens;
+            size_t j = i + 1;
+            while (j < pages.size() && uint64_t(pages[j]) == uint64_t(pages[j - 1]) + 1) { ++j; }
+            const uint64_t end = std::min<uint64_t>(t.rows, (uint64_t(pages[j - 1]) + 1)*page_tokens);
+            if (first >= t.rows || !add(t.offset + size_t(first)*t.row_bytes, size_t(end - first)*t.row_bytes)) {
+                return false;
+            }
+            i = j;
+        }
+        // Quantized backends may initialize allocation padding outside ne[1].
+        if (!add(t.offset + actual, t.allocated_bytes - actual)) { return false; }
+    }
+    std::sort(ranges.begin(), ranges.end(), [](const auto & a, const auto & b) { return a.offset < b.offset; });
+    size_t count = 0;
+    for (const auto r : ranges) {
+        if (count && r.offset <= ranges[count - 1].offset + ranges[count - 1].size) {
+            auto & previous = ranges[count - 1];
+            previous.size = std::max(previous.offset + previous.size, r.offset + r.size) - previous.offset;
+        } else {
+            ranges[count++] = r;
+        }
+    }
+    ranges.resize(count);
+    return true;
+}
