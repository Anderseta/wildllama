diff --git a/tests/test-cuda-paged-attn.cpp b/tests/test-cuda-paged-attn.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-cuda-paged-attn.cpp
@@ -0,0 +1,118 @@
+#define GGML_TEST_PAGED_NO_MAIN
+#define main paged_cpu_reference_entrypoint
+#include "test-paged-attn.cpp"
+#undef main
+
+#include "../ggml/include/ggml-cuda.h"
+
+#include <cstdlib>
+
+static void host_metadata_contracts() {
+    ggml_context_ptr context(ggml_init({1024 * 1024, nullptr, true}));
+    require(bool(context), "metadata fixture allocation failed");
+    auto * q = ggml_new_tensor_4d(context.get(), GGML_TYPE_F32, 32, 1, 4, 1);
+    auto * k = ggml_new_tensor_4d(context.get(), GGML_TYPE_F16, 32, 128, 2, 1);
+    auto * v = ggml_new_tensor_4d(context.get(), GGML_TYPE_Q8_0, 64, 128, 2, 1);
+    auto * table = ggml_new_tensor_2d(context.get(), GGML_TYPE_I32, 2, 1);
+    auto * mask = ggml_new_tensor_4d(context.get(), GGML_TYPE_F32, 64, 1, 1, 1);
+    auto * output = ggml_flash_attn_paged(context.get(), q, k, v, mask, nullptr, table, nullptr, 32, .25f, 0.f, 0.f);
+    require(ggml_paged_attn_valid(output), "unallocated mixed-storage metadata rejected");
+    for (auto * tensor : { q, k, v, table, mask, output }) {
+        const auto stride = tensor->nb[3];
+        const auto dimension = tensor->ne[3];
+        tensor->nb[3] = SIZE_MAX;
+        tensor->ne[3] = INT64_MAX;
+        require(!ggml_paged_attn_valid(output), "overflowing metadata span admitted");
+        tensor->nb[3] = stride;
+        tensor->ne[3] = dimension;
+    }
+    const auto columns = table->ne[0];
+    table->ne[0] = INT32_MAX;
+    require(!ggml_paged_attn_valid(output), "overflowing logical page capacity admitted");
+    table->ne[0] = columns;
+}
+
+static void cuda_capability_contracts(ggml_backend_t backend) {
+    ggml_context_ptr context(ggml_init({1024 * 1024, nullptr, true}));
+    auto * table = ggml_new_tensor_2d(context.get(), GGML_TYPE_I32, 2, 1);
+    for (const int width : { 32, 64, 128, 256, 512 }) {
+        auto * q = ggml_new_tensor_4d(context.get(), GGML_TYPE_F32, width, 65, 4, 1);
+        auto * k = ggml_new_tensor_4d(context.get(), GGML_TYPE_Q8_0, width, 128, 2, 1);
+        auto * v = ggml_new_tensor_4d(context.get(), GGML_TYPE_F16, width, 128, 2, 1);
+        auto * output = ggml_flash_attn_paged(context.get(), q, k, v, nullptr, nullptr, table, nullptr, 32, .25f, 0.f, 0.f);
+        require(ggml_backend_supports_op(backend, output) == (width <= 256),
+            "metadata-only CUDA head-width capability changed");
+        if (width == 32) {
+            const auto stride = q->nb[1];
+            q->nb[1] += 1;
+            require(!ggml_backend_supports_op(backend, output), "misaligned CUDA row stride admitted");
+            q->nb[1] = stride;
+        }
+    }
+}
+
+static void cuda_replay_contract(ggml_backend_t backend) {
+    paged_case options;
+    options.key_type = options.value_type = GGML_TYPE_Q8_0;
+    options.key_width = options.value_width = 128;
+    options.queries = 5;
+    options.blocks = 3;
+    paged_fixture fixture(backend, options);
+    for (int iteration = 0; iteration < 4; ++iteration) {
+        if (iteration) {
+            for (int stream = 0; stream < paged_fixture::streams; ++stream) {
+                auto first = fixture.block_ids.begin() + stream * options.blocks;
+                std::rotate(first, first + 1, first + options.blocks);
+            }
+            fixture.query_bytes = paged_fixture::encoded(fixture.query_storage, 3 + 17 * iteration);
+            ggml_backend_tensor_set(fixture.query_storage, fixture.query_bytes.data(), 0, fixture.query_bytes.size());
+            ggml_backend_tensor_set(fixture.table, fixture.block_ids.data(), 0, fixture.block_ids.size() * sizeof(int32_t));
+        }
+        fixture.check(backend, "CUDA graph replay with changed query data and physical block mapping");
+    }
+}
+
+int main(int argc, char ** argv) {
+    try {
+        host_metadata_contracts();
+        if (argc < 2 || std::string(argv[1]) == "--host-only") {
+            std::puts("PASS paged CUDA metadata contracts without backend initialization");
+            return 0;
+        }
+        require(std::string(argv[1]) == "--cuda", "use --host-only or --cuda");
+#ifdef GGML_TEST_CUDA_BACKEND_PATH
+        require(ggml_backend_load(GGML_TEST_CUDA_BACKEND_PATH), "explicit CUDA backend unavailable");
+#else
+        const char * cuda_path = std::getenv("GGML_BACKEND_PATH");
+        require(cuda_path && ggml_backend_load(cuda_path), "set GGML_BACKEND_PATH to the candidate CUDA backend file");
+#endif
+        auto * registry = ggml_backend_reg_by_name("CUDA");
+        if (!registry || !ggml_backend_reg_dev_count(registry)) { std::puts("SKIP no CUDA device"); return 77; }
+        auto * device = ggml_backend_reg_dev_get(registry, 0);
+        auto set_limit = reinterpret_cast<bool (*)(ggml_backend_dev_t, size_t, bool)>(
+            ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_set_memory_limit"));
+        auto get_stats = reinterpret_cast<decltype(&ggml_backend_cuda_get_memory_stats)>(
+            ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_get_memory_stats"));
+        auto submissions = reinterpret_cast<uint64_t (*)()>(
+            ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_test_paged_attn_submissions"));
+        require(set_limit && get_stats && submissions, "paged CUDA quota or path counters unavailable");
+        require(set_limit(device, 128 * 1024 * 1024, true), "paged CUDA fixture quota rejected");
+        ggml_backend_ptr backend(ggml_backend_dev_init(device, nullptr));
+        require(bool(backend), "CUDA backend initialization failed");
+        cuda_capability_contracts(backend.get());
+        const auto before = submissions();
+        run_cases(backend.get());
+        cuda_replay_contract(backend.get());
+        require(submissions() > before, "paged CUDA kernel was not submitted");
+        ggml_backend_cuda_memory_stats memory{};
+        require(get_stats(device, &memory) && memory.enabled && memory.managed_peak_bytes <= memory.limit_bytes,
+            "paged CUDA fixture exceeded its managed memory limit");
+        std::printf("PAGED_CUDA submissions=%llu tracked_peak_bytes=%llu limit_bytes=%llu global_scratch_bytes=0 shared_bytes_per_block=4144 PASS\n",
+            (unsigned long long) (submissions() - before), (unsigned long long) memory.managed_peak_bytes,
+            (unsigned long long) memory.limit_bytes);
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL paged CUDA attention: %s\n", error.what());
+        return 1;
+    }
+}
