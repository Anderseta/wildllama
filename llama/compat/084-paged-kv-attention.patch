+// Requires validated, sorted, nonoverlapping ranges. Sparse page tables can
+// contain many live islands; do not scan every island for every CUDA mapping.
+inline bool ggml_kv_trim_keep_sorted(size_t offset, size_t size, const ggml_kv_trim_range * ranges, size_t count) {
+    size_t first = 0, end = count;
+    while (first < end) {
+        const size_t middle = first + (end - first)/2;
+        if (ranges[middle].offset + ranges[middle].size <= offset) { first = middle + 1; }
+        else { end = middle; }
+    }
+    return first < count && size && ranges[first].size && ranges[first].offset < offset + size;
+}
