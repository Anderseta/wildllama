+
+static void metadata_cases(ggml_backend_t backend) {
+    paged_fixture fixture(backend, {});
+    ggml_tensor invalid = *fixture.output;
+    auto options = ggml_paged_attn_get_params(&invalid); options.page_tokens = 0;
