+        write.s0 = write.s1 = 0; write.strm = {0}; write.idxs = {{0}};
+        if (gpu) {
+            require(!view.grow_for(write) && state(candidate.get(), 0) == empty_state,
+                "denied padded shared-view preflight changed source cells or bypassed quota");
+        }
+        filler.reset();
+        require(view.grow_for(write) && state(candidate.get(), 0) == empty_state,
+            "shared-view padded read preflight failed or changed source cells");
+        equal(decode(reference.get(), pattern(0, 0, 64)), decode(candidate.get(), pattern(0, 0, 64)), "startup-shared-view-continuation");
+    }
+    equal(decode(reference.get(), pattern(0, 64, 1)), decode(candidate.get(), pattern(0, 64, 1)), "startup-view-retired-continuation");
+    std::puts("PAGED_KV_STARTUP_VIEW initial_physical_budget_preserved=1 source_cells_preserved=1 view_read_padding=1024 dense_continuation=1 PASS");
+}
+
+static void cases(llama_model * weights, ggml_type type) {
+    auto reference = context(weights, false, type), candidate = context(weights, true, type);
+    auto compare = [&](const std::vector<row> & rows, const char * stage) {
+        equal(decode(reference.get(), rows), decode(candidate.get(), rows), stage);
+    };
+    compare(pattern(0, 0, 96), "initial-prefill");
+    for (auto * ctx : {reference.get(), candidate.get()}) { llama_memory_seq_cp(llama_get_memory(ctx), 0, 1, 0, 96); }
+    compare(pattern(0, 96, 32, 7), "branch-A");
+    compare(pattern(1, 96, 32, 19), "branch-B");
+    for (auto * ctx : {reference.get(), candidate.get()}) {
+        require(llama_memory_seq_rm(llama_get_memory(ctx), 0, 32, 96), "cannot remove branch-A interior");
+        require(llama_memory_seq_rm(llama_get_memory(ctx), 1, 32, 96), "cannot remove last interior reference");
+    }
+    auto * cache = dynamic_cast<llama_kv_cache *>(llama_get_memory(candidate.get()));
+    const auto pages = cache->get_cells(0).get_page_pool().table();
+    require(pages.size() >= 3 && uint64_t(pages.back()) - pages.front() + 1 != pages.size(),
+        "test failed to create actual noncontiguous physical read pages");
+    require(cache->paged_reads_confirmed(), "no all-layer actual paged-attention capability was confirmed");
+    const size_t reclaimed = llama_memory_trim_unused(candidate.get());
+    auto mixed = pattern(0, 128, 1, 3); const auto other = pattern(1, 128, 1, 29); mixed.insert(mixed.end(), other.begin(), other.end());
+    compare(mixed, "noncontiguous-mixed-visibility");
+
+    for (auto * ctx : {reference.get(), candidate.get()}) {
+        const auto saved = state(ctx, 0);
+        const auto other_before = state(ctx, 1);
+        require(llama_memory_seq_rm(llama_get_memory(ctx), 0, -1, -1), "cannot clear one sequence");
+        require(llama_state_seq_set_data(ctx, saved.data(), saved.size(), 0) == saved.size(), "cannot reload a fragmented sequence snapshot");
+        require(state(ctx, 1) == other_before, "one sequence restore changed another branch's state");
+    }
+    compare(pattern(0, 129, 1, 5), "state-reload-continuation");
+    for (auto * ctx : {reference.get(), candidate.get()}) {
+        llama_memory_seq_add(llama_get_memory(ctx), 0, 96, -1, -64);
+        llama_memory_seq_add(llama_get_memory(ctx), 1, 96, -1, -64);
+    }
+    compare(pattern(0, 66, 1, 11), "context-rope-shift");
+    const auto retained = state(candidate.get(), 0);
+    require(llama_memory_seq_rm(llama_get_memory(candidate.get()), 1, -1, -1), "cannot cancel independent branch");
+    require(state(candidate.get(), 0) == retained, "canceling branch changed active sequence state");
+    require(llama_memory_seq_rm(llama_get_memory(reference.get()), 1, -1, -1), "cannot clear reference branch");
+    compare(pattern(0, 67, 1, 17), "cancel-isolated-continuation");
+    for (auto * ctx : {reference.get(), candidate.get()}) { llama_memory_clear(llama_get_memory(ctx), true); }
+    const size_t cleared = llama_memory_trim_unused(candidate.get());
+    compare(pattern(0, 0, 32, 23), "clear-recommit");
+
+    if (gpu && type == GGML_TYPE_F32) {
+        llama_memory_clear(llama_get_memory(candidate.get()), true); llama_memory_trim_unused(candidate.get());
+        decode(candidate.get(), pattern(0, 0, 512));
+        const auto saved = state(candidate.get(), 0);
+        llama_gpu_memory_stats memory{};
+        require(llama_model_get_gpu_memory_stats(weights, &memory) && memory.enabled && memory.limit_bytes == 192 * 1024 * 1024,
+            "managed CUDA quota was not enforced for the tiny fixture");
+        require(memory.limit_bytes > memory.managed_used_bytes + 4096, "fixture lacks room for bounded denial control");
+        auto * device = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+        ggml_backend_buffer_ptr filler(ggml_backend_buft_alloc_buffer(ggml_backend_dev_buffer_type(device),
+            size_t(memory.limit_bytes - memory.managed_used_bytes - 1024)));
+        require(bool(filler), "cannot allocate bounded CUDA quota-denial control");
+        bool shared_denied = false;
+        try {
+            auto filter = [](int32_t) { return true; };
+            auto share = [](int32_t layer) { return layer; };
+            llama_kv_cache view(*weights, weights->hparams, type, type, false, gpu, true,
+                llama_n_ctx(candidate.get()), 2, 256, 0, LLAMA_SWA_TYPE_NONE, cache, filter, nullptr, share, "paged-denied-view");
+        } catch (const std::runtime_error &) { shared_denied = true; }
+        require(shared_denied && state(candidate.get(), 0) == saved && cache->paged_reads_confirmed(),
+            "denied unpublished shared view changed source state or disabled its valid page-table path");
+        const auto denied = decode(candidate.get(), pattern(0, 512, 1), true);
+        require(denied.empty() && state(candidate.get(), 0) == saved,
+            "denied physical-page commit changed the previous valid sequence");
+        filler.reset();
+        llama_memory_clear(llama_get_memory(reference.get()), true); decode(reference.get(), pattern(0, 0, 512));
+        compare(pattern(0, 512, 1), "quota-release-retry");
+        require(llama_model_get_gpu_memory_stats(weights, &memory) && memory.managed_peak_bytes <= memory.limit_bytes,
+            "paged allocation exceeded the configured managed CUDA quota");
+        std::puts("PAGED_KV_DENIAL denied_commit_preserves_state=1 retry_after_release=1 managed_peak_within_quota=1 PASS");
+    }
+    {
+        auto filter = [](int32_t) { return true; };
+        auto share = [](int32_t layer) { return layer; };
+        const auto source_state = state(candidate.get(), 0);
+        llama_kv_cache view(*weights, weights->hparams, type, type, false, gpu, true,
+            llama_n_ctx(candidate.get()), 2, 256, 0, LLAMA_SWA_TYPE_NONE, cache, filter, nullptr, share, "paged-admitted-view");
+        require(&view.get_cells(0) == &cache->get_cells(0) && !cache->paged_reads_confirmed() &&
+                state(candidate.get(), 0) == source_state,
+            "legacy shared view failed to preserve source ownership or inhibit interior reclamation");
+        compare(pattern(0, gpu && type == GGML_TYPE_F32 ? 513 : 32, 1, 31), "shared-owner-dense-fallback");
+        require(llama_memory_trim_unused(candidate.get()) == 0, "legacy shared owner allowed sparse interior reclamation");
+    }
+    std::printf("PAGED_KV_MODEL backend=%s kv=%s logical_context=%u initial_floor=257 old_tail_flag_unset=1 noncontiguous_pages=1 alias_branches=1 mixed_visibility=1 snapshot_reload=1 shift=1 cancellation=1 clear_recommit=1 reclaimed_bytes=%zu clear_reclaimed_bytes=%zu PASS\n",
+        gpu ? "CUDA" : "CPU", ggml_type_name(type), llama_n_ctx(candidate.get()), reclaimed, cleared);
+}
+
+int main(int argc, char ** argv) {
+    try {
+        std::setvbuf(stdout, nullptr, _IONBF, 0);
+        gpu = argc == 2 && std::strcmp(argv[1], "--cuda") == 0;
+        require(argc == 1 || gpu, "use test-kv-paged [--cuda]");
+        require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH), "explicit CPU backend unavailable");
+        if (gpu) {
+#ifdef GGML_TEST_CUDA_BACKEND_PATH
+            require(ggml_backend_load(GGML_TEST_CUDA_BACKEND_PATH), "explicit CUDA backend unavailable");
+#else
+            std::puts("SKIP: CUDA backend not built"); return 77;
+#endif
+        }
+        environment("WILDLLAMA_KV_CACHE_PAGING", nullptr);
+        environment("WILDLLAMA_KV_CACHE_INITIAL_TOKENS", "257");
+        environment("WILDLLAMA_GRAPH_VARIANTS_MIB", "0");
+        environment("WILDLLAMA_PAGED_ATTENTION", "0");
+        llama_backend_init();
+        { auto weights = model(); startup_shared_view_case(weights.get());
+            for (auto type : {GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_Q8_0}) { cases(weights.get(), type); } }
+        llama_backend_free();
+        std::printf("PAGED_KV_END_TO_END backend=%s comparisons=%zu pretrained_models=0 downloads=0 PASS\n", gpu ? "CUDA" : "CPU", comparisons);
+        return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr, "FAIL: %s\n", error.what()); return 1; }
+}
