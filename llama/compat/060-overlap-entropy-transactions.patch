+#include "llama.h"
+#include "llama-cpp.h"
+#include "ggml-cpp.h"
+#include "../src/llama-sampler.h"
+
+#include <cstdio>
+#include <array>
+#include <stdexcept>
+#include <vector>
+
+static void require(bool condition, const char * message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+// No model weights or CUDA backend: only a 32-token CPU sampling graph.
+struct sampling_graph {
+    llama_sampler_ptr sampler{llama_sampler_chain_init(llama_sampler_chain_default_params())};
+    ggml_context_ptr context{ggml_init({1024*1024, nullptr, true})};
+    ggml_backend_buffer_ptr storage;
+    ggml_tensor * scores = nullptr;
+    ggml_tensor * selected = nullptr;
+    ggml_cgraph * graph = nullptr;
+    const std::array<float, 32> logits = {{
+        -.9f, -.8f, -.7f, -.6f, .1f, .4f, -.1f, .8f,
+        .2f, .6f, .9f, .3f, -.2f, -.3f, -.4f, -.5f,
+        -.9f, -.8f, -.7f, -.6f, -.5f, -.4f, -.3f, -.2f,
+        -.1f, .0f, .1f, .2f, .3f, .4f, .5f, .6f}};
+
+    sampling_graph(ggml_backend_t backend, bool stochastic, bool penalties, bool mask, int outputs = 1) {
+        require(bool(context), "sampling metadata allocation failed");
+        if (mask) {
+            auto * allow = llama_sampler_init_token_mask(32);
+            const uint32_t words[] = {0x00000ff0};
+            require(llama_sampler_set_token_mask(allow, words, 1), "allow-mask setup failed");
+            llama_sampler_chain_add(sampler.get(), allow);
+        }
+        if (penalties) { llama_sampler_chain_add(sampler.get(), llama_sampler_init_penalties(32, 8, 1.1f, .1f, .2f)); }
+        if (stochastic) {
+            llama_sampler_chain_add(sampler.get(), llama_sampler_init_top_k(8));
+            llama_sampler_chain_add(sampler.get(), llama_sampler_init_temp(.8f));
+        }
+        llama_sampler_chain_add(sampler.get(), stochastic ? llama_sampler_init_dist(12345) : llama_sampler_init_greedy());
+        const bool compact = llama_sampler_backend_set_selected_only(sampler.get());
+        // Penalty accept can allocate/throw. Preserve its existing full-output
+        // contract rather than weakening compact-output ownership guarantees.
+        require(compact == !penalties, "legacy penalty compact-output contract changed");
+        require(sampler->iface->backend_init(sampler.get(), ggml_backend_get_default_buffer_type(backend), outputs),
+                "CPU backend sampling unavailable");
+        graph = ggml_new_graph_custom(context.get(), 256, false);
+        scores = ggml_new_tensor_1d(context.get(), GGML_TYPE_F32, 32);
+        ggml_set_input(scores);
+        llama_sampler_data output{scores, nullptr, nullptr, nullptr};
+        sampler->iface->backend_reset(sampler.get());
+        sampler->iface->backend_apply(sampler.get(), context.get(), graph, &output);
+        selected = output.sampled;
+        require(selected && llama_sampler_backend_can_overlap_output(sampler.get()), "complete backend not eligible for input transaction");
+        require(llama_sampler_backend_selected_only_ready(sampler.get()) == compact, "compact/full backend output contract changed");
+        ggml_build_forward_expand(graph, selected);
+        storage.reset(ggml_backend_alloc_ctx_tensors(context.get(), backend));
+        require(bool(storage) && ggml_backend_buffer_get_size(storage.get()) < 256*1024, "sampling compute allowance exceeded");
+    }
+
+    llama_token run(ggml_backend_t backend) {
+        // Penalty scatter can update source logits in place. A real model
+        // regenerates this input every forward, including discarded work.
+        ggml_backend_tensor_set(scores, logits.data(), 0, logits.size()*sizeof(float));
+        llama_sampler_backend_begin(sampler.get());
+        sampler->iface->backend_set_input(sampler.get());
+        require(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "sampling graph failed");
+        llama_token token = LLAMA_TOKEN_NULL;
+        ggml_backend_tensor_get(selected, &token, 0, sizeof(token));
+        return token;
+    }
+};
+
+static void rollback_cases(ggml_backend_t backend) {
+    size_t compared = 0;
+    for (bool stochastic : {false, true}) for (bool penalties : {false, true}) for (bool mask : {false, true}) {
+        sampling_graph baseline(backend, stochastic, penalties, mask), overlap(backend, stochastic, penalties, mask);
+        llama_sampler_overlap_checkpoint checkpoint;
+        for (int step = 0; step < 48; ++step) {
+            require(llama_sampler_backend_overlap_save(overlap.sampler.get(), checkpoint), "eligible input checkpoint rejected");
+            // Optional work can fail after its input draw, or be discarded
+            // after completion. Neither may consume the ordinary RNG stream.
+            if (step%3 == 0) { (void) overlap.run(backend); }
+            if (step%7 == 0) { (void) overlap.run(backend); }
+            require(llama_sampler_backend_overlap_restore(overlap.sampler.get(), checkpoint), "same-owner rollback failed");
+            const auto expected = baseline.run(backend), actual = overlap.run(backend);
+            if (actual != expected) {
+                std::fprintf(stderr, "SAMPLER_OVERLAP_MISMATCH stochastic=%d penalties=%d mask=%d step=%d expected=%d actual=%d\n",
+                        int(stochastic), int(penalties), int(mask), step, expected, actual);
+            }
+            require(actual == expected, "discarded forward changed selected token/RNG history");
+            if (mask) { require(actual >= 4 && actual < 12, "allow-mask was bypassed"); }
+            llama_sampler_accept(baseline.sampler.get(), expected);
+            llama_sampler_accept(overlap.sampler.get(), actual);
+            ++compared;
+        }
+        // A clone has a distinct lifetime identity even if all settings match.
+        require(!llama_sampler_backend_overlap_restore(baseline.sampler.get(), checkpoint), "cross-owner entropy restore admitted");
+        auto copied_iface = *overlap.sampler->iface;
+        llama_sampler custom{&copied_iface, overlap.sampler->ctx};
+        require(!llama_sampler_backend_overlap_save(&custom, checkpoint), "custom sampler gained builtin transaction contract");
+        auto * added = llama_sampler_init_temp(1.f);
+        llama_sampler_chain_add(overlap.sampler.get(), added);
+        require(!llama_sampler_backend_overlap_restore(overlap.sampler.get(), checkpoint), "changed topology restored stale entropy");
+    }
+    std::printf("SAMPLER_OVERLAP rollback_token_checks=%zu stochastic_greedy=1 penalties_mask=1 owner_topology_isolation=1 checkpoint_bytes=%zu no_model_weights=1 PASS\n",
+            compared, sizeof(llama_sampler_overlap_checkpoint));
+}
+
+static void unsupported_cases(ggml_backend_t backend) {
+    llama_sampler_overlap_checkpoint checkpoint;
+    llama_sampler_ptr leaf(llama_sampler_init_greedy());
+    require(!llama_sampler_backend_overlap_save(leaf.get(), checkpoint), "bare leaf bypassed chain transaction contract");
+    llama_sampler_ptr not_ready(llama_sampler_chain_init(llama_sampler_chain_default_params()));
+    llama_sampler_chain_add(not_ready.get(), llama_sampler_init_dist(123));
+    require(!llama_sampler_backend_overlap_save(not_ready.get(), checkpoint), "uninitialized chain admitted");
+    require(!llama_sampler_backend_overlap_restore(not_ready.get(), checkpoint), "uncaptured restore admitted");
+    require(!llama_sampler_backend_overlap_save(nullptr, checkpoint), "null checkpoint admitted");
+    require(!llama_sampler_backend_overlap_restore(nullptr, checkpoint), "null restore admitted");
+
+    // Speculative multi-output use retains its own transaction. Input rollback
+    // also restores its counters without accepting an unverified proposal.
+    sampling_graph a(backend, true, false, false, 3), b(backend, true, false, false, 3);
+    for (int step = 0; step < 16; ++step) {
+        require(llama_sampler_backend_overlap_save(b.sampler.get(), checkpoint), "multi-output entropy checkpoint rejected");
+        (void) b.run(backend);
+        require(llama_sampler_backend_overlap_restore(b.sampler.get(), checkpoint), "multi-output rollback failed");
+        const auto expected = a.run(backend), actual = b.run(backend);
+        if (actual != expected) {
+            std::fprintf(stderr, "SAMPLER_OVERLAP_TRANSACTION_MISMATCH step=%d expected=%d actual=%d\n", step, expected, actual);
+        }
+        require(expected == actual, "transactional RNG/counters changed after rollback");
+        llama_sampler_accept(a.sampler.get(), expected);
+        llama_sampler_accept(b.sampler.get(), actual);
+    }
+    std::puts("SAMPLER_OVERLAP fallback_null_custom=1 transactional_counters=1 no_gpu_allocations=1 PASS");
+}
+
+int main() {
+    try {
+        require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH), "explicit CPU backend unavailable");
+        auto * device = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+        ggml_backend_ptr backend(device ? ggml_backend_dev_init(device, nullptr) : nullptr);
+        require(bool(backend), "CPU backend initialization failed");
+        rollback_cases(backend.get());
+        unsupported_cases(backend.get());
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "sampler overlap: FAIL: %s\n", error.what());
+        return 1;
+    }
+}
