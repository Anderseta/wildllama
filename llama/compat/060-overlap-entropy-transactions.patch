+bool llama_sampler_backend_can_overlap_output(const llama_sampler * sampler) {
+    if (!sampler || sampler->iface != &llama_sampler_chain_i || !llama_sampler_backend_can_bind_graph(sampler)) { return false; }
+    const auto & chain = *static_cast<const llama_sampler_chain *>(sampler->ctx);
+    if (!chain.backend_selects_token) { return false; }
+    const auto * terminal = chain.samplers.back().ptr;
+    if (terminal->iface != &llama_sampler_dist_i && terminal->iface != &llama_sampler_greedy_i) { return false; }
+    for (size_t i = 0; i < chain.samplers.size(); ++i) {
+        const auto * leaf = chain.samplers[i].ptr;
+        // Only the terminal selector may consume entropy. Nested/custom
+        // chains need their own explicit input-transaction contract.
+        if (!graph_binding_leaf(leaf->iface) || (i+1 < chain.samplers.size() &&
+                (leaf->iface == &llama_sampler_dist_i || leaf->iface == &llama_sampler_greedy_i))) { return false; }
+    }
+    return true;
+}
+
+bool llama_sampler_backend_overlap_save(const llama_sampler * sampler, llama_sampler_overlap_checkpoint & saved) {
+    if (!llama_sampler_backend_can_overlap_output(sampler)) { return false; }
+    const auto & chain = *static_cast<const llama_sampler_chain *>(sampler->ctx);
+    const auto * terminal = chain.samplers.back().ptr;
+    saved.owner = sampler;
+    saved.terminal = terminal;
+    saved.identity = chain.graph_binding_id;
+    saved.revision = chain.graph_binding_revision;
+    saved.stochastic = terminal->iface == &llama_sampler_dist_i;
+    if (saved.stochastic) {
+        const auto & state = *static_cast<const llama_sampler_dist *>(terminal->ctx);
+        saved.rng = state.rng;
+        saved.rng_backend = state.rng_backend;
+        saved.generated = state.n_backend_draws_generated;
+        saved.committed = state.n_backend_draws_committed;
+    }
+    return true;
+}
+
+bool llama_sampler_backend_overlap_restore(llama_sampler * sampler, const llama_sampler_overlap_checkpoint & saved) {
+    if (!sampler || sampler != saved.owner || sampler->iface != &llama_sampler_chain_i) { return false; }
+    const auto & chain = *static_cast<const llama_sampler_chain *>(sampler->ctx);
+    if (chain.graph_binding_id != saved.identity || chain.graph_binding_revision != saved.revision ||
+            chain.samplers.empty() || chain.samplers.back().ptr != saved.terminal) { return false; }
+    if (saved.stochastic) {
+        auto * terminal = chain.samplers.back().ptr;
+        if (terminal->iface != &llama_sampler_dist_i) { return false; }
+        auto & state = *static_cast<llama_sampler_dist *>(terminal->ctx);
+        state.rng = saved.rng;
+        state.rng_backend = saved.rng_backend;
+        state.n_backend_draws_generated = saved.generated;
+        state.n_backend_draws_committed = saved.committed;
+    }
+    return true;
+}
