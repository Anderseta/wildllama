+template<int threads>
+static __global__ void top_p_mask_kernel(const float * logits, const float * cdf,
+        float * output, int n, float p) {
+    __shared__ int counts[threads];
+    int count = 0;
+    for (int i = threadIdx.x; i < n; i += threads) {
+        count += (-1.0f*cdf[i] + p) > 0.0f;
+    }
+    counts[threadIdx.x] = count;
+    __syncthreads();
+    for (int stride = threads/2; stride > 0; stride /= 2) {
+        if (threadIdx.x < stride) { counts[threadIdx.x] += counts[threadIdx.x + stride]; }
+        __syncthreads();
+    }
+    const int inclusive = counts[0] < n ? counts[0] : n - 1;
+    for (int i = threadIdx.x; i < n; i += threads) {
+        const bool keep = (-1.0f*cdf[i] + p) > 0.0f || i == inclusive;
+        // The legacy graph adds a bias; it does not replace rejected logits.
+        output[i] = __fadd_rn(logits[i], keep ? 0.0f : -INFINITY);
+    }
+}
