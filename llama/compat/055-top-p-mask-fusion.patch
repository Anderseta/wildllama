+static ggml_tensor * legacy_mask(ggml_context * ctx, ggml_tensor * logits, ggml_tensor * cdf, float p) {
+    auto * mask = ggml_step(ctx, ggml_scale_bias(ctx, cdf, -1.0f, p));
+    auto * idx = ggml_clamp(ctx, ggml_sum(ctx, mask), 0.0f, float(mask->ne[0] - 1));
+    auto * ones = ggml_scale_bias(ctx, idx, 0.0f, 1.0f);
+    auto * rows = ggml_set_rows(ctx, ggml_reshape_2d(ctx, mask, 1, mask->ne[0]), ones, ggml_cast(ctx, idx, GGML_TYPE_I32));
+    return ggml_add(ctx, logits, ggml_log(ctx, ggml_reshape_1d(ctx, rows, mask->ne[0])));
+}
+
+struct mask_graph {
+    ggml_context_ptr ctx{ggml_init({2*1024*1024, nullptr, true})};
+    ggml_gallocr_ptr alloc;
+    ggml_cgraph * graph;
+    ggml_tensor * scores;
+    ggml_tensor * cdf = nullptr;
+    ggml_tensor * output;
+    ggml_tensor * consumer = nullptr;
+    size_t bytes;
+    mask_graph(ggml_backend_t backend, int n, float p, bool fused, bool full = false, int protect = 0)
+        : alloc(ggml_gallocr_new(ggml_backend_get_default_buffer_type(backend))) {
+        require(bool(ctx), "metadata allocation failed");
+        graph = ggml_new_graph_custom(ctx.get(), 256, false);
+        scores = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, n);
+        ggml_set_input(scores);
+        if (full && protect) { ggml_set_output(scores); }
+        auto * logits = scores;
+        if (full) {
+            auto * ids = ggml_argsort(ctx.get(), scores, GGML_SORT_ORDER_DESC);
+            logits = ggml_get_rows(ctx.get(), ggml_reshape_2d(ctx.get(), scores, 1, n), ids);
+            logits = ggml_reshape_1d(ctx.get(), logits, n);
+            cdf = ggml_cumsum(ctx.get(), ggml_soft_max(ctx.get(), logits));
+        } else {
+            cdf = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, n);
+            ggml_set_input(cdf);
+            if (protect == 1 || protect == 2) { ggml_set_output(scores); }
+            if (protect == 2) { ggml_set_output(cdf); }
+        }
+        output = fused ? ggml_top_p_mask(ctx.get(), logits, cdf, p) : legacy_mask(ctx.get(), logits, cdf, p);
+        ggml_set_output(output);
+        ggml_build_forward_expand(graph, output);
+        if (protect == 3) {
+            consumer = ggml_add(ctx.get(), scores, cdf);
+            ggml_set_output(consumer);
+            ggml_build_forward_expand(graph, consumer);
+        }
+        for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+            require(ggml_backend_supports_op(backend, ggml_graph_node(graph, i)), "backend does not support mask fixture");
+        }
+        require(ggml_gallocr_alloc_graph(alloc.get(), graph), "compute allocation failed");
+        bytes = ggml_gallocr_get_buffer_size(alloc.get(), 0);
+        require(bytes < 1024*1024, "fixture escaped bounded compute allocation");
+        if (fused && !full) {
+            if (protect == 0) { require(output->data == scores->data, "mode2 did not reuse logits"); }
+            if (protect == 1) { require(output->data == cdf->data, "mode2 did not reuse CDF"); }
