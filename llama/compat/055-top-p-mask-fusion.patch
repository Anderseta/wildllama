+    for (int n : {1, 2, 10, 20, 31, 32, 33, 40, 64, 127, 128, 129, 255, 256, 257, 512, 1024}) {
+        for (float p : {0.0f, std::numeric_limits<float>::denorm_min(), 0.1f, 0.5f, 0.95f, 1.0f}) {
+            for (int protect = 0; protect < 4; ++protect) {
+                mask_graph before(backend, n, p, false, false, protect), after(backend, n, p, true, false, protect);
+                require(after.bytes <= before.bytes, "fused compute allocation exceeds legacy");
+                require(ggml_graph_n_nodes(after.graph) < ggml_graph_n_nodes(before.graph), "fusion did not reduce graph nodes");
+                old_peak = std::max(old_peak, before.bytes); new_peak = std::max(new_peak, after.bytes);
+                for (int pattern = 0; pattern < 4; ++pattern) {
+                    std::vector<float> logits(n), cdf(n);
+                    for (int i = 0; i < n; ++i) {
+                        logits[i] = float((i*17)%37 - 18)/8.0f;
+                        cdf[i] = float(i + 1)/n;
+                        if (pattern == 1) { cdf[i] = i%3 == 0 ? std::nextafter(p, -INFINITY) : (i%3 == 1 ? p : std::nextafter(p, INFINITY)); }
+                        if (pattern == 2) {
+                            const float special[] = {NAN, INFINITY, -INFINITY, -0.0f, 0.0f, 0.5f, std::numeric_limits<float>::denorm_min(), -std::numeric_limits<float>::denorm_min()};
+                            cdf[i] = special[i%8]; logits[i] = special[(i + 2)%8];
+                        }
+                        if (pattern == 3) { cdf[i] = i%2 ? -0.5f : 2.0f; logits[i] = i%2 ? -0.0f : 0.0f; }
+                    }
+                    before.input(logits, cdf); after.input(logits, cdf);
+                    const auto a = before.run(backend), b = after.run(backend);
+                    for (int i = 0; i < n; ++i) { same(a[i], b[i]); }
+                    if (protect == 3) {
+                        std::vector<float> a_consumer(n), b_consumer(n);
+                        ggml_backend_tensor_get(before.consumer, a_consumer.data(), 0, n*sizeof(float));
+                        ggml_backend_tensor_get(after.consumer, b_consumer.data(), 0, n*sizeof(float));
+                        for (int i = 0; i < n; ++i) { same(a_consumer[i], b_consumer[i]); }
+                    }
+                    ++cases;
+                }
+            }
+        }
+        for (float p : {0.1f, 0.5f, 0.95f}) {
+            mask_graph before(backend, n, p, false, true), after(backend, n, p, true, true);
+            require(after.bytes <= before.bytes, "fused complete graph allocation exceeds legacy");
+            std::vector<float> logits(n);
+            for (int i = 0; i < n; ++i) { logits[i] = float((i*13)%23 - 11)/4.0f; }
+            before.input(logits); after.input(logits);
+            const auto a = before.run(backend), b = after.run(backend);
+            for (int i = 0; i < n; ++i) { same(a[i], b[i]); }
+            ++cases;
+        }
+    }
+    std::printf("TOP_P_MASK exact_cases=%d logits_alias=1 CDF_alias=1 live_outputs_preserved=1 nonmonotonic_CDF=1 nonfinite=1 signed_zero=1 legacy_peak=%zu fused_peak=%zu PASS\n", cases, old_peak, new_peak);
+}
+
+static void capability(ggml_backend_t backend) {
+    ggml_context_ptr ctx(ggml_init({16*ggml_tensor_overhead(), nullptr, true}));
+    auto * logits = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 20);
+    auto * cdf = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 20);
+    auto * op = ggml_top_p_mask(ctx.get(), logits, cdf, 0.5f);
+    require(!logits->data && !cdf->data && !op->data, "capability probe allocated tensor storage");
+    require(ggml_backend_supports_op(backend, op), "valid mode2 probe rejected");
+    for (float p : {-1.0f, 1.01f, INFINITY, NAN}) {
+        std::memcpy(op->op_params, &p, sizeof(p));
+        require(!ggml_backend_supports_op(backend, op), "unsupported top-p value admitted");
+    }
+    const float p = 0.5f; std::memcpy(op->op_params, &p, sizeof(p));
+    cdf->ne[0] = 19;
+    require(!ggml_backend_supports_op(backend, op), "mismatched CDF shape admitted");
+    cdf->ne[0] = logits->ne[0] = op->ne[0] = 1025;
+    require(!ggml_backend_supports_op(backend, op), "oversized mode2 admitted");
+    cdf->ne[0] = logits->ne[0] = op->ne[0] = 20;
+    const int32_t unknown = 3; std::memcpy(op->op_params + 1, &unknown, sizeof(unknown));
+    require(!ggml_backend_supports_op(backend, op), "unknown token-mask mode admitted");
+    std::puts("TOP_P_MASK_CAPABILITY metadata_only=1 invalid_p=1 shape_guard=1 unknown_mode=1 PASS");
+}
+
+struct sample_graph {
+    llama_sampler_ptr sampler;
+    ggml_context_ptr ctx{ggml_init({2*1024*1024, nullptr, true})};
+    ggml_gallocr_ptr alloc;
+    ggml_cgraph * graph;
+    ggml_tensor * scores;
+    llama_sampler_data output{};
+    std::unique_ptr<llama_sampler_graph_binding> binding;
+    int fused_nodes = 0;
+    sample_graph(ggml_backend_t backend, const char * control, int n, int k, float p, size_t min_keep, bool constrained)
+        : sampler(llama_sampler_chain_init(llama_sampler_chain_default_params())),
+          alloc(ggml_gallocr_new(ggml_backend_get_default_buffer_type(backend))) {
+        fusion_switch mode(control);
+        if (constrained) {
+            auto * mask = llama_sampler_init_token_mask(n);
+            std::vector<uint32_t> words((n + 31)/32, 0);
+            for (int i = 0; i < n; ++i) { if (i%3 != 1) { words[i/32] |= uint32_t(1) << (i%32); } }
+            require(llama_sampler_set_token_mask(mask, words.data(), words.size()), "constraint mask setup failed");
+            llama_sampler_chain_add(sampler.get(), mask);
+        }
+        if (k) { llama_sampler_chain_add(sampler.get(), llama_sampler_init_top_k(k)); }
+        llama_sampler_chain_add(sampler.get(), llama_sampler_init_top_p(p, min_keep));
+        llama_sampler_chain_add(sampler.get(), llama_sampler_init_temp(0.8f));
+        llama_sampler_chain_add(sampler.get(), llama_sampler_init_dist(1234567));
+        require(sampler->iface->backend_init(sampler.get(), ggml_backend_get_default_buffer_type(backend), 1), "complete sampler backend unavailable");
+        scores = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, n); ggml_set_input(scores);
+        graph = ggml_new_graph_custom(ctx.get(), 256, false);
+        output = {scores, nullptr, nullptr, nullptr};
+        sampler->iface->backend_reset(sampler.get());
+        sampler->iface->backend_apply(sampler.get(), ctx.get(), graph, &output);
+        require(output.sampled && output.probs && output.candidates, "complete sampler output contract changed");
+        ggml_build_forward_expand(graph, output.sampled);
+        ggml_build_forward_expand(graph, output.probs); ggml_set_output(output.probs);
+        ggml_build_forward_expand(graph, output.candidates); ggml_set_output(output.candidates);
+        for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+            auto * node = ggml_graph_node(graph, i);
+            int32_t kind; std::memcpy(&kind, node->op_params + 1, sizeof(kind));
+            fused_nodes += node->op == GGML_OP_TOKEN_MASK && kind == 2;
+        }
+        require(ggml_gallocr_alloc_graph(alloc.get(), graph), "complete sampler allocation failed");
+        binding = llama_sampler_backend_capture_bindings(sampler.get());
+        require(binding && binding->matches(sampler.get()), "top-p graph binding unavailable");
+    }
+    llama_token run(ggml_backend_t backend, const std::vector<float> & logits, std::vector<float> & probs, std::vector<int32_t> & ids) {
+        ggml_backend_tensor_set(scores, logits.data(), 0, logits.size()*sizeof(float));
+        binding->swap_bindings(sampler.get());
+        sampler->iface->backend_set_input(sampler.get());
+        require(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "sampler compute failed");
+        binding->swap_bindings(sampler.get());
+        probs.resize(ggml_nelements(output.probs)); ids.resize(ggml_nelements(output.candidates));
+        ggml_backend_tensor_get(output.probs, probs.data(), 0, probs.size()*sizeof(float));
+        ggml_backend_tensor_get(output.candidates, ids.data(), 0, ids.size()*sizeof(int32_t));
+        llama_token selected; ggml_backend_tensor_get(output.sampled, &selected, 0, sizeof(selected));
+        llama_sampler_accept(sampler.get(), selected);
+        return selected;
+    }
+};
+
+static void samplers(ggml_backend_t backend, bool bench) {
+    int repetitions = 0;
+    for (int k : {10, 20, 0}) for (bool constrained : {false, true}) {
+        sample_graph before(backend, "0", 256, k, 0.9f, 1, constrained);
+        sample_graph after(backend, "1", 256, k, 0.9f, 1, constrained);
+        require(before.fused_nodes == 0 && after.fused_nodes == 1, "sampler control did not select actual mask graph");
+        const size_t old_bytes = ggml_gallocr_get_buffer_size(before.alloc.get(), 0);
+        const size_t new_bytes = ggml_gallocr_get_buffer_size(after.alloc.get(), 0);
+        require(new_bytes <= old_bytes, "complete sampler increased compute storage");
+        if (bench) {
+            std::printf("TOP_P_MASK_CHAIN_MEMORY n=256 k=%d constrained=%d legacy_bytes=%zu fused_bytes=%zu\n", k, int(constrained), old_bytes, new_bytes);
+        }
+        for (int repeat = 0; repeat < 48; ++repeat) {
+            if (repeat == 24) { llama_sampler_reset(before.sampler.get()); llama_sampler_reset(after.sampler.get()); }
+            std::vector<float> scores(256), a, b; std::vector<int32_t> ai, bi;
+            for (int i = 0; i < 256; ++i) { scores[i] = float((i*17 + repeat*19)%43 - 21)/8.0f; }
+            require(before.run(backend, scores, a, ai) == after.run(backend, scores, b, bi), "fusion changed seeded selected token");
+            require(ai == bi && a.size() == b.size(), "fusion changed candidate order");
+            for (size_t i = 0; i < a.size(); ++i) { same(a[i], b[i]); }
+            ++repetitions;
+        }
+    }
+    for (const char * control : {"0", "true", "yes"}) {
+        sample_graph fallback(backend, control, 20, 10, 0.9f, 1, false);
+        require(fallback.fused_nodes == 0, "unknown control enabled fusion");
+    }
+    sample_graph many(backend, "1", 2048, 0, 0.9f, 1, false);
+    sample_graph minimum(backend, "1", 20, 0, 0.9f, 2, false);
+    sample_graph negative(backend, "1", 20, 0, -0.1f, 1, false);
+    require(many.fused_nodes == 0 && minimum.fused_nodes == 0 && negative.fused_nodes == 0, "unsupported sampler did not retain legacy graph");
+    std::printf("TOP_P_MASK_SAMPLER seeded_repetitions=%d topK10_20=1 candidate_order=1 probabilities=1 constraint_mask=1 reset=1 graph_bindings=1 legacy_fallback=1 PASS\n", repetitions);
+}
+
+static void defaults(ggml_backend_t backend, bool cuda) {
+    const int limit = cuda ? 256 : 1024;
+    int repetitions = 0;
+    for (int n : {256, 257, 512, 1024}) {
+        sample_graph before(backend, "0", n, 0, 0.9f, 1, false);
+        sample_graph automatic(backend, nullptr, n, 0, 0.9f, 1, false);
+        require(before.fused_nodes == 0 && automatic.fused_nodes == int(n <= limit), "unset environment selected an incorrect automatic range");
+        require(ggml_gallocr_get_buffer_size(automatic.alloc.get(), 0) <= ggml_gallocr_get_buffer_size(before.alloc.get(), 0), "automatic sampler increased compute storage");
+        for (int repeat = 0; repeat < 32; ++repeat) {
+            if (repeat == 16) { llama_sampler_reset(before.sampler.get()); llama_sampler_reset(automatic.sampler.get()); }
+            std::vector<float> scores(n), a, b; std::vector<int32_t> ai, bi;
+            for (int i = 0; i < n; ++i) { scores[i] = float((i*17 + repeat*19)%43 - 21)/8.0f; }
+            require(before.run(backend, scores, a, ai) == automatic.run(backend, scores, b, bi), "automatic mask changed seeded selected token");
+            require(ai == bi && a.size() == b.size(), "automatic mask changed candidate order");
+            for (size_t i = 0; i < a.size(); ++i) { same(a[i], b[i]); }
+            ++repetitions;
+        }
+    }
+    // Windows CRT deletes this variable for an empty value; POSIX retains it.
+    {
+        fusion_switch empty("");
+        const char * observed = std::getenv("WILDLLAMA_TOP_P_MASK_FUSION");
+        const bool deleted = observed == nullptr;
+#ifdef _WIN32
+        require(!observed, "Windows empty environment control did not delete the variable");
+#else
+        require(observed && observed[0] == '\0', "POSIX empty environment control was not retained");
+#endif
+        sample_graph actual(backend, "", 20, 10, 0.9f, 1, false);
+        require(actual.fused_nodes == int(deleted), "empty environment control did not follow observed CRT semantics");
+        std::printf("TOP_P_MASK_EMPTY_ENV deleted=%d retained_empty=%d fused_nodes=%d PASS\n", int(deleted), int(!deleted), actual.fused_nodes);
+    }
+    std::printf("TOP_P_MASK_DEFAULT candidate_limit=%d boundaries_256_257_512_1024=1 seeded_repetitions=%d probabilities=1 candidate_order=1 reset=1 allocation_not_increased=1 PASS\n", limit, repetitions);
+}
+
+static double median(std::vector<double> samples) {
+    std::sort(samples.begin(), samples.end());
+    return (samples[samples.size()/2 - 1] + samples[samples.size()/2])/2;
+}
+
+static void print_samples(const char * name, const std::vector<double> & samples) {
+    std::printf(",\"%s\":[", name);
+    for (size_t i = 0; i < samples.size(); ++i) { std::printf("%s%.6f", i ? "," : "", samples[i]); }
+    std::printf("]");
+}
+
+static void benchmark(ggml_backend_t backend) {
+    constexpr int paired_rounds = 16;
+    constexpr int iterations = 400;
+    for (int n : {10, 20, 40, 64, 128, 256, 512, 1024}) for (bool full : {false, true}) {
+        // Keep both component inputs live so repeated evaluation sees identical data.
+        mask_graph before(backend, n, 0.9f, false, full, 2), after(backend, n, 0.9f, true, full, 2);
+        std::vector<float> scores(n), cdf(n);
+        for (int i = 0; i < n; ++i) { scores[i] = float((i*17)%37 - 18)/8.0f; cdf[i] = float(i + 1)/n; }
+        before.input(scores, full ? std::vector<float>{} : cdf); after.input(scores, full ? std::vector<float>{} : cdf);
+        for (int warm = 0; warm < 10; ++warm) { before.run(backend); after.run(backend); }
+        std::vector<double> old_samples, new_samples;
+        for (int round = 0; round < paired_rounds; ++round) {
+            for (int side = 0; side < 2; ++side) {
+                const bool fused = (round%2 == 0) ? side == 1 : side == 0;
+                auto & fixture = fused ? after : before;
+                ggml_backend_synchronize(backend);
+                const auto begin = std::chrono::steady_clock::now();
+                for (int i = 0; i < iterations; ++i) { require(ggml_backend_graph_compute(backend, fixture.graph) == GGML_STATUS_SUCCESS, "benchmark compute failed"); }
+                ggml_backend_synchronize(backend);
+                const double us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - begin).count()/iterations;
+                (fused ? new_samples : old_samples).push_back(us);
+            }
+        }
+        require(old_samples.size() == paired_rounds && new_samples.size() == paired_rounds, "benchmark sample count changed");
+        const double old_us = median(old_samples), new_us = median(new_samples);
+        const int old_nodes = ggml_graph_n_nodes(before.graph), new_nodes = ggml_graph_n_nodes(after.graph);
+        std::printf("TOP_P_MASK_BENCH n=%d full=%d legacy_us=%.6f fused_us=%.6f ratio=%.6f legacy_nodes=%d fused_nodes=%d legacy_bytes=%zu fused_bytes=%zu\n", n, int(full), old_us, new_us, new_us/old_us, old_nodes, new_nodes, before.bytes, after.bytes);
+        std::printf("TOP_P_MASK_BENCH_JSON {\"n\":%d,\"full\":%d,\"paired_rounds\":%d,\"abba_cycles\":%d,\"iterations\":%d,\"samples_per_control\":%d,\"statistic\":\"median\",\"order\":\"ABBA\",\"legacy_us\":%.6f,\"fused_us\":%.6f,\"ratio\":%.6f,\"legacy_nodes\":%d,\"fused_nodes\":%d,\"legacy_bytes\":%zu,\"fused_bytes\":%zu", n, int(full), paired_rounds, paired_rounds/2, iterations, paired_rounds, old_us, new_us, new_us/old_us, old_nodes, new_nodes, before.bytes, after.bytes);
+        print_samples("legacy_samples_us", old_samples); print_samples("fused_samples_us", new_samples);
+        std::printf("}\n");
+    }
+}
+
+int main(int argc, char ** argv) {
+    try {
+        bool cuda = false, bench = false;
+        for (int i = 1; i < argc; ++i) {
+            const std::string arg(argv[i]);
+            require(arg == "--cuda" || arg == "--bench", "use --cuda and/or --bench");
+            cuda |= arg == "--cuda"; bench |= arg == "--bench";
+        }
+        require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH), "explicit CPU backend unavailable");
+        if (cuda) {
+#ifdef GGML_TEST_CUDA_BACKEND_PATH
+            require(ggml_backend_load(GGML_TEST_CUDA_BACKEND_PATH), "explicit CUDA backend unavailable");
+#else
+            std::puts("SKIP: CUDA backend not built"); return 77;
+#endif
+        }
+        auto * device = ggml_backend_dev_by_type(cuda ? GGML_BACKEND_DEVICE_TYPE_GPU : GGML_BACKEND_DEVICE_TYPE_CPU);
+        require(device && (!cuda || std::string(ggml_backend_reg_name(ggml_backend_dev_backend_reg(device))) == "CUDA"), "isolated requested backend unavailable");
+        ggml_backend_ptr backend(ggml_backend_dev_init(device, nullptr)); require(bool(backend), "backend initialization failed");
+        capability(backend.get()); direct_masks(backend.get()); samplers(backend.get(), bench); defaults(backend.get(), cuda);
+        if (bench) { benchmark(backend.get()); }
+        std::printf("TOP_P_MASK_FUSION device=%s zero_model_weights=1 no_extra_workspace=1 PASS\n", cuda ? "CUDA" : "CPU");
+        return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr, "FAIL: %s\n", error.what()); return 1; }
+}
