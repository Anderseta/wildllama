+static __global__ void top_p_mask_warp_kernel(const float * logits, const float * cdf,
+        float * output, int n, float p) {
+    int count = 0;
+    for (int i = threadIdx.x; i < n; i += 32) {
+        count += (-1.0f*cdf[i] + p) > 0.0f;
+    }
+    count = warp_reduce_sum<32>(count);
+    // Finish all CDF reads before the result can reuse either input.
+    __syncwarp(0xffffffff);
+    const int inclusive = count < n ? count : n - 1;
+    for (int i = threadIdx.x; i < n; i += 32) {
+        const bool keep = (-1.0f*cdf[i] + p) > 0.0f || i == inclusive;
+        output[i] = __fadd_rn(logits[i], keep ? 0.0f : -INFINITY);
+    }
+}
+
+static __global__ void top_p_mask_warps_kernel(const float * logits, const float * cdf,
+        float * output, int n, float p) {
+    __shared__ int warp_counts[8];
+    const int lane = threadIdx.x % 32;
+    const int warp = threadIdx.x / 32;
+    int count = 0;
+    for (int i = threadIdx.x; i < n; i += 256) {
+        count += (-1.0f*cdf[i] + p) > 0.0f;
+    }
+    count = warp_reduce_sum<32>(count);
+    if (lane == 0) { warp_counts[warp] = count; }
+    __syncthreads();
+    if (warp == 0) {
+        count = warp_reduce_sum<32>(lane < 8 ? warp_counts[lane] : 0);
+        if (lane == 0) { warp_counts[0] = count < n ? count : n - 1; }
+    }
+    __syncthreads();
+    const int inclusive = warp_counts[0];
+    for (int i = threadIdx.x; i < n; i += 256) {
+        const bool keep = (-1.0f*cdf[i] + p) > 0.0f || i == inclusive;
+        output[i] = __fadd_rn(logits[i], keep ? 0.0f : -INFINITY);
+    }
