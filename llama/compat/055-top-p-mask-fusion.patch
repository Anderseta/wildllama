+struct fusion_switch {
+    bool had;
+    std::string old;
+    static int set(const char * value) {
+#ifdef _WIN32
+        return _putenv_s("WILDLLAMA_TOP_P_MASK_FUSION", value ? value : "");
+#else
+        return value ? setenv("WILDLLAMA_TOP_P_MASK_FUSION", value, 1) : unsetenv("WILDLLAMA_TOP_P_MASK_FUSION");
+#endif
+    }
+    explicit fusion_switch(const char * value) {
+        const char * before = std::getenv("WILDLLAMA_TOP_P_MASK_FUSION");
+        had = before != nullptr;
+        if (before) { old = before; }
+        require(set(value) == 0, "could not set isolated fusion control");
+    }
+    ~fusion_switch() { set(had ? old.c_str() : nullptr); }
