+static difference compare_attention(const std::vector<float> & reference, const std::vector<float> & actual) {
+    require(reference.size() == actual.size(), "attention comparison shape mismatch");
+    difference result;
+    for (size_t i = 0; i < reference.size(); ++i) {
+        require(std::isfinite(reference[i]) && std::isfinite(actual[i]), "nonfinite attention output");
+        uint32_t a, b;
+        std::memcpy(&a, &reference[i], sizeof(a)); std::memcpy(&b, &actual[i], sizeof(b));
+        result.different_bits += a != b;
+        const float error = std::abs(reference[i]-actual[i]);
+        result.max_absolute = std::max(result.max_absolute, error);
+        result.max_relative = std::max(result.max_relative, error/std::max(std::abs(reference[i]), 1e-20f));
+    }
+    for (size_t start = 0; start < reference.size(); start += 256) {
+        const auto a = std::max_element(reference.begin()+start, reference.begin()+start+256)-reference.begin();
+        const auto b = std::max_element(actual.begin()+start, actual.begin()+start+256)-actual.begin();
+        result.changed_head_argmax += a != b;
+    }
+    return result;
+}
+
+static void print_difference(const char * name, const difference & value) {
+    std::printf(" %s_bits=%zu %s_max_abs=%.9g %s_max_rel=%.9g %s_changed_head_argmax=%d",
+        name,value.different_bits,name,double(value.max_absolute),name,double(value.max_relative),
+        name,value.changed_head_argmax);
+}
+
+static bool production_geometry_case(int tokens, int pattern, bool padded, int nsm, int legacy_occupancy,
+        int pair_occupancy, int parallel_occupancy, uint32_t seed, int heads = 24, int kv_heads = 4) {
+    constexpr int dimension = 256;
+    require(heads > 0 && kv_heads > 0 && heads % (2*kv_heads) == 0, "fixture requires even grouped-query ratio");
+    const int q_stride = dimension + (padded ? 16 : 0);
+    const int kv_stride = dimension/32 + (padded ? 2 : 0);
+    // Live KV views may expose fewer rows than the allocated per-head pitch.
+    const int pitch_rows = padded ? ((tokens+8191)/8192)*8192+7 : tokens;
+    const int head_stride = pitch_rows*kv_stride;
+    const int visible = padded ? tokens-37 : tokens;
+    const int kv_max = ((visible+255)/256)*256;
+    const size_t host_bytes = size_t(heads)*q_stride*sizeof(float) +
+        2*size_t(kv_heads)*head_stride*sizeof(block_q8_0) + size_t(tokens)*sizeof(half);
+    require(host_bytes < 256*1024*1024, "fixture host inputs exceed 256 MiB");
+    std::vector<float> q(size_t(heads)*q_stride, 1234);
+    std::vector<block_q8_0> k(size_t(kv_heads)*head_stride), v(k.size());
+    std::vector<half> mask(tokens);
+    uint32_t random = seed;
+    for (int head = 0; head < heads; ++head) {
+        for (int d = 0; d < dimension; ++d) {
+            const float value = pattern == 0 ? std::sin(float(13*head+d)*.031f) :
+                (int(next_random(random)%20001)-10000)/10000.0f;
+            q[head*q_stride+d] = pattern == 2 ? std::ldexp(value, (head+d)%5-3) : value;
+        }
+    }
+    for (int head = 0; head < kv_heads; ++head) {
+        for (int row = 0; row < tokens; ++row) {
+            for (int b = 0; b < dimension/32; ++b) {
+                const size_t index = size_t(head)*head_stride + row*kv_stride+b;
+                const half ks = __float2half(pattern == 2 ? std::ldexp(1.0f, int(next_random(random)%5)-8) : .003f+.0001f*((row+head+b)%11));
+                const half vs = __float2half(pattern == 2 ? std::ldexp(1.0f, int(next_random(random)%15)-12) : .003f+.0001f*((row+head+b)%11));
+                std::memcpy(&k[index].d,&ks,sizeof(ks)); std::memcpy(&v[index].d,&vs,sizeof(vs));
+                for (int d = 0; d < 32; ++d) {
+                    k[index].qs[d] = pattern == 0 ? int8_t((row*7+head*13+b*3+d*11)%127-63) : int8_t(int(next_random(random)%255)-127);
+                    v[index].qs[d] = pattern == 0 ? int8_t((row*3+head*19+b*17+d*5)%125-62) : int8_t(int(next_random(random)%255)-127);
+                }
+            }
+        }
+    }
+    for (int row = 0; row < tokens; ++row) {
+        const bool hidden = row >= visible || (pattern && row > 0 && next_random(random)%31 == 0);
+        mask[row] = __float2half(hidden ? -INFINITY : 0.0f);
+    }
+    // Production vec wrapper passes nbatch_fa=D, ncols1=1 and ncols2=1/2.
+    const int tiles_kv = (tokens+dimension-1)/dimension;
+    const int legacy_splits = ggml_cuda_fattn_parallel_blocks(tiles_kv, heads, nsm, legacy_occupancy);
+    const int old_pair_splits = ggml_cuda_fattn_parallel_blocks(tiles_kv, heads/2, nsm, pair_occupancy);
+    const int reference_pair_splits = ggml_cuda_fattn_parallel_blocks(tiles_kv, heads, nsm, legacy_occupancy);
+    require(legacy_splits > 0 && old_pair_splits > 0 && reference_pair_splits == legacy_splits,
+        "production reference split policy changed");
+    const auto legacy = run<1>(q,k,v,mask,heads,kv_heads,tokens,legacy_splits,q_stride,kv_stride,head_stride,kv_max);
+    const auto old_pair = run<2>(q,k,v,mask,heads,kv_heads,tokens,old_pair_splits,q_stride,kv_stride,head_stride,kv_max);
+    const auto reference_pair = run<2>(q,k,v,mask,heads,kv_heads,tokens,reference_pair_splits,q_stride,kv_stride,head_stride,kv_max);
+    const auto parallel_pair = run<1,2>(q,k,v,mask,heads,kv_heads,tokens,reference_pair_splits,q_stride,kv_stride,head_stride,kv_max);
+    const auto previous = compare_attention(legacy,old_pair), corrected = compare_attention(legacy,reference_pair);
+    const auto parallel = compare_attention(legacy,parallel_pair);
+    std::printf("GQA_PRODUCTION_PLAN tokens=%d q_heads=%d kv_heads=%d D=256 pattern=%d padded=%d seed=%u sms=%d legacy_occupancy=%d pair_occupancy=%d parallel_occupancy=%d legacy_splits=%d previous_pair_splits=%d corrected_pair_splits=%d host_input_bytes=%zu",
+        tokens,heads,kv_heads,pattern,int(padded),seed,nsm,legacy_occupancy,pair_occupancy,parallel_occupancy,legacy_splits,old_pair_splits,reference_pair_splits,host_bytes);
+    print_difference("previous",previous); print_difference("corrected",corrected); print_difference("parallel",parallel); std::puts("");
+    require(corrected.different_bits == 0, "legacy-reference pair differs bitwise from baseline");
+    require(parallel.different_bits == 0, "parallel warp-group pair differs bitwise from baseline");
+    return previous.different_bits != 0;
+}
+
+// Captured event nodes bracket a batch of kernel/merge launches on the device.
+// Host scheduling delays, allocation, copies and graph creation are not timed.
+struct benchmark_graph {
+    cudaGraph_t graph = nullptr;
+    cudaGraphExec_t executable = nullptr;
+    cudaEvent_t begin = nullptr, end = nullptr;
+    ~benchmark_graph() {
+        if (executable) { cudaGraphExecDestroy(executable); }
+        if (graph) { cudaGraphDestroy(graph); }
+        if (begin) { cudaEventDestroy(begin); }
+        if (end) { cudaEventDestroy(end); }
+    }
+    float measure(cudaStream_t stream, int repetitions) {
+        CUDA_CHECK(cudaGraphLaunch(executable,stream));
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        float milliseconds = 0;
+        CUDA_CHECK(cudaEventElapsedTime(&milliseconds,begin,end));
+        require(std::isfinite(milliseconds) && milliseconds > 0, "invalid GPU event timing");
+        return milliseconds/repetitions;
+    }
+};
+
+struct benchmark_inputs {
+    static constexpr int heads = 24, kv_heads = 4, dimension = 256;
+    int tokens, splits;
+    cudaStream_t stream = nullptr;
+    device_buffer<float> q, output, final;
+    device_buffer<block_q8_0> k, v;
+    device_buffer<half> mask;
+    device_buffer<float2> meta;
+    device_buffer<int> max_rows;
+
+    benchmark_inputs(int rows, int partitions) : tokens(rows), splits(partitions), q(heads*dimension),
+        output(size_t(heads)*dimension*splits), final(heads*dimension),
+        k(size_t(kv_heads)*tokens*(dimension/32)), v(size_t(kv_heads)*tokens*(dimension/32)),
+        mask(tokens), meta(size_t(heads)*splits), max_rows(1) {
+        const size_t input_bytes = size_t(heads)*dimension*sizeof(float) +
+            2*size_t(kv_heads)*tokens*(dimension/32)*sizeof(block_q8_0) + size_t(tokens)*sizeof(half);
+        require(input_bytes < 256*1024*1024, "benchmark inputs exceed 256 MiB");
+        CUDA_CHECK(cudaStreamCreateWithFlags(&stream,cudaStreamNonBlocking));
+        std::vector<float> host_q(heads*dimension);
+        std::vector<block_q8_0> host_k(size_t(kv_heads)*tokens*(dimension/32)), host_v(host_k.size());
+        std::vector<half> host_mask(tokens);
+        uint32_t random = 7331;
+        for (auto & value : host_q) { value = (int(next_random(random)%20001)-10000)/10000.0f; }
+        for (size_t i = 0; i < host_k.size(); ++i) {
+            const half scale = __float2half(.003f+.0001f*(i%11));
+            std::memcpy(&host_k[i].d,&scale,sizeof(scale)); std::memcpy(&host_v[i].d,&scale,sizeof(scale));
+            for (int d = 0; d < 32; ++d) {
+                host_k[i].qs[d] = int8_t(int(next_random(random)%255)-127);
+                host_v[i].qs[d] = int8_t(int(next_random(random)%255)-127);
+            }
+        }
+        for (int row = 0; row < tokens; ++row) {
+            host_mask[row] = __float2half(row >= tokens-37 || (row > 0 && row%31 == 0) ? -INFINITY : 0.0f);
+        }
+        CUDA_CHECK(cudaMemcpy(q.data,host_q.data(),host_q.size()*sizeof(float),cudaMemcpyHostToDevice));
+        CUDA_CHECK(cudaMemcpy(k.data,host_k.data(),host_k.size()*sizeof(block_q8_0),cudaMemcpyHostToDevice));
+        CUDA_CHECK(cudaMemcpy(v.data,host_v.data(),host_v.size()*sizeof(block_q8_0),cudaMemcpyHostToDevice));
+        CUDA_CHECK(cudaMemcpy(mask.data,host_mask.data(),host_mask.size()*sizeof(half),cudaMemcpyHostToDevice));
+        CUDA_CHECK(cudaMemcpy(max_rows.data,&tokens,sizeof(tokens),cudaMemcpyHostToDevice));
+    }
+    ~benchmark_inputs() { if (stream) { cudaStreamSynchronize(stream); cudaStreamDestroy(stream); } }
+
+    template<int group, int parallel_groups = 1> void launch() {
+        const int row_bytes = (dimension/32)*sizeof(block_q8_0), head_bytes = tokens*row_bytes;
+        flash_attn_ext_vec<dimension,1,group,GGML_TYPE_Q8_0,GGML_TYPE_Q8_0,false,parallel_groups><<<dim3(1,splits,heads/(group*parallel_groups)),dim3(32,4*parallel_groups,1),0,stream>>>(
+            (const char *)q.data,(const char *)k.data,(const char *)v.data,(const char *)mask.data,
+            nullptr,max_rows.data,output.data,meta.data,1.0f/16,0,1,1,1,0,
+            dimension,init_fastdiv_values(1),heads,1,dimension*sizeof(float),dimension*sizeof(float),heads*dimension*sizeof(float),
+            dimension,tokens,kv_heads,1,row_bytes,head_bytes,int64_t(kv_heads)*head_bytes,
+            row_bytes,head_bytes,int64_t(kv_heads)*head_bytes,tokens,1,1,tokens*sizeof(half),tokens*sizeof(half),tokens*sizeof(half));
+        CUDA_CHECK(cudaGetLastError());
+        if (splits > 1) {
+            flash_attn_combine_results<dimension><<<dim3(1,heads,1),dim3(dimension,1,1),splits*sizeof(float2),stream>>>(
+                output.data,meta.data,final.data,splits);
+            CUDA_CHECK(cudaGetLastError());
+        }
+    }
+    std::vector<float> download() {
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        std::vector<float> values(heads*dimension);
+        CUDA_CHECK(cudaMemcpy(values.data(),splits > 1 ? final.data : output.data,values.size()*sizeof(float),cudaMemcpyDeviceToHost));
+        return values;
+    }
+    template<int group, int parallel_groups = 1> void capture(benchmark_graph & result, int repetitions) {
+        CUDA_CHECK(cudaEventCreate(&result.begin)); CUDA_CHECK(cudaEventCreate(&result.end));
+        CUDA_CHECK(cudaStreamBeginCapture(stream,cudaStreamCaptureModeThreadLocal));
+        CUDA_CHECK(cudaEventRecordWithFlags(result.begin,stream,cudaEventRecordExternal));
+        for (int i = 0; i < repetitions; ++i) { launch<group,parallel_groups>(); }
+        CUDA_CHECK(cudaEventRecordWithFlags(result.end,stream,cudaEventRecordExternal));
+        CUDA_CHECK(cudaStreamEndCapture(stream,&result.graph));
+        CUDA_CHECK(cudaGraphInstantiate(&result.executable,result.graph,nullptr,nullptr,0));
+    }
+};
+
+static float median(std::vector<float> values) {
+    std::sort(values.begin(),values.end());
+    return (values[values.size()/2-1]+values[values.size()/2])*.5f;
+}
+
+static void benchmark(int tokens, int nsm, int legacy_occupancy) {
+    constexpr int batch = 32, pairs = 12, warmups = 3;
+    const int splits = ggml_cuda_fattn_parallel_blocks((tokens+255)/256,24,nsm,legacy_occupancy);
+    benchmark_inputs inputs(tokens,splits);
+    inputs.launch<1>(); const auto reference = inputs.download();
+    inputs.launch<2>(); require(compare_attention(reference,inputs.download()).different_bits == 0,
+        "benchmark pair changed reference output");
+    inputs.launch<1,2>(); require(compare_attention(reference,inputs.download()).different_bits == 0,
+        "benchmark parallel warp-group pair changed reference output");
+    benchmark_graph legacy, pair, parallel;
+    inputs.capture<1>(legacy,batch); inputs.capture<2>(pair,batch); inputs.capture<1,2>(parallel,batch);
+    for (int i = 0; i < warmups; ++i) {
+        legacy.measure(inputs.stream,batch); pair.measure(inputs.stream,batch); parallel.measure(inputs.stream,batch);
+    }
+    std::vector<float> legacy_ms, pair_ms, parallel_ms;
+    int pair_wins = 0, parallel_wins = 0;
+    const int orders[6][3] = {{0,1,2},{2,1,0},{1,2,0},{0,2,1},{2,0,1},{1,0,2}};
+    benchmark_graph * graphs[] = {&legacy,&pair,&parallel};
+    for (int i = 0; i < pairs; ++i) {
+        float samples[3];
+        for (int position : orders[i%6]) { samples[position]=graphs[position]->measure(inputs.stream,batch); }
+        legacy_ms.push_back(samples[0]); pair_ms.push_back(samples[1]); parallel_ms.push_back(samples[2]);
+        pair_wins += samples[1]<samples[0]; parallel_wins += samples[2]<samples[0];
+    }
+    const float a=median(legacy_ms),b=median(pair_ms),c=median(parallel_ms);
+    std::printf("GQA_GPU_EVENTS tokens=%d q_heads=24 kv_heads=4 splits=%d batch=%d pairs=%d warmups=%d legacy_ms=%.9g pair_ms=%.9g speedup=%.6g pair_wins=%d legacy_min_ms=%.9g legacy_max_ms=%.9g pair_min_ms=%.9g pair_max_ms=%.9g parallel_ms=%.9g parallel_speedup=%.6g parallel_wins=%d parallel_min_ms=%.9g parallel_max_ms=%.9g comparison_order=balanced_six_permutations timing_scope=kernel_plus_canonical_merge excludes=allocation_copy_capture_host_scheduling\n",
+        tokens,splits,batch,pairs,warmups,double(a),double(b),double(a/b),pair_wins,
+        double(*std::min_element(legacy_ms.begin(),legacy_ms.end())),double(*std::max_element(legacy_ms.begin(),legacy_ms.end())),
+        double(*std::min_element(pair_ms.begin(),pair_ms.end())),double(*std::max_element(pair_ms.begin(),pair_ms.end())),
+        double(c),double(a/c),parallel_wins,double(*std::min_element(parallel_ms.begin(),parallel_ms.end())),
+        double(*std::max_element(parallel_ms.begin(),parallel_ms.end())));
+}
+
+int main(int argc, char ** argv) {
+    try {
+        bool measure = false, require_drift = false;
+        for (int i = 1; i < argc; ++i) {
+            const std::string argument = argv[i];
+            if (argument == "--benchmark" && !measure) { measure = true; }
+            else if (argument == "--require-drift" && !require_drift) { require_drift = true; }
+            else { throw std::runtime_error("Usage: test-cuda-fattn-gqa-launch [--benchmark] [--require-drift]"); }
+        }
+        int devices = 0;
+        const auto status = cudaGetDeviceCount(&devices);
+        if (status == cudaErrorNoDevice || status == cudaErrorInsufficientDriver || (status == cudaSuccess && !devices)) {
+            std::puts("SKIP: no CUDA device/driver available"); return 77;
+        }
+        CUDA_CHECK(status);
+        cudaDeviceProp properties{};
+        int device; CUDA_CHECK(cudaGetDevice(&device)); CUDA_CHECK(cudaGetDeviceProperties(&properties,device));
+        int legacy_occupancy = 0, pair_occupancy = 0, parallel_occupancy = 0;
+        CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&legacy_occupancy,
+            flash_attn_ext_vec<256,1,1,GGML_TYPE_Q8_0,GGML_TYPE_Q8_0,false>,128,0));
+        CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&pair_occupancy,
+            flash_attn_ext_vec<256,1,2,GGML_TYPE_Q8_0,GGML_TYPE_Q8_0,false>,128,0));
+        CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&parallel_occupancy,
+            flash_attn_ext_vec<256,1,1,GGML_TYPE_Q8_0,GGML_TYPE_Q8_0,false,2>,256,0));
+        cudaFuncAttributes legacy_attributes{},pair_attributes{},parallel_attributes{};
+        CUDA_CHECK(cudaFuncGetAttributes(&legacy_attributes,flash_attn_ext_vec<256,1,1,GGML_TYPE_Q8_0,GGML_TYPE_Q8_0,false>));
+        CUDA_CHECK(cudaFuncGetAttributes(&pair_attributes,flash_attn_ext_vec<256,1,2,GGML_TYPE_Q8_0,GGML_TYPE_Q8_0,false>));
+        CUDA_CHECK(cudaFuncGetAttributes(&parallel_attributes,flash_attn_ext_vec<256,1,1,GGML_TYPE_Q8_0,GGML_TYPE_Q8_0,false,2>));
+        const auto print_attributes = [](const char * name, const cudaFuncAttributes & value) {
+            std::printf("GQA_KERNEL_ATTR kernel=%s registers_per_thread=%d static_smem_bytes=%zu local_bytes=%zu max_threads_per_block=%d binary_version=%d ptx_version=%d\n",
+                name,value.numRegs,value.sharedSizeBytes,value.localSizeBytes,value.maxThreadsPerBlock,value.binaryVersion,value.ptxVersion);
+        };
+        print_attributes("legacy128",legacy_attributes); print_attributes("pair128",pair_attributes);
+        print_attributes("parallel256",parallel_attributes);
+        std::printf("GQA_DEVICE_ATTR sms=%d registers_per_sm=%d max_threads_per_sm=%d shared_bytes_per_sm=%zu\n",
+            properties.multiProcessorCount,properties.regsPerMultiprocessor,properties.maxThreadsPerMultiProcessor,properties.sharedMemPerMultiprocessor);
+        require(legacy_occupancy > 0 && pair_occupancy > 0 && parallel_occupancy > 0, "invalid production occupancy");
+        int cases = 0, previous_drift_cases = 0;
+        for (int tokens : {1280,33024}) {
+            for (int pattern : {0,1,2}) {
+                for (bool padded : {false,true}) {
+                    previous_drift_cases += production_geometry_case(tokens,pattern,padded,properties.multiProcessorCount,
+                        legacy_occupancy,pair_occupancy,parallel_occupancy,pattern == 0 ? 42u : 8675309u+pattern);
+                    ++cases;
+                }
+            }
+        }
+        // Cover every head geometry from the original fixed-split fixture,
+        // including early decode lengths below one full occupancy wave.
+        const std::pair<int,int> shapes[] = {{4,1},{6,1},{8,2},{12,2}};
+        for (const auto & shape : shapes) {
+            for (int tokens : {256,512,768,1024}) {
+                for (int pattern : {0,1,2}) {
+                    for (bool padded : {false,true}) {
+                        previous_drift_cases += production_geometry_case(tokens,pattern,padded,properties.multiProcessorCount,
+                            legacy_occupancy,pair_occupancy,parallel_occupancy,8675309u+pattern,shape.first,shape.second);
+                        ++cases;
+                    }
+                }
+            }
+        }
+        if (require_drift) {
+            require(previous_drift_cases > 0, "negative control did not reproduce prior automatic-split drift on this GPU");
+        }
+        std::printf("PASS production GQA planner cases=%d previous_drift_cases=%d corrected_bitwise=1 require_drift=%d\n",cases,previous_drift_cases,int(require_drift));
+        if (measure) { for (int tokens : {256,512,1024,1280,8192,33024,65536}) { benchmark(tokens,properties.multiProcessorCount,legacy_occupancy); } }
+        return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr,"FAIL: %s\n",error.what()); return 1; }
+}
