+            require(llama_decode(ctx, batch) == 0, "synthetic decode failed");
+        }
+        llama_synchronize(ctx);
+        require(!ctx->get_graph_variant_admission_stats().reuse_only, "decode leaked reuse-only mode");
+        const float * logits = llama_get_logits_ith(ctx, -1);
+        require(logits != nullptr, "missing synthetic logits");
+        std::vector<float> result(logits, logits + vocab);
+        for (float value : result) { require(std::isfinite(value), "nonfinite synthetic logits"); }
+        llama_batch_free(batch);
+        return result;
+    } catch (...) { llama_batch_free(batch); throw; }
