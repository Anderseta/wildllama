diff --git a/tools/server/server-prefill-budget.h b/tools/server/server-prefill-budget.h
new file mode 100644
--- /dev/null
+++ b/tools/server/server-prefill-budget.h
@@ -0,0 +1,225 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+// CPU-only admission controller. A decision never edits slots, tokens or a
+// configured batch size: it either admits the original prompt round or defers
+// that whole round while already-generating sequences take one ordinary step.
+class server_prefill_budget {
+public:
+    struct counters {
+        uint64_t decisions = 0;
+        uint64_t deferred = 0;
+        uint64_t forced_admissions = 0;
+        uint64_t pure_samples = 0;
+        uint64_t mixed_samples = 0;
+        uint64_t invalid_samples = 0;
+        uint64_t reserve_admissions = 0;
+    };
+
+    static bool enabled(const char * value) {
+        return value && std::strcmp(value, "1") == 0;
+    }
+
+    static uint64_t parse_target(const char * value) {
+        if (!value || !*value) { return 0; }
+        uint64_t result = 0;
+        for (const char * p = value; *p; ++p) {
+            if (*p < '0' || *p > '9' || result > 60000000) { return 0; }
+            result = result * 10 + uint64_t(*p - '0');
+        }
+        return result >= 100 && result <= 60000000 ? result : 0;
+    }
+
+    void reset(uint64_t target_us = 0) { *this = {}; target_override_us = target_us; }
+
+    void clear_learning() {
+        rows = 0;
+        pure_us = 0;
+        mixed_us = 0;
+        warm_pure = 0;
+        slow_mixed = 0;
+        fast_mixed = 0;
+        pressure = false;
+        last_deferred = false;
+    }
+
+    void reservation_changed() {
+        slow_mixed = fast_mixed = 0;
+        pressure = last_deferred = false;
+    }
+
+    bool defer(uint32_t configured_batch, uint32_t generating_rows,
+               uint32_t pending_prompts, bool eligible, bool transient_reservation = false) {
+        ++counts.decisions;
+        if (!eligible || !generating_rows || !pending_prompts || configured_batch <= generating_rows) {
+            // Attaching another slot's backend sampler requires an ordinary
+            // scheduler reservation. It invalidates pressure, not the pure
+            // baseline of unchanged already-generating rows. Unsupported
+            // layouts/tasks still discard every learned sample.
+            if (!generating_rows || (!eligible && (!transient_reservation || rows != generating_rows))) {
+                clear_learning();
+            }
+            if (!eligible && transient_reservation) { ++counts.reserve_admissions; }
+            last_deferred = false;
+            slow_mixed = 0;
+            fast_mixed = 0;
+            pressure = false;
+            return false;
+        }
+        if (rows != generating_rows) { clear_learning(); rows = generating_rows; }
+        // Every deferred round is followed by an ordinary admission round,
+        // even while pressure remains. Prompt progress cannot be starved.
+        if (last_deferred) {
+            last_deferred = false;
+            ++counts.forced_admissions;
+            return false;
+        }
+        if (warm_pure < 2 || !pressure) { return false; }
+        last_deferred = true;
+        ++counts.deferred;
+        return true;
+    }
+
+    // Only completed, synchronized logical decode calls are observations.
+    // No synchronization is performed by this class or added for telemetry.
+    void observe(int64_t elapsed_us, uint32_t generating_rows,
+                 uint32_t prompt_rows, bool completed) {
+        if (!completed || !generating_rows) { return; }
+        if (elapsed_us <= 0 || elapsed_us > 60000000) {
+            ++counts.invalid_samples;
+            clear_learning();
+            return;
+        }
+        if (rows != generating_rows) { clear_learning(); rows = generating_rows; }
+        const uint64_t sample = uint64_t(elapsed_us);
+        if (!prompt_rows) {
+            pure_us = smooth(pure_us, sample);
+            warm_pure = std::min<uint32_t>(warm_pure + 1, 2);
+            ++counts.pure_samples;
+            return;
+        }
+        mixed_us = smooth(mixed_us, sample);
+        ++counts.mixed_samples;
+        if (warm_pure < 2) { return; }
+        // Two baseline steps is a relative latency objective, not a model
+        // speed claim. The 1 ms floor avoids reacting to tiny timing noise.
+        const uint64_t target = target_latency_us();
+        if (sample > target + target / 10) {
+            slow_mixed = std::min<uint32_t>(slow_mixed + 1, 2);
+            fast_mixed = 0;
+            if (slow_mixed == 2) { pressure = true; }
+        } else if (sample < target - target / 4) {
+            slow_mixed = 0;
+            fast_mixed = std::min<uint32_t>(fast_mixed + 1, 4);
+            if (fast_mixed == 4) { pressure = false; }
+        } else {
+            slow_mixed = fast_mixed = 0;
+        }
+    }
+
+    counters stats() const { return counts; }
+    uint64_t pure_latency_us() const { return pure_us; }
+    uint64_t mixed_latency_us() const { return mixed_us; }
+    uint64_t target_latency_us() const { return target_override_us ? target_override_us : std::max<uint64_t>(1000, 2 * pure_us); }
+    bool under_pressure() const { return pressure; }
+
+private:
+    static uint64_t smooth(uint64_t previous, uint64_t sample) {
