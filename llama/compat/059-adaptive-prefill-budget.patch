+        const auto cache = scoped->get_graph_variant_stats();
+        primary_peak = std::max(primary_peak, current.primary_compute_bytes);
+        gpu_peak = std::max(gpu_peak, current.primary_gpu_bytes);
+        baseline_peak = std::max(baseline_peak, reference->get_graph_variant_admission_stats().primary_compute_bytes);
+        baseline_gpu_peak = std::max(baseline_gpu_peak, reference->get_graph_variant_admission_stats().primary_gpu_bytes);
+        require(cache.arenas == initial_secondary.arenas && cache.compute_bytes == initial_secondary.compute_bytes,
+                "contention episode allocated another secondary arena");
+    }
+    require(primary_peak <= baseline_peak, "adaptive episode exceeded the baseline primary reservation");
+    require(gpu_peak <= baseline_gpu_peak, "adaptive episode exceeded baseline primary GPU storage");
+    // A normal short shape is still allowed to create a cache entry after the
+    // episode. The configured 128 MiB cache has not been disabled globally.
+    compare(rows(8, 0), false);
+    const auto ordinary_cache = scoped->get_graph_variant_stats();
+    require(ordinary_cache.arenas > initial_secondary.arenas, "normal cache admission was globally disabled");
+    const auto before_hit = scoped->get_graph_variant_admission_stats().reuse_hits;
+    compare(rows(8, 0), true);
+    require(scoped->get_graph_variant_admission_stats().reuse_hits > before_hit,
+            "existing graph reuse was disabled by the scoped policy");
+    // Two restricted visits must not prime the normal two-hit history. All
+    // positions remain in the same 256-token history bucket in this fixture.
+    compare(rows(16, 0), true); compare(rows(16, 0), true);
+    compare(rows(32, 0), false);
+    const auto before_cold = scoped->get_graph_variant_stats();
+    compare(rows(16, 0), false);
+    const auto after_cold = scoped->get_graph_variant_stats();
+    require(after_cold.arenas == before_cold.arenas && after_cold.compute_bytes == before_cold.compute_bytes,
+            "restricted visits primed later normal admission history");
+    compare(rows(32, 0), false); compare(rows(16, 0), false);
+    require(scoped->get_graph_variant_stats().arenas > after_cold.arenas, "ordinary two-hit cache admission stopped working");
+    auto empty = llama_batch_init(1, 0, 1);
+    empty.n_tokens = 0;
+    {
+        server_prefill_reuse_scope<llama_context> failure_scope(scoped.get(), true);
+        const int status = llama_decode(scoped.get(), empty);
+        llama_batch_free(empty);
+        require(status == -1, "invalid batch unexpectedly accepted");
+    }
+    require(!scoped->get_graph_variant_admission_stats().reuse_only, "decode error leaked scoped admission policy");
+    llama_gpu_execution_stats execution{};
+    require(llama_gpu_execution_stats_get(scoped.get(), &execution), "execution counters unavailable");
+    require(gpu ? execution.gpu_heavy_ops_submitted > 0 && execution.cpu_heavy_ops_submitted == 0 :
+            execution.gpu_heavy_ops_submitted == 0,
+            "requested backend did not execute the fixture");
+    const auto observed = scoped->get_graph_variant_admission_stats();
+    std::printf("ADAPTIVE_PREFILL_GRAPH device=%s configured_cache_mib=128 comparisons=%d exact_logits=1 episode_1_512_1_512=1 new_secondary_bytes=0 primary_initial=%zu primary_peak=%zu baseline_primary_peak=%zu primary_gpu_initial=%zu primary_gpu_peak=%zu baseline_primary_gpu_peak=%zu history_unprimed=1 existing_reuse_preserved=1 normal_admission_preserved=1 error_return_restored=1 reuse_scopes=%llu reuse_hits=%llu reuse_misses=%llu scope_restored=%d cpu_heavy_ops=%llu gpu_heavy_ops=%llu actual_backend_execution=1 PASS\n",
+        gpu ? "CUDA" : "CPU", comparisons, initial.primary_compute_bytes, primary_peak, baseline_peak,
+        initial.primary_gpu_bytes, gpu_peak, baseline_gpu_peak, static_cast<unsigned long long>(observed.reuse_scopes),
+        static_cast<unsigned long long>(observed.reuse_hits), static_cast<unsigned long long>(observed.reuse_misses), int(!observed.reuse_only),
+        static_cast<unsigned long long>(execution.cpu_heavy_ops_submitted), static_cast<unsigned long long>(execution.gpu_heavy_ops_submitted));
+}
+
+// Explicit CPU diagnostic, outside the default tests. Feed the SAME logical
+// histories under different physical interleavings; never sample a divergent
+// continuation. Raw logits permit independent error/margin analysis.
+static void interleaving(const std::filesystem::path & model_path, const std::filesystem::path & history_path,
+                         const std::filesystem::path & directory, ggml_type kv_type = GGML_TYPE_F16, bool flash_attention = true) {
+    require(kv_type == GGML_TYPE_F16 || kv_type == GGML_TYPE_F32, "unsupported diagnostic KV precision");
+    require(std::filesystem::is_regular_file(model_path) && std::filesystem::file_size(model_path) > 0 &&
+            std::filesystem::file_size(model_path) <= 64 * 1024 * 1024, "interleaving requires an existing model at most 64 MiB");
+    std::ifstream input(history_path);
+    std::string version; input >> version;
+    require(version == "ADAPTIVE_PREFILL_HISTORY_V1", "invalid teacher-forcing history version");
+    auto read = [&]() {
+        size_t count = 0; input >> count;
+        require(bool(input) && count > 0 && count <= 8192, "invalid teacher-forcing history length");
+        std::vector<llama_token> tokens(count);
+        for (auto & token : tokens) { input >> token; require(bool(input), "incomplete teacher-forcing history"); }
+        return tokens;
+    };
+    const auto prompt_a = read(), generated_a = read(), prompt_b = read(), generated_b = read(), allowed = read();
+    std::string trailing; require(!(input >> trailing), "unexpected trailing teacher-forcing data");
+    require(generated_a.size() == 512 && prompt_b.size() == 3000 && generated_b.size() == 64 && allowed.size() >= 32,
+            "interleaving diagnostic requires the exact bounded concurrent history contract");
+    auto params = llama_model_default_params(); params.n_gpu_layers = 0; params.load_mode = LLAMA_LOAD_MODE_NONE;
+    std::unique_ptr<llama_model, decltype(&llama_model_free)> model(
+        llama_model_load_from_file(model_path.string().c_str(), params), llama_model_free);
+    require(bool(model), "cannot load the existing teacher-forcing fixture");
+    const int vocab = llama_vocab_n_tokens(llama_model_get_vocab(model.get()));
+    require(vocab == 259, "teacher-forcing diagnostic requires the pinned 259-token fixture");
+    for (const auto * tokens : {&prompt_a, &generated_a, &prompt_b, &generated_b, &allowed}) {
+        for (const auto token : *tokens) { require(token >= 0 && token < vocab, "teacher-forcing token is outside the fixture vocabulary"); }
+    }
+    require(!std::filesystem::exists(directory) || std::filesystem::is_empty(directory), "use a fresh interleaving output directory");
+    std::filesystem::create_directories(directory);
+    std::ofstream shape(directory / "shape.txt");
+    shape << vocab << ' ' << generated_a.size() << ' ' << generated_b.size() << '\n';
+    shape.close(); require(bool(shape), "cannot write diagnostic shape");
+    std::ofstream statistics(directory / "controls.tsv");
+    statistics << "control\tdecode_calls\tdeferrals\tprimary_peak_bytes\tprimary_gpu_peak_bytes\tsecondary_peak_bytes\n";
+    budget_environment budget;
+    for (const auto & name : {"ordinary-normal", "ordinary-reuse", "adaptive-reuse", "adaptive-repeat"}) {
+        const bool altered = std::strncmp(name, "adaptive-", 9) == 0;
+        const bool restrict_episode = std::strcmp(name, "ordinary-normal") != 0;
+        auto cp = llama_context_default_params();
+        cp.n_ctx = 8192; cp.n_batch = 512; cp.n_ubatch = 128; cp.n_seq_max = 2; cp.kv_unified = true;
+        cp.n_threads = cp.n_threads_batch = 1; cp.n_outputs_max = 2; cp.n_outputs_max_per_seq = 1;
+        cp.op_offload = false; cp.type_k = cp.type_v = kv_type;
+        cp.flash_attn_type = flash_attention ? LLAMA_FLASH_ATTN_TYPE_AUTO : LLAMA_FLASH_ATTN_TYPE_DISABLED;
+        context_ptr ctx(llama_init_from_model(model.get(), cp), llama_free);
+        require(bool(ctx) && ctx->adaptive_prefill_supported(), "teacher-forcing context is not eligible plain unified KV");
+        std::vector<float> logits_a, logits_b;
+        logits_a.reserve(generated_a.size() * size_t(vocab)); logits_b.reserve(generated_b.size() * size_t(vocab));
+        size_t calls = 0, deferrals = 0, primary_peak = 0, gpu_peak = 0, secondary_peak = 0;
+        auto append_logits = [&](std::vector<float> & result, int index) {
+            const auto * values = llama_get_logits_ith(ctx.get(), index);
+            require(values != nullptr, "teacher-forcing output logits are missing");
+            for (int i = 0; i < vocab; ++i) { require(std::isfinite(values[i]), "nonfinite teacher-forcing logits"); }
+            result.insert(result.end(), values, values + vocab);
+        };
+        auto decode = [&](const std::vector<input_row> & rows, bool episode, int a_index, int b_index) {
+            auto batch = llama_batch_init(int(rows.size()), 0, 1);
+            try {
+                batch.n_tokens = int(rows.size());
+                for (size_t i = 0; i < rows.size(); ++i) {
+                    batch.token[i] = rows[i].token; batch.pos[i] = rows[i].position;
+                    batch.n_seq_id[i] = 1; batch.seq_id[i][0] = rows[i].sequence; batch.logits[i] = rows[i].output;
+                }
+                {
+                    server_prefill_reuse_scope<llama_context> scope(ctx.get(), restrict_episode && episode);
+                    require(llama_decode(ctx.get(), batch) == 0, "teacher-forcing decode failed");
+                }
+                llama_synchronize(ctx.get());
+                require(!ctx->get_graph_variant_admission_stats().reuse_only, "teacher-forcing scope was not restored");
+                if (a_index >= 0) { append_logits(logits_a, a_index); }
+                if (b_index >= 0) { append_logits(logits_b, b_index); }
+                const auto memory = ctx->get_graph_variant_admission_stats();
+                primary_peak = std::max(primary_peak, memory.primary_compute_bytes);
+                gpu_peak = std::max(gpu_peak, memory.primary_gpu_bytes);
+                secondary_peak = std::max(secondary_peak, ctx->get_graph_variant_stats().compute_bytes);
+                ++calls;
+                llama_batch_free(batch);
+            } catch (...) { llama_batch_free(batch); throw; }
+        };
+        std::vector<input_row> initial;
+        for (size_t i = 0; i < prompt_a.size(); ++i) {
+            initial.push_back({0, int(i), prompt_a[i], i + 1 == prompt_a.size()});
+        }
+        decode(initial, false, int(initial.size()) - 1, -1);
+        size_t b_prompt_done = 0, b_generated = 0, chunks = 0;
+        bool previous_deferred = false;
+        for (size_t sample = 1; sample < generated_a.size(); ++sample) {
+            std::vector<input_row> rows = {{0, int(prompt_a.size() + sample - 1), generated_a[sample - 1], true}};
+            int b_index = -1;
+            const bool episode = sample >= 16 && b_prompt_done < prompt_b.size();
+            const bool defer = altered && episode && chunks >= 3 && !previous_deferred;
+            if (defer) { ++deferrals; previous_deferred = true; }
+            else if (episode) {
+                const size_t count = std::min<size_t>(511, prompt_b.size() - b_prompt_done);
+                for (size_t i = 0; i < count; ++i) {
+                    const size_t position = b_prompt_done + i;
+                    rows.push_back({1, int(position), prompt_b[position], position + 1 == prompt_b.size()});
+                }
+                b_prompt_done += count; ++chunks; previous_deferred = false;
+                if (b_prompt_done == prompt_b.size()) { b_generated = 1; b_index = int(rows.size()) - 1; }
+            } else if (b_prompt_done == prompt_b.size() && b_generated < generated_b.size()) {
+                rows.push_back({1, int(prompt_b.size() + b_generated - 1), generated_b[b_generated - 1], true});
+                ++b_generated; b_index = 1;
+            }
+            decode(rows, episode, 0, b_index);
+        }
+        require(logits_a.size() == generated_a.size() * size_t(vocab) && logits_b.size() == generated_b.size() * size_t(vocab),
+                "teacher-forcing output conservation failed");
+        require(deferrals == (altered ? 3u : 0u), "teacher-forcing schedule did not match the observed policy");
+        auto write = [&](const char * suffix, const std::vector<float> & values) {
+            std::ofstream file(directory / (std::string(name) + suffix), std::ios::binary);
+            file.write(reinterpret_cast<const char *>(values.data()), std::streamsize(values.size() * sizeof(float)));
+            file.close(); require(bool(file), "cannot write teacher-forcing raw logits");
+        };
+        write(".a.f32", logits_a); write(".b.f32", logits_b);
+        statistics << name << '\t' << calls << '\t' << deferrals << '\t' << primary_peak << '\t' << gpu_peak << '\t' << secondary_peak << '\n';
+        std::printf("ADAPTIVE_PREFILL_INTERLEAVING control=%s kv_type=%s flash_attention_requested=%s actual_cpu_decode_calls=%zu deferrals=%zu a_logits=%zu b_logits=%zu primary_peak_bytes=%zu primary_gpu_peak_bytes=%zu secondary_peak_bytes=%zu scope_restored=1\n",
+            name, ggml_type_name(kv_type), flash_attention ? "auto" : "off", calls, deferrals, logits_a.size(), logits_b.size(), primary_peak, gpu_peak, secondary_peak);
+    }
+    statistics.close(); require(bool(statistics), "cannot write teacher-forcing memory statistics");
+}
+
+int main(int argc, char ** argv) {
+    try {
+        if (argc == 5 && (std::strcmp(argv[1], "--interleaving") == 0 || std::strcmp(argv[1], "--interleaving-f32") == 0 ||
+                std::strcmp(argv[1], "--interleaving-f32-no-fa") == 0)) {
+            require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH), "explicit CPU backend unavailable");
+            llama_backend_init();
+            interleaving(argv[2], argv[3], argv[4], std::strcmp(argv[1], "--interleaving") == 0 ? GGML_TYPE_F16 : GGML_TYPE_F32,
+                std::strcmp(argv[1], "--interleaving-f32-no-fa") != 0);
+            llama_backend_free();
+            return 0;
+        }
+        bool gpu = false;
+        std::filesystem::path directory;
+        for (int i = 1; i < argc; ++i) {
+            if (std::strcmp(argv[i], "--cuda") == 0) { gpu = true; }
+            else { require(directory.empty(), "use [--cuda] [fixture-directory]"); directory = argv[i]; }
+        }
+        policy(); scopes(); memory_policy();
+        if (!directory.empty()) {
+            require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH), "explicit CPU backend unavailable");
+            if (gpu) {
+#ifdef GGML_TEST_CUDA_BACKEND_PATH
+                require(ggml_backend_load(GGML_TEST_CUDA_BACKEND_PATH), "explicit CUDA backend unavailable");
+#else
+                std::puts("SKIP: CUDA backend not built"); return 77;
+#endif
+            }
+            llama_backend_init(); runtime(directory, gpu); llama_backend_free();
+        }
+        return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr, "FAIL: %s\n", error.what()); return 1; }
+}
