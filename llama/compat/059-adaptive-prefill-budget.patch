+// Causal accounting of the EXISTING compute reservations. Ordinary rounds can
+// establish a new baseline before this episode has made any scheduling change.
+// After its first real deferral, even forced ordinary followups remain protected.
+// All secondary growth during a protected episode is unexpected, at every stage.
+class server_prefill_memory {
+public:
+    struct statistics {
+        size_t ordinary_primary_growth_bytes = 0, ordinary_primary_gpu_growth_bytes = 0;
+        size_t primary_growth_bytes = 0, primary_gpu_growth_bytes = 0, secondary_growth_bytes = 0;
+        size_t primary_peak_bytes = 0, primary_gpu_peak_bytes = 0, secondary_peak_bytes = 0;
+        size_t ordinary_primary_before_bytes = 0, ordinary_primary_after_bytes = 0;
+        size_t ordinary_primary_gpu_before_bytes = 0, ordinary_primary_gpu_after_bytes = 0;
+        uint64_t calls = 0;
+    };
+    struct result {
+        bool unexpected = false;
+        bool baseline_changed = false;
+        size_t primary_delta = 0, primary_gpu_delta = 0, secondary_delta = 0;
+    };
+
+    void reset() { *this = {}; }
+    void begin_episode() { adapted = false; }
+    void mark_deferred() { adapted = true; }
+    result observe(size_t primary_before, size_t primary_after, size_t gpu_before, size_t gpu_after,
+                   size_t secondary_before, size_t secondary_after, bool protected_round) {
+        ++counts.calls;
+        counts.primary_peak_bytes = std::max({counts.primary_peak_bytes, primary_before, primary_after});
+        counts.primary_gpu_peak_bytes = std::max({counts.primary_gpu_peak_bytes, gpu_before, gpu_after});
+        counts.secondary_peak_bytes = std::max({counts.secondary_peak_bytes, secondary_before, secondary_after});
+        result value;
+        if (!protected_round) { return value; }
+        value.primary_delta = primary_after > primary_before ? primary_after - primary_before : 0;
+        value.primary_gpu_delta = gpu_after > gpu_before ? gpu_after - gpu_before : 0;
+        value.secondary_delta = secondary_after > secondary_before ? secondary_after - secondary_before : 0;
+        counts.secondary_growth_bytes = std::max(counts.secondary_growth_bytes, value.secondary_delta);
+        if (adapted) {
+            counts.primary_growth_bytes = std::max(counts.primary_growth_bytes, value.primary_delta);
+            counts.primary_gpu_growth_bytes = std::max(counts.primary_gpu_growth_bytes, value.primary_gpu_delta);
+        } else if (value.primary_delta || value.primary_gpu_delta) {
+            counts.ordinary_primary_growth_bytes = std::max(counts.ordinary_primary_growth_bytes, value.primary_delta);
+            counts.ordinary_primary_gpu_growth_bytes = std::max(counts.ordinary_primary_gpu_growth_bytes, value.primary_gpu_delta);
+            counts.ordinary_primary_before_bytes = primary_before;
+            counts.ordinary_primary_after_bytes = primary_after;
+            counts.ordinary_primary_gpu_before_bytes = gpu_before;
+            counts.ordinary_primary_gpu_after_bytes = gpu_after;
+            value.baseline_changed = true;
+        }
+        value.unexpected = value.secondary_delta || (adapted && (value.primary_delta || value.primary_gpu_delta));
+        return value;
+    }
+    statistics stats() const { return counts; }
+
+private:
+    statistics counts;
+    bool adapted = false;
+};
+static_assert(sizeof(server_prefill_memory) <= 128, "memory proof must remain bounded CPU metadata");
+
+// The context keeps normal cache lookup behavior but must not retain a new
+// secondary arena merely because this optional scheduling decision changed
+// the batch composition. Nesting and exceptions restore the previous mode.
+template<typename Context>
+class server_prefill_reuse_scope {
+public:
+    server_prefill_reuse_scope(Context * value, bool active) : ctx(active ? value : nullptr) {
+        if (ctx) { previous = ctx->set_graph_variant_reuse_only(true); }
+    }
+    ~server_prefill_reuse_scope() {
+        if (ctx) { ctx->set_graph_variant_reuse_only(previous); }
+    }
+    server_prefill_reuse_scope(const server_prefill_reuse_scope &) = delete;
+    server_prefill_reuse_scope & operator=(const server_prefill_reuse_scope &) = delete;
+
+private:
+    Context * ctx = nullptr;
+    bool previous = false;
+};
