+static void test_prompt_response_materialization(testing & t) {
+    task_params params;
+    t.assert_true("native default retains echoed prompt", params.needs_prompt());
+    params.response_fields = {"content", "stop", "stop_type", "timings", "completion_probabilities", "prompt_progress"};
+    t.assert_true("internal completion excludes unused prompt", !params.needs_prompt());
+    params.response_fields.push_back("prompt");
+    t.assert_true("explicit prompt preserved", params.needs_prompt());
+    params.response_fields = {"prompt/unknown"};
+    t.assert_true("nested prompt selector stays conservative", params.needs_prompt());
+    params.response_fields.clear();
+    for (const auto type : {TASK_RESPONSE_TYPE_OAI_CMPL, TASK_RESPONSE_TYPE_OAI_CHAT,
+            TASK_RESPONSE_TYPE_OAI_RESP, TASK_RESPONSE_TYPE_OAI_ASR, TASK_RESPONSE_TYPE_ANTHROPIC}) {
+        params.res_type = type;
+        t.assert_true("compatibility protocols never emit native prompt field", !params.needs_prompt());
+    }
+}
