+    t.assert_equal("projector text prefix size", (size_t) 3, text.size_up_to_pos(3));
+    t.assert_equal("projector text end", (size_t) 5, text.size_up_to_pos(5));
+    t.assert_equal("projector text past end", (size_t) 5, text.size_up_to_pos(100));
+    server_tokens empty(llama_tokens{}, true);
+    t.assert_equal("projector empty", (size_t) 0, empty.size_up_to_pos(0));
 }
 
