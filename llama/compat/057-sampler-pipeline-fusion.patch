+
+// Internal inference primitive. diff is the existing rounded CDF-uniform
+// F32 vector, with 1..1024 entries. Optional I32 candidates have the same
+// shape. The scalar result exactly composes STEP/SUM/CLAMP/index/gather.
+// It adds no random draw, floating reduction, device workspace or in-place use.
+// Mapped nodes store candidates before diff to preserve the old dependency order;
+// construction never expands the caller's graph or makes unused outputs live.
+GGML_API struct ggml_tensor * ggml_dist_select(
+        struct ggml_context * ctx,
+        struct ggml_tensor * diff,
+        struct ggml_tensor * candidates);
+
+#ifdef __cplusplus
+}
+#endif
