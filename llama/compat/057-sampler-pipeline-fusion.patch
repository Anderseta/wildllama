+    if (!value) { throw std::runtime_error(message); }
+}
+
+static void same(float a, float b) {
+    if (std::isnan(a) && std::isnan(b)) { return; }
+    require(std::memcmp(&a, &b, sizeof(a)) == 0, "sampler probability bits differ");
+}
+
+struct fusion_switch {
+    bool had;
+    std::string old;
+    static int set(const char * value) {
+#ifdef _WIN32
+        return _putenv_s("WILDLLAMA_DIST_TAIL_FUSION", value ? value : "");
+#else
+        return value ? setenv("WILDLLAMA_DIST_TAIL_FUSION", value, 1) : unsetenv("WILDLLAMA_DIST_TAIL_FUSION");
+#endif
+    }
+    explicit fusion_switch(const char * value) {
+        const char * before = std::getenv("WILDLLAMA_DIST_TAIL_FUSION");
+        had = before != nullptr;
+        if (before) { old = before; }
+        require(set(value) == 0, "could not set isolated draw-tail control");
+    }
+    ~fusion_switch() { set(had ? old.c_str() : nullptr); }
+};
+
+// The literal pre-057 composition. Keep the actual rounded subtraction outside
+// this function: fusion only replaces this integer-equivalent selection tail.
+static ggml_tensor * legacy_tail(ggml_context * ctx, ggml_tensor * diff, ggml_tensor * candidates) {
+    auto * mask = ggml_step(ctx, diff);
+    auto * count = ggml_clamp(ctx, ggml_sum(ctx, mask), 1.0f, float(diff->ne[0]));
+    auto * index = ggml_cast(ctx, ggml_scale_bias(ctx, count, -1.0f, float(diff->ne[0])), GGML_TYPE_I32);
+    return candidates ? ggml_get_rows(ctx, ggml_reshape_2d(ctx, candidates, 1, candidates->ne[0]), index) : index;
+}
+
+struct draw_graph {
+    ggml_context_ptr ctx{ggml_init({2*1024*1024, nullptr, true})};
+    ggml_gallocr_ptr alloc;
+    ggml_cgraph * graph;
+    ggml_tensor * input;
+    ggml_tensor * uniform = nullptr;
+    ggml_tensor * candidates = nullptr;
+    ggml_tensor * probs = nullptr;
+    ggml_tensor * output;
+    size_t bytes;
+
+    draw_graph(ggml_backend_t backend, int n, bool mapped, bool full, bool fused)
+        : alloc(ggml_gallocr_new(ggml_backend_get_default_buffer_type(backend))) {
+        require(bool(ctx), "draw metadata allocation failed");
+        graph = ggml_new_graph_custom(ctx.get(), 128, false);
+        input = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, n);
+        ggml_set_input(input); ggml_set_output(input);
+        auto * diff = input;
+        if (full) {
+            uniform = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 1);
+            ggml_set_input(uniform); ggml_set_output(uniform);
+            probs = ggml_soft_max(ctx.get(), input);
+            ggml_set_output(probs);
+            diff = ggml_sub(ctx.get(), ggml_cumsum(ctx.get(), probs), uniform);
+        }
+        if (mapped) {
+            candidates = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I32, n);
+            ggml_set_input(candidates); ggml_set_output(candidates);
+        }
+        output = fused ? ggml_dist_select(ctx.get(), diff, candidates) : legacy_tail(ctx.get(), diff, candidates);
+        ggml_set_output(output);
+        ggml_build_forward_expand(graph, output);
+        if (probs) { ggml_build_forward_expand(graph, probs); }
+        for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+            require(ggml_backend_supports_op(backend, ggml_graph_node(graph, i)), "draw-tail fixture op unsupported");
+        }
+        require(ggml_gallocr_alloc_graph(alloc.get(), graph), "draw-tail allocation failed");
+        bytes = ggml_gallocr_get_buffer_size(alloc.get(), 0);
+        require(bytes < 1024*1024, "draw-tail fixture escaped bounded memory");
+        require(output->data != input->data && (!candidates || output->data != candidates->data), "selection overwrote a live input");
+    }
+
+    void set(const std::vector<float> & values, const std::vector<int32_t> & ids, float rnd) {
+        ggml_backend_tensor_set(input, values.data(), 0, values.size()*sizeof(float));
+        if (uniform) { ggml_backend_tensor_set(uniform, &rnd, 0, sizeof(rnd)); }
+        if (candidates) { ggml_backend_tensor_set(candidates, ids.data(), 0, ids.size()*sizeof(int32_t)); }
+    }
+
+    int32_t run(ggml_backend_t backend) {
+        require(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "draw-tail compute failed");
+        int32_t value; ggml_backend_tensor_get(output, &value, 0, sizeof(value));
+        return value;
+    }
+};
