+static void capability(ggml_backend_t backend) {
+    ggml_context_ptr ctx(ggml_init({16*ggml_tensor_overhead(), nullptr, true}));
+    auto * diff = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 20);
+    auto * candidates = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I32, 20);
+    auto * selected = ggml_dist_select(ctx.get(), diff, candidates);
+    require(selected->src[0] == candidates && selected->src[1] == diff,"mapped selection dependency order changed");
+    require(!selected->data && !diff->data && !candidates->data, "capability probe allocated tensor storage");
+    require(ggml_backend_supports_op(backend, selected), "valid draw-tail capability rejected");
+    selected->src[0] = nullptr;
+    require(!ggml_backend_supports_op(backend,selected),"mapped draw with missing candidates admitted");
+    selected->src[0] = diff; selected->src[1] = candidates;
+    require(!ggml_backend_supports_op(backend,selected),"wrongly ordered mapped inputs admitted");
+    selected->src[0] = candidates; selected->src[1] = diff;
+    auto * unmapped = ggml_dist_select(ctx.get(),diff,nullptr);
+    require(unmapped->src[0] == diff && !unmapped->src[1] && ggml_backend_supports_op(backend,unmapped),
+            "unmapped selection dependency contract changed");
+    selected->type = GGML_TYPE_F32; selected->ne[0] = 20;
+    require(!ggml_backend_supports_op(backend, selected), "malformed pre-057 unknown-mode probe admitted");
+    selected->type = GGML_TYPE_I32; selected->ne[0] = 1;
+    selected->src[2] = diff;
+    require(!ggml_backend_supports_op(backend, selected), "extraneous draw input admitted");
+    selected->src[2] = nullptr;
+    candidates->ne[0] = 19;
+    require(!ggml_backend_supports_op(backend, selected), "mismatched candidate support admitted");
+    candidates->ne[0] = 20;
+    candidates->type = GGML_TYPE_F32;
+    require(!ggml_backend_supports_op(backend, selected), "noninteger candidate map admitted");
+    candidates->type = GGML_TYPE_I32;
+    const size_t old_stride = diff->nb[0]; diff->nb[0] *= 2;
+    require(!ggml_backend_supports_op(backend, selected), "strided diff admitted");
+    diff->nb[0] = old_stride;
+    diff->ne[1] = 2;
+    require(!ggml_backend_supports_op(backend, selected), "matrix diff admitted");
+    diff->ne[1] = 1;
+    diff->ne[0] = candidates->ne[0] = 1025;
+    require(!ggml_backend_supports_op(backend, selected), "oversized draw admitted");
+    diff->ne[0] = candidates->ne[0] = 0;
+    require(!ggml_backend_supports_op(backend, selected), "empty draw admitted");
+    diff->ne[0] = candidates->ne[0] = 20;
+    int32_t mode = 4; std::memcpy(selected->op_params + 1, &mode, sizeof(mode));
+    require(!ggml_backend_supports_op(backend, selected), "unknown mode admitted");
+    mode = 2; std::memcpy(selected->op_params + 1, &mode, sizeof(mode));
+    require(!ggml_backend_supports_op(backend, selected), "draw scalar admitted as top-p F32 mask");
+    std::puts("DIST_TAIL_CAPABILITY metadata_only=1 scalar_type=1 shape_guard=1 mode2_unchanged=1 unknown_mode=1 PASS");
+}
