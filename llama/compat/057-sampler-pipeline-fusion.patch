+// Complete the draw only after the ordinary rounded CDF-uniform subtraction.
+// No floating-point reduction, probability approximation or random draw is added.
+template<int threads>
+static __global__ void dist_select_kernel(const float * diff, const int32_t * candidates,
+        int32_t * output, int n) {
+    __shared__ int counts[threads];
+    int count = 0;
+    for (int i = threadIdx.x; i < n; i += threads) { count += diff[i] > 0.0f; }
+    counts[threadIdx.x] = count;
+    __syncthreads();
+    for (int stride = threads/2; stride > 0; stride /= 2) {
+        if (threadIdx.x < stride) { counts[threadIdx.x] += counts[threadIdx.x + stride]; }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        const int index = n - (counts[0] > 0 ? counts[0] : 1);
+        *output = candidates ? candidates[index] : index;
+    }
+}
+
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+static __global__ void dist_select_warp_kernel(const float * diff, const int32_t * candidates,
+        int32_t * output, int n) {
+    int count = 0;
+    for (int i = threadIdx.x; i < n; i += 32) { count += diff[i] > 0.0f; }
+    count = warp_reduce_sum<32>(count);
+    if (threadIdx.x == 0) {
+        const int index = n - (count > 0 ? count : 1);
+        *output = candidates ? candidates[index] : index;
+    }
+}
+
+static __global__ void dist_select_warps_kernel(const float * diff, const int32_t * candidates,
+        int32_t * output, int n) {
+    __shared__ int warp_counts[8];
+    const int lane = threadIdx.x % 32;
+    const int warp = threadIdx.x / 32;
+    int count = 0;
+    for (int i = threadIdx.x; i < n; i += 256) { count += diff[i] > 0.0f; }
+    count = warp_reduce_sum<32>(count);
+    if (lane == 0) { warp_counts[warp] = count; }
+    __syncthreads();
+    if (warp == 0) {
+        count = warp_reduce_sum<32>(lane < 8 ? warp_counts[lane] : 0);
+        if (lane == 0) {
+            const int index = n - (count > 0 ? count : 1);
+            *output = candidates ? candidates[index] : index;
+        }
+    }
+}
+#endif
