+    const int k = llama_sampler_leading_top_k(sampler->chain);
+    if (k <= 0 || k >= 128) { return false; }
+    if (sampler->raw_top_k_retry) {
+        --sampler->raw_top_k_retry;
+        return false;
+    }
+    const int n = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)));
+    if (n < 4096) { return false; }
+    if (!common_mtp_raw_top_k(output.raw_logits, n, k, sampler->cur)) {
+        if (++sampler->raw_top_k_misses == 3) {
+            sampler->raw_top_k_misses = 0;
+            sampler->raw_top_k_retry = 16;
+        }
+        return false;
+    }
+    sampler->raw_top_k_misses = 0;
+    sampler->cur_p = {sampler->cur.data(), sampler->cur.size(), -1, true};
+    ++sampler->candidate_rows;
+    return true;
+}
