+static bool try_raw_top_k(common_sampler * sampler, llama_context * ctx, const llama_sampler_output & output,
+                          bool grammar_active) {
+    if (!output.raw_logits || output.sampled_logits || output.sampled_probs || grammar_active ||
+            sampler->params.n_probs != 0 || common_reasoning_budget_get_state(sampler->rbudget) == REASONING_BUDGET_FORCING) {
+        return false;
