+#include "../common/ngram-feedback.h"
+#include <cstdio>
+#include <stdexcept>
+
+static void check(bool ok, const char * message) { if (!ok) { throw std::runtime_error(message); } }
+int main() {
+    common_ngram_feedback a, b;
+    std::vector<int32_t> text;
+    for (int repeat = 0; repeat < 6; ++repeat) {
+        for (int i = 10; i <= 30; ++i) { text.push_back(i); }
+    }
+    for (int i = 10; i < 15; ++i) { text.push_back(i); }
+    const auto draft = a.draft(text, 15, 3);
+    check(draft == std::vector<int32_t>({16,17,18}), "known continuation missing");
+    a.accept(0);
+    // Rejection feedback must survive append-only history; this suffix repeats
+    // before enough observations have accumulated to erase the rejection.
+    text.push_back(15);
+    for (int i = 10; i < 15; ++i) { text.push_back(i); }
+    const auto rejected = a.draft(text, 15, 3);
+    check(rejected.empty() || rejected.front() != 16, "refuted suffix repeated");
+    for (int repeat=0;repeat<8;++repeat) {
+        for (int i=15;i<=30;++i) { text.push_back(i); }
+        for (int i=10;i<15;++i) { text.push_back(i); }
+    }
+    check(a.draft(text, 15, 3).front() == 16, "new target observations did not rehabilitate a suffix");
+    check(b.draft(text, 15, 3).front() == 16, "feedback leaked between sequences");
+    b.accept(0, true);
+    check(b.draft(text, 15, 0).empty(), "zero budget ignored");
+    a.reset();
+    check(a.draft(text, 15, 1) == std::vector<int32_t>({16}), "reset did not clear feedback");
+    a.accept(100); // bounded feedback, including caller overshoot
+    check(a.draft({1,2,3}, 4, 8).empty(), "short history accepted");
+    check(sizeof(common_ngram_feedback) < 160*1024, "unbounded proposer footprint");
+    // Churn more contexts than the fixed table capacity. Collision checks must
+    // never return a continuation for a suffix absent from this history.
+    std::vector<int32_t> unique(20000);
+    for (size_t i=0;i<unique.size();++i) { unique[i]=int32_t(i+10000); }
+    a.reset();
+    check(a.draft(unique, 30000, 8).empty(), "hash collision became a match");
+    std::printf("PASS bounded ngram feedback (%zu bytes/sequence)\n", sizeof(a));
+}
