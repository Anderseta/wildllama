+        attrs[0].id = cudaLaunchAttributeAccessPolicyWindow;
+        attrs[0].val.accessPolicyWindow = mmvq_l2_window;
+        cudaLaunchConfig_t config{};
+        config.gridDim=p.block_nums; config.blockDim=p.block_dims;
+        config.dynamicSmemBytes=p.shmem; config.stream=p.stream;
+        config.attrs=attrs; config.numAttrs=1;
+#if defined(GGML_CUDA_USE_PDL)
+        static const bool pdl = [] { const char * v=std::getenv("GGML_CUDA_PDL"); return !v || std::atoi(v)!=0; }();
+        if (pdl && ggml_cuda_kernel_can_use_pdl(reinterpret_cast<const void *>(kernel))) {
+            attrs[1].id=cudaLaunchAttributeProgrammaticStreamSerialization;
+            attrs[1].val.programmaticStreamSerializationAllowed=1; config.numAttrs=2;
+        }
+#endif
+        CUDA_CHECK(cudaLaunchKernelEx(&config, kernel, std::forward<Args>(args)...));
+        return;
+    }
+    ggml_cuda_kernel_launch(kernel, p, std::forward<Args>(args)...);
+}
+#else
+void ggml_cuda_mmvq_l2_initialize(int) {}
+struct mmvq_l2_scope { mmvq_l2_scope(int, const void *, size_t) {} };
+template<typename Kernel, typename... Args>
+static void mmvq_kernel_launch(Kernel kernel, const ggml_cuda_kernel_launch_params & p, Args&&... args) {
+    ggml_cuda_kernel_launch(kernel, p, std::forward<Args>(args)...);
+}
+#endif
