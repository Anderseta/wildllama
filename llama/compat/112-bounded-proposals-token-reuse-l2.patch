diff --git a/common/ngram-feedback.h b/common/ngram-feedback.h
new file mode 100644
index 0000000000000000000000000000000000000000..b3aa6350c0857074a5b859c2b683861b33f4f571
--- /dev/null
+++ b/common/ngram-feedback.h
@@ -0,0 +1,110 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// A request-owned, bounded proposer. Hash collisions are checked against the
+// complete suffix. Only the target's accepted history trains the table; every
+// proposal still goes through the existing target sampler and rollback path.
+class common_ngram_feedback {
+    static constexpr size_t slots = 2048;
+    static constexpr size_t max_draft = 8;
+    struct entry {
+        std::array<int32_t, 5> key{};
+        int32_t token[2] = {-1, -1};
+        uint8_t count[2] = {};
+        int16_t score[2] = {};
+        uint8_t length = 0;
+    };
+    struct pending { size_t slot; int32_t token; std::array<int32_t, 5> key; uint8_t length; };
+    std::array<entry, slots> table{};
+    std::array<pending, max_draft> proposed{};
+    size_t observed = 0;
+    size_t proposed_count = 0;
+
+    static size_t hash(const int32_t * key, size_t n) {
+        uint64_t h = 1469598103934665603ULL ^ n;
+        for (size_t i = 0; i < n; ++i) { h = (h ^ uint32_t(key[i])) * 1099511628211ULL; }
+        return size_t(h ^ (h >> 32)) & (slots - 1);
+    }
+    static bool matches(const entry & e, const int32_t * key, size_t n) {
+        return e.length == n && std::equal(key, key + n, e.key.begin());
+    }
+    void learn(const int32_t * key, size_t n, int32_t token) {
+        auto & e = table[hash(key, n)];
+        if (!matches(e, key, n)) {
+            e = {}; e.length = uint8_t(n);
+            std::copy(key, key + n, e.key.begin());
+        }
+        if (e.count[0] >= 128 || e.count[1] >= 128) {
+            for (auto & c : e.count) { c = uint8_t((c + 1) / 2); }
+            for (auto & s : e.score) { s /= 2; }
+        }
+        int k = e.token[0] == token ? 0 : e.token[1] == token ? 1 : -1;
+        if (k < 0) {
+            k = e.count[0] <= e.count[1] ? 0 : 1;
+            e.token[k] = token; e.count[k] = 0; e.score[k] = 0;
+        }
+        ++e.count[k];
+        // New target-confirmed occurrences can rehabilitate a rejected guess.
+        if (e.score[k] < 0) { e.score[k] = int16_t(std::min(0, int(e.score[k]) + 2)); }
+    }
+public:
+    void reset() { table = {}; observed = proposed_count = 0; }
+
+    std::vector<int32_t> draft(const std::vector<int32_t> & history, int32_t sampled, size_t limit) {
+        proposed_count = 0;
+        if (!limit || history.size() < 5) { return {}; }
+        if (history.size() < observed) { reset(); }
+        // No history copy or unbounded dictionary. Initial ingestion is O(n).
+        for (size_t i = std::max<size_t>(2, observed); i < history.size(); ++i) {
+            for (size_t n = 2; n <= std::min<size_t>(5, i); ++n) {
+                learn(history.data() + i - n, n, history[i]);
+            }
+        }
+        observed = history.size() + 1; // sampled is the next committed history token
+        for (size_t n = 2; n <= 5; ++n) { learn(history.data() + history.size() - n, n, sampled); }
+        std::array<int32_t, 5 + max_draft> tail{};
+        std::copy(history.end() - 4, history.end(), tail.begin()); tail[4] = sampled;
+        std::vector<int32_t> result;
+        limit = std::min(limit, max_draft);
+        result.reserve(limit);
+        for (size_t d = 0; d < limit; ++d) {
+            bool found = false;
+            for (size_t n = 5; n >= 2; --n) {
+                const int32_t * key = tail.data() + 5 + d - n;
+                const size_t idx = hash(key, n);
+                const auto & e = table[idx];
+                if (!matches(e, key, n)) { continue; }
+                const int k = int(e.count[1]) * 4 + e.score[1] > int(e.count[0]) * 4 + e.score[0] ? 1 : 0;
+                // Rejected alternatives are retried only after new observations
+                // change the balance. Short contexts need stronger consensus.
+                if (e.score[k] < -8) { proposed_count = result.size(); return result; }
+                if (e.token[k] < 0 || e.count[k] < (n < 4 ? 3 : 1) ||
+                    e.count[k] < 2 * e.count[1-k]) { continue; }
+                proposed[d] = {idx, e.token[k], e.key, e.length};
+                result.push_back(e.token[k]); tail[5+d] = e.token[k];
+                found = true; break;
+            }
+            if (!found) { break; }
+        }
+        proposed_count = result.size();
+        return result;
+    }
+
+    void accept(size_t accepted, bool other = false) {
+        if (!other) {
+            for (size_t i = 0; i < proposed_count && i <= accepted; ++i) {
+                const auto & p = proposed[i]; auto & e = table[p.slot];
+                if (!matches(e, p.key.data(), p.length)) { continue; }
+                const int k = e.token[0] == p.token ? 0 : e.token[1] == p.token ? 1 : -1;
+                if (k < 0) { continue; }
+                e.score[k] = int16_t(std::clamp(int(e.score[k]) + (i < accepted ? 4 : -16), -64, 64));
+            }
+        }
+        proposed_count = 0;
+    }
+};
