+++ b/ggml/src/ggml-cuda/token-reuse.cuh
@@ -0,0 +1,32 @@
+#pragma once
+
+// Same packed Q4_K bytes and the same per-column scalar dot/reduction sequence.
+// Only weight unpacking is shared; no model conversion or persistent scratch.
+template<int columns>
+static __device__ __forceinline__ void vec_dot_q4_K_q8_1_columns(
+        const block_q4_K * weight, const block_q8_1 * input, uint32_t stride,
+        int iqs, float (&dots)[columns]) {
+    const int offset = QR4_K * ((iqs/2) / (QI8_1/2));
+    const int * q4 = (const int *)(weight->qs + 16*offset + 4*((iqs/2)%4));
+    const int v[2] = {q4[0], q4[4]};
+    const uint16_t * scales = (const uint16_t *)weight->scales;
+    const int j = offset/2, jm = j & 1;
+    const uint32_t s0 = scales[jm], s2 = scales[jm+2], s4 = scales[jm+4];
+    const uint32_t hi = uint32_t(-int32_t(j >= 2));
+    uint16_t aux[2];
+    aux[0] = uint16_t(((s0 & 0x3f3f) & ~hi) | (((s4 & 0x0f0f) | ((s0 & 0xc0c0) >> 2)) & hi));
+    aux[1] = uint16_t(((s2 & 0x3f3f) & ~hi) | ((((s4 >> 4) & 0x0f0f) | ((s2 & 0xc0c0) >> 2)) & hi));
+    const uint8_t * sc = (const uint8_t *)aux;
+#pragma unroll
+    for (int c = 0; c < columns; ++c) {
+        int u[2*QR4_K]; float d8[QR4_K];
+#pragma unroll
+        for (int i = 0; i < QR4_K; ++i) {
+            const auto & a = input[c*stride + offset + i];
+            d8[i] = __low2float(a.ds);
+            const int * q8 = (const int *)a.qs + ((iqs/2)%4);
+            u[2*i] = q8[0]; u[2*i+1] = q8[4];
+        }
+        dots[c] = vec_dot_q4_K_q8_1_impl_vmmq(v, u, sc, sc+2, weight->dm, d8);
+    }
+}
