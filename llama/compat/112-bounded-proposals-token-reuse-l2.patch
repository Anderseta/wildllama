index 0000000000000000000000000000000000000000..1e80ac21ca90b2457cf0085ffd9d109c2a105d42
--- /dev/null
+++ b/tests/test-cuda-token-reuse.cu
@@ -0,0 +1,134 @@
+#define GGML_CUDA_MMVQ_KERNELS_ONLY
+#include "../ggml/src/ggml-cuda/mmvq.cu"
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+
+[[noreturn]] void ggml_cuda_error(const char * s,const char *,const char *,int,const char * message) {
+    throw std::runtime_error(std::string(s)+": "+message);
+}
+static void check(bool ok,const char * message) { if (!ok) { throw std::runtime_error(message); } }
+template<class T> struct gpu {
+    T * p=nullptr;
+    gpu(size_t n) { CUDA_CHECK(cudaMalloc((void **)&p,n*sizeof(T))); }
+    ~gpu() { if (p) { cudaFree(p); } }
+};
+static uint32_t random_value(uint32_t & s) { s^=s<<13; s^=s>>17; s^=s<<5; return s; }
+
+template<ggml_type type,int cols,bool head=false> static void run_case(bool dense,int route_pattern,bool bench,int rows=513) {
+    using block=std::conditional_t<type==GGML_TYPE_Q4_K,block_q4_K,block_iq3_s>;
+    constexpr int k=head?5120:2048,experts=4,ranks=2;
+    const int n_experts=dense?1:experts, n_ranks=dense?1:ranks;
+    const int y_channels=dense?1:(route_pattern==2?ranks:1);
+    std::vector<block> weights(n_experts*rows*(k/256));
+    std::vector<block_q8_1> inputs(cols*y_channels*(k/32));
+    uint32_t seed=42;
+    for (auto & w:weights) {
+        auto * bytes=reinterpret_cast<uint8_t *>(&w);
+        for (size_t j=0;j<sizeof(w);++j) { bytes[j]=uint8_t(random_value(seed)); }
+        if constexpr(type==GGML_TYPE_Q4_K) { w.dm=__floats2half2_rn(.02f,.003f); }
+        else { w.d=__float2half(.02f); }
+    }
+    for (auto & a:inputs) {
+        int sum=0; for(auto & q:a.qs) { q=int8_t(int(random_value(seed)%255)-127); sum+=q; }
+        a.ds=__floats2half2_rn(.01f,sum*.01f);
+    }
+    // Include noncontiguous ID rows and nonzero guard columns in every test.
+    constexpr int id_stride=5;
+    std::vector<int32_t> ids(cols*id_stride,0);
+    for(int t=0;t<cols;++t) { for(int r=0;r<n_ranks;++r) {
+        ids[t*id_stride+r]=(r+(route_pattern==1?t:route_pattern==2?t/2:0))%experts;
+    } }
+    gpu<block> w(weights.size()); gpu<block_q8_1> x(inputs.size()); gpu<int32_t> indices(ids.size());
+    const int out_stride=rows+7, out_size=out_stride*n_ranks*cols;
+    gpu<float> out(out_size);
+    CUDA_CHECK(cudaMemcpy(w.p,weights.data(),weights.size()*sizeof(block),cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaMemcpy(x.p,inputs.data(),inputs.size()*sizeof(block_q8_1),cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaMemcpy(indices.p,ids.data(),ids.size()*sizeof(int32_t),cudaMemcpyHostToDevice));
+    cudaStream_t stream; CUDA_CHECK(cudaStreamCreateWithFlags(&stream,cudaStreamNonBlocking));
+    const auto launch=[&](auto enabled) {
+        constexpr bool reuse=decltype(enabled)::value;
+        if constexpr (head) {
+            mul_mat_vec_q4_head_warp<cols,reuse><<<dim3((rows+3)/4),dim3(32,4),0,stream>>>(w.p,x.p,out.p,rows);
+        } else if(dense) {
+            if constexpr(type==GGML_TYPE_Q4_K) {
+                constexpr int nw=calc_nwarps(type,cols,MMVQ_PARAMETERS_GENERIC);
+                constexpr int rpb=calc_rows_per_block(type,cols,MMVQ_PARAMETERS_GENERIC,false,nw);
+                mul_mat_vec_q<type,cols,false,false,false,false,false,mmvq_iq3_layout::canonical,reuse>
+                    <<<dim3((rows+rpb-1)/rpb),dim3(32,nw),0,stream>>>(
+                    w.p,x.p,nullptr,ggml_cuda_mm_fusion_args_device{},out.p,k,init_fastdiv_values(1),
+                    k/256,k/32,out_stride,init_fastdiv_values(1),rows*(k/256),k/32,out_stride,
+                    init_fastdiv_values(1),rows*(k/256),k/32,out_stride,0,rows);
+            }
+        } else {
+            mul_mat_vec_q_moe<type,2,false,reuse><<<dim3((rows+1)/2,n_ranks),dim3(32,cols),0,stream>>>(
+                w.p,x.p,indices.p,ggml_cuda_mm_fusion_args_device{},out.p,k,init_fastdiv_values(y_channels),rows,
+                k/256,y_channels*(k/32),n_ranks*out_stride,rows*(k/256),k/32,out_stride,cols,id_stride);
+        }
+        CUDA_CHECK(cudaGetLastError());
+    };
+    std::vector<float> baseline(out_size),candidate(out_size);
+    CUDA_CHECK(cudaMemsetAsync(out.p,0xff,out_size*sizeof(float),stream));
+    launch(std::false_type{}); CUDA_CHECK(cudaStreamSynchronize(stream));
+    CUDA_CHECK(cudaMemcpy(baseline.data(),out.p,out_size*sizeof(float),cudaMemcpyDeviceToHost));
+    CUDA_CHECK(cudaMemsetAsync(out.p,0xff,out_size*sizeof(float),stream));
+    launch(std::true_type{}); CUDA_CHECK(cudaStreamSynchronize(stream));
+    CUDA_CHECK(cudaMemcpy(candidate.data(),out.p,out_size*sizeof(float),cudaMemcpyDeviceToHost));
+    check(std::memcmp(baseline.data(),candidate.data(),out_size*sizeof(float))==0,"token reuse changed output bits or guards");
+    for(int t=0;t<cols;++t) { for(int r=0;r<n_ranks;++r) { for(int row=0;row<rows;++row) {
+        check(std::isfinite(candidate[head?t*rows+row:(t*n_ranks+r)*out_stride+row]),"nonfinite or unwritten output");
+    } } }
+    if(bench) {
+        cudaGraph_t graph[2]{}; cudaGraphExec_t exec[2]{}; cudaEvent_t a,b;
+        CUDA_CHECK(cudaEventCreate(&a)); CUDA_CHECK(cudaEventCreate(&b));
+        for(int opt=0;opt<2;++opt) {
+            CUDA_CHECK(cudaStreamBeginCapture(stream,cudaStreamCaptureModeThreadLocal));
+            for(int n=0;n<100;++n) { if(opt) { launch(std::true_type{}); } else { launch(std::false_type{}); } }
+            CUDA_CHECK(cudaStreamEndCapture(stream,&graph[opt]));
+            CUDA_CHECK(cudaGraphInstantiate(&exec[opt],graph[opt],nullptr,nullptr,0));
+            CUDA_CHECK(cudaGraphLaunch(exec[opt],stream)); CUDA_CHECK(cudaStreamSynchronize(stream));
+        }
+        std::vector<float> times[2];
+        for(int repeat=0;repeat<8;++repeat) { for(int j=0;j<2;++j) {
+            const int opt=j^(repeat&1); float ms;
+            CUDA_CHECK(cudaEventRecord(a,stream)); CUDA_CHECK(cudaGraphLaunch(exec[opt],stream));
+            CUDA_CHECK(cudaEventRecord(b,stream)); CUDA_CHECK(cudaEventSynchronize(b));
+            CUDA_CHECK(cudaEventElapsedTime(&ms,a,b)); times[opt].push_back(ms/100);
+        } }
+        for(auto & t:times) { std::sort(t.begin(),t.end()); }
+        std::printf("TOKEN_REUSE type=%d dense=%d head=%d rows=%d tokens=%d route=%d baseline_ms=%.6f candidate_ms=%.6f ratio=%.4f exact=1\n",
+            int(type),dense,head,rows,cols,route_pattern,times[0][4],times[1][4],times[1][4]/times[0][4]);
+        for(int opt=0;opt<2;++opt) { cudaGraphExecDestroy(exec[opt]);cudaGraphDestroy(graph[opt]); }
+        cudaEventDestroy(a);cudaEventDestroy(b);
+    }
+    CUDA_CHECK(cudaStreamDestroy(stream));
+}
+template<int n> static void cases(bool bench) {
+    run_case<GGML_TYPE_Q4_K,n>(true,0,bench);
+    for(int route=0;route<3;++route) {
+        run_case<GGML_TYPE_Q4_K,n>(false,route,bench);
+        run_case<GGML_TYPE_IQ3_S,n>(false,route,bench);
+    }
+}
+int main(int argc,char **) {
+    try {
+        cases<1>(argc>1);cases<2>(argc>1);cases<3>(argc>1);cases<4>(argc>1);cases<8>(argc>1);
+        run_case<GGML_TYPE_Q4_K,2,true>(true,0,argc>1);
+        run_case<GGML_TYPE_Q4_K,3,true>(true,0,argc>1);
+        if (argc>1) {
+            for (int route=0;route<2;++route) {
+                run_case<GGML_TYPE_Q4_K,4>(false,route,true,8193);
+                run_case<GGML_TYPE_IQ3_S,4>(false,route,true,8193);
+                run_case<GGML_TYPE_Q4_K,8>(false,route,true,8193);
+                run_case<GGML_TYPE_IQ3_S,8>(false,route,true,8193);
+            }
+            run_case<GGML_TYPE_Q4_K,3>(true,0,true,65537);
+            run_case<GGML_TYPE_Q4_K,2,true>(true,0,true,248320);
+            run_case<GGML_TYPE_Q4_K,3,true>(true,0,true,248320);
+        }
+        std::printf("PASS %d dense/MoE token-reuse cases, bitwise equality and output guards\n",argc>1?48:37);return 0;
+    } catch(const std::exception & e) { std::fprintf(stderr,"FAIL %s\n",e.what());return 1; }
+}
