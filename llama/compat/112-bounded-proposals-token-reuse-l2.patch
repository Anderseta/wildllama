+static bool mmvq_token_reuse_enabled() {
+    static const bool enabled = mmvq_feature("WILDLLAMA_CUDA_TOKEN_REUSE");
+    return enabled;
+}
+
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA) && CUDART_VERSION >= 12000
+static std::atomic<size_t> mmvq_l2_capacity[GGML_CUDA_MAX_DEVICES]{};
+static thread_local cudaAccessPolicyWindow mmvq_l2_window{};
+
+void ggml_cuda_mmvq_l2_initialize(int device) {
+    static const bool enabled = mmvq_feature("WILDLLAMA_CUDA_L2_REUSE");
+    if (!enabled || device < 0 || device >= GGML_CUDA_MAX_DEVICES) { return; }
+    static std::mutex mutex;
+    static bool tried[GGML_CUDA_MAX_DEVICES]{};
+    std::lock_guard<std::mutex> lock(mutex);
+    if (tried[device]) { return; }
+    tried[device] = true;
+    int previous = 0;
+    CUDA_CHECK(cudaGetDevice(&previous));
+    CUDA_CHECK(cudaSetDevice(device));
+    cudaDeviceProp prop{};
+    CUDA_CHECK(cudaGetDeviceProperties(&prop, device));
+    const size_t limit = std::min<size_t>({size_t(std::max(0, prop.persistingL2CacheMaxSize)),
+                                         size_t(std::max(0, prop.l2CacheSize))/16, 1024*1024});
+    if (limit && prop.accessPolicyMaxWindowSize > 0) {
+        size_t existing = 0;
+        cudaError_t status = cudaDeviceGetLimit(&existing, cudaLimitPersistingL2CacheSize);
+        if (status == cudaSuccess && existing < limit) { status = cudaDeviceSetLimit(cudaLimitPersistingL2CacheSize, limit); }
+        if (status == cudaSuccess) {
+            mmvq_l2_capacity[device].store(std::min(limit, size_t(prop.accessPolicyMaxWindowSize)));
+            GGML_LOG_INFO("cuda_l2: bounded activation reuse enabled (%zu KiB L2, no VRAM allocation)\n", limit/1024);
+        } else {
+            GGML_LOG_INFO("cuda_l2: policy unavailable; retaining normal accesses (%s)\n", cudaGetErrorString(status));
+            (void)cudaGetLastError();
+        }
+    }
+    CUDA_CHECK(cudaSetDevice(previous));
+}
+
+struct mmvq_l2_scope {
+    cudaAccessPolicyWindow previous;
+    mmvq_l2_scope(int device, const void * ptr, size_t bytes) : previous(mmvq_l2_window) {
+        const size_t budget = mmvq_l2_capacity[device].load(std::memory_order_relaxed);
+        mmvq_l2_window = {};
+        if (budget && ptr && bytes) {
+            mmvq_l2_window.base_ptr = const_cast<void *>(ptr);
+            mmvq_l2_window.num_bytes = std::min(bytes, budget);
+            mmvq_l2_window.hitRatio = 1.0f;
+            mmvq_l2_window.hitProp = cudaAccessPropertyPersisting;
+            mmvq_l2_window.missProp = cudaAccessPropertyStreaming;
+        }
+    }
+    ~mmvq_l2_scope() { mmvq_l2_window = previous; }
+};
+
+template<typename Kernel, typename... Args>
