+namespace {
+class llm_graph_input_draft_vocab final : public llm_graph_input_i {
+public:
+    const llama_draft_vocab * vocab;
+    ggml_tensor * ids;
+    explicit llm_graph_input_draft_vocab(const llama_draft_vocab * vocab, ggml_tensor * ids) : vocab(vocab), ids(ids) {}
+    void set_input(const llama_ubatch *) override {
+        GGML_ASSERT(vocab && vocab->ids.size() == size_t(ids->ne[0]));
+        // Inputs can share scheduler storage with other graph variants. Refresh
+        // even unchanged IDs after a variant switch or compute-arena reuse.
+        ggml_backend_tensor_set(ids, vocab->ids.data(), 0, vocab->ids.size()*sizeof(int32_t));
+    }
+    bool can_reuse(const llm_graph_params & params) override {
+        return params.draft_vocab == vocab && params.draft_vocab_size == size_t(ids->ne[0]);
+    }
+};
+}
+
+ggml_tensor * llm_graph_context::build_mtp_head(ggml_tensor * w, ggml_tensor * cur, ggml_tensor * scale) const {
+    if (!draft_vocab || draft_vocab->ids.empty() || cparams.ctx_type != LLAMA_CONTEXT_TYPE_MTP ||
+        n_outputs != 1 || n_tokens != 1 || ubatch.n_seqs_unq != 1 ||
+        !loras->empty() || hdmd || scale || w->type != GGML_TYPE_Q4_K ||
+        !ggml_is_contiguous(w) || !ggml_is_matrix(w)) {
+        return build_lora_mm(w, cur, scale);
+    }
+    const int64_t selected = int64_t(draft_vocab->ids.size());
+    auto * ids = ggml_new_tensor_2d(ctx0, GGML_TYPE_I32, selected, 1);
+    ggml_set_input(ids); ggml_set_name(ids, "mtp_draft_vocab_ids");
+
+    auto head = llama_build_indexed_head(ctx0, w, cur, ids);
+    if (prec_policy) {
+        for (auto * operation : head.operations) {
+            if (operation->op == GGML_OP_MUL_MAT_ID) { prec_policy->apply(operation); }
+        }
+    }
+
+    auto * device = w->buffer ? ggml_backend_buft_get_device(ggml_backend_buffer_get_type(w->buffer)) : nullptr;
+    ggml_backend_t backend = nullptr;
+    for (int i = 0; i < ggml_backend_sched_get_n_backends(sched); ++i) {
+        auto * candidate = ggml_backend_sched_get_backend(sched, i);
+        if (ggml_backend_get_device(candidate) == device) { backend = candidate; break; }
+    }
+    if (!backend) { return build_lora_mm(w, cur, scale); }
+    for (auto * operation : head.operations) {
+        if (!ggml_backend_supports_op(backend, operation)) { return build_lora_mm(w, cur, scale); }
+    }
+    for (auto * operation : head.operations) { ggml_backend_sched_set_tensor_backend(sched, operation, backend); }
+    ggml_backend_sched_set_tensor_backend(sched, ids, backend);
+    res->add_input(std::make_unique<llm_graph_input_draft_vocab>(draft_vocab, ids));
+    return head.logits;
+}
