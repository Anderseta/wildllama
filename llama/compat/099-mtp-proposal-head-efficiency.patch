@@ -0,0 +1,111 @@
+#include "../src/llama-draft-vocab.h"
+#include "../src/llama-draft-head.h"
+#include "../common/speculative.h"
+#include "ggml-cpp.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+
+static void require(bool value, const char * message) { if (!value) { throw std::runtime_error(message); } }
+
+static void policy() {
+    require(common_speculative_mtp_top_k(false,0.0f)==1, "greedy no-cutoff MTP did not simplify selection");
+    require(common_speculative_mtp_top_k(false,0.01f)==10, "confidence probabilities were reduced");
+    require(common_speculative_mtp_top_k(true,0.0f)==10, "rejection distribution was reduced");
+    require(common_speculative_mtp_top_k(false,NAN)==10, "invalid cutoff enabled reduced selection");
+    llama_draft_vocab v;
+    require(!v.reset(248320, 0) && !v.reset(248320, 255) && !v.reset(256,256), "invalid counts accepted");
+    require(!v.reset(248320,131073) && !v.reset(1048577,65536), "memory bounds ignored");
+    require(v.reset(248320,32768), "valid shortlist rejected");
+    const auto original = v.ids;
+    v.observe(-1); v.observe(248320); v.observe(0);
+    require(v.ids == original, "invalid/duplicate token changed shortlist");
+    for (int i = 0; i < 40000; ++i) { v.observe(140000+i); }
+    std::vector<int32_t> ids = v.ids; std::sort(ids.begin(),ids.end());
+    require(std::adjacent_find(ids.begin(),ids.end()) == ids.end(), "duplicate token mapping");
+    for (size_t i = 0; i < v.ids.size(); ++i) {
+        require(v.positions[size_t(v.ids[i])] == int32_t(i), "inconsistent inverse index");
+        if (i < v.stable) { require(v.ids[i] == int32_t(i), "stable vocabulary was evicted"); }
+    }
+    require(v.positions[140000] == -1 && v.positions[179999] >= 0, "recent-token eviction failed");
+    require(!v.reset(248320,-1) && v.ids.size()==32768, "invalid reset destroyed state");
+    require(v.reset(248320,65536) && v.positions[179999] == -1, "request reset leaked prior selection");
+    require(v.reset(1024,256), "small valid selection rejected");
+    std::vector<float> scores(1024, -INFINITY);
+    for (int i=500;i<900;++i) { scores[size_t(i)] = float(i%97); }
+    require(v.seed(scores.data(),scores.size()), "finite target seed rejected");
+    const auto seeded=v.ids;
+    for (int id:seeded) { require(id>=500 && id<900, "excluded target token included"); }
+    for (size_t i=1;i<seeded.size();++i) { require(scores[seeded[i-1]]>=scores[seeded[i]], "target rank lost"); }
+    scores[12]=NAN;
+    require(!v.seed(scores.data(),scores.size()) && v.ids==seeded, "NaN changed valid selection");
+    scores.assign(1024,-INFINITY);
+    require(!v.seed(scores.data(),scores.size()) && v.ids==seeded, "empty target seed changed state");
+    std::puts("PASS: bounded indices, deduplication, eviction, invalid input, request reset");
+}
+
+static void graph_case(ggml_backend_t backend, const char * path, bool large) {
+    gguf_context_ptr metadata(gguf_init_from_file(path,{true,nullptr}));
+    require(bool(metadata), "cannot read GGUF metadata");
+    const int64_t index = gguf_find_tensor(metadata.get(),"output.weight");
+    require(index>=0 && gguf_get_tensor_type(metadata.get(),index)==GGML_TYPE_Q4_K,"expected original Q4_K output head");
+    const int64_t k=large ? 256 : gguf_get_tensor_ne(metadata.get(),index)[0], rows=large ? 131073 : 4097, selected=large ? 131072 : 512;
+    require(k>0 && k<=8192 && gguf_get_tensor_ne(metadata.get(),index)[1]>=rows+17000,"unsupported fixture dimensions");
+    const size_t bytes=ggml_row_size(GGML_TYPE_Q4_K,k)*rows;
+    require(bytes<32*1024*1024,"fixture exceeds weight memory cap");
+    std::vector<unsigned char> weights(bytes);
+    std::ifstream file(path,std::ios::binary);
+    file.seekg(std::streamoff(gguf_get_data_offset(metadata.get())+gguf_get_tensor_offset(metadata.get(),index)+17000*ggml_row_size(GGML_TYPE_Q4_K,k)));
+    file.read(reinterpret_cast<char *>(weights.data()),bytes);
+    require(size_t(file.gcount())==bytes,"truncated head weight range");
+
+    ggml_context_ptr ctx(ggml_init({ggml_graph_overhead_custom(96,false)+96*ggml_tensor_overhead(),nullptr,true}));
+    auto * w=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_Q4_K,k,rows);
+    auto * input=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_F32,k,1);
+    auto * ids=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_I32,selected,1);
+    auto * full=ggml_mul_mat(ctx.get(),w,input);
+    auto head=llama_build_indexed_head(ctx.get(),w,input,ids);
+    auto * scattered=head.logits;
+    for (auto * operation:head.operations) { require(ggml_backend_supports_op(backend,operation),"backend unsupported"); }
+    auto * graph=ggml_new_graph_custom(ctx.get(),96,false);
+    ggml_build_forward_expand(graph,full); ggml_build_forward_expand(graph,scattered);
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(ctx.get(),backend));
+    require(bool(buffer),"cannot allocate bounded fixture");
+    ggml_backend_tensor_set(w,weights.data(),0,bytes);
+    std::vector<float> x(size_t(k),0),a(size_t(rows),0),b(size_t(rows),0);
+    std::vector<int32_t> mapping(size_t(selected),0);
+    for (int replay=0;replay<8;++replay) {
+        for(int64_t i=0;i<k;++i) { x[size_t(i)] = std::sin(float(i+replay*37)*.073f)*(replay+1); }
+        for(int64_t i=0;i<selected;++i) { mapping[size_t(i)] = int32_t((i*17+replay*131)%rows); }
+        ggml_backend_tensor_set(input,x.data(),0,x.size()*sizeof(float));
+        ggml_backend_tensor_set(ids,mapping.data(),0,mapping.size()*sizeof(int32_t));
+        require(ggml_backend_graph_compute(backend,graph)==GGML_STATUS_SUCCESS,"indexed graph failed");
+        ggml_backend_tensor_get(full,a.data(),0,a.size()*sizeof(float));
+        ggml_backend_tensor_get(scattered,b.data(),0,b.size()*sizeof(float));
+        std::vector<bool> seen(size_t(rows),false);
+        for(int32_t id:mapping) {
+            seen[size_t(id)]=true;
+            require(std::isfinite(a[size_t(id)]) && std::isfinite(b[size_t(id)]),"nonfinite selected logit");
+            require(std::memcmp(&a[size_t(id)],&b[size_t(id)],sizeof(float))==0,"indexed head changed selected logit bits");
+        }
+        for(int64_t i=0;i<rows;++i) { if(!seen[size_t(i)]) { require(b[size_t(i)]==-INFINITY,"stale/unselected proposal logit"); } }
+    }
+    std::printf("PASS: 8 CUDA graph replays, selected=%lld logits bitwise equal, excluded logits -inf; weights=%zu bytes\n",(long long)selected,bytes);
+}
+
+int main(int argc,char **argv) {
+    try {
+        policy();
+        if(argc==1) { return 0; }
+        require(argc==3,"Usage: test-mtp-draft-vocab [CUDA_BACKEND GGUF]");
+        auto * reg=ggml_backend_load(argv[1]); require(reg,"cannot load CUDA backend");
+        auto * device=ggml_backend_reg_dev_get(reg,0);
+        ggml_backend_ptr backend(ggml_backend_dev_init(device,nullptr)); require(bool(backend),"cannot initialize CUDA");
+        graph_case(backend.get(),argv[2],false); graph_case(backend.get(),argv[2],true);
+        return 0;
+    } catch(const std::exception &e) { std::fprintf(stderr,"FAIL: %s\n",e.what()); return 1; }
+}
