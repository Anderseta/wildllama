+bool llama_context::set_mtp_draft_vocab(int32_t count) {
+    if (!count) { mtp_draft_vocab_enabled = false; return true; }
+    // Measured implementation: a single CUDA-resident, unscaled Q4_K head.
+    // Preserve all other architectures, tensor splits and adapter semantics.
+    if (cparams.ctx_type != LLAMA_CONTEXT_TYPE_MTP || cparams.n_seq_max != 1 ||
+        (model.arch != LLM_ARCH_QWEN35 && model.arch != LLM_ARCH_QWEN35MOE) ||
+        model.ram_cache || !loras->empty() || !model.hdmd.rot.empty() || model.hparams.n_layer_nextn != 1) { return false; }
+    const auto & layer = model.layers[model.hparams.n_layer()];
+    auto * w = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : model.output;
+    auto * scale = layer.nextn.shared_head_head ? layer.nextn.shared_head_head_s : model.output_s;
+    if (!w || scale || !w->buffer || w->type != GGML_TYPE_Q4_K || !ggml_is_matrix(w) || !ggml_is_contiguous(w)) { return false; }
+    auto * buft = ggml_backend_buffer_get_type(w->buffer);
+    auto * device = ggml_backend_buft_get_device(buft);
+    if (!device || ggml_backend_dev_type(device) != GGML_BACKEND_DEVICE_TYPE_GPU ||
+        std::strcmp(ggml_backend_reg_name(ggml_backend_dev_backend_reg(device)), "CUDA") ||
+        buft != ggml_backend_dev_buffer_type(device)) { return false; }
+    try {
+        if (!mtp_draft_vocab.reset(model.vocab.n_tokens(), count)) { return false; }
+    } catch (const std::bad_alloc &) { return false; }
+    mtp_draft_vocab_enabled = true;
+    LLAMA_LOG_INFO("mtp_draft_vocab: %d/%d indexed proposal rows, original quantized weights shared\n", count, model.vocab.n_tokens());
+    return true;
+}
+
+bool llama_mtp_draft_vocab_seed(llama_context * ctx, const float * logits, size_t count) {
+    try { return ctx && ctx->mtp_draft_vocab_enabled && ctx->mtp_draft_vocab.seed(logits, count); }
+    catch (const std::bad_alloc &) { return false; }
+}
+
+void llama_mtp_draft_vocab_observe(llama_context * ctx, const llama_token * tokens, size_t count) {
+    if (ctx && ctx->mtp_draft_vocab_enabled && tokens) {
+        for (size_t i = 0; i < count; ++i) { ctx->mtp_draft_vocab.observe(tokens[i]); }
+    }
+}
+
+bool llama_set_mtp_draft_vocab(llama_context * ctx, int32_t count) {
+    return ctx && ctx->set_mtp_draft_vocab(count);
+}
