diff --git a/src/llama-draft-head.h b/src/llama-draft-head.h
new file mode 100644
index 0000000..23d803f
--- /dev/null
+++ b/src/llama-draft-head.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include "ggml.h"
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+struct llama_indexed_head_graph {
+    ggml_tensor * logits = nullptr;
+    std::vector<ggml_tensor *> operations;
+};
+
+// Quantized weights remain views of the original allocation. The output keeps
+// global vocabulary IDs so the existing sampler sees no local-ID remapping.
+inline llama_indexed_head_graph llama_build_indexed_head(
+        ggml_context * ctx, ggml_tensor * w, ggml_tensor * input, ggml_tensor * ids) {
+    GGML_ASSERT(w->type == GGML_TYPE_Q4_K && ggml_is_matrix(w) && ggml_is_contiguous(w));
+    GGML_ASSERT(input->ne[0] == w->ne[0] && ggml_nrows(input) == 1);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->ne[0] > 0 && ggml_nrows(ids) == 1);
+    llama_indexed_head_graph result;
+    auto * weights = ggml_reshape_3d(ctx, w, w->ne[0], 1, w->ne[1]);
+    auto * activation = ggml_reshape_3d(ctx, input, input->ne[0], 1, 1);
+    ggml_tensor * compact = nullptr;
+    // MMVQ maps selected rows to the Y grid dimension (CUDA maximum 65535).
+    for (int64_t offset = 0; offset < ids->ne[0]; offset += 32768) {
+        const int64_t count = std::min<int64_t>(32768, ids->ne[0] - offset);
+        auto * selected = ggml_view_2d(ctx, ids, count, 1, ids->nb[1], size_t(offset)*sizeof(int32_t));
+        auto * part = ggml_mul_mat_id(ctx, weights, activation, selected);
+        result.operations.push_back(part);
+        if (compact) {
+            compact = ggml_concat(ctx, compact, part, 1);
+            result.operations.push_back(compact);
+        } else { compact = part; }
+    }
+    auto * base = ggml_fill(ctx, ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, w->ne[1], 1), -INFINITY);
+    auto * scattered = ggml_set_rows(ctx, base, compact, ids);
+    result.operations.push_back(base); result.operations.push_back(scattered);
+    result.logits = ggml_reshape_2d(ctx, scattered, w->ne[1], 1);
+    return result;
+}
diff --git a/src/llama-draft-vocab.h b/src/llama-draft-vocab.h
new file mode 100644
index 0000000..90282d5
--- /dev/null
+++ b/src/llama-draft-vocab.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cmath>
+#include <numeric>
+#include <vector>
+
+// A bounded proposal vocabulary. It never changes the target vocabulary or
+// tokenizer. The stable BPE prefix is augmented by recently observed tokens,
+// including prompt/control tokens outside the prefix. No weight copies.
+struct llama_draft_vocab {
+    std::vector<int32_t> ids;
+    std::vector<int32_t> positions;
+    size_t cursor = 0;
+    size_t stable = 0;
+
+    bool reset(int32_t vocab, int32_t count) {
+        if (count < 256 || count > 131072 || count >= vocab || vocab > 1048576) { return false; }
+        std::vector<int32_t> next_ids(size_t(count), 0);
+        std::vector<int32_t> next_positions(size_t(vocab), -1);
+        std::iota(next_ids.begin(), next_ids.end(), 0);
+        std::iota(next_positions.begin(), next_positions.begin() + count, 0);
+        ids.swap(next_ids); positions.swap(next_positions);
+        stable = ids.size()*3/4; cursor = stable;
+        return true;
+    }
+
+    void observe(int32_t token) {
+        if (ids.empty() || token < 0 || size_t(token) >= positions.size() || positions[size_t(token)] >= 0) { return; }
+        positions[size_t(ids[cursor])] = -1;
+        ids[cursor] = token; positions[size_t(token)] = int32_t(cursor);
+        if (++cursor == ids.size()) { cursor = stable; }
+    }
+
+    // Reuse already materialized target logits; this never runs another head
+    // or downloads a full GPU output solely to choose proposal candidates.
+    bool seed(const float * scores, size_t count) {
+        if (!scores || ids.empty() || count != positions.size()) { return false; }
+        std::vector<int32_t> ranking;
+        ranking.reserve(count);
+        for (size_t i = 0; i < count; ++i) {
+            if (std::isnan(scores[i]) || scores[i] == INFINITY) { return false; }
+            if (std::isfinite(scores[i])) { ranking.push_back(int32_t(i)); }
+        }
+        if (ranking.size() < ids.size()) { return false; }
+        const auto better = [scores](int32_t a, int32_t b) {
+            return scores[a] > scores[b] || (scores[a] == scores[b] && a < b);
+        };
+        if (ranking.size() > ids.size()) { std::nth_element(ranking.begin(), ranking.begin()+ids.size(), ranking.end(), better); }
+        ranking.resize(ids.size());
+        std::sort(ranking.begin(), ranking.end(), better);
+        std::fill(positions.begin(), positions.end(), -1);
+        ids.swap(ranking);
+        for (size_t i = 0; i < ids.size(); ++i) { positions[size_t(ids[i])] = int32_t(i); }
+        cursor = stable;
+        return true;
+    }
+};
