index d7f8c02..906aaf8 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -2079,6 +2079,36 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
     return GGML_STATUS_SUCCESS;
 }
 
+// Conservative managed host reservation for an independent scheduler arena.
+// Includes tensor-copy context, four backend-ID arrays, hash tables, splits,
+// graph allocator bookkeeping and copy descriptors. Driver allocations are separate.
+size_t ggml_backend_sched_host_reservation(size_t graph_size, int n_backends, bool parallel) {
+    if (!graph_size || n_backends <= 0 || n_backends > GGML_SCHED_MAX_BACKENDS ||
+        graph_size > size_t(INT_MAX) / (1 + 2 * GGML_SCHED_MAX_SPLIT_INPUTS * GGML_SCHED_MAX_COPIES)) {
+        return SIZE_MAX;
+    }
+    const size_t copies = parallel ? GGML_SCHED_MAX_COPIES : 1;
+    const size_t hash = ggml_hash_size(graph_size);
+    const size_t split_inputs = graph_size * GGML_SCHED_MAX_SPLIT_INPUTS;
+    const size_t nodes = graph_size + 2 * split_inputs * copies;
+    size_t bytes = sizeof(ggml_backend_sched);
+    auto add = [&](size_t count, size_t size) {
+        if (size && count > (SIZE_MAX - bytes) / size) { bytes = SIZE_MAX; return; }
+        bytes += count * size;
+    };
+    add(hash, sizeof(ggml_tensor *) * (1 + n_backends * copies) + sizeof(int) + sizeof(ggml_bitset_t));
+    add(nodes, 4 * sizeof(int) + 2 * sizeof(ggml_tensor *));
+    add(2 * split_inputs, sizeof(ggml_tensor));
+    add(1, ggml_graph_overhead_custom(graph_size, false));
+    add(std::max<size_t>(16, graph_size), sizeof(ggml_backend_sched_split));
+    add(split_inputs * copies, 2 * sizeof(ggml_tensor *));
+    // Conservative allowance for allocator records and bookkeeping. This is
+    // admission accounting, not a measurement of process RSS/driver memory.
+    add(nodes, (GGML_MAX_SRC + 4) * 64);
+    add(size_t(n_backends), 1024 * 1024);
+    return bytes;
+}
+
 ggml_backend_sched_t ggml_backend_sched_new(
         ggml_backend_t * backends,
         ggml_backend_buffer_type_t * bufts,
