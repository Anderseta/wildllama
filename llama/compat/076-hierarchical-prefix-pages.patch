 static void require(bool value, const char * message) { if (!value) { throw std::runtime_error(message); } }
+static void page_budget(const char * value) {
+#ifdef _WIN32
+    require(_putenv_s("WILDLLAMA_PREFIX_DISK_PAGE_CACHE_MIB", value) == 0, "cannot set page-cache metadata budget");
+#else
+    require(setenv("WILDLLAMA_PREFIX_DISK_PAGE_CACHE_MIB", value, 1) == 0, "cannot set page-cache metadata budget");
+#endif
+}
+static std::vector<uint8_t> patterned(size_t size, uint32_t seed) {
+    std::vector<uint8_t> result(size);
+    for (auto & value : result) {
+        seed ^= seed << 13; seed ^= seed >> 17; seed ^= seed << 5;
+        value = uint8_t(seed);
+    }
+    return result;
+}
+static void shared_pages(const std::filesystem::path & directory) {
+    constexpr size_t mib = 1024 * 1024;
+    page_budget("4");
+    server_state_pager pager;
+    require(pager.configure(directory, 8 * mib), "shared page pool configure failed");
+    auto base = patterned(2 * mib + 17, 9181), grown = base;
+    auto auxiliary = patterned(31, 219), empty = std::vector<uint8_t>{};
+    grown.insert(grown.begin() + 23, 37, 0x7e);
+    const auto suffix = patterned(384 * 1024, 9871);
+    grown.insert(grown.end(), suffix.begin(), suffix.end());
+    auto original = pager.store({&base, &auxiliary, &empty});
+    require(original && original->storage && original->resident_metadata_bytes(), "first content-defined snapshot missing");
+    const auto original_path = original->path;
+    const auto original_size = original->file_bytes;
+    auto child = pager.store({&grown, &auxiliary, &empty});
+    require(child && child->storage && child->file_bytes + 256 * 1024 < child->payload_bytes,
+            "shifted header/grown prefix did not reuse immutable chunks");
+    const auto child_path = child->path;
+    const auto child_size = child->file_bytes;
+    const auto stats = pager.page_stats();
+    require(stats.reused_chunks > 1 && stats.shared_bytes > 256 * 1024 &&
+            stats.metadata_used <= stats.metadata_limit && stats.metadata_limit == 4 * mib,
+            "shared chunk accounting escaped its explicit metadata allowance");
+    std::vector<uint8_t> a, b, c;
+    require(server_state_pager::load(child, {&a, &b, &c}) && a == grown && b == auxiliary && c.empty(),
+            "shared page restore changed complete component bytes");
+    original.reset();
+    require(std::filesystem::exists(original_path) && pager.used() == original_size + child_size,
+            "a small child bypassed the retained origin's complete file charge");
+    std::vector<server_state_pager::handle> retained;
+    for (size_t i = 0; i < 62; ++i) {
+        auto value = patterned(1024, uint32_t(i + 1));
+        auto saved = pager.store({&value}); require(bool(saved), "bounded origin pool filled before 64 files");
