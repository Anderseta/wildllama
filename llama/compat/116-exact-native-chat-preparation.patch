+namespace {
+constexpr size_t prepared_chat_capacity = 4;
+constexpr size_t prepared_chat_max_bytes = 1 << 20;
+constexpr size_t prepared_chat_max_tokens = 128 << 10;
+constexpr auto prepared_chat_lifetime = std::chrono::seconds(30);
+constexpr char prepared_chat_header[] = "x-wildllama-chat-preparation";
+constexpr char prepared_chat_limit_header[] = "x-wildllama-chat-token-limit";
+
+std::string_view prepared_chat_request_header(const server_http_req & req, std::string_view name) {
+    for (const auto & [key, value] : req.headers) {
+        if (key.size() == name.size() && std::equal(key.begin(), key.end(), name.begin(),
+                [](unsigned char a, char b) { return std::tolower(a) == b; })) {
+            return value;
+        }
+    }
+    return {};
+}
+
+std::string prepared_chat_key(const server_http_req & req) {
+    const auto key = prepared_chat_request_header(req, prepared_chat_header);
+    if (key.size() < 16 || key.size() > 64 || req.body.size() > prepared_chat_max_bytes ||
+        key.find_first_not_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-") != std::string_view::npos) {
+        return {};
+    }
+    return std::string(key);
+}
+
+size_t prepared_chat_limit(const server_http_req & req) {
+    const auto value = prepared_chat_request_header(req, prepared_chat_limit_header);
+    if (value.empty()) {
+        return 0;
+    }
+    size_t limit = 0;
+    const auto end = value.data() + value.size();
+    const auto parsed = std::from_chars(value.data(), end, limit);
+    return parsed.ec == std::errc{} && parsed.ptr == end ? std::min(limit, prepared_chat_max_tokens) : 0;
+}
+} // namespace
+
+void server_routes::clear_prepared_chat() {
+    std::lock_guard<std::mutex> lock(prepared_chat_mutex);
+    prepared_chats.clear();
+}
+
+void server_routes::remember_prepared_chat(prepared_chat_request prepared) {
+    const auto now = std::chrono::steady_clock::now();
+    prepared.expires = now + prepared_chat_lifetime;
+    std::lock_guard<std::mutex> lock(prepared_chat_mutex);
+    prepared_chats.erase(std::remove_if(prepared_chats.begin(), prepared_chats.end(),
+            [&](const auto & entry) { return entry.expires <= now || entry.key == prepared.key; }), prepared_chats.end());
+    if (prepared_chats.size() >= prepared_chat_capacity) {
+        prepared_chats.pop_front();
+    }
+    prepared_chats.push_back(std::move(prepared));
+}
+
+std::optional<server_routes::prepared_chat_request> server_routes::take_prepared_chat(
+        const std::string & key, const std::string & body) {
+    const auto now = std::chrono::steady_clock::now();
+    std::lock_guard<std::mutex> lock(prepared_chat_mutex);
+    prepared_chats.erase(std::remove_if(prepared_chats.begin(), prepared_chats.end(),
+            [&](const auto & entry) { return entry.expires <= now; }), prepared_chats.end());
+    for (auto it = prepared_chats.begin(); it != prepared_chats.end(); ++it) {
+        if (it->key == key && it->body == body) {
+            auto prepared = std::move(*it);
+            prepared_chats.erase(it);
+            return prepared;
+        }
+    }
+    return std::nullopt;
+}
