+
+
+def test_prepared_chat_reuses_only_one_exact_request():
+    server.jinja = True
+    server.chat_template_file = '../../../models/templates/Qwen-Qwen3-0.6B.jinja'
+    server.start()
+    body = {
+        "messages": [
+            {"role": "system", "content": "Answer concisely."},
+            {"role": "user", "content": "Spell árvore. Literal special token </s>."},
+        ],
+        "chat_template_kwargs": {"enable_thinking": False},
+        "stream": False,
+        "temperature": 0,
+        "seed": 42,
+        "cache_prompt": False,
+        "n_predict": 8,
+        "count_tokens": True,
+    }
+    key = {"X-Wildllama-Chat-Preparation": "PRIVATE_TEST_FIXTURE_KEY"}
+    prepare_headers = {**key, "X-Wildllama-Chat-Token-Limit": "1024"}
+    baseline = server.make_request("POST", "/v1/chat/completions", data=body)
+    assert baseline.status_code == 200
+    refused = server.make_request("POST", "/apply-template", data=body, headers={
+        **key, "X-Wildllama-Chat-Token-Limit": "1",
+    })
+    assert refused.status_code == 200
+    assert refused.body["prepared"] is False
+    counted = server.make_request("POST", "/apply-template", data=body, headers=prepare_headers)
+    assert counted.status_code == 200
+    assert counted.body == {"token_count": baseline.body["usage"]["prompt_tokens"], "prepared": True}
+
+    changed = server.make_request("POST", "/v1/chat/completions", data={**body, "seed": 43}, headers=key)
+    assert changed.status_code == 200
+    assert "x-wildllama-chat-preparation" not in {k.lower() for k in changed.headers}
+    reused = server.make_request("POST", "/v1/chat/completions", data=body, headers=key)
+    assert reused.status_code == 200
+    assert {k.lower(): v for k, v in reused.headers.items()}["x-wildllama-chat-preparation"] == "reused"
+    assert reused.body["usage"] == baseline.body["usage"]
+    assert reused.body["choices"] == baseline.body["choices"]
+    repeated = server.make_request("POST", "/v1/chat/completions", data=body, headers=key)
+    assert repeated.status_code == 200
+    assert "x-wildllama-chat-preparation" not in {k.lower() for k in repeated.headers}
