+static std::vector<llama_token_data> rows(const std::vector<llama_token> & ids, bool nonfinite=false) {
+    std::vector<llama_token_data> values;
+    for (auto id:ids) {
+        float score=float((id*17)%37-18)/8.f;
+        if (id==0) {score=0.f;} if (id==1) {score=-0.f;}
+        if (nonfinite && id==2) {score=INFINITY;}
+        if (nonfinite && id==3) {score=-INFINITY;}
+        if (nonfinite && id==4) {score=NAN;}
+        values.push_back({id,score,float(id%5)/8.f});
+    }
+    return values;
+}
