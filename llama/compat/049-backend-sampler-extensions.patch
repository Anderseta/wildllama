+// Vocabulary-only metadata: zero model weights, no downloaded files.
+static llama_model_ptr vocabulary(int count = 259) {
+    gguf_context_ptr metadata(gguf_init_empty());
+    gguf_set_val_str(metadata.get(), "general.architecture", "llama");
+    for (const auto & item : std::vector<std::pair<const char *, uint32_t>>{
+            {"context_length",128},{"embedding_length",32},{"feed_forward_length",64},
+            {"block_count",1},{"attention.head_count",1},{"attention.head_count_kv",1},
+            {"rope.dimension_count",32}}) {
+        gguf_set_val_u32(metadata.get(), (std::string("llama.")+item.first).c_str(), item.second);
+    }
+    gguf_set_val_f32(metadata.get(), "llama.attention.layer_norm_rms_epsilon", 1e-6f);
+    gguf_set_val_str(metadata.get(), "tokenizer.ggml.model", "llama");
+    gguf_set_val_bool(metadata.get(), "tokenizer.ggml.add_space_prefix", false);
+    std::vector<std::string> names = {"<unk>","<s>","</s>"};
+    for (int i=0; i<256; ++i) { char byte[16]; std::snprintf(byte,sizeof(byte),"<0x%02X>",i); names.emplace_back(byte); }
+    for (int i=259; i<count; ++i) { names.emplace_back("word"+std::to_string(i)); }
+    std::vector<const char *> tokens; for (const auto & name:names) { tokens.push_back(name.c_str()); }
+    std::vector<float> scores(count,0.f);
+    std::vector<int32_t> types(count,6); types[0]=2;types[1]=types[2]=3;
+    for (int i=259; i<count; ++i) { types[i]=1; }
+    gguf_set_arr_str(metadata.get(), "tokenizer.ggml.tokens", tokens.data(),tokens.size());
+    gguf_set_arr_data(metadata.get(), "tokenizer.ggml.scores", GGUF_TYPE_FLOAT32,scores.data(),scores.size());
+    gguf_set_arr_data(metadata.get(), "tokenizer.ggml.token_type", GGUF_TYPE_INT32,types.data(),types.size());
+    gguf_set_val_u32(metadata.get(), "tokenizer.ggml.unknown_token_id",0);
+    gguf_set_val_u32(metadata.get(), "tokenizer.ggml.bos_token_id",1);
+    gguf_set_val_u32(metadata.get(), "tokenizer.ggml.eos_token_id",2);
+    auto params=llama_model_default_params(); params.vocab_only=true; params.n_gpu_layers=0;
+    llama_model_ptr model(llama_model_init_from_user(metadata.get(),nullptr,nullptr,params));
+    require(bool(model) && llama_vocab_n_tokens(llama_model_get_vocab(model.get()))==count,"vocabulary-only fixture failed");
+    return model;
+}
