+static void chains(llama_model * model, ggml_backend_t backend) {
+    auto * vocab=llama_model_get_vocab(model);const auto buft=ggml_backend_get_default_buffer_type(backend);
+    std::vector<llama_token> canonical(259);std::iota(canonical.begin(),canonical.end(),0);
+    for(bool partial:{false,true}) for(bool constrained:{false,true}) {
+        llama_sampler_ptr chain(llama_sampler_chain_init(llama_sampler_chain_default_params()));
+        if(constrained) {
+            llama_sampler_ptr mask(llama_sampler_init_token_mask(259));std::vector<uint32_t> words(9,0);
+            for(int id:{3,4,5}) {words[id/32]|=UINT32_C(1)<<(id%32);}
+            require(llama_sampler_set_token_mask(mask.get(),words.data(),words.size()),"mask setup failed");
+            llama_sampler_chain_add(chain.get(),mask.release());
+        }
+        auto penalty=dry(vocab);accept(penalty.get(),{3,4,5,3,4});llama_sampler_chain_add(chain.get(),penalty.release());
+        if(partial) {llama_sampler_chain_add(chain.get(),llama_sampler_init_top_n_sigma(.8f));}
+        llama_sampler_chain_add(chain.get(),llama_sampler_init_greedy());
+        auto cpu=llama_sampler_ptr(llama_sampler_clone(chain.get()));
+        require(llama_sampler_backend_set_selected_only(chain.get()),"selected-only contract rejected before backend init");
+        require(chain->iface->backend_init(chain.get(),buft,1)==!partial,"DRY chain backend support changed");
+        auto * state=static_cast<llama_sampler_chain *>(chain->ctx);
+        if(partial && constrained) {
+            for(const auto & child:state->samplers) {require(!child.is_backend,"partial constrained DRY chain did not wholly fall back");}
+            auto input=rows(canonical);input[4].logit=2.5f;input[5].logit=3.f;auto expected=input;
+            llama_token_data_array a{input.data(),input.size(),-1,false},b{expected.data(),expected.size(),-1,false};
+            llama_sampler_apply(chain.get(),&a);llama_sampler_apply(cpu.get(),&b);
+            require(a.selected==b.selected && a.data[a.selected].id==b.data[b.selected].id,"constrained DRY CPU fallback changed selection");
+            for(size_t i=0;i<input.size();++i) {same_float(input[i].logit,expected[i].logit);}
+            continue;
+        }
+        raw_graph graph(chain.get(),backend,canonical.size(),false,!partial);
+        auto input=rows(canonical);
+        // DRY must change the winner from5 to4; the post-penalty maximum has
+        // a unique margin, so host/backend tie conventions are irrelevant.
+        input[4].logit=2.5f;input[5].logit=3.f;
+        auto expected=input;llama_token_data_array array{expected.data(),expected.size(),-1,false};
+        llama_sampler_apply(cpu.get(),&array);
+        require(array.data[array.selected].id==4,"manual DRY chain winner did not change from5 to4");
+        const auto computed=graph.compute(backend,input);
+        if(!partial) {
+            int32_t selected=-1;ggml_backend_tensor_get(graph.output.sampled,&selected,0,sizeof(selected));
+            for(size_t i=0;i<expected.size();++i) {same_float(computed[i],expected[i].logit);}
+            if(selected!=array.data[array.selected].id) {
+                std::fprintf(stderr,"DRY_CHAIN_DIAGNOSTIC partial=%d constrained=%d actual=%d expected=%d\n",partial,constrained,selected,array.data[array.selected].id);
+            }
+            require(selected==array.data[array.selected].id,"complete DRY/grammar backend selected a different token");
+            require(llama_sampler_backend_selected_only_ready(chain.get()),"complete DRY chain lost compact output");
+        } else {
+            for(size_t i=0;i<input.size();++i) {input[i].logit=computed[i];}
+            llama_token_data_array actual{input.data(),input.size(),-1,false};llama_sampler_apply(chain.get(),&actual);
+            require(actual.data[actual.selected].id==array.data[array.selected].id,"partial DRY GPU prefix changed CPU suffix selection");
+            for(size_t i=0;i<input.size();++i) {same_float(input[i].logit,expected[i].logit);}
+        }
+    }
+    std::puts("DRY_CHAIN full_compact=1 grammar_guard=1 partial_host_suffix=1 constrained_full_fallback=1 PASS");
+}
