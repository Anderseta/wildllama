+static void masked_top_k_distribution(llama_model * model, ggml_backend_t backend) {
+    const auto * vocab=llama_model_get_vocab(model);
+    const auto buft=ggml_backend_get_default_buffer_type(backend);
+    const std::vector<llama_token> history={3,4,5,3,4};
+    std::vector<llama_token> ids(259);std::iota(ids.begin(),ids.end(),0);
+    auto input=rows(ids);
+    for(auto & value:input) {value.logit=-10.f;}
+    input[3].logit=1.7f;input[4].logit=2.f;input[5].logit=2.4f;
+    auto make_chain=[&](bool with_dry) {
+        llama_sampler_ptr chain(llama_sampler_chain_init(llama_sampler_chain_default_params()));
+        llama_sampler_ptr mask(llama_sampler_init_token_mask(259));
+        std::vector<uint32_t> words(9,0);
+        for(int id:{3,4,5}) {words[id/32]|=UINT32_C(1)<<(id%32);}
+        require(llama_sampler_set_token_mask(mask.get(),words.data(),words.size()),"distribution mask setup failed");
+        llama_sampler_chain_add(chain.get(),mask.release());
+        if(with_dry) {llama_sampler_chain_add(chain.get(),dry(vocab).release());}
+        llama_sampler_chain_add(chain.get(),llama_sampler_init_top_k(5));
+        llama_sampler_chain_add(chain.get(),llama_sampler_init_temp(.6f));
+        llama_sampler_chain_add(chain.get(),llama_sampler_init_dist(424242));
+        accept(chain.get(),history);
+        require(chain->iface->backend_init(chain.get(),buft,1),"complete masked top-k distribution was not admitted");
+        const auto * state=static_cast<const llama_sampler_chain *>(chain->ctx);
+        require(std::all_of(state->samplers.begin(),state->samplers.end(),
+            [](const llama_sampler_chain::info & child){return child.is_backend;}),"distribution fixture hid a CPU suffix");
+        return chain;
+    };
+    int draws=0;
+    for(bool with_dry:{false,true}) {
+        auto chain=make_chain(with_dry),reference=make_chain(false);
+        auto host_penalty=dry(vocab);accept(host_penalty.get(),history);
+        raw_graph graph(chain.get(),backend,ids.size(),false,true,with_dry);
+        raw_graph baseline(reference.get(),backend,ids.size(),false,true,false);
+        require(graph.output.logits->ne[0]==1 && graph.output.logits->ne[1]==5 &&
+            ggml_is_contiguous(graph.output.logits) && !ggml_is_vector(graph.output.logits),
+            "fixture no longer exercises the original contiguous [1,5] top-k shape");
+        require(graph.output.sampled->op==GGML_OP_TOKEN_MASK && graph.output.sampled->src[0]->op==GGML_OP_RESHAPE &&
+            ggml_is_vector(graph.output.sampled->src[0]) && graph.output.sampled->src[0]->view_src==graph.output.logits,
+            "final mask guard did not use a metadata-only view of the actual top-k logits");
+        std::vector<int32_t> first_sequence;
+        for(int cycle=0;cycle<2;++cycle) {
+            if(cycle) {
+                llama_sampler_reset(chain.get());llama_sampler_reset(reference.get());llama_sampler_reset(host_penalty.get());
+                accept(chain.get(),history);accept(reference.get(),history);accept(host_penalty.get(),history);
+            }
+            for(int step=0;step<16;++step) {
+                auto expected=input;
+                if(with_dry) {
+                    llama_token_data_array values{expected.data(),expected.size(),-1,false};
+                    llama_sampler_apply(host_penalty.get(),&values);
+                }
+                const auto actual=graph.compute(backend,input),ordinary=baseline.compute(backend,expected);
+                require(actual.size()==5 && ordinary.size()==5,"top-k fixture candidate count changed");
+                std::vector<int32_t> actual_ids(5),ordinary_ids(5);
+                std::vector<float> probabilities(5),ordinary_probabilities(5);
+                ggml_backend_tensor_get(graph.output.candidates,actual_ids.data(),0,actual_ids.size()*sizeof(int32_t));
+                ggml_backend_tensor_get(baseline.output.candidates,ordinary_ids.data(),0,ordinary_ids.size()*sizeof(int32_t));
+                ggml_backend_tensor_get(graph.output.probs,probabilities.data(),0,probabilities.size()*sizeof(float));
+                ggml_backend_tensor_get(baseline.output.probs,ordinary_probabilities.data(),0,ordinary_probabilities.size()*sizeof(float));
+                require(actual_ids==ordinary_ids,"DRY changed the same-backend candidate indexing");
+                float total=0.f;int positive=0;
+                for(size_t i=0;i<actual.size();++i) {
+                    same_float(actual[i],ordinary[i]);same_float(probabilities[i],ordinary_probabilities[i]);
+                    require(std::isfinite(probabilities[i]) && probabilities[i]>=0.f,"masked distribution contained invalid probabilities");
+                    total+=probabilities[i];positive+=probabilities[i]>0.f;
+                    if(probabilities[i]>0.f) {require(actual_ids[i]>=3 && actual_ids[i]<=5,"masked-out candidate retained probability mass");}
+                }
+                require(std::fabs(total-1.f)<2e-6f && positive>=2,"masked distribution lost normalized nontrivial support");
+                int32_t selected=-1,ordinary_selected=-1;
+                ggml_backend_tensor_get(graph.output.sampled,&selected,0,sizeof(selected));
+                ggml_backend_tensor_get(baseline.output.sampled,&ordinary_selected,0,sizeof(ordinary_selected));
+                require(selected>=3 && selected<=5 && selected==ordinary_selected,"masked DRY changed the same-backend seeded distribution");
+                if(!cycle) {first_sequence.push_back(selected);}
+                else {require(selected==first_sequence[step],"masked distribution reset did not reproduce the seeded sequence");}
+                llama_sampler_accept(chain.get(),selected);llama_sampler_accept(reference.get(),selected);llama_sampler_accept(host_penalty.get(),selected);
+                ++draws;
+            }
+        }
+    }
+    std::printf("DRY_MASKED_TOP_K original_shape_1x5=1 zero_copy_validation_view=1 no_dry_control=1 same_backend_distribution_bits_exact=1 seeded_reset_draws=%d mask_support_valid=1 PASS\n",draws);
+}
