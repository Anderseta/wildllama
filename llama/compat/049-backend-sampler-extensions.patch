+static void same_float(float actual, float expected) {
+    if (std::isnan(expected)) { require(std::isnan(actual),"nonfinite DRY classification changed"); }
+    else { require(std::memcmp(&actual,&expected,sizeof(float))==0,"DRY score/signed-zero bits changed"); }
+}
