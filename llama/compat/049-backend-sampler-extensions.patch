+static void compare(raw_graph & graph, ggml_backend_t backend, llama_sampler * cpu,
+        const std::vector<llama_token_data> & input) {
+    auto values=input;
+    llama_token_data_array expected{values.data(),values.size(),-1,false};llama_sampler_apply(cpu,&expected);
+    const auto actual=graph.compute(backend,input);
+    for(size_t i=0;i<values.size();++i) {same_float(actual[i],values[i].logit);}
+}
