+        return _putenv_s("WILDLLAMA_DRY_BACKEND",value ? value : "");
+#else
+        return value ? setenv("WILDLLAMA_DRY_BACKEND",value,1) : unsetenv("WILDLLAMA_DRY_BACKEND");
+#endif
+    }
+    explicit scoped_dry_backend(const char * value) {
+        const char * old=std::getenv("WILDLLAMA_DRY_BACKEND");had_value=old!=nullptr;
+        if(old) {previous=old;}
+        require(set(value)==0,"could not set isolated DRY backend fixture switch");
+    }
+    ~scoped_dry_backend() {set(had_value ? previous.c_str() : nullptr);}
+};
