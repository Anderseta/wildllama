+static void dry_backend(llama_model * model, ggml_backend_t backend) {
+    const auto * vocab=llama_model_get_vocab(model);
+    const auto buft=ggml_backend_get_default_buffer_type(backend);
+    std::vector<llama_token> canonical(259);std::iota(canonical.begin(),canonical.end(),0);
+    int comparisons=0;
+    const std::vector<std::vector<llama_token>> histories={
+        {},{3,4},{3,4,5,3,4},{3,4,3,4,3,4},{3,4,5,6,3,4},
+        {3+'a',3+'b',3+'c',3+'a',3+'b'},
+        {3+'a',3+'b',3+'c',3+'x',3+'a',3+'b'},
+        {-1,3,4,90000,-1,3,4}};
+    for(const auto & history:histories) for(bool filtered:{false,true}) for(bool nonfinite:{false,true}) {
+        auto current=dry(vocab);auto cpu=dry(vocab);accept(current.get(),history);accept(cpu.get(),history);
+        require(current->iface->backend_init(current.get(),buft,1),"DRY backend was not admitted");
+        require(std::string(llama_sampler_name(current.get()))=="+dry","actual DRY backend marker missing");
+        auto ids=canonical;
+        if(filtered) {ids={9,5,4,3,0,1,2,4,900%259};}
+        raw_graph graph(current.get(),backend,ids.size(),filtered);
+        const auto input=rows(ids,nonfinite);
+        compare(graph,backend,cpu.get(),input);++comparisons;
+        // Repeated graph evaluation never accepts tokens by itself.
+        compare(graph,backend,cpu.get(),input);++comparisons;
+        if(history==std::vector<llama_token>{3,4,5,3,4} && !filtered && !nonfinite) {
+            auto expected=input;llama_token_data_array array{expected.data(),expected.size(),-1,false};
+            llama_sampler_apply(cpu.get(),&array);
+            require(expected[5].logit==input[5].logit-.75f,"manual repeated-suffix penalty did not fire");
+        }
+    }
+    for(const auto & breakers:std::vector<std::vector<const char *>>{{"x"},{"ab"},{"aab","ab","\n"}}) {
+        auto current=dry(vocab,.5f,1.1f,1,32,breakers),cpu=dry(vocab,.5f,1.1f,1,32,breakers);
+        const std::vector<llama_token> history={3+'a',3+'b',3+'c',3+'a',3+'b',3+'x',3+'a',3+'b'};
+        accept(current.get(),history);accept(cpu.get(),history);
+        require(current->iface->backend_init(current.get(),buft,1),"sequence-breaker DRY backend missing");
+        raw_graph graph(current.get(),backend,canonical.size(),false);
+        compare(graph,backend,cpu.get(),rows(canonical));++comparisons;
+    }
+    // Full/filtered graph bindings exchange scratch, never logical history.
+    auto current=dry(vocab),cpu=dry(vocab);accept(current.get(),{3,4,5,3,4});accept(cpu.get(),{3,4,5,3,4});
+    require(current->iface->backend_init(current.get(),buft,1),"binding DRY backend missing");
+    raw_graph full(current.get(),backend,canonical.size(),false);
+    auto binding=llama_sampler_backend_capture_bindings(current.get());
+    require(binding && llama_sampler_backend_binding_size_bound(current.get())>=binding->memory_size(),"DRY binding budget missing");
+    raw_graph filtered(current.get(),backend,7,true);
+    auto current_copy=llama_sampler_ptr(llama_sampler_clone(cpu.get()));
+    accept(current_copy.get(),{5,3,4});accept(cpu.get(),{5,3,4});
+    current->iface->copy_state(current_copy.get(),current.get());
+    binding->swap_bindings(current.get());compare(full,backend,cpu.get(),rows(canonical));binding->swap_bindings(current.get());
+    compare(filtered,backend,cpu.get(),rows({0,1,3,4,5,6,5}));comparisons+=2;
+    llama_sampler_reset(current.get());llama_sampler_reset(cpu.get());
+    binding->swap_bindings(current.get());compare(full,backend,cpu.get(),rows(canonical));binding->swap_bindings(current.get());++comparisons;
+    auto custom=*current->iface;llama_sampler alias{&custom,current->ctx};
+    require(!llama_sampler_backend_can_bind_graph(&alias),"copied custom DRY table was treated as builtin");
+    require(!llama_sampler_can_defer_candidates(&alias),"copied custom DRY accept gained compact-output permission");
+    auto multi=dry(vocab);require(!multi->iface->backend_init(multi.get(),buft,2),"unaccepted multi-output history was offloaded");
+    auto disabled=dry(vocab,0.f);require(std::string(llama_sampler_name(disabled.get()))=="?dry","disabled DRY no-op changed");
+    auto large=vocabulary(70000);auto oversized=dry(llama_model_get_vocab(large.get()),1.f,2.f,2,65537);
+    require(!oversized->iface->backend_init(oversized.get(),buft,1),"oversized sparse DRY plan was admitted");
+    std::printf("DRY_BACKEND sparse_exact_cases=%d selected_history_cpu_exact=1 graph_bindings=1 reset_clone_copy=1 bounds_fallback=1 PASS\n",comparisons);
+}
