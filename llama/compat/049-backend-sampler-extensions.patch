+struct raw_graph {
+    llama_sampler * sampler;
+    ggml_context_ptr context;
+    ggml_cgraph * graph=nullptr;
+    ggml_tensor * scores=nullptr;
+    ggml_tensor * ids=nullptr;
+    llama_sampler_data output{};
+    ggml_backend_buffer_ptr storage;
+    size_t bytes=0;
+    raw_graph(llama_sampler * sampler, ggml_backend_t backend, size_t count, bool candidates, bool selected=false, bool expect_dry=true)
+        :sampler(sampler),context(ggml_init({4*1024*1024,nullptr,true})) {
+        require(bool(context),"raw graph metadata allocation failed");
+        scores=ggml_new_tensor_1d(context.get(),GGML_TYPE_F32,count);ggml_set_input(scores);
+        ids=candidates ? ggml_new_tensor_1d(context.get(),GGML_TYPE_I32,count) : nullptr;
+        if(ids) {ggml_set_input(ids);}
+        graph=ggml_new_graph_custom(context.get(),2048,false);
+        output={scores,nullptr,nullptr,ids};
+        sampler->iface->backend_reset(sampler);
+        sampler->iface->backend_apply(sampler,context.get(),graph,&output);
+        require(ggml_graph_n_nodes(graph)==0,"sampler expanded an inactive output branch");
+        require(!selected || output.sampled,"backend selector was absent");
+        ggml_build_forward_expand(graph,selected ? output.sampled : output.logits);
+        for(int i=0;i<ggml_graph_n_nodes(graph);++i) {
+            require(ggml_backend_supports_op(backend,ggml_graph_node(graph,i)),"raw backend cannot execute operation");
+        }
+        storage.reset(ggml_backend_alloc_ctx_tensors(context.get(),backend));
+        require(bool(storage),"raw graph buffer unavailable");
+        bytes=ggml_backend_buffer_get_size(storage.get());
+        require(bytes<=8*1024*1024,"DRY fixture graph escaped the conservative byte bound");
+        max_graph_buffer_bytes=std::max(max_graph_buffer_bytes,bytes);
+        size_t sparse=0;
+        for(auto * tensor=ggml_get_first_tensor(context.get());tensor;tensor=ggml_get_next_tensor(context.get(),tensor)) {
+            if(std::strcmp(ggml_get_name(tensor),"dry_token_ids")==0 || std::strcmp(ggml_get_name(tensor),"dry_penalties")==0) {sparse+=ggml_nbytes(tensor);}
+        }
+        require((!expect_dry || sparse>0) && sparse<=512*1024,"DRY graph lacks bounded sparse metadata inputs");
+        max_sparse_input_bytes=std::max(max_sparse_input_bytes,sparse);
+    }
+    std::vector<float> compute(ggml_backend_t backend, const std::vector<llama_token_data> & values) {
+        std::vector<float> logits;std::vector<llama_token> candidates;
+        for(const auto & value:values) {logits.push_back(value.logit);candidates.push_back(value.id);}
+        ggml_backend_tensor_set(scores,logits.data(),0,logits.size()*sizeof(float));
+        if(ids) {ggml_backend_tensor_set(ids,candidates.data(),0,candidates.size()*sizeof(llama_token));}
+        sampler->iface->backend_set_input(sampler);
+        require(ggml_backend_graph_compute(backend,graph)==GGML_STATUS_SUCCESS,"raw DRY graph execution failed");
+        std::vector<float> result(output.logits ? ggml_nelements(output.logits) : 0);
+        if(output.logits) {ggml_backend_tensor_get(output.logits,result.data(),0,result.size()*sizeof(float));}
+        return result;
+    }
+};
