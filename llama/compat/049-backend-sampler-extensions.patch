+static void greedy_tie_contract(llama_model * model,ggml_backend_t backend) {
+    const auto * vocab=llama_model_get_vocab(model);
+    auto penalty=dry(vocab),cpu=dry(vocab);
+    accept(penalty.get(),{3,4,5,3,4});accept(cpu.get(),{3,4,5,3,4});
+    llama_sampler_ptr chain(llama_sampler_chain_init(llama_sampler_chain_default_params()));
+    llama_sampler_chain_add(chain.get(),penalty.release());llama_sampler_chain_add(chain.get(),llama_sampler_init_greedy());
+    require(llama_sampler_backend_set_selected_only(chain.get()),"tie fixture compact output unavailable");
+    require(chain->iface->backend_init(chain.get(),ggml_backend_get_default_buffer_type(backend),1),"tie fixture backend unavailable");
+    std::vector<llama_token> ids(259);std::iota(ids.begin(),ids.end(),0);
+    auto input=rows(ids),expected=input;llama_token_data_array values{expected.data(),expected.size(),-1,false};
+    llama_sampler_apply(cpu.get(),&values);
+    raw_graph graph(chain.get(),backend,ids.size(),false,true);
+    const auto actual_logits=graph.compute(backend,input);
+    std::vector<float> reference_logits;
+    for(size_t i=0;i<expected.size();++i) {same_float(actual_logits[i],expected[i].logit);reference_logits.push_back(expected[i].logit);}
+    // Compare with the existing selector on this same backend, not the host
+    // sampler's distinct FIRST-tie rule (the ordinary CPU backend uses LAST).
+    ggml_context_ptr context(ggml_init({1024*1024,nullptr,true}));
+    auto * scores=ggml_new_tensor_1d(context.get(),GGML_TYPE_F32,ids.size());ggml_set_input(scores);
+    auto * selected=ggml_argmax(context.get(),scores);auto * baseline=ggml_new_graph(context.get());
+    ggml_build_forward_expand(baseline,selected);
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(context.get(),backend));require(bool(buffer),"baseline selector buffer unavailable");
+    ggml_backend_tensor_set(scores,reference_logits.data(),0,reference_logits.size()*sizeof(float));
+    require(ggml_backend_graph_compute(backend,baseline)==GGML_STATUS_SUCCESS,"baseline backend selector failed");
+    int32_t expected_token=-1,actual_token=-1;
+    ggml_backend_tensor_get(selected,&expected_token,0,sizeof(expected_token));
+    ggml_backend_tensor_get(graph.output.sampled,&actual_token,0,sizeof(actual_token));
+    require(actual_token==expected_token,"DRY changed the existing backend tie contract");
+    const float maximum=*std::max_element(reference_logits.begin(),reference_logits.end());
+    require(actual_token>=0 && size_t(actual_token)<reference_logits.size() && reference_logits[actual_token]==maximum,"backend tie selection was not a maximum");
+    llama_sampler_ptr host(llama_sampler_init_greedy());llama_sampler_apply(host.get(),&values);
+    require(values.data[values.selected].id==13,"fixture no longer exercises the host FIRST tie");
+    if(ggml_backend_dev_type(ggml_backend_get_device(backend))==GGML_BACKEND_DEVICE_TYPE_CPU) {
+        require(actual_token==235,"existing CPU backend LAST tie changed");
+    }
+    std::printf("DRY_GREEDY_TIES full_logits_exact=1 baseline_backend_selector_exact=1 host_first=13 backend_selected=%d PASS\n",actual_token);
+}
