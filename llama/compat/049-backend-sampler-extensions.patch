 static void llama_sampler_dry_free(struct llama_sampler * smpl) {
     delete (llama_sampler_dry *) smpl->ctx;
+}
+
+// A DRY plan is history-only, so keep the exact CPU Z-algorithm and pow
+// arithmetic, upload bounded sparse penalties, then subtract on the backend.
+// Larger plans and multi-output verification retain the original host path.
+static bool llama_sampler_dry_backend_init(llama_sampler * sampler,
+        ggml_backend_buffer_type_t buft, uint32_t max_outputs) {
+    auto * ctx = static_cast<llama_sampler_dry *>(sampler->ctx);
+    // A newly complete backend chain can select tokens with a different device
+    // RNG algorithm than the old CPU suffix. Preserve existing seeded profiles
+    // unless the caller explicitly opts into that backend execution contract.
+    const char * enabled = std::getenv("WILDLLAMA_DRY_BACKEND");
+    if (!enabled || std::strcmp(enabled, "1") != 0) {
+        ctx->init(false);
+        return false;
+    }
+    const int32_t entries = std::min(ctx->dry_penalty_last_n, ctx->n_vocab);
+    // Include sparse inputs, gathered/subtracted scores, possible full-vocab
+    // penalty rows, and graph metadata. This is a conservative admission bound,
+    // not an additional allowance beyond the allocator's existing VRAM quota.
+    const uint64_t extra_bound = uint64_t(std::max(ctx->n_vocab, 0)) * 24u +
+        uint64_t(std::max(entries, 0)) * 32u + 64u * ggml_tensor_overhead();
+    bool budget_ok = extra_bound <= 8u * 1024u * 1024u;
+    auto * device = ggml_backend_buft_get_device(buft);
+    auto * registry = device ? ggml_backend_dev_backend_reg(device) : nullptr;
+    if (budget_ok && registry && std::strcmp(ggml_backend_reg_name(registry), "CUDA") == 0) {
+        auto stats_fn = reinterpret_cast<bool (*)(ggml_backend_dev_t, ggml_backend_cuda_memory_stats *)>(
+            ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_get_memory_stats"));
+        ggml_backend_cuda_memory_stats stats{};
+        budget_ok = stats_fn && stats_fn(device, &stats);
+        if (budget_ok && stats.enabled && stats.limit_bytes) {
+            budget_ok = stats.managed_used_bytes <= stats.limit_bytes &&
+                extra_bound <= stats.limit_bytes - stats.managed_used_bytes;
+        }
+        size_t free = 0, total = 0;
+        ggml_backend_dev_memory(device, &free, &total);
+        budget_ok = budget_ok && extra_bound <= free;
+    }
+    if (max_outputs > 1 || entries <= 0 || entries > llama_sampler_dry::backend_max_entries || !budget_ok) {
+        ctx->init(false);
+        return false;
+    }
+    const bool supported = llama_sampler_backend_support(sampler, buft);
+    ctx->init(supported);
+    return supported;
+}
+
+static void llama_sampler_dry_backend_reset(llama_sampler * sampler) {
+    auto * ctx = static_cast<llama_sampler_dry *>(sampler->ctx);
+    ctx->inp_token_ids = nullptr;
+    ctx->inp_penalties = nullptr;
+}
+
+static void llama_sampler_dry_backend_apply(llama_sampler * sampler, ggml_context * context,
+        ggml_cgraph * graph, llama_sampler_data * data) {
+    GGML_UNUSED(graph);
+    auto * ctx = static_cast<llama_sampler_dry *>(sampler->ctx);
+    ctx->n_max = std::min(ctx->dry_penalty_last_n, ctx->n_vocab);
+    GGML_ASSERT(ctx->n_max > 0 && ctx->n_max <= llama_sampler_dry::backend_max_entries);
+    ctx->has_candidates = data->candidates != nullptr;
+    ctx->inp_token_ids = ggml_new_tensor_1d(context, GGML_TYPE_I32, ctx->n_max);
+    ctx->inp_penalties = ggml_new_tensor_1d(context, GGML_TYPE_F32, ctx->n_max);
+    ggml_set_name(ctx->inp_token_ids, "dry_token_ids");
+    ggml_set_name(ctx->inp_penalties, "dry_penalties");
+    ggml_set_input(ctx->inp_token_ids);
+    ggml_set_input(ctx->inp_penalties);
+    ctx->host_token_ids.resize(ctx->n_max);
+    ctx->host_penalties.resize(ctx->n_max);
+    auto * logits = ggml_reshape_1d(context, data->logits, ggml_nelements(data->logits));
+    if (ctx->has_candidates) {
+        // IDs may already be filtered/reordered (or duplicated). Gather the
+        // same penalty per ID instead of treating candidate positions as IDs.
+        auto * rows = ggml_fill(context, ggml_new_tensor_2d(context, GGML_TYPE_F32, 1, ctx->n_vocab), 0.f);
+        rows = ggml_set_rows(context, rows, ggml_reshape_2d(context, ctx->inp_penalties, 1, ctx->n_max), ctx->inp_token_ids);
+        auto * candidates = ggml_reshape_1d(context, data->candidates, ggml_nelements(data->candidates));
+        GGML_ASSERT(ggml_nelements(candidates) == ggml_nelements(logits));
+        auto * penalties = ggml_get_rows(context, rows, candidates);
+        data->logits = ggml_sub(context, logits, ggml_reshape_1d(context, penalties, ggml_nelements(logits)));
+    } else {
+        auto * rows = ggml_reshape_2d(context, logits, 1, ggml_nelements(logits));
+        auto * gathered = ggml_get_rows(context, rows, ctx->inp_token_ids);
+        auto * penalized = ggml_sub(context, ggml_reshape_1d(context, gathered, ctx->n_max), ctx->inp_penalties);
+        rows = ggml_set_rows(context, rows, ggml_reshape_2d(context, penalized, 1, ctx->n_max), ctx->inp_token_ids);
+        data->logits = ggml_reshape_1d(context, rows, ggml_nelements(logits));
+    }
+}
+
+static void llama_sampler_dry_backend_set_input(llama_sampler * sampler) {
+    auto * ctx = static_cast<llama_sampler_dry *>(sampler->ctx);
+    if (!ctx->inp_token_ids || !ctx->inp_penalties || ctx->n_max <= 0) { return; }
+    int32_t active = 0;
+    if (llama_sampler_dry_prepare(ctx)) {
+        for (const auto & entry : ctx->dry_max_token_repeat) {
+            if (entry.first < 0 || entry.first >= ctx->n_vocab) { continue; }
+            bool breaker = false;
+            const auto range = ctx->dry_processed_breakers.equal_range(entry.first);
+            for (auto it = range.first; it != range.second; ++it) {
+                if (it->second.empty()) { breaker = true; break; }
+            }
+            if (!breaker) {
+                GGML_ASSERT(active < ctx->n_max);
+                ctx->host_token_ids[active++] = entry.first;
+            }
+        }
+    }
+    std::sort(ctx->host_token_ids.begin(), ctx->host_token_ids.begin() + active);
+    const float FLOAT_MAX_LOG = 88.7228391f;
+    int max_exponent = 0;
+    if (ctx->dry_base > 1.000001f) { max_exponent = FLOAT_MAX_LOG / std::log(ctx->dry_base); }
+    for (int32_t i = 0; i < active; ++i) {
+        int exponent = ctx->dry_max_token_repeat.at(ctx->host_token_ids[i]) - ctx->dry_allowed_length;
+        if (max_exponent > 0 && exponent > max_exponent) { exponent = max_exponent; }
+        ctx->host_penalties[i] = ctx->dry_multiplier * std::pow(ctx->dry_base, exponent);
+    }
+    // Every padding ID is distinct and absent from the active set. Unlike
+    // duplicate scatter indices, these writes have a defined order-free result.
+    int32_t filler = 0, seen = 0;
+    for (int32_t i = active; i < ctx->n_max; ++i) {
+        while (seen < active && ctx->host_token_ids[seen] == filler) { ++seen; ++filler; }
+        GGML_ASSERT(filler < ctx->n_vocab);
+        ctx->host_token_ids[i] = filler++;
+        ctx->host_penalties[i] = 0.f;
+    }
+    ggml_backend_tensor_set(ctx->inp_token_ids, ctx->host_token_ids.data(), 0, ctx->n_max * sizeof(int32_t));
+    ggml_backend_tensor_set(ctx->inp_penalties, ctx->host_penalties.data(), 0, ctx->n_max * sizeof(float));
 }
 
