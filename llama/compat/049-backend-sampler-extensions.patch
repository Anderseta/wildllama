+static void masked_top_k_invalid_support(ggml_backend_t backend) {
+    ggml_context_ptr context(ggml_init({1024*1024,nullptr,true}));
+    auto * scores=ggml_new_tensor_2d(context.get(),GGML_TYPE_F32,1,5);
+    auto * words=ggml_new_tensor_1d(context.get(),GGML_TYPE_I32,9);
+    auto * selected=ggml_new_tensor_1d(context.get(),GGML_TYPE_I32,1);
+    auto * candidates=ggml_new_tensor_1d(context.get(),GGML_TYPE_I32,5);
+    auto * probabilities=ggml_new_tensor_1d(context.get(),GGML_TYPE_F32,5);
+    auto * pre_filter=ggml_new_tensor_1d(context.get(),GGML_TYPE_F32,259);
+    for(auto * input:{scores,words,selected,candidates,probabilities,pre_filter}) {ggml_set_input(input);}
+    auto * guard=ggml_token_mask_validate(context.get(),ggml_reshape_1d(context.get(),scores,5),words,
+        selected,candidates,probabilities,pre_filter,259);
+    auto * graph=ggml_new_graph(context.get());ggml_build_forward_expand(graph,guard);
+    for(int i=0;i<ggml_graph_n_nodes(graph);++i) {require(ggml_backend_supports_op(backend,ggml_graph_node(graph,i)),"invalid-support guard backend unavailable");}
+    ggml_backend_buffer_ptr storage(ggml_backend_alloc_ctx_tensors(context.get(),backend));require(bool(storage),"invalid-support guard allocation failed");
+    for(int mode=0;mode<7;++mode) {
+        std::vector<uint32_t> allowed(9,0);for(int id:{3,4,5}) {allowed[id/32]|=UINT32_C(1)<<(id%32);}
+        std::vector<float> logits={3.f,2.f,1.f,-INFINITY,-INFINITY},probs={.5f,.3f,.2f,0.f,0.f},original(259,-10.f);
+        const int32_t ids[]={5,4,3,8,9};int32_t chosen=5;
+        if(mode==1) {std::fill(allowed.begin(),allowed.end(),0);}
+        if(mode==2) {chosen=259;}
+        if(mode==3) {probs[0]=0.f;}
+        if(mode==4) {original[200]=NAN;}
+        if(mode==5) {logits[0]=-INFINITY;}
+        if(mode==6) {logits[4]=INFINITY;}
+        ggml_backend_tensor_set(scores,logits.data(),0,logits.size()*sizeof(float));
+        ggml_backend_tensor_set(words,allowed.data(),0,allowed.size()*sizeof(uint32_t));
+        ggml_backend_tensor_set(selected,&chosen,0,sizeof(chosen));
+        ggml_backend_tensor_set(candidates,ids,0,sizeof(ids));
+        ggml_backend_tensor_set(probabilities,probs.data(),0,probs.size()*sizeof(float));
+        ggml_backend_tensor_set(pre_filter,original.data(),0,original.size()*sizeof(float));
+        require(ggml_backend_graph_compute(backend,graph)==GGML_STATUS_SUCCESS,"invalid-support guard graph failed");
+        int32_t actual=-2;ggml_backend_tensor_get(guard,&actual,0,sizeof(actual));
+        require(actual==(mode ? -1 : 5),"reshaped mask validation changed invalid-support rejection");
+    }
+    std::puts("DRY_MASKED_TOP_K_INVALID support_cases=7 finite_selected_probability=1 empty_mask=1 candidate_bounds=1 prefilter_nonfinite=1 sentinel_rejection_preserved=1 PASS");
+}
+
+static void adaptive_clone() {
+    const std::vector<llama_token> ids={3,7,9,11,13,15};
+    auto sample=[&](llama_sampler * sampler) {
+        auto input=rows(ids);llama_token_data_array current{input.data(),input.size(),-1,false};
+        llama_sampler_apply(sampler,&current);
+        return std::make_pair(current.data[current.selected].id,input);
+    };
+    for(float target:{-.1f,.15f,.7f}) for(uint32_t seed:{93281u,LLAMA_DEFAULT_SEED}) for(int mode=0;mode<4;++mode) {
+        llama_sampler_ptr original(llama_sampler_init_adaptive_p(target,.9f,seed));
+        for(int i=0;i<19;++i) {auto result=sample(original.get());llama_sampler_accept(original.get(),result.first);}
+        const auto pending=sample(original.get());
+        llama_sampler_ptr clone(llama_sampler_clone(original.get()));
+        llama_sampler_ptr twice(llama_sampler_clone(clone.get()));
+        require(llama_sampler_get_seed(original.get())==llama_sampler_get_seed(clone.get()) &&
+            llama_sampler_get_seed(original.get())==llama_sampler_get_seed(twice.get()),"adaptive clone changed actual seed metadata");
+        // This pending accept used to index a missing original_probs vector.
+        auto accepted=pending.first;
+        if(mode==1) {
+            const auto a=sample(original.get()),b=sample(clone.get()),c=sample(twice.get());
+            require(a.first==b.first && a.first==c.first,"replacement apply after pending clone changed RNG");
+            accepted=a.first;
+        }
+        if(mode==2) {accepted=1000;} // Unaccepted pending row must not update EMA.
+        for(auto * sampler:{original.get(),clone.get(),twice.get()}) {
+            llama_sampler_accept(sampler,accepted);
+            if(mode==3) {llama_sampler_accept(sampler,accepted);}
+        }
+        for(int i=0;i<64;++i) {
+            const auto a=sample(original.get()),b=sample(clone.get()),c=sample(twice.get());
+            require(a.first==b.first && a.first==c.first,"adaptive clone lost advanced RNG/EMA state");
+            for(size_t j=0;j<a.second.size();++j) {
+                same_float(a.second[j].logit,b.second[j].logit);same_float(a.second[j].p,b.second[j].p);
+                same_float(a.second[j].logit,c.second[j].logit);same_float(a.second[j].p,c.second[j].p);
+            }
+            llama_sampler_accept(original.get(),a.first);llama_sampler_accept(clone.get(),b.first);llama_sampler_accept(twice.get(),c.first);
+        }
+        llama_sampler_reset(original.get());llama_sampler_reset(clone.get());
+        if (seed != LLAMA_DEFAULT_SEED) {
+            require(sample(original.get()).first==sample(clone.get()).first,"adaptive explicit-seed reset after clone diverged");
+        } else {
+            // Reset deliberately chooses a fresh random seed independently for
+            // each sampler. A checkpoint of that newly reset state must still
+            // reproduce its future draws and probabilities exactly.
+            llama_sampler_ptr reset_copy(llama_sampler_clone(original.get()));
+            require(llama_sampler_get_seed(original.get())==llama_sampler_get_seed(reset_copy.get()),
+                "adaptive reset checkpoint changed its actual random seed");
+            for (int i=0;i<8;++i) {
+                const auto a=sample(original.get()),b=sample(reset_copy.get());
+                require(a.first==b.first,"adaptive checkpoint after random reset diverged");
+                for(size_t j=0;j<a.second.size();++j) {same_float(a.second[j].p,b.second[j].p);}
+                llama_sampler_accept(original.get(),a.first);llama_sampler_accept(reset_copy.get(),b.first);
+            }
+            require(std::find(ids.begin(),ids.end(),sample(clone.get()).first)!=ids.end(),
+                "independent random reset produced an invalid token");
+        }
+    }
+    std::puts("ADAPTIVE_P_CLONE advanced_rng_steps=19 pending_accept=1 replacement_apply=1 double_accept=1 clone_of_clone=1 actual_seed_preserved=1 future_draws_exact=1536 candidate_probabilities_exact=1 reset=1 PASS");
+}
+
+static void quota_fallback(llama_model * model, ggml_backend_t backend, bool cuda) {
+    if(!cuda) {return;}
+    auto * device=ggml_backend_get_device(backend);auto * registry=ggml_backend_dev_backend_reg(device);
+    auto get=reinterpret_cast<bool (*)(ggml_backend_dev_t,ggml_backend_cuda_memory_stats *)>(ggml_backend_reg_get_proc_address(registry,"ggml_backend_cuda_get_memory_stats"));
+    auto set=reinterpret_cast<bool (*)(ggml_backend_dev_t,size_t,bool)>(ggml_backend_reg_get_proc_address(registry,"ggml_backend_cuda_set_memory_limit"));
+    ggml_backend_cuda_memory_stats stats{};require(get && set && get(device,&stats) && !stats.enabled,"quota fixture needs an isolated unbudgeted backend");
+    require(set(device,stats.managed_used_bytes+1,true),"quota fixture could not set remaining headroom to one byte");
+    struct release {ggml_backend_dev_t device;bool (*set)(ggml_backend_dev_t,size_t,bool);~release(){set(device,0,false);}} release{device,set};
+    auto sampler=dry(llama_model_get_vocab(model));
+    require(!sampler->iface->backend_init(sampler.get(),ggml_backend_get_default_buffer_type(backend),1),"insufficient CUDA quota did not retain CPU DRY");
+    accept(sampler.get(),{3,4,5,3,4});auto input=rows({3,4,5,6});llama_token_data_array values{input.data(),input.size(),-1,false};
+    const float before=input[2].logit;llama_sampler_apply(sampler.get(),&values);same_float(input[2].logit,before-.75f);
+    std::puts("DRY_QUOTA denied_optional_backend=1 exact_host_fallback=1 quota_preserved=1 PASS");
+}
+
+static void default_off(llama_model * model,ggml_backend_t backend) {
+    for(const char * value:std::vector<const char *>{nullptr,"0","","true","yes"}) {
+        scoped_dry_backend flag(value);
+        auto sampler=dry(llama_model_get_vocab(model));
+        require(!sampler->iface->backend_init(sampler.get(),ggml_backend_get_default_buffer_type(backend),1),"DRY backend changed an existing profile without exact opt-in");
+        accept(sampler.get(),{3,4,5,3,4});auto input=rows({3,4,5,6});
+        const float before=input[2].logit;llama_token_data_array current{input.data(),input.size(),-1,false};
+        llama_sampler_apply(sampler.get(),&current);same_float(input[2].logit,before-.75f);
+    }
+    std::puts("DRY_OPT_IN default_host=1 unknown_values_host=1 enabled_only_exact_one=1 PASS");
+}
