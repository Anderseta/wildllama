+static llama_sampler_ptr dry(const llama_vocab * vocab, float multiplier=.75f, float base=2.f,
+        int allowed=2, int window=32, const std::vector<const char *> & breakers={}) {
+    return llama_sampler_ptr(llama_sampler_init_dry(vocab,multiplier,base,allowed,window,
+        breakers.empty() ? nullptr : const_cast<const char **>(breakers.data()),breakers.size()));
