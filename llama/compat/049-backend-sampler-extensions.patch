+int main(int argc,char ** argv) {
+    try {
+        const bool cuda=argc==2 && std::string(argv[1])=="--cuda";
+        require(argc==1 || cuda,"use no arguments or --cuda");
+        require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH),"explicit CPU backend unavailable");
+        if(cuda) {
+#ifdef GGML_TEST_CUDA_BACKEND_PATH
+            require(ggml_backend_load(GGML_TEST_CUDA_BACKEND_PATH),"explicit CUDA backend unavailable");
+#else
+            std::puts("SKIP: CUDA backend not built");return 77;
+#endif
+        }
+        auto * device=ggml_backend_dev_by_type(cuda ? GGML_BACKEND_DEVICE_TYPE_GPU : GGML_BACKEND_DEVICE_TYPE_CPU);
+        require(device && (!cuda || std::string(ggml_backend_reg_name(ggml_backend_dev_backend_reg(device)))=="CUDA"),"requested isolated device missing");
+        ggml_backend_ptr backend(ggml_backend_dev_init(device,nullptr));require(bool(backend),"backend unavailable");
+        auto model=vocabulary();adaptive_clone();default_off(model.get(),backend.get());
+        scoped_dry_backend enable("1");
+        dry_backend(model.get(),backend.get());chains(model.get(),backend.get());greedy_tie_contract(model.get(),backend.get());
+        // CUDA distribution initialization can retain device RNG allocations
+        // outside the managed quota. Prove quota denial before that optional
+        // resource exists; both distribution regressions still run afterward.
+        quota_fallback(model.get(),backend.get(),cuda);
+        masked_top_k_distribution(model.get(),backend.get());masked_top_k_invalid_support(backend.get());
+        std::printf("SAMPLER_BACKEND_EXTENSIONS device=%s actual_raw_backend_execution=1 zero_model_weights=1 max_graph_buffer_bytes=%zu max_sparse_input_bytes=%zu PASS\n",cuda?"CUDA":"CPU",max_graph_buffer_bytes,max_sparse_input_bytes);
+        return 0;
+    } catch(const std::exception & e) {std::fprintf(stderr,"FAIL: %s\n",e.what());return 1;}
+}
