diff --git a/tests/test-server-checkpoint-budget.cpp b/tests/test-server-checkpoint-budget.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-server-checkpoint-budget.cpp
@@ -0,0 +1,52 @@
+#include "../tools/server/server-checkpoint-budget.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <list>
+#include <vector>
+
+#define CHECK(x) do { if (!(x)) { std::abort(); } } while (0)
+struct snapshot { int64_t n_tokens; };
+static std::vector<int64_t> positions(const std::list<snapshot> & items) {
+    std::vector<int64_t> result;
+    for (const auto & item : items) { result.push_back(item.n_tokens); }
+    return result;
+}
+int main() {
+    constexpr size_t mib = 1024ULL*1024ULL;
+    constexpr size_t gib = 1024ULL*mib;
+    const auto no_log = [](const snapshot &) {};
+    std::list<snapshot> short_chat;
+    for (int n : {22,89,92,122,134,136,158,168,170,203}) { short_chat.push_back({n}); }
+    CHECK(server_checkpoint_compact(short_chat, 8192, no_log) == 7);
+    CHECK(positions(short_chat) == std::vector<int64_t>({22,170,203}));
+
+    // Every edit/shorter prefix is reconstructed exactly from a retained anchor
+    // or full replay, including positions whose optional snapshot was removed.
+    for (int cutoff = 0; cutoff <= 210; ++cutoff) {
+        int64_t restored = 0;
+        for (const auto & item : short_chat) {
+            if (item.n_tokens <= cutoff) { restored = item.n_tokens; }
+        }
+        int64_t state = restored*(restored+1)/2;
+        for (int64_t n = restored+1; n <= cutoff; ++n) { state += n; }
+        CHECK(state == int64_t(cutoff)*(cutoff+1)/2);
+    }
+    std::list<snapshot> long_chat{{1},{8194},{8200},{16387},{16500},{17000}};
+    CHECK(server_checkpoint_compact(long_chat,8192,no_log) == 1);
+    CHECK(positions(long_chat) == std::vector<int64_t>({1,8194,16387,16500,17000}));
+    CHECK(server_checkpoint_compact(long_chat,0,no_log) == 0);
+    std::list<snapshot> three{{1},{2},{3}};
+    CHECK(server_checkpoint_compact(three,8192,no_log) == 0);
+
+    // 16 GiB RAM reserves 819.2 MiB. Already held bytes must not be charged
+    // twice; only the next target/draft allocation needs physical headroom.
+    const size_t reserve = 16*gib/20;
+    CHECK(server_checkpoint_can_allocate(3*gib, 8*mib, {reserve+16*mib,16*gib,true}));
+    CHECK(!server_checkpoint_can_allocate(3*gib, 17*mib, {reserve+16*mib,16*gib,true}));
+    CHECK(!server_checkpoint_can_allocate(3*gib, 0, {reserve-1,16*gib,true}));
+    CHECK(server_checkpoint_can_allocate(3*gib, 2*gib, {})); // unknown probe preserves fallback
+    CHECK(!server_checkpoint_can_allocate(SIZE_MAX-1,2,{}));
+    CHECK(server_checkpoint_add_bytes(SIZE_MAX-1,2) == SIZE_MAX);
+    return 0;
+}
