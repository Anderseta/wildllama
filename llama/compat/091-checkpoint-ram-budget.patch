diff --git a/tools/server/server-checkpoint-budget.h b/tools/server/server-checkpoint-budget.h
new file mode 100644
--- /dev/null
+++ b/tools/server/server-checkpoint-budget.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include "server-prefix-ram-budget.h"
+#include <cstdint>
+#include <iterator>
+#include <limits>
+
+inline size_t server_checkpoint_add_bytes(size_t a, size_t b) {
+    return b > SIZE_MAX - a ? SIZE_MAX : a + b;
+}
+
+// Already allocated snapshots are held, not a second pending allocation. The
+// system's available RAM already excludes active model/KV/speculative state.
+inline bool server_checkpoint_can_allocate(size_t held, size_t candidate,
+        server_prefix_ram_info memory) {
+    const size_t budget = server_prefix_ram_budget(0, held, memory);
+    return held <= budget && candidate <= budget - held;
+}
+
+// Keep interval anchors and the two newest exact rewind points. Removing an
+// intermediate optional checkpoint only extends replay from the prior anchor;
+// it never changes prompt tokens or the mandatory speculative rollback state.
+template <class List, class Erased>
+size_t server_checkpoint_compact(List & snapshots, int64_t min_step, Erased erased) {
+    if (min_step <= 0 || snapshots.size() <= 3) { return 0; }
+    auto anchor = snapshots.begin();
+    auto it = std::next(anchor);
+    size_t remaining = snapshots.size() - 1;
+    size_t removed = 0;
+    while (it != snapshots.end() && remaining > 2) {
+        const auto position = it->n_tokens;
+        if (position >= anchor->n_tokens &&
+                uint64_t(position) - uint64_t(anchor->n_tokens) < uint64_t(min_step)) {
+            erased(*it);
+            it = snapshots.erase(it);
+            ++removed;
+        } else {
+            anchor = it++;
+        }
+        --remaining;
+    }
+    return removed;
+}
