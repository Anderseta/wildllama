+#if defined(_WIN32) && !defined(_POSIX_MAPPED_FILES)
+llama_mmap::upload_window::~upload_window() {
+    if (view) { UnmapViewOfFile(view); }
+}
+
+const void * llama_mmap::upload_window::read(const llama_mmap & mapping, size_t offset, size_t bytes) {
+    GGML_ASSERT(offset <= mapping.size() && bytes <= mapping.size() - offset);
+    if (view && owner == &mapping && offset >= first && offset - first <= length &&
+            bytes <= length - (offset - first)) {
+        return static_cast<const char *>(view) + (offset - first);
+    }
+    if (view) {
+        UnmapViewOfFile(view);
+        view = nullptr;
+    }
+    if (bytes) {
+        static const DWORD granularity = [] {
+            SYSTEM_INFO info;
+            GetSystemInfo(&info);
+            return info.dwAllocationGranularity;
+        }();
+        first = offset - offset % granularity;
+        const size_t required = (offset - first) + bytes;
+        length = std::min(mapping.size() - first, std::max<size_t>(64u << 20, required));
+        const uint64_t start = first;
+        view = MapViewOfFile(mapping.pimpl->hMapping, FILE_MAP_READ,
+                             DWORD(start >> 32), DWORD(start), length);
+        if (view) {
+            owner = &mapping;
+            return static_cast<const char *>(view) + (offset - first);
+        }
+    }
+    // Address space can be exhausted even when the existing primary view is usable.
+    return static_cast<const char *>(mapping.addr()) + offset;
+}
+#elif defined(_WIN32)
+llama_mmap::upload_window::~upload_window() = default;
+
+const void * llama_mmap::upload_window::read(const llama_mmap & mapping, size_t offset, size_t) {
+    return static_cast<const char *>(mapping.addr()) + offset;
+}
