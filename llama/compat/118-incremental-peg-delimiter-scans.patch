diff --git a/tests/test-stream-scan.cpp b/tests/test-stream-scan.cpp
new file mode 100644
index 0000000..2597464
--- /dev/null
+++ b/tests/test-stream-scan.cpp
@@ -0,0 +1,62 @@
+#include "chat-peg-parser.h"
+#include "peg-parser.h"
+
+#include <chrono>
+#include <cstdio>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool valid, const char * message) {
+    if (!valid) {
+        throw std::runtime_error(message);
+    }
+}
+
+static void verify_fragments() {
+    const auto parser = build_chat_peg_parser([](common_chat_peg_builder & p) {
+        return p.reasoning(p.until("</think>")) + p.literal("</think>") +
+            p.content(p.until("<tool_call>")) + p.literal("<tool_call>") + p.rest();
+    });
+
+    std::vector<common_peg_stream_scan> scans;
+    std::string text;
+    const std::string chunks[] = {
+        "Pensando ", "\xc3", "\xa7", "</thi", "ng> ", "\xff", "</thi", "nk>",
+        "resposta ", "<tool_", "x> ", "<tool_", "call>", "{\"x\": 2}",
+    };
+    for (const auto & chunk : chunks) {
+        text += chunk;
+        common_peg_parse_context baseline(text, COMMON_PEG_PARSE_FLAG_LENIENT);
+        common_peg_parse_context incremental(text, COMMON_PEG_PARSE_FLAG_LENIENT);
+        incremental.stream_scans = &scans;
+        const auto a = parser.parse(baseline);
+        const auto b = parser.parse(incremental);
+        require(a.type == b.type && a.start == b.start && a.end == b.end, "stream result differs");
+        require(baseline.ast.dump() == incremental.ast.dump(), "stream AST differs");
+    }
+}
+
+static double replay(bool incremental) {
+    const auto parser = build_chat_peg_parser([](common_chat_peg_builder & p) {
+        return p.until("</think>");
+    });
+    std::vector<common_peg_stream_scan> scans;
+    const auto start = std::chrono::steady_clock::now();
+    std::string text;
+    for (int i = 0; i < 8192; ++i) {
+        text += "token ";
+        common_peg_parse_context context(text, COMMON_PEG_PARSE_FLAG_LENIENT);
+        context.stream_scans = incremental ? &scans : nullptr;
+        const auto result = parser.parse(context);
+        require(result.end == text.size(), "plain scan lost input");
+    }
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+}
+
+int main() {
+    verify_fragments();
+    const double reference = replay(false);
+    const double resumed = replay(true);
+    std::printf("PASS stream scan parity (reference %.2f ms, resumed %.2f ms)\n", reference, resumed);
+}
