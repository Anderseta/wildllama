+
+bool llama_context::defer_sampler_outputs(const llm_graph_result * result, uint32_t row_offset, uint32_t total_rows) {
+    if (!device_verify_allowance || !device_verify_conventional_kv || row_offset || !total_rows || total_rows > llama_device_verification_policy::max_rows ||
+            result->t_sampled.size() != total_rows || result->t_sampled_logits.size() != total_rows ||
+            result->t_sampled_probs.size() != total_rows || result->t_candidates.size() != total_rows ||
+            !sampling.sampled.has_data() || !sampling.logits.has_data() || !sampling.probs.has_data() ||
+            !sampling.candidates.has_data() || sampling.samplers.size() != 1 ||
+            !llama_sampler_backend_device_verify_ready(sampling.samplers.begin()->second) ||
+            moe_cache || model.ram_cache || model.n_devices() > 1 || cparams.training || cparams.pipeline_parallel) { return false; }
+    ggml_backend_t backend = nullptr;
+    uint64_t bytes = 0;
+    for (size_t row = 0; row < total_rows; ++row) {
+        auto * selected = result->t_sampled[row];
+        if (!selected || selected->type != GGML_TYPE_I32 || ggml_nelements(selected) != 1) { return false; }
+        for (auto * tensor : { selected, result->t_sampled_logits[row], result->t_sampled_probs[row], result->t_candidates[row] }) {
+            if (!tensor) { continue; }
+            auto * current = ggml_backend_sched_get_tensor_backend(sched.get(), tensor);
+            if (!current || !tensor->buffer || ggml_backend_buffer_is_host(tensor->buffer) ||
+                    ggml_backend_buffer_get_type(tensor->buffer) != ggml_backend_get_default_buffer_type(current) ||
+                    !ggml_is_contiguous(tensor) || (backend && backend != current)) { return false; }
+            backend = current; bytes += ggml_nbytes(tensor);
+        }
+    }
+    auto * device = ggml_backend_get_device(backend);
+    auto * registry = device ? ggml_backend_dev_backend_reg(device) : nullptr;
+    if (!registry || std::strcmp(ggml_backend_reg_name(registry), "CUDA") != 0) { return false; }
+    if (!device_verify_api) {
+        device_verify_api = static_cast<const ggml_backend_cuda_verify_api *>(
+            ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_verify_api"));
+    }
+    if (!device_verify_api || device_verify_api->version != 1 ||
+            device_verify_api->allocation_size(model.vocab.n_tokens()) > device_verify_allowance) { return false; }
+    if (!device_verify_admission.eligible()) { return false; }
+    try {
+        if (!device_verify_state) {
+            std::vector<uint8_t> eog(model.vocab.n_tokens());
+            for (size_t i = 0; i < eog.size(); ++i) { eog[i] = model.vocab.is_eog(llama_token(i)); }
+            device_verify_state = device_verify_api->create(backend, device_verify_allowance, model.vocab.n_tokens(), eog.data());
+            device_verify_backend = backend;
+        }
+        if (!device_verify_state) { device_verify_admission.deny(); return false; }
+        if (backend != device_verify_backend) { return false; }
+        deferred_sampler_rows.resize(total_rows);
+        for (size_t row = 0; row < total_rows; ++row) {
+            deferred_sampler_rows[row] = {result->t_sampled[row], result->t_sampled_logits[row],
+                result->t_sampled_probs[row], result->t_candidates[row], false};
+            if (result->t_sampled_logits[row]) { sampling.logits_count[row] = ggml_nelements(result->t_sampled_logits[row]); }
+            if (result->t_sampled_probs[row]) { sampling.probs_count[row] = ggml_nelements(result->t_sampled_probs[row]); }
+            if (result->t_candidates[row]) { sampling.candidates_count[row] = ggml_nelements(result->t_candidates[row]); }
+        }
+        device_verify_stats.deferred_bytes += bytes;
+        device_verify_ordered = true;
+        return true;
+    } catch (const std::bad_alloc &) {
+        deferred_sampler_rows.clear(); device_verify_admission.deny(); return false;
+    }
+}
+
+void llama_context::materialize_sampler_row(size_t row, bool fence) {
+    if (row >= deferred_sampler_rows.size() || deferred_sampler_rows[row].materialized) { return; }
+    auto & saved = deferred_sampler_rows[row];
+    auto copy = [&](ggml_tensor * tensor, void * destination) {
+        if (!tensor) { return; }
+        ggml_backend_tensor_get_async(device_verify_backend, tensor, destination, 0, ggml_nbytes(tensor));
+        device_verify_stats.materialized_bytes += ggml_nbytes(tensor);
+    };
+    const auto stride = model.vocab.n_tokens();
+    copy(saved.selected, sampling.sampled.data + row);
+    if (saved.logits) { copy(saved.logits, sampling.logits.data + row * stride); }
+    if (saved.probabilities) { copy(saved.probabilities, sampling.probs.data + row * stride); }
+    if (saved.candidates) { copy(saved.candidates, sampling.candidates.data + row * stride); }
+    saved.materialized = true;
+    if (fence) { synchronize(); }
+}
+
+void llama_context::materialize_sampler_outputs() {
+    bool copied = false;
+    for (size_t row = 0; row < deferred_sampler_rows.size(); ++row) {
+        copied |= !deferred_sampler_rows[row].materialized;
+        materialize_sampler_row(row, false);
+    }
+    if (copied) { synchronize(); }
+}
+
+bool llama_context::verify_draft_device(const std::vector<int> & indexes, const std::vector<llama_token> & draft,
+        std::vector<llama_token> & accepted) {
+    if (!device_verify_state || !device_verify_ordered || draft.empty() || indexes.size() != draft.size() + 1 ||
+            indexes.size() > llama_device_verification_policy::max_rows || !output_swaps.empty()) { return false; }
+    std::array<const ggml_tensor *, llama_device_verification_policy::max_rows> selected{};
+    std::array<int32_t, llama_device_verification_policy::max_rows + 1> output{};
+    for (size_t i = 0; i < indexes.size(); ++i) {
+        const auto row = output_resolve_row(indexes[i]);
+        if (row < 0 || size_t(row) >= deferred_sampler_rows.size()) { return false; }
+        selected[i] = deferred_sampler_rows[row].selected;
+    }
+    accepted.reserve(indexes.size());
+    if (!device_verify_api->enqueue(device_verify_state, selected.data(), draft.data(), draft.size(), output.data())) {
+        synchronize(); ++device_verify_stats.fallbacks; return false;
+    }
+    synchronize();
+    if (output[0] < 1 || size_t(output[0]) > indexes.size()) { ++device_verify_stats.fallbacks; return false; }
+    accepted.assign(output.begin() + 1, output.begin() + 1 + output[0]);
+    ++device_verify_stats.verified_batches;
+    return true;
 }
 
