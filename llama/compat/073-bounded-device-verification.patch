+static bool llama_sampler_device_verify_chain(const llama_sampler * sampler) {
+    if (!sampler || sampler->iface != &llama_sampler_chain_i) { return false; }
+    const auto & chain = *static_cast<const llama_sampler_chain *>(sampler->ctx);
+    if (chain.samplers.empty() || chain.samplers.back().ptr->iface != &llama_sampler_greedy_i) { return false; }
+    for (const auto & entry : chain.samplers) {
+        const auto * iface = entry.ptr->iface;
+        if (iface != &llama_sampler_empty_i && iface != &llama_sampler_greedy_i &&
+                iface != &llama_sampler_temp_i && iface != &llama_sampler_temp_ext_i &&
+                iface != &llama_sampler_top_k_i && iface != &llama_sampler_top_p_i &&
+                iface != &llama_sampler_min_p_i && iface != &llama_sampler_typical_i &&
+                iface != &llama_sampler_top_n_sigma_i && iface != &llama_sampler_logit_bias_i) { return false; }
+    }
+    return true;
+}
+
+bool llama_sampler_backend_enable_device_verify(llama_sampler * sampler) {
+    if (!llama_sampler_device_verify_chain(sampler)) { return false; }
+    auto & chain = *static_cast<llama_sampler_chain *>(sampler->ctx);
+    if (chain.is_init) { return false; }
+    chain.device_verify = true;
+    return true;
+}
+
+bool llama_sampler_backend_device_verify_ready(const llama_sampler * sampler) {
+    if (!sampler || sampler->iface != &llama_sampler_chain_i) { return false; }
+    const auto & chain = *static_cast<const llama_sampler_chain *>(sampler->ctx);
+    if (!chain.device_verify || !llama_sampler_device_verify_chain(sampler)) { return false; }
+    return chain.is_init && chain.backend_selects_token && !chain.selected_only &&
+        std::all_of(chain.samplers.begin(), chain.samplers.end(), [](const auto & entry) { return entry.is_backend; });
+}
+
 bool llama_sampler_backend_can_overlap_output(const llama_sampler * sampler) {
