+        operands = {
+            ggml_new_tensor_4d(ctx, GGML_TYPE_F32, width, key_heads, n_tokens, 1),
+            ggml_new_tensor_4d(ctx, GGML_TYPE_F32, width, key_heads, n_tokens, 1),
+            ggml_new_tensor_4d(ctx, GGML_TYPE_F32, width, heads, n_tokens, 1),
+            ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, heads, n_tokens, 1),
+            ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, heads, n_tokens, 1),
+        };
+        cache = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, state_elements, 3);
+        source_cache = shared_cache ? cache : ggml_dup_tensor(ctx, cache);
+        index = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+        ggml_set_input(index);
+        auto * gather = ggml_get_rows(ctx, source_cache, index);
+        if (observe_gather) {
+            ggml_set_output(gather); // external consumer: cannot elide this intermediate
+        }
+        auto * rows = ggml_view_2d(ctx, gather, state_elements, 1, state_bytes, 0);
+        auto * state = ggml_reshape_4d(ctx, rows, width, width, heads, 1);
+        auto * output = ggml_gated_delta_net(ctx, operands[0], operands[1], operands[2], operands[3], operands[4],
+            state, n_tokens);
+        const size_t score_elements = width * heads * n_tokens;
+        // A downstream copy models the production consumer of attention scores.
+        // Marking the view itself as an output would expose the whole GDN base
+        // tensor, including the snapshot tail, and correctly forbid fusion.
+        scores = ggml_dup(ctx, ggml_view_1d(ctx, output, score_elements, 0));
+        ggml_set_output(scores);
+        auto * snapshots = ggml_view_3d(ctx, output, state_elements, 1, n_tokens, state_bytes, state_bytes,
+            score_elements * sizeof(float));
+        auto * destination = ggml_view_3d(ctx, cache, state_elements, 1, n_tokens, state_bytes, state_bytes, 0);
+        ggml_build_forward_expand(graph, ggml_cpy(ctx, snapshots, destination));
+        ggml_build_forward_expand(graph, scores);
+        buffer.reset(ggml_backend_alloc_ctx_tensors(context.get(), backend));
+        require(bool(buffer), "cannot allocate bounded graph tensors");
+    }
+
+    void run(ggml_backend_t backend, int row, int pattern) {
+        uint32_t bits = 0x31841423u + pattern;
+        auto fill = [&](ggml_tensor * tensor, float amplitude, float bias) {
+            std::vector<float> data(ggml_nelements(tensor));
+            for (float & value : data) {
+                bits ^= bits << 13;
+                bits ^= bits >> 17;
+                bits ^= bits << 5;
+                value = bias + amplitude * (float(bits >> 8) * 0x1p-23f - 1.0f);
+            }
+            ggml_backend_tensor_set(tensor, data.data(), 0, ggml_nbytes(tensor));
+        };
+        fill(cache, 0.2f, 0.0f);
+        if (source_cache != cache) {
+            ggml_backend_tensor_copy(cache, source_cache);
+        }
+        fill(operands[0], 0.1f, 0.0f);
+        fill(operands[1], 0.1f, 0.0f);
+        fill(operands[2], 0.7f, 0.0f);
+        fill(operands[3], 0.2f, -0.3f);
+        fill(operands[4], 0.3f, 0.5f);
+        const int32_t index_value = row;
+        ggml_backend_tensor_set(index, &index_value, 0, sizeof(index_value));
+        require(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "GDN graph compute failed");
+    }
+};
+
+void compare(const ggml_tensor * a, const ggml_tensor * b) {
+    const size_t bytes = ggml_nbytes(a);
+    require(ggml_nbytes(b) == bytes, "shape mismatch");
+    std::vector<unsigned char> x(bytes), y(bytes);
+    ggml_backend_tensor_get(a, x.data(), 0, bytes);
+    ggml_backend_tensor_get(b, y.data(), 0, bytes);
+    require(x == y, "indexed GDN changed graph output or state bits");
+}
+
+double measure(ggml_backend_t backend, replay_graph & graph) {
+    using clock = std::chrono::steady_clock;
+    constexpr int replays = 64;
+    require(ggml_backend_graph_compute(backend, graph.graph) == GGML_STATUS_SUCCESS, "GDN warmup failed");
+    const auto start = clock::now();
+    for (int i = 0; i < replays; ++i) {
+        require(ggml_backend_graph_compute_async(backend, graph.graph) == GGML_STATUS_SUCCESS, "GDN benchmark failed");
+    }
+    ggml_backend_synchronize(backend);
+    return std::chrono::duration<double, std::micro>(clock::now() - start).count() / replays;
+}
+
+} // namespace
+
+int main(int argc, char ** argv) {
+    try {
+        require(argc == 2 || (argc == 3 && std::strcmp(argv[2], "--benchmark") == 0),
+            "pass the compiled ggml-cuda library and optionally --benchmark");
+#ifdef _WIN32
+        _putenv_s("WILDLLAMA_CUDA_GDN_GATHER", "1");
+        _putenv_s("WILDLLAMA_CUDA_GDN_GATHER_TRACE", "1");
+#else
+        setenv("WILDLLAMA_CUDA_GDN_GATHER", "1", 1);
+        setenv("WILDLLAMA_CUDA_GDN_GATHER_TRACE", "1", 1);
+#endif
+        ggml_log_set(trace, nullptr);
+        auto * registry = ggml_backend_load(argv[1]);
+        require(registry != nullptr && ggml_backend_reg_dev_count(registry) > 0, "cannot load CUDA backend");
+        ggml_backend_ptr backend(ggml_backend_dev_init(ggml_backend_reg_dev_get(registry, 0), nullptr));
+        require(bool(backend), "cannot initialize CUDA");
+        for (int tokens = 1; tokens <= 3; ++tokens) {
+            replay_graph reference(backend.get(), tokens, true);
+            replay_graph candidate(backend.get(), tokens, false);
+            replay_graph distinct_cache(backend.get(), tokens, false, false);
+            reference.run(backend.get(), 0, 17);
+            distinct_cache.run(backend.get(), 0, 17);
+            require(!(traced_shapes & (1u << tokens)), "unsupported gather was fused");
+            compare(reference.scores, distinct_cache.scores);
+            compare(reference.cache, distinct_cache.cache);
+            for (int round = 0; round < 9; ++round) {
+                reference.run(backend.get(), round % 3, round);
+                candidate.run(backend.get(), round % 3, round);
+                compare(reference.scores, candidate.scores);
+                compare(reference.cache, candidate.cache);
+            }
+            if (argc == 3) {
+                std::array<double, 6> baseline, fused;
+                for (int pair = 0; pair < 6; ++pair) {
+                    if (pair % 2 == 0) {
+                        baseline[pair] = measure(backend.get(), reference);
+                        fused[pair] = measure(backend.get(), candidate);
+                    } else {
+                        fused[pair] = measure(backend.get(), candidate);
+                        baseline[pair] = measure(backend.get(), reference);
+                    }
+                }
+                std::sort(baseline.begin(), baseline.end());
+                std::sort(fused.begin(), fused.end());
+                std::printf("GDN graph tokens=%d baseline_us=%.3f fused_us=%.3f (6 pairs, 64 replays each)\n",
+                    tokens, (baseline[2] + baseline[3]) / 2, (fused[2] + fused[3]) / 2);
+            }
+        }
+        require(traced_shapes == 14, "expected fused dispatch for all three token shapes");
+        std::printf("PASS 27 CUDA graph replays and 3 fallback cases, all rollback rows and 1-3 tokens bitwise equal (%zu bytes cache)\n",
+            cache_bytes);
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        return 1;
+    }
+}
diff --git a/tests/test-cuda-gdn-replay.cu b/tests/test-cuda-gdn-replay.cu
new file mode 100644
index 0000000..ba72ce5
--- /dev/null
+++ b/tests/test-cuda-gdn-replay.cu
@@ -0,0 +1,202 @@
+// Manual GPU fixture for the existing GDN arithmetic and compact rollback.
+#define GGML_CUDA_GDN_KERNELS_ONLY
+#include "../ggml/src/ggml-cuda/gated_delta_net.cu"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+
+static constexpr int width = 128;
+static constexpr int heads = 48;
+static constexpr int key_heads = 16;
+static constexpr size_t state_size = width * width * heads;
+static constexpr size_t record_size = heads * (2 * width + 1);
+static constexpr size_t score_size = width * heads * 3;
+
+[[noreturn]] void ggml_cuda_error(const char * statement, const char *, const char *, int, const char * message) {
+    throw std::runtime_error(std::string(statement) + ": " + message);
+}
+
+template<class T> struct device_buffer {
+    T * data = nullptr;
+    explicit device_buffer(size_t size) { CUDA_CHECK(cudaMalloc((void **) &data, size * sizeof(T))); }
+    ~device_buffer() { cudaFree(data); }
+    device_buffer(const device_buffer &) = delete;
+    device_buffer & operator=(const device_buffer &) = delete;
+};
+
+static void require_equal(const float * expected, const float * actual, size_t count, const char * label) {
+    std::vector<float> a(count), b(count);
+    CUDA_CHECK(cudaMemcpy(a.data(), expected, count * sizeof(float), cudaMemcpyDeviceToHost));
+    CUDA_CHECK(cudaMemcpy(b.data(), actual, count * sizeof(float), cudaMemcpyDeviceToHost));
+    if (std::memcmp(a.data(), b.data(), count * sizeof(float))) {
+        for (size_t i = 0; i < count; ++i) {
+            if (std::memcmp(&a[i], &b[i], sizeof(float))) {
+                std::fprintf(stderr, "%s differs at %zu: %.9g != %.9g\n", label, i, a[i], b[i]);
+                break;
+            }
+        }
+        throw std::runtime_error(label);
+    }
+}
+
+static void initialize(float * dst, size_t count, int seed, float amplitude, float bias = 0.0f) {
+    std::vector<float> host(count);
+    uint32_t bits = uint32_t(seed + 1);
+    for (float & value : host) {
+        bits ^= bits << 13;
+        bits ^= bits >> 17;
+        bits ^= bits << 5;
+        value = bias + amplitude * (float(bits >> 8) * 0x1p-23f - 1.0f);
+    }
+    CUDA_CHECK(cudaMemcpy(dst, host.data(), count * sizeof(float), cudaMemcpyHostToDevice));
+}
+
+template<bool indexed, bool compact>
+static void launch(const float * q, const float * k, const float * v, const float * g, const float * beta,
+        const float * input, float * output, float * snapshots, int n_tokens, int slots, const int32_t * index,
+        cudaStream_t stream = nullptr) {
+    const dim3 grid(heads, 1, width / 16);
+    const dim3 block(32, 4, 1);
+    gated_delta_net_cuda<width, false, true, 4, indexed, compact><<<grid, block, 0, stream>>>(
+        q, k, v, g, beta, input, output, snapshots, heads, n_tokens, 1,
+        width, key_heads * width, n_tokens * key_heads * width,
+        width, heads * width, n_tokens * heads * width,
+        1, heads, n_tokens * heads, init_fastdiv_values(key_heads), init_fastdiv_values(1),
+        1.0f / std::sqrt(float(width)), state_size, slots, index);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+__global__ void replay_middle_state(const float * oldest, const float * record, float * destination) {
+    const size_t i = size_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    const int head = i / (width * width);
+    const int col = (i / width) % width;
+    const int row = i % width;
+    const float * update = record + head * (2 * width + 1);
+    destination[i] = update[2 * width] * oldest[i] + update[row] * update[width + col];
+}
+
+template<class Submit> static float time_graph(const Submit & submit) {
+    constexpr int ops = 32;
+    constexpr int replays = 16;
+    cudaStream_t stream;
+    cudaGraph_t graph;
+    cudaGraphExec_t executable;
+    cudaEvent_t begin, end;
+    CUDA_CHECK(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
+    CUDA_CHECK(cudaEventCreate(&begin));
+    CUDA_CHECK(cudaEventCreate(&end));
+    CUDA_CHECK(cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreadLocal));
+    for (int i = 0; i < ops; ++i) {
+        submit(stream);
+    }
+    CUDA_CHECK(cudaStreamEndCapture(stream, &graph));
+    CUDA_CHECK(cudaGraphInstantiate(&executable, graph, 0));
+    for (int i = 0; i < 4; ++i) {
+        CUDA_CHECK(cudaGraphLaunch(executable, stream));
+    }
+    CUDA_CHECK(cudaEventRecord(begin, stream));
+    for (int i = 0; i < replays; ++i) {
+        CUDA_CHECK(cudaGraphLaunch(executable, stream));
+    }
+    CUDA_CHECK(cudaEventRecord(end, stream));
+    CUDA_CHECK(cudaEventSynchronize(end));
+    float milliseconds = 0;
+    CUDA_CHECK(cudaEventElapsedTime(&milliseconds, begin, end));
+    CUDA_CHECK(cudaEventDestroy(begin));
+    CUDA_CHECK(cudaEventDestroy(end));
+    CUDA_CHECK(cudaGraphExecDestroy(executable));
+    CUDA_CHECK(cudaGraphDestroy(graph));
+    CUDA_CHECK(cudaStreamDestroy(stream));
+    return milliseconds * 1000 / (ops * replays);
+}
+
+int main(int argc, char ** argv) {
+    try {
+        cudaDeviceProp info;
+        CUDA_CHECK(cudaGetDeviceProperties(&info, 0));
+        if (info.major != 12 || info.minor != 0) {
+            std::puts("SKIP: this fixture is scoped to SM120");
+            return 77;
+        }
+
+        device_buffer<float> q(width * key_heads * 3), k(width * key_heads * 3);
+        device_buffer<float> v(score_size), g(heads * 3), beta(heads * 3);
+        device_buffer<float> initial(3 * state_size), reference(3 * state_size), indexed(3 * state_size);
+        device_buffer<float> compact(2 * state_size + record_size);
+        device_buffer<float> reference_scores(score_size), candidate_scores(score_size);
+        device_buffer<int32_t> device_index(1);
+        int cases = 0;
+        for (int pattern = 0; pattern < 4; ++pattern) {
+            initialize(q.data, width * key_heads * 3, pattern * 100 + 1, 0.1f);
+            initialize(k.data, width * key_heads * 3, pattern * 100 + 2, 0.1f);
+            initialize(v.data, score_size, pattern * 100 + 3, 0.7f);
+            initialize(g.data, heads * 3, pattern * 100 + 4, 0.2f, -0.3f);
+            initialize(beta.data, heads * 3, pattern * 100 + 5, 0.3f, 0.5f);
+            initialize(initial.data, 3 * state_size, pattern * 100 + 6, 0.2f);
+            for (int tokens = 1; tokens <= 3; ++tokens) {
+                for (int32_t row = 0; row < 3; ++row) {
+                    CUDA_CHECK(cudaMemcpy(device_index.data, &row, sizeof(row), cudaMemcpyHostToDevice));
+                    CUDA_CHECK(cudaMemcpy(indexed.data, initial.data, 3 * state_size * sizeof(float), cudaMemcpyDeviceToDevice));
+                    CUDA_CHECK(cudaMemcpy(reference.data, initial.data, 3 * state_size * sizeof(float), cudaMemcpyDeviceToDevice));
+                    launch<false, false>(q.data, k.data, v.data, g.data, beta.data,
+                        initial.data + row * state_size, reference_scores.data, reference.data, tokens, 3, nullptr);
+                    launch<true, false>(q.data, k.data, v.data, g.data, beta.data,
+                        indexed.data, candidate_scores.data, indexed.data, tokens, tokens, device_index.data);
+                    require_equal(reference_scores.data, candidate_scores.data, width * heads * tokens, "indexed scores");
+                    require_equal(reference.data, indexed.data, 3 * state_size, "indexed rollback slots");
+                    if (tokens == 3) {
+                        launch<false, true>(q.data, k.data, v.data, g.data, beta.data,
+                            initial.data + row * state_size, candidate_scores.data, compact.data, tokens, 3, nullptr);
+                        require_equal(reference_scores.data, candidate_scores.data, score_size, "compact scores");
+                        require_equal(reference.data, compact.data, state_size, "compact newest state");
+                        require_equal(reference.data + 2 * state_size, compact.data + state_size, state_size, "compact oldest state");
+                        replay_middle_state<<<state_size / 256, 256>>>(
+                            compact.data + state_size, compact.data + 2 * state_size, compact.data);
+                        CUDA_CHECK(cudaGetLastError());
+                        require_equal(reference.data + state_size, compact.data, state_size, "reconstructed middle state");
+                    }
+                    ++cases;
+                }
+            }
+        }
+        std::printf("PASS %d GDN cases with live cache-row aliasing and exact 3-token compact replay\n", cases);
+        std::printf("GDN layer state bytes: full=%zu compact=%zu delta_record=%zu\n",
+            3 * state_size * sizeof(float), (2 * state_size + record_size) * sizeof(float), record_size * sizeof(float));
+        std::printf("GDN theoretical 48-layer state saving: %.3f MiB (fixture only, no runtime allocation change)\n",
+            48.0 * (state_size - record_size) * sizeof(float) / (1024.0 * 1024.0));
+        if (argc == 2 && std::strcmp(argv[1], "--benchmark") == 0) {
+            std::array<float, 5> full_times, compact_times, replay_times;
+            for (int repeat = 0; repeat < 5; ++repeat) {
+                full_times[repeat] = time_graph([&](cudaStream_t stream) {
+                    launch<false, false>(q.data, k.data, v.data, g.data, beta.data,
+                        reference.data, reference_scores.data, reference.data, 3, 3, nullptr, stream);
+                });
+                compact_times[repeat] = time_graph([&](cudaStream_t stream) {
+                    launch<false, true>(q.data, k.data, v.data, g.data, beta.data,
+                        compact.data, candidate_scores.data, compact.data, 3, 3, nullptr, stream);
+                });
+                replay_times[repeat] = time_graph([&](cudaStream_t stream) {
+                    launch<false, true>(q.data, k.data, v.data, g.data, beta.data,
+                        compact.data, candidate_scores.data, compact.data, 3, 3, nullptr, stream);
+                    replay_middle_state<<<state_size / 256, 256, 0, stream>>>(
+                        compact.data + state_size, compact.data + 2 * state_size, compact.data);
+                    CUDA_CHECK(cudaGetLastError());
+                });
+            }
+            std::sort(full_times.begin(), full_times.end());
+            std::sort(compact_times.begin(), compact_times.end());
+            std::sort(replay_times.begin(), replay_times.end());
+            std::printf("GDN 3-token device us/layer: full=%.3f compact=%.3f compact_with_rollback=%.3f (5 samples)\n",
+                full_times[2], compact_times[2], replay_times[2]);
+        }
+        return 0;
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "FAIL: %s\n", e.what());
+        return 1;
+    }
+}
