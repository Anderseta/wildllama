+static void q8_pair_conversion_case(int rows, int layout, bool measure) {
+    constexpr int dim = 256, heads = 4;
+    constexpr size_t row_blocks = dim/QK8_0;
+    const size_t row_stride = layout == 1 ? heads*row_blocks : row_blocks;
+    const size_t head_stride = layout == 1 ? row_blocks : (rows + (layout == 2 ? 7 : 0))*row_stride;
+    const size_t allocation = (heads-1)*head_stride + (rows-1)*row_stride + row_blocks;
+    std::vector<block_q8_0> host_k(allocation), host_v(allocation);
+    uint32_t rng = 767821u;
+    for (size_t block = 0; block < allocation; ++block) {
+        const half k_scale = __float2half(std::ldexp(0.713f, int(next_random(rng)%19)-17));
+        const half v_scale = __float2half(std::ldexp(0.361f, int(next_random(rng)%19)-17));
+        std::memcpy(&host_k[block].d, &k_scale, sizeof(half));
+        std::memcpy(&host_v[block].d, &v_scale, sizeof(half));
+        for (int8_t & q : host_k[block].qs) {
+            q = int8_t(next_random(rng)%256);
+        }
+        for (int8_t & q : host_v[block].qs) {
+            q = int8_t(next_random(rng)%256);
+        }
+    }
+    device_buffer<block_q8_0> dk(allocation), dv(allocation);
+    const size_t elements = size_t(dim)*rows*heads;
+    device_buffer<half> keys(elements), values(elements);
+    CUDA_CHECK(cudaMemcpy(dk.data, host_k.data(), allocation*sizeof(block_q8_0), cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaMemcpy(dv.data, host_v.data(), allocation*sizeof(block_q8_0), cudaMemcpyHostToDevice));
+    ggml_tensor K{};
+    K.type = GGML_TYPE_Q8_0;
+    K.data = dk.data;
+    K.ne[0] = dim;
+    K.ne[1] = rows;
+    K.ne[2] = heads;
+    K.ne[3] = 1;
+    K.nb[0] = sizeof(block_q8_0);
+    K.nb[1] = row_stride*sizeof(block_q8_0);
+    K.nb[2] = head_stride*sizeof(block_q8_0);
+    K.nb[3] = allocation*sizeof(block_q8_0);
+    ggml_tensor V = K;
+    V.data = dv.data;
+    require(ggml_is_contiguously_allocated(&K) == (layout != 2), "unexpected conversion layout");
+    const auto previous = [&](cudaStream_t stream) {
+        if (ggml_is_contiguously_allocated(&K)) {
+            const auto convert = ggml_get_to_fp16_cuda(GGML_TYPE_Q8_0);
+            convert(K.data, keys.data, elements, stream);
+            convert(V.data, values.data, elements, stream);
+        } else {
+            const auto convert = ggml_get_to_fp16_nc_cuda(GGML_TYPE_Q8_0);
+            convert(K.data, keys.data, dim, rows, heads, 1, row_stride, head_stride, allocation, stream);
