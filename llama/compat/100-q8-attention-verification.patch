+template<class Before, class After>
+static void verify_benchmark(const char * path, int rows, int layout, cudaStream_t stream, Before before, After after) {
+    constexpr int repeats = 24, samples = 12;
+    benchmark_graph a, b;
+    capture_component(a, stream, repeats, before);
+    capture_component(b, stream, repeats, after);
+    for (int i = 0; i < 3; ++i) {
+        a.measure(stream, repeats);
+        b.measure(stream, repeats);
+    }
+    std::vector<float> a_times, b_times;
+    int wins = 0;
+    for (int i = 0; i < samples; ++i) {
+        float previous, candidate;
+        if (i % 2) {
+            candidate = b.measure(stream, repeats);
+            previous = a.measure(stream, repeats);
+        } else {
+            previous = a.measure(stream, repeats);
+            candidate = b.measure(stream, repeats);
+        }
+        a_times.push_back(previous);
+        b_times.push_back(candidate);
+        wins += candidate < previous;
+    }
+    std::printf("GQA_VERIFY_GPU_EVENTS path=%s kv=%d layout=%d baseline_ms=%.8g candidate_ms=%.8g speedup=%.6g wins=%d/%d\n",
+        path, rows, layout, double(median(a_times)), double(median(b_times)), double(median(a_times)/median(b_times)), wins, samples);
+}
