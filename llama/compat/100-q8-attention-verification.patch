+    std::vector<half> expected(elements), actual(elements);
+    previous(nullptr);
+    CUDA_CHECK(cudaMemcpy(expected.data(), keys.data, elements*sizeof(half), cudaMemcpyDeviceToHost));
+    candidate(nullptr);
+    CUDA_CHECK(cudaMemcpy(actual.data(), keys.data, elements*sizeof(half), cudaMemcpyDeviceToHost));
+    require(std::memcmp(expected.data(), actual.data(), elements*sizeof(half)) == 0, "MMA key conversion changed bytes");
+    previous(nullptr);
+    CUDA_CHECK(cudaMemcpy(expected.data(), values.data, elements*sizeof(half), cudaMemcpyDeviceToHost));
+    candidate(nullptr);
+    CUDA_CHECK(cudaMemcpy(actual.data(), values.data, elements*sizeof(half), cudaMemcpyDeviceToHost));
+    require(std::memcmp(expected.data(), actual.data(), elements*sizeof(half)) == 0, "MMA value conversion changed bytes");
+    std::printf("PASS three-query MMA conversion kv=%d layout=%d half_values=%zu bitwise=1\n", rows, layout, 2*elements);
+    if (measure) {
+        cudaStream_t stream;
+        CUDA_CHECK(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
+        verify_benchmark("three_query_mma_conversion", rows, layout, stream,
+            [&] { previous(stream); }, [&] { candidate(stream); });
+        CUDA_CHECK(cudaStreamDestroy(stream));
+    }
+}
