diff --git a/ggml/src/ggml-cuda/fattn-q8-convert.cuh b/ggml/src/ggml-cuda/fattn-q8-convert.cuh
new file mode 100644
index 0000000..057cbff
--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-q8-convert.cuh
@@ -0,0 +1,50 @@
+#pragma once
+
+#include "common.cuh"
+#include "convert.cuh"
+
+struct fattn_q8_to_f16_view {
+    const block_q8_0 * source;
+    half2 * destination;
+    int64_t row_stride;
+    int64_t head_stride;
+};
+
+// The two streams of work occupy disjoint output arrays. A CTA handles either
+// K or V and never changes the half conversion used by the original launcher.
+static __global__ void fattn_q8_pair_to_f16(fattn_q8_to_f16_view k, fattn_q8_to_f16_view v,
+        uint3 row_count, int64_t pairs) {
+    constexpr int pairs_per_row = 256/2;
+    constexpr int pairs_per_quant = QK8_0/2;
+    const auto view = blockIdx.y == 0 ? k : v;
+    const int64_t index = int64_t(blockIdx.x)*blockDim.x + threadIdx.x;
+    if (index >= pairs) {
+        return;
+    }
+    const int64_t row = index/pairs_per_row;
+    const int64_t pair = index % pairs_per_row;
+    const uint2 pos = fast_div_modulo(uint32_t(row), row_count);
+    const int64_t block = int64_t(pos.x)*view.head_stride + int64_t(pos.y)*view.row_stride + pair/pairs_per_quant;
+    const block_q8_0 & source = view.source[block];
+    const int q = 2*int(pair % pairs_per_quant);
+    const float scale = __half2float(source.d);
+    view.destination[index] = __floats2half2_rn(float(source.qs[q])*scale, float(source.qs[q+1])*scale);
+}
+
+static inline void fattn_launch_q8_pair_to_f16(const ggml_tensor * K, const ggml_tensor * V,
+        half * keys, half * values, cudaStream_t stream) {
+    if (ggml_is_contiguously_allocated(K)) {
+        ggml_cuda_convert_q8_pair_f16(K->data, V->data, keys, values, ggml_nelements(K), stream);
+        CUDA_CHECK(cudaGetLastError());
+        return;
+    }
+    auto view = [](const ggml_tensor * src, half * dst) {
+        return fattn_q8_to_f16_view{static_cast<const block_q8_0 *>(src->data), reinterpret_cast<half2 *>(dst),
+            int64_t(src->nb[1]/sizeof(block_q8_0)), int64_t(src->nb[2]/sizeof(block_q8_0))};
+    };
+    constexpr int threads = 256;
+    const int64_t pairs = ggml_nelements(K)/2;
+    fattn_q8_pair_to_f16<<<dim3((pairs + threads - 1)/threads, 2), threads, 0, stream>>>(
+        view(K, keys), view(V, values), init_fastdiv_values(K->ne[1]), pairs);
+    CUDA_CHECK(cudaGetLastError());
+}
