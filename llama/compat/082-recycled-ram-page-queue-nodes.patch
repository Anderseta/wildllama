diff --git a/src/llama-model-ram-queue-nodes.h b/src/llama-model-ram-queue-nodes.h
new file mode 100644
--- /dev/null
+++ b/src/llama-model-ram-queue-nodes.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <cassert>
+#include <cstddef>
+#include <list>
+#include <memory>
+#include <stdexcept>
+#include <type_traits>
+
+// Queues share an allocator and transfer nodes only by splice/recycle until
+// final destruction. Pointer values in the recycled list are never dereferenced.
+template <typename Pointer, typename Allocator = std::allocator<Pointer>>
+class llama_model_ram_queue_nodes {
+    static_assert(std::is_pointer<Pointer>::value, "RAM queue entries must be pointers");
+public:
+    using queue = std::list<Pointer, Allocator>;
+    using iterator = typename queue::iterator;
+
+    explicit llama_model_ram_queue_nodes(size_t maximum, const Allocator & allocator = Allocator()) :
+        recycled(allocator), maximum(maximum) {}
+
+    llama_model_ram_queue_nodes(const llama_model_ram_queue_nodes &) = delete;
+    llama_model_ram_queue_nodes & operator=(const llama_model_ram_queue_nodes &) = delete;
+
+    iterator append(queue & target, Pointer value) {
+        assert(target.get_allocator() == recycled.get_allocator());
+        if (!recycled.empty()) {
+            auto node = recycled.begin();
+            *node = value;
+            target.splice(target.end(), recycled, node);
+            return node;
+        }
+        if (allocated == maximum) {
+            throw std::length_error("MoE RAM cache: queue node limit exceeded");
+        }
+        target.push_back(value);
+        ++allocated;
+        return --target.end();
+    }
+
+    void recycle(queue & source, iterator first, iterator last) noexcept {
+        assert(source.get_allocator() == recycled.get_allocator());
+        recycled.splice(recycled.end(), source, first, last);
+    }
+
+    void recycle(queue & source) noexcept {
+        assert(source.get_allocator() == recycled.get_allocator());
+        recycled.splice(recycled.end(), source);
+    }
+
+    size_t allocated_nodes() const { return allocated; }
+    size_t recycled_nodes() const { return recycled.size(); }
+
+private:
+    queue recycled;
+    size_t maximum;
+    size_t allocated = 0;
+};
diff --git a/tests/test-moe-ram-queue-nodes.cpp b/tests/test-moe-ram-queue-nodes.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-moe-ram-queue-nodes.cpp
@@ -0,0 +1,164 @@
+#include "../src/llama-model-ram-queue-nodes.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <iterator>
+#include <memory>
+#include <new>
+#include <stdexcept>
+#include <vector>
+
+static void require(bool condition, const char * message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+struct allocation_state {
+    size_t allocations = 0, releases = 0, live = 0, peak = 0;
+    bool fail = false;
+};
+
+template <typename T>
+struct counting_allocator {
+    using value_type = T;
+    std::shared_ptr<allocation_state> state;
+    explicit counting_allocator(std::shared_ptr<allocation_state> state) : state(std::move(state)) {}
+    template <typename U> counting_allocator(const counting_allocator<U> & other) noexcept : state(other.state) {}
+    T * allocate(size_t count) {
+        if (state->fail) { throw std::bad_alloc(); }
+        T * result = std::allocator<T>().allocate(count);
+        state->allocations += count;
+        state->live += count;
+        state->peak = std::max(state->peak, state->live);
+        return result;
+    }
+    void deallocate(T * pointer, size_t count) noexcept {
+        state->releases += count;
+        state->live -= count;
+        std::allocator<T>().deallocate(pointer, count);
+    }
+    template <typename U> bool operator==(const counting_allocator<U> & other) const noexcept { return state == other.state; }
+    template <typename U> bool operator!=(const counting_allocator<U> & other) const noexcept { return !(*this == other); }
+};
+
+using pointer = const int *;
+using allocator = counting_allocator<pointer>;
+using pool = llama_model_ram_queue_nodes<pointer, allocator>;
+
+static void order_and_quota() {
+    auto state = std::make_shared<allocation_state>();
+    {
+        allocator allocation(state);
+        pool nodes(4, allocation);
+        pool::queue cold(allocation), hot(allocation), ready(allocation);
+        const size_t empty_queue_nodes = state->live; // Some standard libraries allocate list sentinels.
+        std::array<int, 8> pages{};
+        require(nodes.allocated_nodes() == 0, "queue pool eagerly allocated page nodes");
+        for (size_t i = 0; i < 4; ++i) { nodes.append(cold, &pages[i]); }
+        auto retained = std::next(cold.begin());
+        hot.splice(hot.end(), cold, retained);
+        auto reused = cold.begin();
+        nodes.recycle(cold, cold.begin(), std::next(cold.begin(), 2));
+        require(nodes.recycled_nodes() == 2 && cold.front() == &pages[3], "eviction range or survivor order changed");
+        nodes.append(ready, &pages[4]);
+        nodes.append(ready, &pages[5]);
+        cold.splice(cold.end(), ready);
+        require(*retained == &pages[1] && *reused == &pages[4], "splice changed stable active or recycled node identity");
+        require(std::vector<pointer>(cold.begin(), cold.end()) == std::vector<pointer>({&pages[3], &pages[4], &pages[5]}),
+                "recycling changed probation publication order");
+        const size_t allocated = state->allocations;
+        bool rejected = false;
+        try { nodes.append(ready, &pages[6]); } catch (const std::length_error &) { rejected = true; }
+        require(rejected && ready.empty() && nodes.allocated_nodes() == 4 && state->allocations == allocated,
+                "active plus inflight nodes bypassed the cap or mutated a rejected queue");
+        nodes.recycle(hot);
+        require(nodes.allocated_nodes() == 4 && nodes.recycled_nodes() == 1, "recycled node escaped total accounting");
+        nodes.append(ready, &pages[7]);
+        require(state->allocations == allocated && state->live == empty_queue_nodes + 4,
+                "a full pool allocated a node instead of reusing its reservation");
+    }
+    require(state->live == 0 && state->allocations == state->releases, "queue pool destruction leaked nodes");
+}
+
+static void failure_return() {
+    auto state = std::make_shared<allocation_state>();
+    {
+        allocator allocation(state);
+        pool nodes(8, allocation);
+        pool::queue ready(allocation), cold(allocation);
+        auto pages = std::make_unique<std::array<int, 8>>();
+        state->fail = true;
+        bool rejected = false;
+        try { nodes.append(ready, &(*pages)[0]); } catch (const std::bad_alloc &) { rejected = true; }
+        require(rejected && ready.empty() && nodes.allocated_nodes() == 0,
+                "allocation failure consumed a node reservation or partially appended");
+        state->fail = false;
+        nodes.append(ready, &(*pages)[0]);
+        nodes.append(ready, &(*pages)[1]);
+        state->fail = true;
+        rejected = false;
+        try { nodes.append(ready, &(*pages)[2]); } catch (const std::bad_alloc &) { rejected = true; }
+        require(rejected && ready.size() == 2 && nodes.allocated_nodes() == 2, "partial planning failure lost ready nodes");
+        nodes.recycle(ready); // Exception cleanup must not allocate.
+        const size_t allocated = state->allocations;
+        nodes.append(ready, &(*pages)[3]);
+        nodes.append(ready, &(*pages)[4]);
+        require(state->allocations == allocated && ready.size() == 2, "exception cleanup failed to recover reusable nodes");
+        cold.splice(cold.end(), ready);
+        nodes.recycle(cold);
+        pages.reset(); // Recycled dangling pointer values must never be dereferenced, even on destruction.
+    }
+    require(state->live == 0 && state->allocations == state->releases, "failure cleanup leaked queue nodes");
+}
+
+static void plateau() {
+    constexpr size_t capacity = 128, cycles = 1024;
+    std::array<int, capacity> pages{};
+    auto baseline_state = std::make_shared<allocation_state>();
+    auto pooled_state = std::make_shared<allocation_state>();
+    double baseline_ms = 0, pooled_ms = 0;
+    size_t baseline_new = 0, pooled_new = 0;
+    {
+        allocator baseline_allocation(baseline_state), pooled_allocation(pooled_state);
+        pool::queue baseline(baseline_allocation), cold(pooled_allocation), ready(pooled_allocation);
+        pool nodes(capacity, pooled_allocation);
+        for (const auto & page : pages) { baseline.push_back(&page); nodes.append(cold, &page); }
+        const size_t before_baseline = baseline_state->allocations, before_pool = pooled_state->allocations;
+        const auto begin_baseline = std::chrono::steady_clock::now();
+        for (size_t cycle = 0; cycle < cycles; ++cycle) {
+            baseline.clear();
+            for (const auto & page : pages) { baseline.push_back(&page); }
+        }
+        baseline_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin_baseline).count();
+        const auto begin_pool = std::chrono::steady_clock::now();
+        for (size_t cycle = 0; cycle < cycles; ++cycle) {
+            nodes.recycle(cold);
+            for (const auto & page : pages) { nodes.append(ready, &page); }
+            cold.splice(cold.end(), ready);
+        }
+        pooled_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin_pool).count();
+        baseline_new = baseline_state->allocations - before_baseline;
+        pooled_new = pooled_state->allocations - before_pool;
+        require(pooled_new == 0 && baseline_new == capacity * cycles, "queue allocations did not plateau after warmup");
+        require(nodes.allocated_nodes() == capacity && nodes.recycled_nodes() == 0 && cold.size() == capacity,
+                "cycling exceeded total node cap or lost an active node");
+        require(std::equal(cold.begin(), cold.end(), baseline.begin()), "recycled queue changed the exact page order");
+    }
+    require(baseline_state->live == 0 && pooled_state->live == 0, "plateau fixture leaked queue nodes");
+    std::printf("RAM_QUEUE_NODES capacity=%zu cycles=%zu baseline_new=%zu recycled_new=%zu baseline_ms=%.6f recycled_ms=%.6f persistent_page_nodes=%zu\n",
+        capacity, cycles, baseline_new, pooled_new, baseline_ms, pooled_ms, capacity);
+}
+
+int main() {
+    try {
+        order_and_quota();
+        failure_return();
+        plateau();
+        std::puts("PASS RAM queue nodes: lazy allocation, combined cap, exact order, stable iterators, failure recovery and allocation plateau");
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        return 1;
+    }
+}
