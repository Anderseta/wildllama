diff --git a/ggml/src/ggml-attn-mask-compact.h b/ggml/src/ggml-attn-mask-compact.h
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-attn-mask-compact.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include "ggml.h"
+#include <cstdint>
+#include <cstring>
+
+// Internal, CUDA-only representation of the exact ordinary causal mask.
+// Interleaved (position, sequence-membership) pairs are stored for keys then
+// queries, once per stream. It is not a lower precision attention mask.
+constexpr int32_t GGML_ATTN_MASK_COMPACT_MAGIC = 0x57414d31;
+
+inline bool ggml_attn_mask_is_compact(const ggml_tensor * t) {
+    int32_t tag = 0;
+    if (t) { std::memcpy(&tag, t->op_params, sizeof(tag)); }
+    return t && t->op == GGML_OP_ATTN_MASK && t->type == GGML_TYPE_I32 &&
+        tag == GGML_ATTN_MASK_COMPACT_MAGIC;
+}
+
+inline bool ggml_attn_mask_compact_valid(const ggml_tensor * t) {
+    if (!ggml_attn_mask_is_compact(t) || !t->src[0] || !t->src[1]) { return false; }
+    const auto * k = t->src[0];
+    const auto * q = t->src[1];
+    return k->type == GGML_TYPE_I32 && q->type == GGML_TYPE_I32 &&
+        k->ne[0] > 0 && k->ne[0] <= INT32_MAX/2 && q->ne[0] > 0 && q->ne[0] <= 65535 &&
+        k->ne[1] == 2 && q->ne[1] == 2 && k->ne[2] > 0 && k->ne[2] <= 65535 && k->ne[2] == q->ne[2] &&
+        k->ne[3] == 1 && q->ne[3] == 1 && t->ne[0] == 2*(k->ne[0] + q->ne[0]) &&
+        t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == k->ne[2] &&
+        ggml_is_contiguous(t) && ggml_is_contiguous(k) && ggml_is_contiguous(q);
+}
+
+#if defined(__CUDACC__) || defined(__HIPCC__)
+#define GGML_MASK_HD __host__ __device__
+#else
+#define GGML_MASK_HD
+#endif
+GGML_MASK_HD inline bool ggml_attn_mask_compact_keep(
+        const int32_t * pairs, int32_t nk, int32_t q, int32_t k) {
+    const auto * query = pairs + 2*int64_t(nk) + 2*int64_t(q);
+    const auto * key = pairs + 2*int64_t(k);
+    return (uint32_t(key[1]) & uint32_t(query[1])) != 0 && key[0] <= query[0];
+}
+#undef GGML_MASK_HD
diff --git a/ggml/src/ggml-cuda/pool-trim-policy.h b/ggml/src/ggml-cuda/pool-trim-policy.h
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-cuda/pool-trim-policy.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <limits>
+
+// A small warm reserve and hysteresis avoid reallocating steady decode scratch.
+// A graph replay may perform no host-side pool allocations: retain the last
+// observed non-zero peak rather than mistaking that replay for an empty phase.
+struct ggml_cuda_pool_trim_policy {
+    static constexpr size_t warm_bytes = 16ull << 20;
+    static constexpr size_t minimum_release = 32ull << 20;
+    size_t peak = 0;
+    size_t last_peak = 0;
+
+    void observe(size_t used) { peak = std::max(peak, used); }
+
+    size_t idle_target(size_t used, size_t capacity, size_t granularity) {
+        if (peak) { last_peak = peak; }
+        peak = used;
+        const size_t live = std::max(used, last_peak);
+        if (!granularity || live > std::numeric_limits<size_t>::max()-warm_bytes) { return capacity; }
+        const size_t wanted = live + warm_bytes;
+        if (wanted > std::numeric_limits<size_t>::max()-(granularity-1)) { return capacity; }
+        const size_t aligned = (wanted+granularity-1)/granularity*granularity;
+        return capacity > aligned && capacity-aligned >= minimum_release ? aligned : capacity;
+    }
+};
