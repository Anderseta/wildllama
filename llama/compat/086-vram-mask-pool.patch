+    require(ggml_nbytes(mask)==expected_packed && ggml_nbytes(mask)<dense_bytes/8,
+        "packed representation byte accounting or storage reduction is incorrect");
+    auto invalid=*mask;invalid.ne[0]++;
+    require(!ggml_attn_mask_compact_valid(&invalid),"invalid compact shape accepted");
+    invalid=*mask;invalid.nb[3]++; // Both streams are live: this stride is semantically used.
+    require(!ggml_attn_mask_compact_valid(&invalid),"invalid compact stride accepted");
+    invalid=*mask;invalid.op_params[0]^=1;
+    require(!ggml_attn_mask_compact_valid(&invalid),"invalid metadata version accepted");
+    size_t checks=0;
+    std::vector<int32_t> pairs(2*(768+65));
+    for (int change=0;change<5;++change) {
+        for (int i=0;i<768+65;++i) {
+            pairs[2*i]=(i%19==0) ? INT32_MIN : (i%23==0) ? INT32_MAX : (i*73+change*17)%768-8;
+            const uint32_t bits=(uint32_t(1)<<((i+change)%32)) | (i%11==0 ? 0x80000001u : 0);
+            std::memcpy(&pairs[2*i+1],&bits,4);
+        }
+        for (int qi=0;qi<65;++qi) { for (int ki=0;ki<768;++ki) {
+            const auto * key=pairs.data()+2*ki;
+            const auto * query=pairs.data()+2*(768+qi);
+            const bool expected=(uint32_t(key[1])&uint32_t(query[1])) && key[0]<=query[0];
+            require(ggml_attn_mask_compact_keep(pairs.data(),768,qi,ki)==expected,"causal/sequence predicate mismatch");++checks;
+        } }
+    }
+    constexpr size_t mib=1ull<<20;
+    ggml_cuda_pool_trim_policy policy;
+    policy.observe(128*mib);
+    require(policy.idle_target(0,128*mib,2*mib)==128*mib,"trimmed active prefill peak");
+    require(policy.idle_target(0,128*mib,2*mib)==128*mib,"mistook allocation-free graph replay for idle scratch");
+    policy.observe(4*mib);
+    require(policy.idle_target(0,128*mib,2*mib)==20*mib,"did not trim old prefill excess");
+    require(policy.idle_target(0,20*mib,2*mib)==20*mib,"discarded stable warm reserve");
+    policy.observe(48*mib);
+    require(policy.idle_target(48*mib,96*mib,2*mib)==64*mib,"trim target crossed live scratch");
+    require(policy.idle_target(48*mib,64*mib,2*mib)==64*mib,"steady decode trim churn");
+    require(policy.idle_target(48*mib,64*mib,0)==64*mib,"zero granularity accepted");
+    std::printf("PASS compact metadata: %zu exact predicates; shape/version rejection; warm-pool hysteresis\n",checks);
+}
+
+static void environment(const char * name,const char * value) {
+#ifdef _WIN32
+    _putenv_s(name,value ? value : "");
+#else
+    if (value) { setenv(name,value,1); } else { unsetenv(name); }
+#endif
+}
