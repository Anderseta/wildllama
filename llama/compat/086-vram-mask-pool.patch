+static void cpu_rejection() {
+#ifdef GGML_TEST_CPU_BACKEND_PATH
+    require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH),"candidate CPU backend unavailable");
+    auto * reg=ggml_backend_reg_by_name("CPU");
+    require(reg && ggml_backend_reg_dev_count(reg),"CPU device unavailable");
+    ggml_backend_ptr cpu(ggml_backend_dev_init(ggml_backend_reg_dev_get(reg,0),nullptr));
+    ggml_context_ptr ctx(ggml_init({128*ggml_tensor_overhead(),nullptr,true}));
+    auto * keys=ggml_new_tensor_3d(ctx.get(),GGML_TYPE_I32,256,2,1);
+    auto * queries=ggml_new_tensor_3d(ctx.get(),GGML_TYPE_I32,32,2,1);
+    auto * mask=ggml_attn_mask(ctx.get(),keys,queries,GGML_TYPE_F16);
+    auto * q=ggml_new_tensor_4d(ctx.get(),GGML_TYPE_F32,64,32,2,1);
+    auto * k=ggml_new_tensor_4d(ctx.get(),GGML_TYPE_F16,64,256,2,1);
+    auto * v=ggml_new_tensor_4d(ctx.get(),GGML_TYPE_F16,64,256,2,1);
+    auto * fa=ggml_flash_attn_ext(ctx.get(),q,k,v,mask,.125f,0,0);
+    make_compact(mask);
+    require(!ggml_backend_supports_op(cpu.get(),mask),"CPU accepted private CUDA packed mask");
+    require(!ggml_backend_supports_op(cpu.get(),fa),"CPU accepted CUDA packed attention consumer");
+    std::puts("PASS CPU unsupported packed mask/attention rejection");
+#endif
+}
+
+// Exercise the real scratch allocator through F16 GEMM conversion, below a
+// 248 MiB managed quota, with all graph tensor buffers remaining live during
+// the measured release. Large/small graph replays must produce identical math.
+static void cuda_pool_contract(ggml_backend_reg_t registry) {
+    auto * device=ggml_backend_reg_dev_get(registry,0);
+    const auto set_limit=reinterpret_cast<decltype(&ggml_backend_cuda_set_memory_limit)>(
+        ggml_backend_reg_get_proc_address(registry,"ggml_backend_cuda_set_memory_limit"));
+    const auto get_stats=reinterpret_cast<decltype(&ggml_backend_cuda_get_memory_stats)>(
+        ggml_backend_reg_get_proc_address(registry,"ggml_backend_cuda_get_memory_stats"));
+    require(set_limit && get_stats,"CUDA memory quota diagnostics unavailable");
+    constexpr size_t mib=1ull<<20,limit=248*mib;
+    environment("WILDLLAMA_CUDA_POOL_TRIM","1");
+    environment("GGML_CUDA_CUBLAS_COMPUTE_TYPE","f16");
+    require(set_limit(device,limit,true),"cannot enable small CUDA pool quota");
+    struct release_limit { decltype(set_limit) fn;ggml_backend_dev_t device;~release_limit(){fn(device,0,false);} } owner{set_limit,device};
+    auto stats=[&]{ggml_backend_cuda_memory_stats s{};require(get_stats(device,&s),"cannot read memory quota");return s;};
+    size_t high=0,low=0;
+    {
+        ggml_backend_ptr backend(ggml_backend_dev_init(device,nullptr));
+        require(bool(backend),"CUDA pool test backend initialization failed");
+        ggml_context_ptr ctx(ggml_init({32*ggml_tensor_overhead()+2*ggml_graph_overhead_custom(32,false),nullptr,true}));
+        constexpr int width=4096,rows=64,large=8192,small=64;
+        auto * w=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_F16,width,rows);
+        auto * x=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_F32,width,large);
+        auto * xs=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_F32,width,small);
+        auto * out=ggml_mul_mat(ctx.get(),w,x);
+        auto * outs=ggml_mul_mat(ctx.get(),w,xs);
+        auto * heavy=ggml_new_graph_custom(ctx.get(),32,false);
+        auto * light=ggml_new_graph_custom(ctx.get(),32,false);
+        ggml_build_forward_expand(heavy,out);ggml_build_forward_expand(light,outs);
+        ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(ctx.get(),backend.get()));
+        require(bool(buffer),"CUDA pool graph tensor allocation failed");
+        const size_t tensor_bytes=stats().managed_used_bytes;
+        std::vector<ggml_fp16_t> weights(width*rows,ggml_fp32_to_fp16(.125f));
+        std::vector<float> values(width*large,.125f),little(width*small,.125f);
+        ggml_backend_tensor_set(w,weights.data(),0,weights.size()*2);
+        ggml_backend_tensor_set(x,values.data(),0,values.size()*4);
+        ggml_backend_tensor_set(xs,little.data(),0,little.size()*4);
+        auto compute=[&](ggml_cgraph * graph,ggml_tensor * result){
+            require(ggml_backend_graph_compute(backend.get(),graph)==GGML_STATUS_SUCCESS,"CUDA pool GEMM failed");
+            std::vector<float> output(ggml_nelements(result));
+            ggml_backend_tensor_get(result,output.data(),0,output.size()*4);
+            for (float f:output) { require(std::isfinite(f) && std::fabs(f-64.f)<1e-4f,"scratch trim changed GEMM/replay output"); }
+            const auto s=stats();require(s.managed_used_bytes<=limit && s.managed_peak_bytes<=limit,"scratch pool exceeded managed quota");
+        };
+        for (int i=0;i<5;++i) { compute(heavy,out); }
+        high=stats().managed_used_bytes;
+        require(high>tensor_bytes+32*mib,"large GEMM did not exercise temporary CUDA pool");
+        for (int i=0;i<5;++i) { compute(light,outs); }
+        low=stats().managed_used_bytes;
+        require(high>=low+32*mib,"idle scratch pool failed to return old large-phase backing");
+        const auto warm=stats().managed_used_bytes;
+        for (int i=0;i<5;++i) { compute(light,outs); }
+        require(stats().managed_used_bytes==warm,"stable small-phase replay repeatedly discarded warm reserve");
+        // Re-enter the large phase after old captured pointers were released.
+        for (int i=0;i<5;++i) { compute(heavy,out); }
+        require(stats().managed_used_bytes>=high,"large graph failed to rebuild its released scratch");
+    }
+    require(stats().managed_used_bytes==0,"CUDA pool destruction leaked managed quota accounting");
+    std::printf("PASS CUDA pool trim: high=%zu low=%zu released=%zu peak<=%zu graph_outputs_and_reentry_exact accounting_after_destroy=0\n",high,low,high-low,limit);
+    environment("WILDLLAMA_CUDA_POOL_TRIM",nullptr);
+    environment("GGML_CUDA_CUBLAS_COMPUTE_TYPE",nullptr);
+}
+
+static void cuda_case(ggml_backend_t backend,int nk,int nq,int ns,int gqa,bool effects,ggml_type kvtype) {
+    ggml_context_ptr ctx(ggml_init({128*ggml_tensor_overhead()+ggml_graph_overhead_custom(128,false),nullptr,true}));
+    const int width=effects ? 128 : 64;constexpr int heads=2;
+    auto * query=ggml_new_tensor_4d(ctx.get(),GGML_TYPE_F32,width,nq,heads*gqa,ns);
+    auto * key=ggml_new_tensor_4d(ctx.get(),kvtype,width,nk,heads,ns);
+    auto * value=ggml_new_tensor_4d(ctx.get(),kvtype,width,nk,heads,ns);
+    auto * keys=ggml_new_tensor_3d(ctx.get(),GGML_TYPE_I32,nk,2,ns);
+    auto * queries=ggml_new_tensor_3d(ctx.get(),GGML_TYPE_I32,nq,2,ns);
+    auto * dense=ggml_attn_mask(ctx.get(),keys,queries,GGML_TYPE_F16);
+    auto * compact=ggml_attn_mask(ctx.get(),keys,queries,GGML_TYPE_F16);
+    auto * reference=ggml_flash_attn_ext(ctx.get(),query,key,value,dense,0.125f,0,effects ? 3.f : 0.f);
+    auto * result=ggml_flash_attn_ext(ctx.get(),query,key,value,compact,0.125f,0,effects ? 3.f : 0.f);
+    ggml_tensor * sinks=nullptr;
+    if (effects) {
+        sinks=ggml_new_tensor_1d(ctx.get(),GGML_TYPE_F32,heads*gqa);
+        ggml_flash_attn_ext_add_sinks(reference,sinks);ggml_flash_attn_ext_add_sinks(result,sinks);
+    }
+    make_compact(compact);
+    require(ggml_backend_supports_op(backend,compact),"CUDA rejects valid packed mask");
+    require(ggml_backend_supports_op(backend,result),"CUDA FA rejects packed mask");
+    {
+        // Internally valid metadata is not sufficient: its bounds must also
+        // cover this particular attention consumer.
+        auto bad_keys=*keys;bad_keys.ne[0]-=32;
+        bad_keys.nb[1]=bad_keys.ne[0]*sizeof(int32_t);
+        bad_keys.nb[2]=2*bad_keys.nb[1];bad_keys.nb[3]=bad_keys.nb[2]*ns;
+        auto bad_mask=*compact;bad_mask.src[0]=&bad_keys;make_compact(&bad_mask);
+        require(ggml_attn_mask_compact_valid(&bad_mask),"cross-shape fixture is not independently valid");
+        auto bad_result=*result;bad_result.src[3]=&bad_mask;
+        require(!ggml_backend_supports_op(backend,&bad_result),"CUDA accepted insufficient key metadata");
+        if (nq>1) {
+            auto bad_queries=*queries;--bad_queries.ne[0];
+            bad_queries.nb[1]=bad_queries.ne[0]*sizeof(int32_t);
+            bad_queries.nb[2]=2*bad_queries.nb[1];bad_queries.nb[3]=bad_queries.nb[2]*ns;
+            bad_mask=*compact;bad_mask.src[1]=&bad_queries;make_compact(&bad_mask);
+            require(ggml_attn_mask_compact_valid(&bad_mask),"short-query metadata fixture is invalid");
+            bad_result=*result;bad_result.src[3]=&bad_mask;
+            require(!ggml_backend_supports_op(backend,&bad_result),"CUDA accepted insufficient query metadata");
+        }
+        bad_mask=*compact;bad_mask.op_params[0]^=1;
+        bad_result=*result;bad_result.src[3]=&bad_mask;
+        require(!ggml_backend_supports_op(backend,&bad_result),"CUDA accepted unknown packed mask version");
+    }
+    auto * graph=ggml_new_graph_custom(ctx.get(),128,false);
+    ggml_build_forward_expand(graph,reference);ggml_build_forward_expand(graph,result);
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(ctx.get(),backend));
+    require(bool(buffer),"small CUDA fixture allocation failed");
+    size_t total=0;
+    for (auto * tensor:{query,key,value}) { total+=ggml_nbytes(tensor); }
+    require(total<32ull*1024*1024,"fixture exceeds small-GPU test budget");
+    std::vector<float> qs(ggml_nelements(query));
+    for (size_t i=0;i<qs.size();++i) { qs[i]=std::sin(float(i%317)*.09f)*.4f; }
+    ggml_backend_tensor_set(query,qs.data(),0,qs.size()*sizeof(float));
+    // Native quantizer is used once; both paths consume identical stored bytes.
+    for (auto * tensor:{key,value}) {
+        std::vector<float> values(ggml_nelements(tensor));
+        for (size_t i=0;i<values.size();++i) { values[i]=std::cos(float((i+(tensor==value ? 7 : 0))%239)*.07f)*.3f; }
+        std::vector<unsigned char> encoded(ggml_nbytes(tensor));
+        ggml_quantize_chunk(kvtype,values.data(),encoded.data(),0,ggml_nelements(tensor)/width,width,nullptr);
+        ggml_backend_tensor_set(tensor,encoded.data(),0,encoded.size());
+    }
+    if (sinks) { std::vector<float> ss(heads*gqa,.15f);ggml_backend_tensor_set(sinks,ss.data(),0,ss.size()*4); }
+    std::vector<int32_t> kp(2*nk*ns),qp(2*nq*ns);
+    std::vector<float> expected(ggml_nelements(result)),actual(expected.size());
+    float max_error=0;
+    for (int change=0;change<5;++change) {
+        for (int s=0;s<ns;++s) {
+            for (int i=0;i<nk;++i) {
+                const int at=s*2*nk+i;
+                kp[at]=i==0 ? INT32_MIN : (i*73+change*17+s)%nk;
+                uint32_t bits=i==0 ? 0xffffffffu : i%7==0 ? 0 : uint32_t(1)<<((i+change+s)%32);
+                if (i%11==0) { bits|=0x80000001u; }
+                std::memcpy(&kp[at+nk],&bits,4);
+            }
+            for (int i=0;i<nq;++i) {
+                const int at=s*2*nq+i;
+                qp[at]=i%13==0 ? INT32_MIN : (i*59+change*7+s)%nk;
+                const uint32_t bits=uint32_t(1)<<((i+3*change+s)%32);
+                std::memcpy(&qp[at+nq],&bits,4);
+            }
+        }
+        ggml_backend_tensor_set(keys,kp.data(),0,kp.size()*4);ggml_backend_tensor_set(queries,qp.data(),0,qp.size()*4);
+        require(ggml_backend_graph_compute(backend,graph)==GGML_STATUS_SUCCESS,"CUDA attention computation failed");
+        ggml_backend_tensor_get(reference,expected.data(),0,expected.size()*4);
+        ggml_backend_tensor_get(result,actual.data(),0,actual.size()*4);
+        for (size_t i=0;i<actual.size();++i) {
+            require(std::isfinite(expected[i]) && std::isfinite(actual[i]),"non-finite compact attention result");
+            const float error=std::fabs(actual[i]-expected[i])/std::max(1.f,std::fabs(expected[i]));
+            max_error=std::max(max_error,error);require(error<2e-4f,"compact attention differs from dense mature FA");
+        }
+    }
+    std::printf("PASS CUDA compact FA: nk=%d nq=%d streams=%d GQA=%d effects=%d type=%s changed_inputs=5 max_scaled_error=%.9g dense=%zu packed=%zu\n",
+        nk,nq,ns,gqa,int(effects),ggml_type_name(kvtype),max_error,ggml_nbytes(dense),ggml_nbytes(compact));
+}
+
+int main(int argc,char ** argv) {
+    try {
+        host_contracts();
+        cpu_rejection();
+        if (argc<2 || std::string(argv[1])=="--host-only") { return 0; }
+        require(std::string(argv[1])=="--cuda","use --host-only or --cuda");
+#ifdef GGML_TEST_CUDA_BACKEND_PATH
+        require(ggml_backend_load(GGML_TEST_CUDA_BACKEND_PATH),"candidate CUDA backend unavailable");
+#else
+        const char * path=std::getenv("GGML_BACKEND_PATH");require(path && ggml_backend_load(path),"set GGML_BACKEND_PATH to candidate CUDA backend");
+#endif
+        auto * registry=ggml_backend_reg_by_name("CUDA");
+        if (!registry || !ggml_backend_reg_dev_count(registry)) { std::puts("SKIP no CUDA device");return 77; }
+        ggml_backend_ptr backend(ggml_backend_dev_init(ggml_backend_reg_dev_get(registry,0),nullptr));
+        require(bool(backend),"CUDA backend initialization failed");
+        for (auto type:{GGML_TYPE_F16,GGML_TYPE_Q8_0}) {
+            cuda_case(backend.get(),256,1,1,1,false,type);
+            cuda_case(backend.get(),512,2,1,4,true,type);
+            cuda_case(backend.get(),768,5,2,8,true,type);
+            cuda_case(backend.get(),512,65,2,4,false,type);
+            cuda_case(backend.get(),512,1024,1,4,false,type);
+            cuda_case(backend.get(),512,1025,1,4,false,type);
+        }
+        backend.reset();
+        cuda_pool_contract(registry);
+        return 0;
+    } catch (const std::exception & e) { std::fprintf(stderr,"FAIL %s\n",e.what());return 1; }
+}
