diff --git a/ggml/include/ggml-output-copy-plan.h b/ggml/include/ggml-output-copy-plan.h
new file mode 100644
--- /dev/null
+++ b/ggml/include/ggml-output-copy-plan.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+struct ggml_output_copy_row {
+    uintptr_t address = 0;
+    uintptr_t owner = 0;
+    uintptr_t buffer_begin = 0;
+    size_t buffer_bytes = 0;
+    size_t bytes = 0;
+    bool eligible = false;
+};
+
+struct ggml_output_copy_plan {
+    static constexpr size_t max_rows = 1024;
+    static constexpr size_t max_row_bytes = 64 * 1024;
+    size_t rows = 0;
+    size_t row_bytes = 0;
+    size_t source_stride = 0;
+};
+
+inline bool ggml_output_copy_row_valid(const ggml_output_copy_row & row) {
+    const auto maximum = std::numeric_limits<uintptr_t>::max();
+    return row.eligible && row.owner && row.buffer_begin && row.address && row.bytes &&
+        row.bytes <= ggml_output_copy_plan::max_row_bytes && row.bytes % 4 == 0 && row.address % 4 == 0 &&
+        row.buffer_bytes <= maximum - row.buffer_begin && row.address >= row.buffer_begin &&
+        row.address - row.buffer_begin <= row.buffer_bytes &&
+        row.bytes <= row.buffer_bytes - (row.address - row.buffer_begin);
+}
+
+// Inspect original rows. No envelope tensor or extra staging allocation is created.
+template <typename RowAt>
+ggml_output_copy_plan ggml_output_copy_rows(size_t available, uintptr_t destination,
+        size_t destination_stride, size_t destination_bytes, RowAt row_at) {
+    const auto maximum = std::numeric_limits<uintptr_t>::max();
+    if (available < 2 || !destination || destination % 4 || !destination_stride ||
+            destination_stride % 4 || destination_bytes > maximum - destination) { return {}; }
+    const auto first = row_at(0);
+    if (!ggml_output_copy_row_valid(first) || first.bytes > destination_stride ||
+            first.bytes > destination_bytes) { return {}; }
+    const size_t rows_fit = 1 + (destination_bytes - first.bytes) / destination_stride;
+    const size_t limit = std::min({available, rows_fit, ggml_output_copy_plan::max_rows});
+    if (limit < 2) { return {}; }
+    const uintptr_t destination_end = destination + (limit - 1) * destination_stride + first.bytes;
+    if (destination < first.buffer_begin + first.buffer_bytes && first.buffer_begin < destination_end) { return {}; }
+    const auto second = row_at(1);
+    if (!ggml_output_copy_row_valid(second) || second.owner != first.owner ||
+            second.buffer_begin != first.buffer_begin || second.buffer_bytes != first.buffer_bytes ||
+            second.bytes != first.bytes || second.address <= first.address) { return {}; }
+    const size_t pitch = second.address - first.address;
+    if (pitch < first.bytes || pitch % 4) { return {}; }
+    size_t count = 2;
+    for (; count < limit; ++count) {
+        const auto row = row_at(count);
+        if (!ggml_output_copy_row_valid(row) || row.owner != first.owner ||
+                row.buffer_begin != first.buffer_begin || row.buffer_bytes != first.buffer_bytes ||
+                row.bytes != first.bytes || count > (maximum - first.address) / pitch ||
+                row.address != first.address + count * pitch) { break; }
+    }
+    return {count, first.bytes, pitch};
+}
