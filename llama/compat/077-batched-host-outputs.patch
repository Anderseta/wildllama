+extern "C" {
+#endif
+
+// Optional registry extension "ggml_backend_cuda_output_api". A return value
+// of zero enqueues nothing; the caller retains its original per-row path.
+struct ggml_backend_cuda_output_api {
+    uint32_t version;
+    size_t (*copy_rows)(ggml_backend_t backend, ggml_backend_sched_t scheduler,
+        const struct ggml_tensor * const * tensors, size_t rows, void * destination,
+        size_t destination_stride_bytes, size_t destination_capacity_bytes);
+};
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/ggml/src/ggml-cuda/host-output.cuh b/ggml/src/ggml-cuda/host-output.cuh
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-cuda/host-output.cuh
@@ -0,0 +1,68 @@
+#pragma once
+
+#include "ggml-cuda-output.h"
+#include "ggml-output-copy-plan.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace wildllama_cuda_output {
+inline size_t copy_rows(ggml_backend_t backend, ggml_backend_sched_t scheduler,
+        const ggml_tensor * const * tensors, size_t rows, void * destination,
+        size_t destination_stride, size_t destination_capacity) {
+    if (!backend || !scheduler || !tensors || !destination || rows < 2 || !ggml_backend_is_cuda(backend)) { return 0; }
+    auto * context = static_cast<ggml_backend_cuda_context *>(backend->context);
+    const auto buffer_type = ggml_backend_cuda_buffer_type(context->device);
+    const auto type = tensors[0] ? tensors[0]->type : GGML_TYPE_COUNT;
+    auto inspect = [&](size_t index) -> ggml_output_copy_row {
+        const auto * tensor = tensors[index];
+        if (!tensor || tensor->type != type || (type != GGML_TYPE_F32 && type != GGML_TYPE_I32) ||
+                tensor->ne[0] <= 0 || tensor->ne[0] > int64_t(ggml_output_copy_plan::max_row_bytes / 4) ||
+                !ggml_is_vector(tensor) || !ggml_is_contiguous(tensor) || !tensor->data ||
+                ggml_backend_sched_get_tensor_backend(scheduler, const_cast<ggml_tensor *>(tensor)) != backend) { return {}; }
+        auto * buffer = tensor->buffer;
+        if (!buffer || buffer->buft != buffer_type ||
+                (tensor->view_src && tensor->view_src->buffer != buffer) ||
+                buffer->iface.get_base != ggml_backend_cuda_buffer_interface.get_base ||
+                buffer->iface.free_buffer != ggml_backend_cuda_buffer_interface.free_buffer) { return {}; }
+        const auto * storage = static_cast<const ggml_backend_cuda_buffer_context *>(buffer->context);
+        if (storage->kv_vmm) { return {}; }
+        return {reinterpret_cast<uintptr_t>(tensor->data), reinterpret_cast<uintptr_t>(buffer),
+            reinterpret_cast<uintptr_t>(storage->dev_ptr), buffer->size, size_t(tensor->ne[0]) * 4, true};
+    };
+    const auto plan = ggml_output_copy_rows(rows, reinterpret_cast<uintptr_t>(destination),
+        destination_stride, destination_capacity, inspect);
+    if (plan.rows < 2) { return 0; }
+    ggml_cuda_set_device(context->device);
+    if (plan.source_stride == plan.row_bytes && destination_stride == plan.row_bytes) {
+        CUDA_CHECK(cudaMemcpyAsync(destination, tensors[0]->data, plan.rows * plan.row_bytes,
+            cudaMemcpyDeviceToHost, context->stream()));
+    } else {
+        // Cache this immutable device limit on the calling inference thread.
+        static thread_local int last_device = -1;
+        static thread_local size_t maximum_pitch = 0;
+        const int physical = ggml_cuda_get_physical_device(context->device);
+        if (last_device != physical) {
+            int value = 0;
+            if (cudaDeviceGetAttribute(&value, cudaDevAttrMaxPitch, physical) != cudaSuccess || value <= 0) { return 0; }
+            maximum_pitch = size_t(value);
+            last_device = physical;
+        }
+        if (plan.source_stride > maximum_pitch || destination_stride > maximum_pitch) { return 0; }
+        CUDA_CHECK(cudaMemcpy2DAsync(destination, destination_stride, tensors[0]->data,
+            plan.source_stride, plan.row_bytes, plan.rows, cudaMemcpyDeviceToHost, context->stream()));
+    }
+    static const bool trace = [] {
+        const char * value = std::getenv("GGML_CUDA_OUTPUT_TRACE");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    if (trace) {
+        std::fprintf(stderr, "cuda_output: rows=%zu row_bytes=%zu source_pitch=%zu host_pitch=%zu\n",
+            plan.rows, plan.row_bytes, plan.source_stride, destination_stride);
+    }
+    return plan.rows;
+}
+
+inline const ggml_backend_cuda_output_api api = {1, copy_rows};
+}
