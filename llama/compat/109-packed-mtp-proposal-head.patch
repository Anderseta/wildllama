@@ -38,3 +43,114 @@ inline llama_indexed_head_graph llama_build_indexed_head(
     result.logits = ggml_reshape_2d(ctx, scattered, w->ne[1], 1);
     return result;
 }
+
+
+struct llama_packed_draft_head {
+    static constexpr int64_t max_rows = 32768;
+    static constexpr size_t max_bytes = size_t{128} << 20;
+    static constexpr size_t headroom = size_t{256} << 20;
+
+    ggml_backend_t backend;
+    const ggml_tensor * source;
+    ggml_context_ptr ctx;
+    ggml_backend_buffer_ptr storage;
+    ggml_backend_buffer_ptr host_stage;
+    ggml_backend_event_ptr upload_done;
+    ggml_tensor * weights = nullptr;
+    ggml_tensor * ids = nullptr;
+    ggml_tensor * changes = nullptr;
+    ggml_backend_cuda_mtp_pack_rows_t pack;
+    std::vector<int32_t> current;
+    std::vector<ggml_cuda_mtp_pack_row> pending;
+    bool submitted = false;
+
+    llama_packed_draft_head(ggml_backend_t backend, const ggml_tensor * source,
+            ggml_backend_cuda_mtp_pack_rows_t pack, int64_t count) :
+        backend(backend), source(source), pack(pack), current(size_t(count), -1) {
+        pending.reserve(size_t(count));
+    }
+
+    static std::unique_ptr<llama_packed_draft_head> create(
+            ggml_backend_t backend, const ggml_tensor * source, int64_t count) {
+        if (!backend || !source || source->type != GGML_TYPE_Q4_K || !source->buffer ||
+                !ggml_is_matrix(source) || !ggml_is_contiguous(source) ||
+                count <= 0 || count >= source->ne[1] || count > max_rows ||
+                source->nb[1] > max_bytes/size_t(count)) {
+            return nullptr;
+        }
+        const auto device = ggml_backend_get_device(backend);
+        const auto buft = ggml_backend_dev_buffer_type(device);
+        if (ggml_backend_buffer_get_type(source->buffer) != buft) {
+            return nullptr;
+        }
+        const auto pack = reinterpret_cast<ggml_backend_cuda_mtp_pack_rows_t>(
+                ggml_backend_reg_get_proc_address(ggml_backend_dev_backend_reg(device),
+                    "ggml_backend_cuda_mtp_pack_rows"));
+        const auto host_buft = ggml_backend_dev_host_buffer_type(device);
+        if (!pack || !host_buft) {
+            return nullptr;
+        }
+
+        auto result = std::make_unique<llama_packed_draft_head>(backend, source, pack, count);
+        result->ctx.reset(ggml_init({3*ggml_tensor_overhead(), nullptr, true}));
+        if (!result->ctx) {
+            return nullptr;
+        }
+        result->weights = ggml_new_tensor_2d(result->ctx.get(), GGML_TYPE_Q4_K, source->ne[0], count);
+        result->ids = ggml_new_tensor_2d(result->ctx.get(), GGML_TYPE_I32, count, 1);
+        result->changes = ggml_new_tensor_2d(result->ctx.get(), GGML_TYPE_I32, 2, count);
+        const size_t bytes = ggml_backend_alloc_ctx_tensors_from_buft_size(result->ctx.get(), buft);
+        size_t free = 0, total = 0;
+        ggml_backend_dev_memory(device, &free, &total);
+        if (!bytes || bytes > max_bytes || free < bytes + headroom) {
+            return nullptr;
+        }
+        result->storage.reset(ggml_backend_alloc_ctx_tensors_from_buft(result->ctx.get(), buft));
+        if (!result->storage || ggml_backend_buffer_get_size(result->storage.get()) > max_bytes) {
+            return nullptr;
+        }
+        result->host_stage.reset(ggml_backend_buft_alloc_buffer(host_buft, size_t(count)*sizeof(ggml_cuda_mtp_pack_row)));
+        if (!result->host_stage || ggml_backend_buffer_get_type(result->host_stage.get()) != host_buft) {
+            return nullptr;
+        }
+        result->upload_done.reset(ggml_backend_event_new(device));
+        if (!result->upload_done) {
+            return nullptr;
+        }
+        return result;
+    }
+
+    bool refresh(const std::vector<int32_t> & wanted) {
+        if (wanted.size() != current.size()) {
+            return false;
+        }
+        pending.clear();
+        for (size_t i = 0; i < wanted.size(); ++i) {
+            if (wanted[i] < 0 || wanted[i] >= source->ne[1]) {
+                return false;
+            }
+            if (wanted[i] != current[i]) {
+                pending.push_back({int32_t(i), wanted[i]});
+            }
+        }
+        if (pending.empty()) {
+            return submitted;
+        }
+        if (!pack(backend, source, weights, ids, changes, host_stage.get(), upload_done.get(),
+                pending.data(), pending.size(), submitted)) {
+            return false;
+        }
+        std::copy(wanted.begin(), wanted.end(), current.begin());
+        submitted = true;
+        return true;
+    }
+};
+
+inline llama_indexed_head_graph llama_build_packed_head(
+        ggml_context * ctx, const llama_packed_draft_head & cache, ggml_tensor * input) {
+    auto * logits = ggml_mul_mat(ctx, cache.weights, input);
+    auto * compact = ggml_reshape_3d(ctx, logits, 1, cache.ids->ne[0], 1);
+    auto * base = ggml_fill(ctx, ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, cache.source->ne[1], 1), -INFINITY);
+    auto * scattered = ggml_set_rows(ctx, base, compact, cache.ids);
+    return {ggml_reshape_2d(ctx, scattered, cache.source->ne[1], 1), {logits, base, scattered}};
+}
