+struct ggml_cuda_mtp_pack_row {
+    int32_t position;
+    int32_t token;
+};
+static_assert(sizeof(ggml_cuda_mtp_pack_row) == 2*sizeof(int32_t));
+
+using ggml_backend_cuda_mtp_pack_rows_t = bool (*)(
+        ggml_backend_t backend, const ggml_tensor * source, ggml_tensor * weights, ggml_tensor * ids,
+        ggml_tensor * changes, ggml_backend_buffer_t host_stage, ggml_backend_event_t upload_done,
+        const ggml_cuda_mtp_pack_row * update, size_t count, bool pending);
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 787866f..b287988 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -7555,7 +7555,87 @@ static ggml_backend_feature * ggml_backend_cuda_get_features(ggml_backend_reg_t
     GGML_UNUSED(reg);
 }
 
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+#include "ggml-cuda-mtp-pack.h"
+
+static __global__ void ggml_cuda_mtp_pack_rows(
+        const uint4 * __restrict__ source, uint4 * __restrict__ packed, int32_t * __restrict__ ids,
+        const ggml_cuda_mtp_pack_row * __restrict__ changes, int stride) {
+    const auto row = changes[blockIdx.x];
+    for (int i = threadIdx.x; i < stride; i += blockDim.x) {
+        packed[size_t(row.position)*stride + i] = source[size_t(row.token)*stride + i];
+    }
+    if (threadIdx.x == 0) {
+        ids[row.position] = row.token;
+    }
+}
+
+static bool ggml_backend_cuda_mtp_pack_rows(
+        ggml_backend_t backend, const ggml_tensor * source, ggml_tensor * weights, ggml_tensor * ids,
+        ggml_tensor * changes, ggml_backend_buffer_t host_stage, ggml_backend_event_t upload_done,
+        const ggml_cuda_mtp_pack_row * update, size_t count, bool pending) {
+    if (!ggml_backend_is_cuda(backend) || !source || !weights || !ids || !changes || !host_stage ||
+            !upload_done || upload_done->device != ggml_backend_get_device(backend) || !update ||
+            !count || count > 32768 || !ggml_backend_buft_is_cuda_host(host_stage->buft) ||
+            count*sizeof(*update) > ggml_backend_buffer_get_size(host_stage) ||
+            count*sizeof(*update) > ggml_nbytes(changes) ||
+            source->type != GGML_TYPE_Q4_K || weights->type != GGML_TYPE_Q4_K ||
+            ids->type != GGML_TYPE_I32 || !ggml_is_matrix(source) || !ggml_is_matrix(weights) ||
+            ids->ne[0] != weights->ne[1] || source->ne[0] != weights->ne[0] ||
+            !ggml_is_contiguous(source) || !ggml_is_contiguous(weights) ||
+            source->nb[1] % sizeof(uint4) != 0 ||
+            reinterpret_cast<uintptr_t>(source->data) % alignof(uint4) != 0 ||
+            reinterpret_cast<uintptr_t>(weights->data) % alignof(uint4) != 0) {
+        return false;
+    }
+
+    auto * ctx = static_cast<ggml_backend_cuda_context *>(backend->context);
+    const auto buft = ggml_backend_cuda_buffer_type(ctx->device);
+    for (const auto * tensor : {source, static_cast<const ggml_tensor *>(weights),
+            static_cast<const ggml_tensor *>(ids), static_cast<const ggml_tensor *>(changes)}) {
+        if (!tensor->data || !tensor->buffer || ggml_backend_buffer_get_type(tensor->buffer) != buft) {
+            return false;
+        }
+    }
+    for (size_t i = 0; i < count; ++i) {
+        if (update[i].position < 0 || update[i].position >= weights->ne[1] ||
+                update[i].token < 0 || update[i].token >= source->ne[1]) {
+            return false;
+        }
+    }
+
+    ggml_cuda_set_device(ctx->device);
+    auto stream = ctx->stream();
+    cudaStreamCaptureStatus capture = cudaStreamCaptureStatusNone;
+    if (cudaStreamIsCapturing(stream, &capture) != cudaSuccess || capture != cudaStreamCaptureStatusNone) {
+        return false;
+    }
+    auto event = static_cast<cudaEvent_t>(upload_done->context);
+    if (pending && cudaEventQuery(event) != cudaSuccess) {
+        return false;
+    }
+
+    // The event protects the pinned host copy. The next upload and this gather
+    // use the same stream as the consuming graph, including replay.
+    void * staging = ggml_backend_buffer_get_base(host_stage);
+    std::memcpy(staging, update, count*sizeof(*update));
+    CUDA_CHECK(cudaMemcpyAsync(changes->data, staging, count*sizeof(*update), cudaMemcpyHostToDevice, stream));
+    CUDA_CHECK(cudaEventRecord(event, stream));
+    ggml_cuda_mtp_pack_rows<<<unsigned(count), 128, 0, stream>>>(
+            static_cast<const uint4 *>(source->data), static_cast<uint4 *>(weights->data),
+            static_cast<int32_t *>(ids->data), static_cast<const ggml_cuda_mtp_pack_row *>(changes->data),
+            int(source->nb[1]/sizeof(uint4)));
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+#endif
+
 static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+    if (strcmp(name, "ggml_backend_cuda_mtp_pack_rows") == 0) {
+        return (void *) ggml_backend_cuda_mtp_pack_rows;
+    }
+#endif
     if (strcmp(name, "ggml_backend_gdn_compact_v2") == 0) {
         return (void *) ggml_cuda_gdn_extended_interface;
     }
