+            try {
+                mtp_packed_head = llama_packed_draft_head::create(backend.get(), mtp_pack_source, mtp_draft_vocab.ids.size());
+            } catch (const std::bad_alloc &) {
+                // This is optional memory. Keep the existing indexed path.
+            }
+            if (mtp_packed_head) {
+                LLAMA_LOG_INFO("mtp_draft_vocab: packed %zu Q4_K rows, %.2f MiB device storage\n",
+                        mtp_draft_vocab.ids.size(), ggml_backend_buffer_get_size(mtp_packed_head->storage.get()) / 1048576.0);
+            }
+            break;
+        }
+    }
+    if (!mtp_packed_head) {
+        return false;
+    }
+    if (mtp_packed_head->submitted && mtp_pack_revision == mtp_draft_vocab.revision) {
+        return true;
+    }
+    if (!mtp_packed_head->refresh(mtp_draft_vocab.ids)) {
+        return false;
+    }
+    mtp_pack_revision = mtp_draft_vocab.revision;
+    return true;
+}
