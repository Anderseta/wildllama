diff --git a/tests/test-server-component.cpp b/tests/test-server-component.cpp
index d738b21..eb29e10 100644
--- a/tests/test-server-component.cpp
+++ b/tests/test-server-component.cpp
@@ -670,6 +670,41 @@ static void test_grammar_first_request_contract(testing & t) {
     t.assert_true("string cannot silently change order",rejected);
 }
 
+static void test_stream_message_materialization(testing & t) {
+    for (const auto type : {TASK_RESPONSE_TYPE_NONE, TASK_RESPONSE_TYPE_OAI_CMPL,
+                            TASK_RESPONSE_TYPE_OAI_CHAT, TASK_RESPONSE_TYPE_OAI_RESP,
+                            TASK_RESPONSE_TYPE_ANTHROPIC, TASK_RESPONSE_TYPE_OAI_ASR}) {
+        const bool plain = type == TASK_RESPONSE_TYPE_NONE || type == TASK_RESPONSE_TYPE_OAI_CMPL;
+        task_result_state state;
+        std::string expected;
+        for (const std::string piece : {"one", " two"}) {
+            server_task_result_cmpl_partial part{};
+            part.res_type = type;
+            part.content = common_chat_input(piece);
+            part.n_decoded = expected.empty() ? 1 : 2;
+            expected += piece;
+            part.update(state);
+            t.assert_true("partial marked updated", part.is_updated);
+            if (plain) {
+                const auto output = part.to_json();
+                const auto & text = type == TASK_RESPONSE_TYPE_NONE ? output.at("content") :
+                    output.at("choices").at(0).at("text");
+                t.assert_true("plain response emits this chunk", text == piece);
+                t.assert_true("plain response needs no parser history", state.chat_msg.content.empty());
+            } else {
+                t.assert_true("structured response retains transcript", state.chat_msg.content == expected);
+                t.assert_true("structured response emits only new bytes", part.oaicompat_msg_diffs.size() == 1 &&
+                    part.oaicompat_msg_diffs.front().content_delta == piece);
+            }
+        }
+        server_task_result_cmpl_final final{};
+        final.res_type = type;
+        final.update(state);
+        t.assert_true("final transcript is available to structured serializers",
+            final.oaicompat_msg.content == (plain ? std::string{} : expected));
+    }
+}
+
 int main(int argc, char ** argv) {
     testing t;
 
@@ -697,5 +732,7 @@ int main(int argc, char ** argv) {
     t.test("grammar_first_request", test_grammar_first_request_contract);
     t.test("prompt_response_materialization", test_prompt_response_materialization);
 
+    t.test("stream_message_materialization", test_stream_message_materialization);
+
     return t.summary();
 }
