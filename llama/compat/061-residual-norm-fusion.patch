diff --git a/ggml/src/ggml-cuda/residual-norm.h b/ggml/src/ggml-cuda/residual-norm.h
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-cuda/residual-norm.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include "ggml-impl.h"
+
+#include <cmath>
+#include <cstdint>
+#include <limits>
+
+// No lifetime extensions: allocator aliases simply retain the ordinary kernels.
+inline bool ggml_cuda_residual_norm_disjoint(const ggml_tensor * a, const ggml_tensor * b) {
+    if (!a || !b || !a->data || !b->data) { return false; }
+    const auto x = reinterpret_cast<uintptr_t>(a->data);
+    const auto y = reinterpret_cast<uintptr_t>(b->data);
+    const auto nx = ggml_nbytes(a), ny = ggml_nbytes(b);
+    if (x > std::numeric_limits<uintptr_t>::max() - nx ||
+        y > std::numeric_limits<uintptr_t>::max() - ny) { return false; }
+    return x + nx <= y || y + ny <= x;
+}
+
+inline bool ggml_cuda_match_residual_norm(const ggml_cgraph * graph, int i, bool allocated) {
+    if (i < 0 || graph->n_nodes < 3 || i > graph->n_nodes - 3 ||
+        !ggml_can_fuse_subgraph(graph, i,
+            { GGML_OP_ADD, GGML_OP_RMS_NORM, GGML_OP_MUL }, { i, i + 2 })) { return false; }
+    const auto * add = graph->nodes[i];
+    const auto * norm = graph->nodes[i + 1];
+    const auto * output = graph->nodes[i + 2];
+    if (norm->src[0] != add || (output->src[0] != norm && output->src[1] != norm)) { return false; }
+    const auto * input = add->src[0];
+    const auto * residual = add->src[1];
+    const auto * weight = output->src[0] == norm ? output->src[1] : output->src[0];
+    if (!input || !residual || !weight || input->ne[0] <= 0 || input->ne[0] > 16384 ||
+        input->ne[0] % 4 != 0 || ggml_nelements(input) / input->ne[0] > 512 ||
+        weight->ne[0] != input->ne[0] || weight->ne[1] != 1 || weight->ne[2] != 1 || weight->ne[3] != 1) {
+        return false;
+    }
+    for (const auto * tensor : { input, residual, add, norm, output }) {
+        if (tensor->type != GGML_TYPE_F32 || !ggml_is_contiguous(tensor) ||
+            !ggml_are_same_shape(input, tensor)) { return false; }
+    }
+    if (weight->type != GGML_TYPE_F32 || !ggml_is_contiguous(weight) ||
+        !std::isfinite(ggml_get_op_params_f32(norm, 0)) || ggml_get_op_params_f32(norm, 0) < 0.0f) { return false; }
+    if (!allocated) { return true; }
+    for (const auto * tensor : { input, residual, add, output, weight }) {
+        if (!tensor->data || (reinterpret_cast<uintptr_t>(tensor->data) & 15) != 0) { return false; }
+    }
+    if (!ggml_cuda_residual_norm_disjoint(add, output)) { return false; }
+    for (const auto * dst : { add, output }) {
+        for (const auto * src : { input, residual, weight }) {
+            if (!ggml_cuda_residual_norm_disjoint(dst, src)) { return false; }
+        }
+    }
+    return true;
+}
