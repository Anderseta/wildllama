+static void test_residual_norm_plan() {
+    auto ctx = context();
+    auto * input = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, 128, 2);
+    auto * residual = ggml_dup_tensor(ctx.get(), input);
+    auto * weight = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 128);
+    auto * add = ggml_add(ctx.get(), input, residual);
+    auto * norm = ggml_rms_norm(ctx.get(), add, 1e-6f);
+    auto * output = ggml_mul(ctx.get(), norm, weight);
+    auto * graph = ggml_new_graph(ctx.get());
+    ggml_set_output(add);
+    ggml_set_output(output);
+    ggml_build_forward_expand(graph, output);
+    require(ggml_cuda_match_residual_norm(graph, 0, false), "residual output must remain externally usable");
+    require(!ggml_cuda_match_residual_norm(graph, -1, false) &&
+            !ggml_cuda_match_residual_norm(graph, 1, false), "invalid residual pattern index admitted");
+    require(!ggml_cuda_match_residual_norm(graph, 0, true), "unallocated residual graph admitted");
+    uintptr_t address = 0x100000;
+    for (auto * tensor : { input, residual, weight, add, output }) {
+        tensor->data = reinterpret_cast<void *>(address);
+        address += 0x100000;
+    }
+    require(ggml_cuda_match_residual_norm(graph, 0, true), "disjoint residual graph rejected");
+    std::swap(output->src[0], output->src[1]);
+    require(ggml_cuda_match_residual_norm(graph, 0, true), "commuted normalization weight rejected");
+    std::swap(output->src[0], output->src[1]);
+    void * saved = output->data;
+    for (const auto * tensor : { input, residual, add, weight }) {
+        output->data = tensor->data;
+        require(!ggml_cuda_match_residual_norm(graph, 0, true), "overlapping output admitted");
+    }
+    output->data = reinterpret_cast<char *>(saved) + 4;
+    require(!ggml_cuda_match_residual_norm(graph, 0, true), "unaligned output admitted");
+    output->data = saved;
+    saved = add->data;
+    add->data = input->data;
+    require(!ggml_cuda_match_residual_norm(graph, 0, true), "in-place residual add admitted");
+    add->data = saved;
+    const auto stride = residual->nb[1];
+    residual->nb[1] += sizeof(float);
+    require(!ggml_cuda_match_residual_norm(graph, 0, false), "strided residual admitted");
+    residual->nb[1] = stride;
+    const auto type = weight->type;
+    weight->type = GGML_TYPE_F16;
+    require(!ggml_cuda_match_residual_norm(graph, 0, false), "different precision weight admitted");
+    weight->type = type;
+    norm->flags |= GGML_TENSOR_FLAG_OUTPUT;
+    require(!ggml_cuda_match_residual_norm(graph, 0, false), "live intermediate norm elided");
+    norm->flags &= ~GGML_TENSOR_FLAG_OUTPUT;
+    ggml_set_op_params_f32(norm, 0, -1.0f);
+    require(!ggml_cuda_match_residual_norm(graph, 0, false), "negative normalization epsilon admitted");
+    ggml_set_op_params_f32(norm, 0, std::numeric_limits<float>::quiet_NaN());
+    require(!ggml_cuda_match_residual_norm(graph, 0, false), "NaN normalization epsilon admitted");
+}
