+
+// Read the format emitted above without creating a logical-size scratch file.
+// Only the last record can be short. The index costs one offset per 64 KiB.
+class server_slot_delta_input : public std::streambuf {
+    static constexpr size_t block = 65536;
+    std::ifstream delta, base;
+    struct span { bool copy; uint64_t offset; };
+    std::vector<span> spans;
+    std::vector<char> buffer = std::vector<char>(block);
+    size_t logical = 0, next = 0;
+
+    uint64_t integer(size_t width) {
+        uint64_t value = 0;
+        for (size_t i = 0; i < width; ++i) {
+            const auto c = delta.get();
+            if (c == EOF) { throw std::runtime_error("truncated delta record"); }
+            value |= uint64_t(uint8_t(c)) << (8 * i);
+        }
+        return value;
+    }
+    bool locate(size_t pos) {
+        if (pos > logical) { return false; }
+        if (eback() && pos >= next - size_t(egptr() - eback()) && pos <= next) {
+            setg(eback(), egptr() - (next - pos), egptr());
+            return true;
+        }
+        setg(nullptr, nullptr, nullptr);
+        next = pos;
+        return true;
+    }
+protected:
+    int_type underflow() override {
+        if (next == logical) { return traits_type::eof(); }
+        const size_t index = next / block, skip = next % block;
+        const auto & span = spans[index];
+        auto & in = span.copy ? base : delta;
+        const size_t size = std::min(block - skip, logical - next);
+        const auto pos = std::streamoff(span.offset + skip);
+        if (in.tellg() != pos) { in.seekg(pos); }
+        if (!in.read(buffer.data(), size)) { throw std::runtime_error("short checkpoint input"); }
+        setg(buffer.data(), buffer.data(), buffer.data() + size);
+        next += size;
+        return traits_type::to_int_type(*gptr());
+    }
+    pos_type seekoff(off_type off, std::ios::seekdir dir, std::ios::openmode) override {
+        const auto cur = off_type(next) - (gptr() ? egptr() - gptr() : 0);
+        const auto origin = dir == std::ios::beg ? off_type(0) : dir == std::ios::end ? off_type(logical) : cur;
+        if (off < -origin || off > off_type(logical) - origin) { return pos_type(-1); }
+        return locate(size_t(origin + off)) ? pos_type(origin + off) : pos_type(-1);
+    }
+    pos_type seekpos(pos_type pos, std::ios::openmode mode) override {
+        return seekoff(off_type(pos), std::ios::beg, mode);
+    }
+public:
+    size_t size() const { return logical; }
+    server_slot_delta_input(const std::filesystem::path & path, const std::string & digest, size_t limit)
+        : delta(path, std::ios::binary | std::ios::ate),
+          base(std::filesystem::path(path).concat(".base"), std::ios::binary | std::ios::ate) {
+        if (!delta || !base) { throw std::runtime_error("missing checkpoint inputs"); }
+        const uint64_t encoded = delta.tellg(), base_size = base.tellg();
+        if (encoded > limit || base_size > limit) { throw std::runtime_error("checkpoint exceeds budget"); }
+        delta.seekg(0);
+        std::string header(72, ' ');
+        if (!delta.read(header.data(), header.size()) || header != "WLDDEL01" + digest) {
+            throw std::runtime_error("invalid checkpoint header");
+        }
+        while (auto kind = integer(1)) {
+            const auto n = integer(4);
+            if ((kind != 1 && kind != 2) || !n || n > block || logical % block || n > limit - logical) {
+                throw std::runtime_error("invalid checkpoint record");
+            }
+            const uint64_t offset = kind == 2 ? integer(8) : uint64_t(delta.tellg());
+            const uint64_t end = kind == 2 ? base_size : encoded;
+            if (offset > end || n > end - offset) { throw std::runtime_error("checkpoint span exceeds input"); }
+            spans.push_back({kind == 2, offset});
+            if (kind == 1) { delta.seekg(std::streamoff(n), std::ios::cur); }
+            logical += size_t(n);
+        }
+        if (!logical || uint64_t(delta.tellg()) != encoded) { throw std::runtime_error("invalid checkpoint end"); }
+    }
+};
