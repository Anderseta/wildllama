+
+size_t llama_context::state_seq_write_raw(llama_seq_id seq_id, llama_state_sink sink, void * user) {
+    llama_io_write_file io(sink, user);
+    // The draft appendix uses the in-memory sequence format, including the
+    // sequence header. Target slot files have a separate prompt header.
+    io.write(&io_magic, sizeof(io_magic));
+    io.write(&seq_id, sizeof(seq_id));
+    return state_seq_write_data(io, seq_id, 0);
+}
+
+size_t llama_state_seq_write_raw(llama_context * ctx, llama_seq_id seq_id, llama_state_sink sink, void * user) {
+    if (!sink) { return 0; }
+    try {
+        ctx->synchronize();
+        return ctx->state_seq_write_raw(seq_id, sink, user);
+    } catch (const std::exception & e) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return 0;
+    }
+}
+
+size_t llama_state_seq_read_raw(llama_context * ctx, llama_seq_id seq_id, size_t limit, bool buffer_header, llama_state_source source, void * user) {
+    if (!source) { return 0; }
+    try {
+        ctx->synchronize();
+        llama_io_read_file io(source, user, limit);
+        if (buffer_header) {
+            uint32_t magic;
+            llama_seq_id saved_id;
+            io.read(&magic, sizeof(magic));
+            io.read(&saved_id, sizeof(saved_id));
+            if (magic != io_magic) { return 0; }
+        }
+        return ctx->state_seq_read_checked(io, seq_id, limit);
+    } catch (const std::exception & e) {
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return 0;
+    }
+}
+
 size_t llama_context::state_seq_write_stream(llama_seq_id seq_id, const llama_token * tokens,
         size_t count, llama_state_sink sink, void * user) {
     if (!sink || count > UINT32_MAX) { return 0; }
