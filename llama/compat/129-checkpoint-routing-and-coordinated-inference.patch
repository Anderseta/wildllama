+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+// Runner-local, single text sequence. Each observation covers the entire
+// uncached prefill including draft catch-up and the ordinary output fence.
+class server_single_prefill {
+    struct history {
+        unsigned rounds = 0;
+        int candidate_wins = 0;
+        bool smaller = false;
+        int baseline_rows = 0, baseline_end = 0;
+        double baseline = 0;
+    };
+    std::array<history, 32> costs{};
+    int task = -1, key = 0, rows = 0, end = 0, chunk = 0;
+    bool candidate = false, trial = false;
+    int64_t start = 0;
+public:
+    int plan(int id, int prefix, int remaining, int ceiling, int micro, int64_t now) {
+        if (id == task) {
+            if (ceiling < chunk) { start = 0; candidate = false; chunk = ceiling; }
+            return chunk;
+        }
+        task = id;
+        chunk = ceiling;
+        start = 0;
+        candidate = false;
+        if (micro <= 0 || ceiling / micro < 2 || remaining < 2048 || remaining / ceiling < 4) {
+            return chunk;
+        }
+        int size_bin = 0;
+        for (int n = remaining / 2048; n > 1 && size_bin < 7; n /= 2) { ++size_bin; }
+        key = size_bin * 4 + int(prefix >= 2048) + int(prefix >= 8192) + int(prefix >= 24576);
+        auto & h = costs[key];
+        // Three independent control/probe pairs, then one pair in sixteen.
+        const unsigned phase = h.rounds < 6 ? h.rounds % 2 : (h.rounds - 6) % 16;
+        trial = phase <= 1;
+        candidate = phase == 1 || (!trial && h.smaller);
+        if (candidate) { chunk = std::max(1, ceiling / micro / 2) * micro; }
+        rows = remaining;
+        end = prefix + remaining;
+        start = now;
+        return chunk;
+    }
+    bool reduced() const { return candidate; }
+    bool measuring(int id) const { return id == task && start != 0; }
+    int batch_size() const { return chunk; }
+    void finish(int id, int64_t now) {
+        if (id != task || !start || now <= start) { return; }
+        auto & h = costs[key];
+        const double cost = double(now - start) / rows;
+        if (trial && !candidate) {
+            h.baseline = cost;
+            h.baseline_rows = rows;
+            h.baseline_end = end;
+        }
+        const auto comparable = [](int a, int b) {
+            return int64_t(std::max(a,b)) * 8 <= int64_t(std::min(a,b)) * 9;
+        };
+        if (trial && candidate && h.baseline > 0 && comparable(rows,h.baseline_rows) && comparable(end,h.baseline_end)) {
+            if (cost < h.baseline * .94) { h.candidate_wins = std::min(3, h.candidate_wins + 1); }
+            else if (cost > h.baseline * .98) { h.candidate_wins = 0; }
+            h.smaller = h.candidate_wins >= 3;
+        }
+        ++h.rounds;
+        start = 0;
+    }
+};
