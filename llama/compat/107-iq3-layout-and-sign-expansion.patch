+// One warp reads eight 32-element fragments from each of four original blocks.
+struct alignas(8) iq3_s_warp_block {
+    int2 qs[4][8];
+    int32_t signs[4][8];
+    uint8_t qh[4][8];
+    uint8_t scales[4][4];
+    half d[4];
+};
+static_assert(sizeof(iq3_s_warp_block) == 4 * sizeof(block_iq3_s), "IQ3 repack must preserve byte size");
+
+static constexpr __host__ __device__ uint32_t iq3_s_expand_signs(uint32_t nibble) {
+    // Move bits 0,1,2,3 to bits 0,8,16,24, then broadcast each into its byte.
+    return ((nibble * 0x00204081u) & 0x01010101u) * 255u;
+}
+
+template<int columns, bool repacked = false, bool fast_sign = false>
+static __device__ __forceinline__ void vec_dot_iq3_s_q8_1_layout(
+    const block_iq3_s * __restrict__ bq3, const block_q8_1 * __restrict__ bq8_1,
+    uint32_t stride_col_y, int iqs, float (&dots)[columns], int block_index = 0) {
+
+    const int group = iqs / 2;
+    int2 qs_packed;
+    int qh;
+    int signs_packed_32;
+    half weight_scale;
+    int scale;
+    if constexpr (repacked) {
+        const auto & tile = reinterpret_cast<const iq3_s_warp_block *>(bq3)[block_index / 4];
+        const int slot = block_index % 4;
+        qs_packed = tile.qs[slot][group];
+        signs_packed_32 = tile.signs[slot][group];
+        qh = tile.qh[slot][group];
+        weight_scale = tile.d[slot];
+        scale = tile.scales[slot][group / 2];
+    } else {
+        qs_packed = make_int2(get_int_b2(bq3->qs, iqs), get_int_b2(bq3->qs, iqs + 1));
+        qh = bq3->qh[group];
+        signs_packed_32 = get_int_b2(bq3->signs, group);
+        weight_scale = bq3->d;
+        scale = bq3->scales[group / 2];
+    }
+    const auto * qs = reinterpret_cast<const uint8_t *>(&qs_packed);
+    const auto * signs_packed_8 = reinterpret_cast<const uint8_t *>(&signs_packed_32);
+    int sums[columns] = {};
+#pragma unroll
+    for (int l0 = 0; l0 < 8; l0 += 2) {
+        const int2 grid_pos = make_int2(
+            iq3s_grid[qs[l0 + 0] | ((qh << (8 - l0)) & 0x100)],
+            iq3s_grid[qs[l0 + 1] | ((qh << (7 - l0)) & 0x100)]);
+
+        int signs0, signs1;
+        if constexpr (fast_sign) {
+            const uint32_t sign = signs_packed_8[l0 / 2];
+            signs0 = iq3_s_expand_signs(sign & 0xfu);
+            signs1 = iq3_s_expand_signs(sign >> 4);
+        } else {
+            signs0 = __vcmpne4(((signs_packed_8[l0/2] & 0x03) << 7) | ((signs_packed_8[l0/2] & 0x0C) << 21), 0x00000000);
+            signs1 = __vcmpne4(((signs_packed_8[l0/2] & 0x30) << 3) | ((signs_packed_8[l0/2] & 0xC0) << 17), 0x00000000);
+        }
+
+        const int grid_l = __vsub4(grid_pos.x ^ signs0, signs0);
+        const int grid_h = __vsub4(grid_pos.y ^ signs1, signs1);
+
+#pragma unroll
+        for (int col = 0; col < columns; ++col) {
+            const block_q8_1 & input = bq8_1[col*stride_col_y + iqs/2];
+            const int u0 = get_int_b4(input.qs, l0 + 0);
+            const int u1 = get_int_b4(input.qs, l0 + 1);
+
+            sums[col] = ggml_cuda_dp4a(grid_l, u0, sums[col]);
+            sums[col] = ggml_cuda_dp4a(grid_h, u1, sums[col]);
+        }
+    }
+
+    scale = 1 + 2 * ((scale >> ((group & 1) * 4)) & 0x0f);
+#pragma unroll
+    for (int col = 0; col < columns; ++col) {
+        const float d = __half2float(weight_scale) * __low2float(bq8_1[col*stride_col_y + iqs/2].ds);
+        dots[col] = d * (sums[col] * scale);
+    }
+}
