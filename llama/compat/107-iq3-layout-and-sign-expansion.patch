+static std::vector<iq3_s_warp_block> repack_weights(const std::vector<block_iq3_s> & weights) {
+    require(weights.size() % 4 == 0, "four IQ3 blocks per packed tile are required");
+    std::vector<iq3_s_warp_block> packed(weights.size() / 4);
+    for (size_t i = 0; i < weights.size(); ++i) {
+        auto & tile = packed[i / 4];
+        const auto & input = weights[i];
+        const size_t slot = i % 4;
+        std::memcpy(tile.qs[slot], input.qs, sizeof(input.qs));
+        std::memcpy(tile.signs[slot], input.signs, sizeof(input.signs));
+        std::memcpy(tile.qh[slot], input.qh, sizeof(input.qh));
+        std::memcpy(tile.scales[slot], input.scales, sizeof(input.scales));
+        std::memcpy(&tile.d[slot], &input.d, sizeof(input.d));
+
+        block_iq3_s restored;
+        std::memcpy(restored.qs, tile.qs[slot], sizeof(restored.qs));
+        std::memcpy(restored.signs, tile.signs[slot], sizeof(restored.signs));
+        std::memcpy(restored.qh, tile.qh[slot], sizeof(restored.qh));
+        std::memcpy(restored.scales, tile.scales[slot], sizeof(restored.scales));
+        std::memcpy(&restored.d, &tile.d[slot], sizeof(restored.d));
+        require(std::memcmp(&restored, &input, sizeof(input)) == 0, "IQ3 byte round trip failed");
+    }
+    return packed;
+}
