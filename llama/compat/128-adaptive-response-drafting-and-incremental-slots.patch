diff --git a/common/mtp-round-policy.h b/common/mtp-round-policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..789b8bcb5c1e47ab067d1c029417fbdc3de3f004
--- /dev/null
+++ b/common/mtp-round-policy.h
@@ -0,0 +1,125 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Only confirmed history is indexed. Offsets refer to the caller's token vector;
+// collisions and rewinds are harmless because each match is verified in full.
+class common_mtp_response_lookup {
+    static constexpr size_t anchor = 6, buckets = 4096, window = 16384;
+    std::vector<uint32_t> offsets;
+    size_t start = 0, next = 0, last_size = 0;
+    template <class At> static size_t bucket(At at) {
+        uint32_t h = 2166136261u;
+        for (size_t i = 0; i < anchor; ++i) {
+            h = (h ^ uint32_t(at(i))) * 16777619u;
+        }
+        return h % buckets;
+    }
+
+  public:
+    void begin(size_t prompt) {
+        start = last_size = prompt;
+        next = prompt;
+        offsets.clear();
+    }
+    bool propose(const std::vector<int32_t> &h, int32_t last, size_t max, std::vector<int32_t> &out) {
+        if (h.size() < last_size) {
+            begin(h.size());
+        }
+        last_size = h.size();
+        if (max < 2 || !out.empty() || h.size() > UINT32_MAX || h.size() - start < anchor + 2) {
+            return false;
+        }
+        if (offsets.empty()) {
+            offsets.resize(buckets);
+        }
+        const size_t oldest = std::max(start, h.size() > window ? h.size() - window : 0);
+        next = std::max(next, oldest + anchor);
+        for (; next <= h.size() - 2; ++next) {
+            offsets[bucket([&](size_t i) { return h[next - anchor + i]; })] = uint32_t(next);
+        }
+        const auto at = [&](size_t i) { return i + 1 == anchor ? last : h[h.size() - (anchor - 1) + i]; };
+        const size_t pos = offsets[bucket(at)];
+        if (pos < oldest + anchor || pos > h.size() - 2) {
+            return false;
+        }
+        for (size_t i = 0; i < anchor; ++i) {
+            if (at(i) != h[pos - anchor + i]) {
+                return false;
+            }
+        }
+        const size_t count = std::min(max, h.size() - pos);
+        out.assign(h.begin() + pos, h.begin() + pos + count);
+        return true;
+    }
+};
+
+class common_mtp_round_policy {
+  public:
+    enum arm { normal, temperature, shortlist };
+
+  private:
+    std::array<double, 3> elapsed{}, tokens{};
+    double cost(arm a) const { return elapsed[a] / tokens[a]; }
+    std::array<unsigned, 3> samples{};
+    arm best = normal, active = normal;
+    unsigned in_window = 0, next_probe = 0;
+    bool allow_shortlist = true;
+    // Successful extensions beyond two tokens, counted only in uncut trials.
+    unsigned trials = 0, successes = 0, cuts = 0;
+
+  public:
+    arm selected() const { return active; }
+    void disable_shortlist() {
+        allow_shortlist = false;
+        if (best == shortlist) {
+            best = normal;
+        }
+        active = best;
+        in_window = 0;
+    }
+    void observe(int64_t us, unsigned committed) {
+        if (us <= 0 || committed == 0) {
+            return;
+        }
+        elapsed[active] = .75 * elapsed[active] + us;
+        tokens[active] = .75 * tokens[active] + committed;
+        ++samples[active];
+        if (++in_window < (active == best && samples[active] >= 4 ? 20u : 4u)) {
+            return;
+        }
+        in_window = 0;
+        if (active != best) {
+            if (cost(active) < .94 * cost(best)) {
+                best = active;
+            }
+            active = best;
+            return;
+        }
+        do {
+            next_probe = (next_probe + 1) % (allow_shortlist ? 3u : 2u);
+        } while (next_probe == unsigned(best));
+        active = arm(next_probe);
+    }
+    void extension_result(unsigned proposed, unsigned accepted) {
+        if (proposed < 3) {
+            return;
+        }
+        if (trials == 16) {
+            trials /= 2;
+            successes /= 2;
+        }
+        ++trials;
+        successes += accepted >= 3;
+    }
+    bool stop_after_two(float confidence) {
+        if (trials < 4 || successes * 2 >= trials || !(confidence >= 0 && confidence < .65f)) {
+            return false;
+        }
+        // Periodically measure a full round to detect a change in workload.
+        return ++cuts % 4 != 0;
+    }
+};
