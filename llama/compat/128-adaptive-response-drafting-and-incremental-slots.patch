new file mode 100644
index 0000000000000000000000000000000000000000..bbe78db4f285107c55d38574b1256f198dfac3f0
--- /dev/null
+++ b/tools/server/server-slot-delta.h
@@ -0,0 +1,155 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <stdexcept>
+#include <streambuf>
+#include <vector>
+
+// One immutable base, one bounded stream of copy/literal records. Content
+// anchors find blocks displaced by growing token arrays or tensor lengths.
+// A full byte comparison is mandatory even if the anchor hash matches.
+class server_slot_delta final : public std::streambuf {
+    static constexpr size_t block = 65536;
+    std::ifstream base;
+    std::ofstream out;
+    struct anchor {
+        uint64_t signature = 0, offset = UINT64_MAX;
+    };
+    static constexpr size_t stride = block / 4;
+    std::vector<anchor> anchors = std::vector<anchor>(32768);
+    std::vector<char> buffer = std::vector<char>(block), reference = std::vector<char>(block);
+    uint64_t predicted = 0, base_size = 0, logical = 0, physical = 0, limit;
+    size_t used = 0;
+
+    static uint64_t signature(const char *bytes) {
+        uint64_t value;
+        std::memcpy(&value, bytes, sizeof(value));
+        return value;
+    }
+    anchor &entry(uint64_t value) {
+        value ^= value >> 31;
+        return anchors[(value * UINT64_C(11400714819323198485)) >> 49];
+    }
+    void emit(const char *data, size_t size) {
+        if (size > limit - physical) {
+            throw std::runtime_error("checkpoint delta exceeds budget");
+        }
+        out.write(data, size);
+        if (!out) {
+            throw std::runtime_error("checkpoint delta write failed");
+        }
+        physical += size;
+    }
+    void integer(uint64_t n, size_t bytes) {
+        char data[8];
+        for (size_t i = 0; i < bytes; ++i) {
+            data[i] = char(n >> (8 * i));
+        }
+        emit(data, bytes);
+    }
+    bool matches(uint64_t pos) {
+        if (pos > base_size || used > base_size - pos) {
+            return false;
+        }
+        base.clear();
+        base.seekg(static_cast<std::streamoff>(pos));
+        base.read(reference.data(), used);
+        return base && !std::memcmp(reference.data(), buffer.data(), used);
+    }
+    void record() {
+        if (!used) {
+            return;
+        }
+        if (used > limit - logical) {
+            throw std::runtime_error("checkpoint state exceeds budget");
+        }
+        uint64_t found = predicted;
+        bool copy = matches(found);
+        if (!copy) {
+            unsigned comparisons = 0;
+            // Only search after a displacement changes. Fixed base anchors
+            // also work for float and quantized data with a biased byte alphabet.
+            for (size_t i = 0; i + sizeof(uint64_t) <= used; ++i) {
+                const auto sig = signature(buffer.data() + i);
+                const auto a = entry(sig);
+                if (a.signature != sig || a.offset == UINT64_MAX || a.offset < i || a.offset - i == predicted) {
+                    continue;
+                }
+                if (matches(a.offset - i)) {
+                    found = a.offset - i;
+                    copy = true;
+                    break;
+                }
+                if (++comparisons == 8) {
+                    break;
+                }
+            }
+        }
+        // 0 = end, 1 = literal, 2 = base span. All integers little endian.
+        integer(copy ? 2 : 1, 1);
+        integer(used, 4);
+        if (copy) {
+            integer(found, 8);
+            predicted = found + used;
+        } else {
+            emit(buffer.data(), used);
+            predicted += used;
+        }
+        logical += used;
+        used = 0;
+    }
+
+  protected:
+    std::streamsize xsputn(const char *data, std::streamsize size) override {
+        std::streamsize done = 0;
+        while (done < size) {
+            const size_t n = std::min<size_t>(block - used, size_t(size - done));
+            std::memcpy(buffer.data() + used, data + done, n);
+            done += n;
+            used += n;
+            if (used == block) {
+                record();
+            }
+        }
+        return done;
+    }
+
+  public:
+    server_slot_delta(const std::filesystem::path &path, const std::string &digest, uint64_t max_bytes)
+        : base(std::filesystem::path(path).concat(".base"), std::ios::binary),
+          out(path, std::ios::binary | std::ios::trunc), limit(max_bytes) {
+        if (!base || !out || digest.size() != 64) {
+            throw std::runtime_error("checkpoint delta files unavailable");
+        }
+        while (base.read(reference.data(), block) || base.gcount() > 0) {
+            const size_t n = size_t(base.gcount());
+            if (n > limit - base_size) {
+                throw std::runtime_error("checkpoint base exceeds budget");
+            }
+            for (size_t i = 0; i + sizeof(uint64_t) <= n; i += stride) {
+                const auto sig = signature(reference.data() + i);
+                entry(sig) = {sig, base_size + i};
+            }
+            base_size += n;
+        }
+        if (!base.eof()) {
+            throw std::runtime_error("checkpoint base read failed");
+        }
+        emit("WLDDEL01", 8);
+        emit(digest.data(), digest.size());
+    }
+    uint64_t finish() {
+        record();
+        integer(0, 1);
+        out.close();
+        if (!out) {
+            throw std::runtime_error("checkpoint delta close failed");
+        }
+        return physical;
+    }
+};
