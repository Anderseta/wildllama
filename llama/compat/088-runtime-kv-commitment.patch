+bool llama_get_kv_memory_stats(const struct llama_context * ctx, struct llama_kv_memory_stats * result) {
+    if (!ctx || !result) { return false; }
+    const auto * memory = ctx->get_memory();
+    if (!memory) { return false; }
+    const llama_kv_cache * attention = nullptr;
+    if (typeid(*memory) == typeid(llama_kv_cache)) {
+        attention = static_cast<const llama_kv_cache *>(memory);
+    } else if (typeid(*memory) == typeid(llama_memory_hybrid)) {
+        attention = static_cast<const llama_memory_hybrid *>(memory)->get_mem_attn();
+    }
+    // Derived/indexed memories can own additional caches, so a partial count
+    // would be misleading. Leave their live commitment explicitly unknown.
+    return attention && attention->physical_memory_stats(*result);
+}
