diff --git a/common/runtime-kv-memory.h b/common/runtime-kv-memory.h
new file mode 100644
--- /dev/null
+++ b/common/runtime-kv-memory.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include "llama.h"
+
+#include <cinttypes>
+#include <cstdio>
+
+// Sampling runs on the server's existing context owner thread. No additional
+// worker, synchronization of GPU work, or per-token log output is introduced.
+class common_kv_memory_reporter {
+public:
+    using sink = void (*)(const llama_kv_memory_stats &);
+    explicit common_kv_memory_reporter(sink emit = write_event) : emit(emit) {}
+
+    bool sample(const llama_context * ctx, bool force = false) {
+        if (!ctx) { previous_context = nullptr; observed = false; return false; }
+        if (ctx != previous_context) {
+            previous_context = ctx;
+            observed = false;
+            next_sample = 0;
+        }
+        const int64_t now = llama_time_us();
+        if (!force && now < next_sample) { return false; }
+        next_sample = now + 500000;
+        llama_kv_memory_stats measured {};
+        if (!llama_get_kv_memory_stats(ctx, &measured)) { observed = false; return false; }
+        const bool changed = !observed || measured.gpu_bytes != previous.gpu_bytes ||
+            measured.host_bytes != previous.host_bytes || measured.capacity_bytes != previous.capacity_bytes;
+        previous = measured;
+        observed = true;
+        if (!changed && !force) { return false; }
+        emit(measured);
+        return true;
+    }
+
+private:
+    static void write_event(const llama_kv_memory_stats & memory) {
+        std::fprintf(stderr, "wildllama_activity {\"kind\":\"kv_memory\",\"scope\":\"target\",\"gpu_bytes\":%" PRIu64
+            ",\"host_bytes\":%" PRIu64 ",\"capacity_bytes\":%" PRIu64 "}\n",
+            memory.gpu_bytes, memory.host_bytes, memory.capacity_bytes);
+    }
+    sink emit;
+    const llama_context * previous_context = nullptr;
+    llama_kv_memory_stats previous {};
+    int64_t next_sample = 0;
+    bool observed = false;
+};
diff --git a/tests/test-kv-memory-report.cpp b/tests/test-kv-memory-report.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-kv-memory-report.cpp
@@ -0,0 +1,45 @@
+#include "runtime-kv-memory.h"
+
+#include <cstdio>
+#include <stdexcept>
+
+static int64_t clock_us = 0;
+static int queries = 0, events = 0;
+static bool available = true;
+static llama_kv_memory_stats actual {320, 0, 2176};
+static llama_kv_memory_stats emitted {};
+
+int64_t llama_time_us() { return clock_us; }
+bool llama_get_kv_memory_stats(const llama_context *, llama_kv_memory_stats * out) {
+    ++queries;
+    if (!available) { return false; }
+    *out = actual;
+    return true;
+}
+static void event(const llama_kv_memory_stats & memory) { ++events; emitted = memory; }
+static void require(bool value, const char * reason) { if (!value) { throw std::runtime_error(reason); } }
+
+int main() {
+    const auto * target = reinterpret_cast<const llama_context *>(uintptr_t(1));
+    const auto * replacement = reinterpret_cast<const llama_context *>(uintptr_t(2));
+    common_kv_memory_reporter reporter(event);
+    require(reporter.sample(target) && emitted.gpu_bytes == 320, "initial measured commitment missing");
+    actual.gpu_bytes = 1088;
+    clock_us = 100;
+    require(!reporter.sample(target) && queries == 1, "per-token sampling was not throttled");
+    clock_us = 500000;
+    require(reporter.sample(target) && emitted.gpu_bytes == 1088, "grown physical commitment was not observed");
+    clock_us = 1000000;
+    require(!reporter.sample(target) && events == 2, "unchanged counters produced duplicate events");
+    actual.gpu_bytes = 320;
+    require(reporter.sample(target, true) && emitted.gpu_bytes == 320, "idle reclamation must bypass throttle");
+    available = false;
+    require(!reporter.sample(replacement, true), "unsupported layout must remain unknown");
+    require(!reporter.sample(nullptr), "null context must not fabricate a zero measurement");
+    available = true;
+    actual = {0, 0, 0};
+    require(reporter.sample(target) && emitted.gpu_bytes == 0 && emitted.capacity_bytes == 0,
+        "a measured zero must remain distinct from unsupported memory");
+    std::puts("PASS: measured initial/grown/trimmed KV, throttle, context change and unknown layouts");
+    return 0;
+}
