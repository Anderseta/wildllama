+bool llama_kv_cache::physical_memory_stats(llama_kv_memory_stats & result) const {
+    if (hparams.no_alloc || other || typeid(*this) != typeid(llama_kv_cache)) { return false; }
+    llama_kv_memory_stats measured {};
+    for (const auto & entry : ctxs_bufs) {
+        const auto & buf = entry.second;
+        const auto buft = ggml_backend_buffer_get_type(buf.get());
+        const auto dev = ggml_backend_buft_get_device(buft);
+        if (!dev) { return false; }
+        const auto type = ggml_backend_dev_type(dev);
+        const bool gpu = type == GGML_BACKEND_DEVICE_TYPE_IGPU ||
+            (type == GGML_BACKEND_DEVICE_TYPE_GPU && !ggml_backend_buft_is_host(buft));
+        const bool host = !gpu && (ggml_backend_buft_is_host(buft) || type == GGML_BACKEND_DEVICE_TYPE_CPU || type == GGML_BACKEND_DEVICE_TYPE_ACCEL);
+        if (!host && !gpu) { return false; }
+        const auto * growth = growth_initial_tokens ? llama_kv_growth_api(buft) : nullptr;
+        const uint64_t physical = growth ? growth->committed(buf.get()) : ggml_backend_buffer_get_size(buf.get());
+        const uint64_t capacity = ggml_backend_buffer_get_size(buf.get());
+        auto & used = gpu ? measured.gpu_bytes : measured.host_bytes;
+        if (physical > UINT64_MAX - used || capacity > UINT64_MAX - measured.capacity_bytes) { return false; }
+        used += physical;
+        measured.capacity_bytes += capacity;
+    }
+    result = measured;
+    return true;
+}
