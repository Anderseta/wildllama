+static constexpr int mmvq_q4_head_width = 5120;
+static constexpr int mmvq_q4_head_vocab = 248320;
+
+static constexpr bool mmvq_q4_head_geometry(int64_t width, int64_t rows, int64_t tokens) {
+    return width == mmvq_q4_head_width && rows == mmvq_q4_head_vocab && (tokens == 2 || tokens == 3);
+}
+
+template<int tokens>
+static __global__ __launch_bounds__(128, 1) void mul_mat_vec_q4_head_warp(
+        const block_q4_K * __restrict__ weights, const block_q8_1 * __restrict__ input,
+        float * __restrict__ output, int rows) {
+    static_assert(tokens == 2 || tokens == 3, "only measured Q4_K head batches are supported");
+    constexpr int weight_stride = mmvq_q4_head_width / QK_K;
+    constexpr int input_stride = mmvq_q4_head_width / QK8_1;
+    constexpr int lanes_per_block = QI4_K / VDR_Q4_K_Q8_1_MMVQ;
+    constexpr int blocks_per_warp = 32 / lanes_per_block;
+    static_assert(weight_stride % blocks_per_warp == 0, "head rows must fill the final warp");
+    const int row = 4 * blockIdx.x + threadIdx.y;
+    ggml_cuda_pdl_sync();
+    if (row >= rows) { return; }
+
+    const block_q4_K * row_weights = weights + size_t(row)*weight_stride;
+    const int lane = threadIdx.x;
+    const int kqs = (lane % lanes_per_block) * VDR_Q4_K_Q8_1_MMVQ;
+    float sums[tokens] = {};
+    // Reproduce the four original warps' partial sums in order, now within
+    // one warp for each row. No shared memory or block barrier is needed.
+#pragma unroll
+    for (int part = 0; part < 4; ++part) {
+        float partial[tokens] = {};
+#pragma unroll
+        for (int tile = part*blocks_per_warp; tile < weight_stride; tile += 4*blocks_per_warp) {
+            const int kbx = tile + lane/lanes_per_block;
+#pragma unroll
+            for (int j = 0; j < tokens; ++j) {
+                partial[j] += vec_dot_q4_K_q8_1(row_weights,
+                    input + j*input_stride + kbx*(QK_K/QK8_1), kbx, kqs);
+            }
+        }
+#pragma unroll
+        for (int j = 0; j < tokens; ++j) {
+            sums[j] = part == 0 ? partial[j] : sums[j] + partial[j];
+        }
+    }
+
+#pragma unroll
+    for (int j = 0; j < tokens; ++j) {
+        const float value = warp_reduce_sum<32>(sums[j]);
+        if (lane == row % 2) { output[j*rows + row] = value; }
+    }
+}
+#endif
