+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+
+[[noreturn]] void ggml_cuda_error(const char * statement, const char *, const char *, int, const char * message) {
+    throw std::runtime_error(std::string(statement) + ": " + message);
+}
+template<class T> struct buffer {
+    T * data = nullptr;
+    explicit buffer(size_t n) { CUDA_CHECK(cudaMalloc((void **)&data,n*sizeof(T))); }
+    ~buffer() {cudaFree(data);}
+};
+constexpr int D=ggml_gdn_compact_state,H=48,W=128,KH=16,R=ggml_gdn_extended_record(5);
+static void fill(float * data,size_t n,int seed,float amplitude,float bias=0) {
+    std::vector<float> host(n);uint32_t bits=seed+1;
+    for(auto & x:host){bits^=bits<<13;bits^=bits>>17;bits^=bits<<5;x=bias+amplitude*(float(bits>>8)*0x1p-23f-1.f);}
+    CUDA_CHECK(cudaMemcpy(data,host.data(),n*sizeof(float),cudaMemcpyHostToDevice));
+}
+static void equal(const float * a,const float * b,size_t n,const char * message) {
+    std::vector<float> x(n),y(n);
+    CUDA_CHECK(cudaMemcpy(x.data(),a,n*4,cudaMemcpyDeviceToHost));CUDA_CHECK(cudaMemcpy(y.data(),b,n*4,cudaMemcpyDeviceToHost));
+    if(std::memcmp(x.data(),y.data(),n*4)) {throw std::runtime_error(message);}
+}
+template<bool compact> static void run(const float * q,const float * k,const float * v,const float * g,const float * beta,
+        const float * input,float * output,float * states,const int * index,const float * records,float * next_records,int tokens,cudaStream_t stream=nullptr) {
+    gated_delta_net_cuda<128,false,true,4,compact,compact,compact><<<dim3(H,1,8),dim3(32,4),0,stream>>>(
+        q,k,v,g,beta,input,output,states,H,tokens,1,W,KH*W,tokens*KH*W,W,H*W,tokens*H*W,1,H,tokens*H,
+        init_fastdiv_values(KH),init_fastdiv_values(1),1.f/std::sqrt(float(W)),D,tokens,index,records,next_records);
+    CUDA_CHECK(cudaGetLastError());
+}
+template<class Fn> static float time_graph(Fn fn) {
+    cudaStream_t stream;cudaGraph_t graph;cudaGraphExec_t exec;cudaEvent_t begin,end;
+    CUDA_CHECK(cudaStreamCreate(&stream));CUDA_CHECK(cudaEventCreate(&begin));CUDA_CHECK(cudaEventCreate(&end));
+    CUDA_CHECK(cudaStreamBeginCapture(stream,cudaStreamCaptureModeThreadLocal));
+    for(int i=0;i<32;++i){fn(stream);}
+    CUDA_CHECK(cudaStreamEndCapture(stream,&graph));CUDA_CHECK(cudaGraphInstantiate(&exec,graph,0));
+    for(int i=0;i<4;++i){CUDA_CHECK(cudaGraphLaunch(exec,stream));}
+    CUDA_CHECK(cudaEventRecord(begin,stream));for(int i=0;i<16;++i){CUDA_CHECK(cudaGraphLaunch(exec,stream));}
+    CUDA_CHECK(cudaEventRecord(end,stream));CUDA_CHECK(cudaEventSynchronize(end));float ms;
+    CUDA_CHECK(cudaEventElapsedTime(&ms,begin,end));cudaGraphExecDestroy(exec);cudaGraphDestroy(graph);cudaEventDestroy(begin);cudaEventDestroy(end);cudaStreamDestroy(stream);
+    return ms*1000/(32*16);
+}
+int main() {
+ try {
+    buffer<float> q(W*KH*5),k(W*KH*5),v(W*H*5),g(H*5),beta(H*5),initial(D),full_initial(5*D),full(5*D),packed_initial(2*D),packed(2*D);
+    buffer<float> records_initial(R),records(R),scratch(D),a(W*H*5),b(W*H*5);buffer<int> index(1);
+    int cases=0;
+    for(int pattern=0;pattern<3;++pattern){
+        fill(q.data,W*KH*5,pattern*20+1,.1f);fill(k.data,W*KH*5,pattern*20+2,.1f);fill(v.data,W*H*5,pattern*20+3,.7f);
+        fill(g.data,H*5,pattern*20+4,.2f,-.3f);fill(beta.data,H*5,pattern*20+5,.3f,.5f);fill(initial.data,D,pattern*20+6,.2f);
+        CUDA_CHECK(cudaMemcpy(packed_initial.data,initial.data,D*4,cudaMemcpyDeviceToDevice));CUDA_CHECK(cudaMemset(index.data,0,4));CUDA_CHECK(cudaMemset(records_initial.data,0,R*4));
+        run<false>(q.data,k.data,v.data,g.data,beta.data,initial.data,a.data,full_initial.data,nullptr,nullptr,nullptr,5);
+        run<true>(q.data,k.data,v.data,g.data,beta.data,packed_initial.data,b.data,packed_initial.data,index.data,records_initial.data,records_initial.data,5);
+        equal(a.data,b.data,W*H*5,"initial extended scores changed");
+        for(int row=0;row<5;++row){
+            gdn_extended_materialize<<<D/256,256>>>(packed_initial.data,records_initial.data,nullptr,row,scratch.data);
+            equal(full_initial.data+row*D,scratch.data,D,"initial logical replay changed");
+            for(int tokens=1;tokens<=5;++tokens){
+                CUDA_CHECK(cudaMemcpy(packed.data,packed_initial.data,2*D*4,cudaMemcpyDeviceToDevice));CUDA_CHECK(cudaMemcpy(index.data,&row,4,cudaMemcpyHostToDevice));
+                run<false>(q.data,k.data,v.data,g.data,beta.data,full_initial.data+row*D,a.data,full.data,nullptr,nullptr,nullptr,tokens);
+                run<true>(q.data,k.data,v.data,g.data,beta.data,packed.data,b.data,packed.data,index.data,records_initial.data,records.data,tokens);
+                equal(a.data,b.data,W*H*tokens,"continued scores changed");
+                for(int selected=0;selected<tokens;++selected){
+                    gdn_extended_materialize<<<D/256,256>>>(packed.data,records.data,nullptr,selected,scratch.data);
+                    equal(full.data+selected*D,scratch.data,D,"continued logical replay changed");
+                }
+                if(tokens>1){
+                    gdn_extended_materialize<<<D/256,256>>>(packed.data,records.data,nullptr,1,packed.data);
+                    equal(full.data+D,packed.data,D,"checkpoint alias changed");
+                }
+                ++cases;
+            }
+        }
+    }
+    CUDA_CHECK(cudaMemset(index.data,0,4));
+    for(int tokens:{3,4,5}){
+        std::array<float,7> old,next;
+        for(int round=0;round<7;++round){
+            auto baseline=[&](cudaStream_t s){run<false>(q.data,k.data,v.data,g.data,beta.data,initial.data,a.data,full.data,nullptr,nullptr,nullptr,tokens,s);};
+            auto compact=[&](cudaStream_t s){run<true>(q.data,k.data,v.data,g.data,beta.data,packed_initial.data,b.data,packed.data,index.data,records_initial.data,records.data,tokens,s);};
+            if(round%2){next[round]=time_graph(compact);old[round]=time_graph(baseline);}else{old[round]=time_graph(baseline);next[round]=time_graph(compact);}
+        }
+        std::sort(old.begin(),old.end());std::sort(next.begin(),next.end());
+        std::printf("EXTENDED tokens=%d baseline_us=%.4f compact_us=%.4f ratio=%.4f state_saving_48layers_mib=%.3f\n",
+            tokens,old[3],next[3],old[3]/next[3],48.0*((tokens-2)*D-ggml_gdn_extended_record(tokens))*4/1048576.0);
+    }
+    std::printf("PASS %d extended rollback cases, all logical rows and checkpoint aliasing bitwise equal\n",cases);return 0;
+ }catch(const std::exception &e){std::fprintf(stderr,"FAIL: %s\n",e.what());return 1;}
+}
