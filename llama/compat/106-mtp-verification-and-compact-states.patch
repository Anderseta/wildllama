+static void block_preview_env(bool enabled) {
+#ifdef _WIN32
+    _putenv_s("WILDLLAMA_MTP_BLOCK_PREVIEW", enabled ? "1" : "0");
+#else
+    setenv("WILDLLAMA_MTP_BLOCK_PREVIEW", enabled ? "1" : "0", 1);
+#endif
+}
