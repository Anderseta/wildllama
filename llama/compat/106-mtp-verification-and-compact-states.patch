+        for(int i=0;i<count;++i){require(std::memcmp(llama_get_logits_ith(left.get(),i),llama_get_logits_ith(right.get(),i),n_vocab*sizeof(float))==0,"extended rollback changed model logits");}
+    };
+    decode(0,5);int position=5;
+    for(int round=0;round<12;++round){
+        decode(position,5);position+=5;
+        const int rollback=1+round%4;position-=rollback;
+        require(llama_memory_seq_rm(llama_get_memory(left.get()),0,position,-1) && llama_memory_seq_rm(llama_get_memory(right.get()),0,position,-1),"extended rollback range rejected");
+        std::array<std::vector<uint8_t>,2> saved;
+        int j=0;
+        for(auto * ctx:{left.get(),right.get()}){
+            auto & data=saved[j++];data.resize(llama_state_seq_get_size_ext(ctx,0,LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY));
+            require(llama_state_seq_get_data_ext(ctx,data.data(),data.size(),0,LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY)==data.size(),"extended checkpoint write failed");
+        }
+        require(saved[0]==saved[1],"extended canonical checkpoint differs");
+        if(round%2){
+            for(auto * ctx:{left.get(),right.get()}){require(llama_state_seq_set_data_ext(ctx,saved[0].data(),saved[0].size(),0,LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY)==saved[0].size(),"cross-layout restore failed");}
+        }
+    }
+    decode(position,1);
+    std::puts("PASS extended compact model: exact logits, 12 rollbacks, canonical checkpoints and cross-layout restore");
+}
