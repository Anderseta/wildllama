diff --git a/common/mtp-proposal-policy.h b/common/mtp-proposal-policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..666ec10478474407d16e712c515d417eae077527
--- /dev/null
+++ b/common/mtp-proposal-policy.h
@@ -0,0 +1,61 @@
+#pragma once
+#include "llama.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <vector>
+
+// Tune only the proposal. The verifier must still receive the exact q used by
+// that proposal; target temperature, filters, RNG and vocabulary never change.
+struct common_mtp_proposal_feedback {
+    static constexpr std::array<float, 3> factors{1.f, .85f, 1.15f};
+    std::array<double, 3> overlap{};
+    double weight = 0;
+    float factor = 1;
+    void observe(const llama_token_data_array & p, const std::vector<llama_token_data> & q, double prefix) {
+        if (q.empty() || q.size() > 10 || prefix <= 0 || !std::isfinite(prefix)) { return; }
+        std::array<llama_token_data, 10> ordered{};
+        std::copy(q.begin(), q.end(), ordered.begin());
+        std::sort(ordered.begin(), ordered.begin() + q.size(), [](const auto & a, const auto & b) { return a.logit > b.logit; });
+        double p_sum = 0;
+        for (size_t i = 0; i < p.size; ++i) { p_sum += p.data[i].p; }
+        if (!(p_sum > 0) || !std::isfinite(p_sum)) { return; }
+        for (size_t arm = 0; arm < factors.size(); ++arm) {
+            const size_t count = q.size();
+            std::array<double, 10> probability{};
+            double sum = 0;
+            for (size_t i = 0; i < count; ++i) {
+                probability[i] = std::exp(double(ordered[i].logit - ordered[0].logit) * factor / factors[arm]);
+                sum += probability[i];
+            }
+            if (!(sum > 0) || !std::isfinite(sum)) { return; }
+            double mass = 0;
+            for (size_t i = 0; i < count; ++i) {
+                for (size_t j = 0; j < p.size; ++j) {
+                    if (ordered[i].id == p.data[j].id) { mass += std::min(double(p.data[j].p) / p_sum, probability[i] / sum); break; }
+                }
+            }
+            overlap[arm] += prefix * mass;
+        }
+        weight += prefix;
+    }
+};
+
+struct common_mtp_proposal_policy {
+    std::array<double, 3> score{};
+    size_t rounds = 0;
+    size_t arm = 0;
+    void update(const common_mtp_proposal_feedback & feedback) {
+        if (!(feedback.weight > 0) || !std::isfinite(feedback.weight)) { return; }
+        for (size_t i = 0; i < score.size(); ++i) {
+            const double next = feedback.overlap[i] / feedback.weight;
+            if (!std::isfinite(next)) { return; }
+            score[i] = rounds ? .875 * score[i] + .125 * next : next;
+        }
+        ++rounds;
+        if (rounds < 8 || rounds % 8) { return; }
+        const size_t best = std::max_element(score.begin(), score.end()) - score.begin();
+        if (score[best] > score[arm] + .02) { arm = best; }
+    }
+};
