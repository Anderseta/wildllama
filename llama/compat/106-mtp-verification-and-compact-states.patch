+static void gpu_distribution_preview(llama_model * model, common_params_sampling params) {
+    if (!fixture_gpu_device) { return; }
+    params.min_p = 0; params.top_k = 20; params.top_p = .95f;
+    common_sampler_ptr reference(common_sampler_init(model, params));
+    llama_sampler_ptr distribution(llama_sampler_init_gpu_distribution(common_sampler_get(reference.get()), n_vocab));
+    require(distribution && llama_sampler_is_gpu_distribution(distribution.get()), "GPU distribution unavailable");
+    auto context = fixture_context(model);
+    require(llama_set_sampler(context.get(), 0, distribution.get()), "GPU distribution attachment failed");
+    float max_error = 0;
+    for (int round = 0; round < 8; ++round) {
+        common_batch batch(context.get());
+        for (int row = 0; row < 3; ++row) { batch.add(3 + 'x' + row + round, round * 3 + row, 0, true); }
+        require(llama_process(context.get(), LLAMA_PROCESS_TYPE_DECODE, batch.get()) == 0, "distribution decode failed");
+        for (int row = 0; row < 3; ++row) {
+            const auto output = llama_get_sampler_output_ith(context.get(), row);
+            require(output.raw_logits && output.sampled_probs && output.sampled_logits && output.candidates,
+                "GPU distribution lost original fallback or candidate outputs");
+            require(output.sampled_token == LLAMA_TOKEN_NULL, "distribution consumed an unused random draw");
+            std::vector<llama_token_data> data;
+            for (int id = 0; id < n_vocab; ++id) { data.push_back({id,output.raw_logits[id],0.f}); }
+            llama_token_data_array expected{data.data(),data.size(),-1,false};
+            require(llama_sampler_preview_distribution(common_sampler_get(reference.get()), &expected), "CPU probability preview failed");
+            double total = 0;
+            for (uint32_t i = 0; i < output.sampled_probs_count; ++i) {
+                float p = 0;
+                for(size_t j=0;j<expected.size;++j) { if(expected.data[j].id==output.candidates[i]) {p=expected.data[j].p;break;} }
+                const float error=std::abs(p-output.sampled_probs[i]); max_error=std::max(max_error,error);
+                require(std::isfinite(error) && error<3e-6f, "GPU distribution differs beyond FP32 tolerance");
+                total+=output.sampled_probs[i];
+            }
+            require(std::abs(total-1.0)<1e-5,"GPU distribution lost probability mass");
+        }
+    }
+    require(llama_set_sampler(context.get(),0,nullptr), "GPU distribution detach failed");
+    params.penalty_repeat=1.1f;
+    common_sampler_ptr stateful(common_sampler_init(model,params));
+    llama_sampler_ptr unsupported(llama_sampler_init_gpu_distribution(common_sampler_get(stateful.get()),n_vocab));
+    require(!unsupported,"stateful penalties were unsafely offloaded as independent rows");
+    std::printf("PASS 24 GPU distribution rows, no entropy draws, raw fallback, max absolute FP32 error %.9g\n",max_error);
+}
