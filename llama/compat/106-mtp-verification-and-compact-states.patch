+static void block_preview_regression(llama_model * model, common_params_sampling params) {
+    int64_t baseline_us = 0, preview_us = 0;
+    auto context = fixture_context(model);
+    common_batch batch(context.get());
+    for (int i = 0; i < 3; ++i) { batch.add(3 + 'x' + i, i, 0, true); }
+    require(llama_process(context.get(), LLAMA_PROCESS_TYPE_DECODE, batch.get()) == 0, "preview decode failed");
+    params.logit_bias = {{0, -INFINITY}, {1, -INFINITY}, {2, -INFINITY}};
+    const std::vector<int> rows{0, 1, 2};
+    for (int mode = 0; mode < 3; ++mode) {
+        auto settings = params;
+        if (mode == 1) { settings.top_k = 0; settings.top_p = 1; settings.min_p = 0; }
+        if (mode == 2) { settings.penalty_repeat = 1.1f; settings.penalty_freq = .1f; settings.penalty_last_n = 32; }
+        for (uint32_t seed = 1; seed <= 24; ++seed) {
+            settings.seed = seed;
+            block_preview_env(false);
+            common_sampler_ptr baseline(common_sampler_init(model, settings));
+            block_preview_env(true);
+            common_sampler_ptr optimized(common_sampler_init(model, settings));
+            require(llama_sampler_can_preview_distribution(common_sampler_get(optimized.get())), "builtin preview declined");
+            for (int round = 0; round < 5; ++round) {
+                common_sampler_ptr drafter(common_sampler_clone(baseline.get()));
+                llama_tokens draft;
+                std::vector<std::vector<llama_token_data>> q;
+                for (int i = 0; i < 2; ++i) {
+                    const auto token = common_sampler_sample(drafter.get(), context.get(), i);
+                    draft.push_back(token);
+                    const auto * candidates = common_sampler_get_candidates(drafter.get(), false);
+                    q.emplace_back(candidates->data, candidates->data + candidates->size);
+                    common_sampler_accept(drafter.get(), token, true);
+                }
+                if (round % 3 == 1) { draft[0] = 0; q[0] = {{0, 0.f, 1.f}}; }
+                if (round % 3 == 2) { draft[1] = 0; q[1] = {{0, 0.f, 1.f}}; }
+                const auto begin = ggml_time_us();
+                auto expected = common_sampler_sample_and_accept_n_rejection(baseline.get(), context.get(), rows, draft, q, false, true);
+                const auto middle = ggml_time_us();
+                auto actual = common_sampler_sample_and_accept_n_rejection(optimized.get(), context.get(), rows, draft, q, false, true);
+                baseline_us += middle - begin;
+                preview_us += ggml_time_us() - middle;
+                require(expected == actual, "preview changed block results or continued entropy");
+                require(common_sampler_last(baseline.get()) == common_sampler_last(optimized.get()), "preview changed history");
+            }
+            require(common_sampler_get_verified_blocks(optimized.get()) == 5, "preview fell back");
+            require(common_sampler_sample(baseline.get(), context.get(), 2) == common_sampler_sample(optimized.get(), context.get(), 2),
+                    "preview advanced target RNG");
+        }
+    }
+    // Both active grammar and a lazy grammar becoming active INSIDE the block
+    // must constrain the committed suffix, not only the first position.
+    for (bool lazy : {false, true}) {
+        auto settings = params;
+        settings.top_k = 0; settings.top_p = 1; settings.min_p = 0;
+        settings.grammar = common_grammar(COMMON_GRAMMAR_TYPE_USER, lazy ? "root ::= \"!\" [A-Z]+\n" : "root ::= [A-Z]+\n");
+        settings.grammar_lazy = lazy;
+        if (lazy) {
+            settings.grammar_triggers = {{COMMON_GRAMMAR_TRIGGER_TYPE_TOKEN, "", 3 + '!'}};
+            settings.logit_bias.push_back({3 + '!', 100.f});
+        }
+        for (int seed = 1; seed <= 24; ++seed) {
+            settings.seed = seed;
+            common_sampler_ptr sampler(common_sampler_init(model, settings));
+            require(common_sampler_can_verify_block(sampler.get(), false), "grammar-last block declined");
+            llama_tokens draft{3 + (lazy ? '!' : 'A'), 3 + 'B'};
+            std::vector<std::vector<llama_token_data>> q{{{draft[0], 0.f, 1.f}}, {{draft[1], 0.f, 1.f}}};
+            const auto accepted = common_sampler_sample_and_accept_n_rejection(sampler.get(), context.get(), rows, draft, q, false, true);
+            require(common_sampler_get_verified_blocks(sampler.get()) == 1, "grammar verifier fell back");
+            if (lazy) { require(accepted[0] == 3 + '!', "lazy trigger was not accepted"); }
+            for (size_t i = lazy ? 1 : 0; i < accepted.size(); ++i) {
+                require(accepted[i] >= 3 + 'A' && accepted[i] <= 3 + 'Z', "grammar emitted invalid token");
+            }
+        }
+    }
+    block_preview_env(false);
+    std::puts("PASS block preview: 360 exact rounds, continued RNG, penalties, active/lazy grammar");
+    std::printf("BLOCK_PREVIEW_FIXTURE baseline_us=%lld preview_us=%lld rounds=360 (component only)\n",
+        (long long) baseline_us, (long long) preview_us);
+}
