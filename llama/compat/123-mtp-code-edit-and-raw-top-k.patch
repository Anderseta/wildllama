     tokens source;
 
+    // A prior source match is only a hint. Verify the accepted history again:
+    // rejected proposals, repeated boilerplate and slot rewinds can all diverge.
+    size_t last_history_size = 0;
+    size_t last_source_end = 0;
+    size_t last_draft_size = 0;
+
     template<class At> static size_t bucket(At at) {
         uint32_t hash = 2166136261u;
         for (size_t i = 0; i < anchor; ++i) { hash = (hash ^ uint32_t(at(i))) * 16777619u; }
@@ -23,6 +29,7 @@ class common_mtp_edit_lookup {
 
 public:
     void begin(const tokens & prompt) {
+        last_source_end = 0;
         offsets.clear();
         source.clear();
         if (prompt.size() < anchor + 2) { return; }
@@ -34,18 +41,42 @@ public:
         }
     }
 
-    bool propose(const tokens & history, int32_t last, size_t maximum, tokens & result) const {
-        if (maximum < 2 || offsets.empty() || history.size() < anchor - 1 || !result.empty()) { return false; }
-        const auto at = [&](size_t i) {
-            return i == anchor - 1 ? last : history[history.size() - (anchor - 1) + i];
-        };
-        const size_t end = offsets[bucket(at)];
-        if (end == 0) { return false; }
-        for (size_t i = 0; i < anchor; ++i) {
-            if (source[end - anchor + i] != at(i)) { return false; }
+    bool propose(const tokens & history, int32_t last, size_t maximum, tokens & result) {
+        if (maximum < 2 || offsets.empty() || history.size() < anchor - 1 || !result.empty()) {
+            last_source_end = 0;
+            return false;
+        }
+
+        size_t end = 0;
+        if (last_source_end && history.size() > last_history_size) {
+            const size_t advance = history.size() - last_history_size;
+            // The target may also commit one token beyond the previous draft.
+            if (advance - 1 <= last_draft_size && advance <= source.size() - last_source_end) {
+                const size_t next = last_source_end + advance;
+                const size_t known = anchor + advance - 1;
+                if (source.size() - next >= 2 && source[next - 1] == last &&
+                        std::equal(source.begin() + last_source_end - anchor, source.begin() + next - 1,
+                                   history.end() - known)) {
+                    end = next;
+                }
+            }
+        }
+        if (!end) {
+            last_source_end = 0;
+            const auto at = [&](size_t i) {
+                return i == anchor - 1 ? last : history[history.size() - (anchor - 1) + i];
+            };
+            end = offsets[bucket(at)];
+            if (end == 0) { return false; }
+            for (size_t i = 0; i < anchor; ++i) {
+                if (source[end - anchor + i] != at(i)) { return false; }
+            }
         }
         const size_t count = std::min(maximum, source.size() - end);
         result.assign(source.begin() + end, source.begin() + end + count);
+        last_source_end = end;
+        last_history_size = history.size();
+        last_draft_size = count;
         return true;
     }
 };
diff --git a/common/mtp-raw-top-k.h b/common/mtp-raw-top-k.h
new file mode 100644
index 0000000..bbaa478
--- /dev/null
+++ b/common/mtp-raw-top-k.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include "llama.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <vector>
+
+// An exact shortlist for chains that begin with top-k. Keep a witness just
+// outside the cutoff so ties there can fall back to the original CPU ordering.
+inline bool common_mtp_raw_top_k(const float * logits, int n, int k, std::vector<llama_token_data> & out) {
+    if (!logits || k < 1 || k >= 128 || n < 4096) { return false; }
+    const auto descending = [](const auto & a, const auto & b) { return a.logit > b.logit; };
+    std::array<llama_token_data, 128> heap;
+    const auto end = heap.begin() + k + 1;
+    for (int i = 0; i <= k; ++i) {
+        if (!std::isfinite(logits[i])) { return false; }
+        heap[i] = {i, logits[i], 0.0f};
+    }
+    std::make_heap(heap.begin(), end, descending);
+    for (int i = k + 1; i < n; ++i) {
+        const float score = logits[i];
+        if (!std::isfinite(score)) { return false; }
+        if (score > heap.front().logit) {
+            std::pop_heap(heap.begin(), end, descending);
+            heap[k] = {i, score, 0.0f};
+            std::push_heap(heap.begin(), end, descending);
+        }
+    }
+    std::sort_heap(heap.begin(), end, descending);
+    for (int i = 1; i <= k; ++i) {
+        if (heap[i].logit == heap[i - 1].logit) { return false; }
+    }
+    out.assign(heap.begin(), end - 1);
+    return true;
+}
