diff --git a/tests/test-mtp-raw-top-k.cpp b/tests/test-mtp-raw-top-k.cpp
new file mode 100644
index 0000000..4af20ff
--- /dev/null
+++ b/tests/test-mtp-raw-top-k.cpp
@@ -0,0 +1,79 @@
+#include "../common/mtp-raw-top-k.h"
+#include "../src/llama-sampler.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <numeric>
+#include <random>
+static void check(bool ok) {
+    if (!ok) {
+        std::fputs("top-k oracle mismatch\n", stderr);
+        std::exit(1);
+    }
+}
+int main() {
+    std::mt19937 rng(713);
+    std::vector<llama_token_data> got;
+    for (int size : {4096, 248320}) {
+        std::vector<float> row(size);
+        std::iota(row.begin(), row.end(), float(-size / 2));
+        for (int round = 0; round < 4; ++round) {
+            std::shuffle(row.begin(), row.end(), rng);
+            for (int k : {1, 2, 20, 64, 127}) {
+                std::vector<llama_token_data> ref(size);
+                for (int i = 0; i < size; ++i) {
+                    ref[i] = {i, row[i], 0.0f};
+                }
+                auto original = ref;
+                std::partial_sort(ref.begin(), ref.begin() + k, ref.end(),
+                                  [](const auto & a, const auto & b) { return a.logit > b.logit; });
+                check(common_mtp_raw_top_k(row.data(), size, k, got) && got.size() == size_t(k));
+                for (int i = 0; i < k; ++i) {
+                    check(ref[i].id == got[i].id && ref[i].logit == got[i].logit && got[i].p == 0.0f);
+                }
+                // Compare the actual filtering chain, including float probabilities.
+                for (auto & t : original) {
+                    t.logit *= 1.0f / 8192;
+                }
+                for (auto & t : got) {
+                    t.logit *= 1.0f / 8192;
+                }
+                auto chain = llama_sampler_chain_init(llama_sampler_chain_default_params());
+                llama_sampler_chain_add(chain, llama_sampler_init_top_k(k));
+                llama_sampler_chain_add(chain, llama_sampler_init_top_p(0.95f, 1));
+                llama_sampler_chain_add(chain, llama_sampler_init_min_p(0.02f, 1));
+                llama_sampler_chain_add(chain, llama_sampler_init_temp(0.83f));
+                llama_sampler_chain_add(chain, llama_sampler_init_dist(42));
+                llama_token_data_array full = {original.data(), original.size(), -1, false};
+                llama_token_data_array compact = {got.data(), got.size(), -1, true};
+                check(llama_sampler_preview_distribution(chain, &full));
+                check(llama_sampler_preview_distribution(chain, &compact));
+                check(full.size == compact.size);
+                for (size_t i = 0; i < full.size; ++i) {
+                    check(full.data[i].id == compact.data[i].id && full.data[i].p == compact.data[i].p);
+                }
+                llama_sampler_free(chain);
+            }
+        }
+        std::iota(row.begin(), row.end(), 0.f);
+        row[size - 21] = row[size - 20];
+        check(!common_mtp_raw_top_k(row.data(), size, 20, got));
+        row[size - 21] = 0.f;
+        row.back() = row[size - 2];
+        check(!common_mtp_raw_top_k(row.data(), size, 20, got));
+        row.back() = float(size);
+        for (auto v : {std::numeric_limits<float>::quiet_NaN(), std::numeric_limits<float>::infinity(),
+                       -std::numeric_limits<float>::infinity()}) {
+            row[0] = v;
+            check(!common_mtp_raw_top_k(row.data(), size, 20, got));
+            row[0] = 0;
+            row[size / 2] = v;
+            check(!common_mtp_raw_top_k(row.data(), size, 20, got));
+            row[size / 2] = 0;
+        }
+        check(!common_mtp_raw_top_k(row.data(), size, 128, got) && !common_mtp_raw_top_k(row.data(), size, 0, got));
+    }
+    std::puts(
+        "PASS CPU shortlist: full-sort IDs and native probabilities, bounds, top and boundary ties, nonfinite rows");
+}
