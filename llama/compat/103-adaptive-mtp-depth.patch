diff --git a/tests/test-server-mtp-depth.cpp b/tests/test-server-mtp-depth.cpp
new file mode 100644
index 0000000..ac1be5a
--- /dev/null
+++ b/tests/test-server-mtp-depth.cpp
@@ -0,0 +1,47 @@
+#include "../tools/server/server-mtp-depth.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+static void check(bool condition, const char * message) {
+    if (!condition) {
+        std::fprintf(stderr, "%s\n", message);
+        std::exit(1);
+    }
+}
+
+int main() {
+    server_mtp_depth depth;
+    check(depth.choose(800, 2) == 2, "short replies lost the configured depth");
+    for (int round = 0; round < 32; ++round) {
+        const int proposal_limit = depth.choose(800, 2);
+        check(proposal_limit >= 0 && proposal_limit <= 2, "profile ceiling exceeded");
+        // Depth two has better acceptance but a higher cost per output token.
+        const double costs[] = { 10, 12, 24 };
+        const uint64_t outputs[] = { 1, 2, 3 };
+        depth.observe(costs[proposal_limit], outputs[proposal_limit]);
+    }
+    check(depth.choose(800, 2) == 1, "used acceptance instead of total generation cost");
+    check(depth.choose(16000, 2) == 2, "long context reused short-context timing");
+    check(depth.choose(800, 2) == 1, "short context lost its learned preference");
+    // If the workload becomes easy for depth two, periodic probes must
+    // recover from the old preference instead of disabling it forever.
+    for (int round = 0; round < 1024; ++round) {
+        const int proposal_limit = depth.choose(800, 2);
+        const double costs[] = { 10, 12, 10 };
+        const uint64_t outputs[] = { 1, 2, 3 };
+        depth.observe(costs[proposal_limit], outputs[proposal_limit]);
+    }
+    check(depth.choose(800, 2) == 2, "periodic probes failed to recover a faster depth");
+    check(depth.choose(800, 1) <= 1, "lowered ceiling was ignored");
+    check(depth.choose(800, 4) == 0, "unsupported depth was admitted");
+
+    server_mtp_depth third;
+    for (int round = 0; round < 24; ++round) {
+        const int proposal_limit = third.choose(32000, 3);
+        check(proposal_limit >= 0 && proposal_limit <= 3, "three-draft profile ceiling exceeded");
+        third.observe(10, uint64_t(proposal_limit + 1));
+    }
+    check(third.choose(32000, 3) == 3, "fast third proposal was not selected");
+    std::puts("PASS adaptive MTP depth: request ceiling, cost, context isolation and recovery");
+}
