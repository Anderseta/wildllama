diff --git a/tools/server/server-mtp-depth.h b/tools/server/server-mtp-depth.h
new file mode 100644
index 0000000..43db1c6
--- /dev/null
+++ b/tools/server/server-mtp-depth.h
@@ -0,0 +1,98 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+// Request-local measurements. A depth is the proposal limit, so a short or
+// empty proposal still pays its actual cost to the depth that requested it.
+class server_mtp_depth {
+    static constexpr int minimum_samples = 3;
+    static constexpr int refresh_interval = 128;
+
+    struct cost {
+        double time = 0;
+        double tokens = 0;
+        int samples = 0;
+
+        void add(double us, uint64_t committed) {
+            time = time * 0.8 + us;
+            tokens = tokens * 0.8 + double(committed);
+            if (samples < minimum_samples) {
+                ++samples;
+            }
+        }
+
+        double us_per_token() const { return time / tokens; }
+    };
+
+    struct history {
+        std::array<cost, 4> depths{};
+        int preferred = -1;
+        int until_refresh = refresh_interval;
+        int refresh_depth = 0;
+        int refresh_samples = 0;
+    };
+
+    std::array<history, 4> histories{};
+    int active_history = -1;
+    int active_depth = -1;
+    bool warmup = true;
+
+public:
+    int choose(uint64_t context_tokens, int ceiling) {
+        if (ceiling < 1 || ceiling > 3) {
+            active_depth = -1;
+            return 0;
+        }
+        const int bucket = int(context_tokens >= 2048) + int(context_tokens >= 8192) +
+                           int(context_tokens >= 24576);
+        auto & h = histories[bucket];
+        // Start with the configured depth before probing alternatives.
+        int selected = ceiling;
+        if (h.depths[ceiling].samples >= minimum_samples) {
+            selected = 0;
+            while (selected < ceiling && h.depths[selected].samples >= minimum_samples) {
+                ++selected;
+            }
+            if (h.depths[selected].samples >= minimum_samples) {
+                if (h.preferred < 0 || h.preferred > ceiling) {
+                    h.preferred = 0;
+                }
+                for (int depth = 0; depth <= ceiling; ++depth) {
+                    if (h.depths[depth].us_per_token() < 0.95 * h.depths[h.preferred].us_per_token()) {
+                        h.preferred = depth;
+                    }
+                }
+                selected = h.until_refresh > 0 ? h.preferred : h.refresh_depth % (ceiling + 1);
+            }
+        }
+        if (bucket != active_history || selected != active_depth) {
+            warmup = true; // discard the graph transition from the measurement
+        }
+        active_history = bucket;
+        active_depth = selected;
+        return selected;
+    }
+
+    void observe(double us, uint64_t committed) {
+        if (active_depth < 0 || us <= 0 || committed == 0) {
+            return;
+        }
+        if (warmup) {
+            warmup = false;
+            return;
+        }
+        auto & h = histories[active_history];
+        h.depths[active_depth].add(us, committed);
+        if (h.preferred < 0) {
+            return;
+        }
+        if (h.until_refresh > 0) {
+            --h.until_refresh;
+        } else if (++h.refresh_samples == minimum_samples) {
+            h.refresh_samples = 0;
+            h.refresh_depth = active_depth + 1;
+            h.until_refresh = refresh_interval;
+        }
+    }
+};
