 inline size_t server_checkpoint_add_bytes(size_t a, size_t b) {
     return b > SIZE_MAX - a ? SIZE_MAX : a + b;
+}
+
+// Keep an editable suffix when a short conversation fits entirely in one
+// physical batch. Leave the normal four-token tail anchor in place as well.
+inline int32_t server_checkpoint_early_offset(int64_t prompt_tokens, int32_t batch, int32_t ubatch,
+        bool reusable_text) {
+    constexpr int32_t edit_offset = 64 + 4;
+    const int32_t usual = std::min(batch, ubatch + 4);
+    if (reusable_text && prompt_tokens >= 2 * edit_offset && prompt_tokens <= usual) {
+        return edit_offset;
+    }
+    return usual;
+}
+
+// A large recurrent snapshot can cost more to copy than replaying a tiny text
+// prefix. Respect explicitly close checkpoint spacing and expensive media prefixes.
+inline bool server_checkpoint_prefer_replay(int64_t tokens, size_t state_bytes,
+        int64_t min_step, bool has_media) {
+    constexpr int64_t max_replay_tokens = 32;
+    constexpr size_t large_state = 64u * 1024 * 1024;
+    return !has_media && tokens > 0 && tokens <= max_replay_tokens &&
+        min_step > max_replay_tokens && state_bytes >= large_state;
 }
 
