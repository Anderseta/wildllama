+static bool llama_can_prefer_fp8_kv(const llama_model & model, const llama_context_params & params) {
+    if (!llama_fp8_cache_arch(model) || model.split_mode() == LLAMA_SPLIT_MODE_TENSOR) {
+        return false;
+    }
+    const auto & hp = model.hparams;
+    const bool mtp = params.ctx_type == LLAMA_CONTEXT_TYPE_MTP;
+    const uint32_t first = mtp ? hp.n_layer() : 0;
+    const uint32_t last = mtp ? hp.n_layer_all : hp.n_layer();
+    std::set<std::tuple<ggml_backend_dev_t, uint32_t, uint32_t, uint32_t, uint32_t>> tested;
+    for (uint32_t il = first; il < last; ++il) {
+        if (!hp.has_kv(il) || (!mtp && hp.is_recr(il)) || hp.n_head_kv(il) == 0) continue;
+        auto * dev = params.offload_kqv ? model.dev_layer(il) : ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+        const auto dk = hp.n_embd_head_k(il), dv = hp.n_embd_head_v(il);
+        const auto h = hp.n_head(il), hk = hp.n_head_kv(il);
+        if (!dev || !dk || !dv || !h || h % hk) return false;
+        if (!tested.emplace(dev, dk, dv, h, hk).second) continue;
+        ggml_context_ptr ctx(ggml_init({24 * ggml_tensor_overhead(), nullptr, true}));
+        if (!ctx) return false;
+        auto * ids = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I64, 1);
+        for (const auto d : {dk, dv}) {
+            auto * rows = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F8_E4M3, d * hk, 256);
+            auto * src = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, d * hk, 1);
+            if (!ggml_backend_dev_supports_op(dev, ggml_set_rows(ctx.get(), rows, src, ids))) return false;
+        }
+        if (params.flash_attn_type == LLAMA_FLASH_ATTN_TYPE_DISABLED) {
+            // The unfused CPU path stores V transposed, one scalar per row,
+            // and accumulates both products against FP32 activations.
+            if (ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU) return false;
+            auto * vt = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F8_E4M3, 1, 256 * dv * hk);
+            auto * value = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, 1, 1);
+            if (!ggml_backend_dev_supports_op(dev, ggml_set_rows(ctx.get(), vt, value, ids))) return false;
+            for (const auto width : {dk, uint32_t(256)}) {
+                auto * weights = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F8_E4M3, width, 256);
+                auto * input = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, width, 1);
+                if (!ggml_backend_dev_supports_op(dev, ggml_mul_mat(ctx.get(), weights, input))) return false;
+            }
+            continue;
+        }
+        auto * k = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_F8_E4M3, dk, 256, hk);
+        auto * v = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_F8_E4M3, dv, 256, hk);
+        for (const int tokens : {1, 32}) {
+            auto * q = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_F32, dk, tokens, h);
+            auto * mask = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F16, 256, tokens);
+            auto * attention = ggml_flash_attn_ext(ctx.get(), q, k, v, mask, 1.f, 0.f, 0.f);
+            if (!ggml_backend_dev_supports_op(dev, attention)) return false;
+        }
+    }
