diff --git a/tests/test-fp8-kv.cpp b/tests/test-fp8-kv.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..418c419a11e6c3144d37402918ce736ca1873eb7
--- /dev/null
+++ b/tests/test-fp8-kv.cpp
@@ -0,0 +1,140 @@
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <numeric>
+#include <random>
+#include <stdexcept>
+#include <vector>
+
+static void check(bool ok, const char * reason) {
+    if (!ok) throw std::runtime_error(reason);
+}
+
+struct measurement {
+    std::vector<float> output;
+    size_t bytes;
+    double milliseconds;
+};
+
+// Build the same strided K/V views used during grouped-query attention.
+// Populate both banks through SET_ROWS and measure only repeated attention.
+static measurement run(ggml_backend_t backend, ggml_type type, int length, int tokens, bool cuda) {
+    constexpr int d = 256, heads = 24, kv_heads = 4;
+    ggml_context_ptr ctx(ggml_init({64 * ggml_tensor_overhead() + 2 * ggml_graph_overhead_custom(64, false), nullptr, true}));
+    auto * ids = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I64, length);
+    auto * writes = ggml_new_graph_custom(ctx.get(), 64, false);
+    size_t cache_bytes = 0;
+    auto bank = [&](ggml_tensor ** data) {
+        auto * cache = ggml_new_tensor_2d(ctx.get(), type, d * kv_heads, length);
+        cache_bytes += ggml_nbytes(cache);
+        *data = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, d * kv_heads, length);
+        ggml_build_forward_expand(writes, ggml_set_rows(ctx.get(), cache, *data, ids));
+        return ggml_permute(ctx.get(), ggml_reshape_3d(ctx.get(), cache, d, kv_heads, length), 0, 2, 1, 3);
+    };
+    ggml_tensor * sk, * sv;
+    auto * k = bank(&sk);
+    auto * v = bank(&sv);
+    auto * q = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_F32, d, tokens, heads);
+    auto * mask = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F16, length, tokens);
+    auto * out = ggml_flash_attn_ext(ctx.get(), q, k, v, mask, 1.f/std::sqrt(float(d)), 0, 0);
+    auto * attention = ggml_new_graph_custom(ctx.get(), 64, false);
+    ggml_build_forward_expand(attention, out);
+    ggml_backend_buffer_ptr buf(ggml_backend_alloc_ctx_tensors(ctx.get(), backend));
+    check(bool(buf), "tensor allocation");
+    std::mt19937 generator(3128);
+    std::uniform_real_distribution<float> random(-1.5f, 1.5f);
+    for (auto * tensor : {sk, sv, q}) {
+        std::vector<float> data(ggml_nelements(tensor));
+        for (auto & x : data) x = random(generator);
+        ggml_backend_tensor_set(tensor, data.data(), 0, ggml_nbytes(tensor));
+    }
+    std::vector<int64_t> indices(length);
+    std::iota(indices.begin(), indices.end(), 0);
+    ggml_backend_tensor_set(ids, indices.data(), 0, ggml_nbytes(ids));
+    std::vector<ggml_fp16_t> causal(length*tokens);
+    for (int i = 0; i < tokens; i++) {
+        std::fill(causal.begin()+i*length+length-tokens+i+1, causal.begin()+(i+1)*length, ggml_fp32_to_fp16(-INFINITY));
+    }
+    ggml_backend_tensor_set(mask, causal.data(), 0, ggml_nbytes(mask));
+    check(ggml_backend_graph_compute(backend, writes) == GGML_STATUS_SUCCESS, "cache write");
+    auto compute = [&] {
+        check(ggml_backend_graph_compute(backend, attention) == GGML_STATUS_SUCCESS, "attention");
+        ggml_backend_synchronize(backend);
+    };
+    compute();
+    std::vector<double> samples;
+    for (int i = 0; i < (cuda ? 31 : 3); i++) {
+        auto start = std::chrono::steady_clock::now();
+        compute();
+        samples.push_back(std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count());
+    }
+    std::sort(samples.begin(), samples.end());
+    measurement result{{}, cache_bytes, samples[samples.size()/2]};
+    result.output.resize(ggml_nelements(out));
+    ggml_backend_tensor_get(out, result.output.data(), 0, ggml_nbytes(out));
+    return result;
+}
+
+int main(int argc, char ** argv) {
+    try {
+        uint8_t codes[256]; float values[256];
+        for (int i = 0; i < 256; ++i) codes[i] = uint8_t(i);
+        ggml_get_type_traits(GGML_TYPE_F8_E4M3)->to_float(codes, values, 256);
+        for (int i = 0; i < 256; ++i) {
+            const int mag = i & 127, exponent = mag >> 3, mantissa = mag & 7;
+            if (mag == 127) { check(std::isnan(values[i]), "E4M3 NaN"); continue; }
+            const float absolute = exponent ? std::ldexp(float(8 + mantissa), exponent - 10) : std::ldexp(float(mantissa), -9);
+            check(values[i] == (i < 128 ? absolute : -absolute) && std::signbit(values[i]) == (i >= 128), "E4M3 decode");
+        }
+        const auto encode = [](float x) {
+            uint8_t encoded;
+            ggml_get_type_traits(GGML_TYPE_F8_E4M3)->from_float_ref(&x, &encoded, 1);
+            return encoded;
+        };
+        for (int mag = 0; mag < 126; ++mag) {
+            const float midpoint = (values[mag] + values[mag+1]) * 0.5f;
+            for (int sign : {0, 128}) {
+                auto code = [&](float v) { return encode(sign ? -v : v); };
+                check(code(std::nextafter(midpoint, 0.f)) == (sign | mag), "below E4M3 midpoint");
+                check(code(midpoint) == (sign | (mag + (mag & 1))), "E4M3 ties-to-even");
+                check(code(std::nextafter(midpoint, INFINITY)) == (sign | (mag+1)), "above E4M3 midpoint");
+            }
+        }
+        check(encode(-0.0f) == 128 && encode(INFINITY) == 126 && encode(-INFINITY) == 254 &&
+              encode(NAN) == 127, "E4M3 saturation or special encoding");
+        const bool cuda = argc > 1 && std::strcmp(argv[1], "--cuda") == 0;
+        auto registry = ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH);
+#ifdef GGML_TEST_CUDA_BACKEND_PATH
+        if (cuda) registry = ggml_backend_load(GGML_TEST_CUDA_BACKEND_PATH);
+#else
+        if (cuda) return 77;
+#endif
+        if (!registry || !ggml_backend_reg_dev_count(registry)) return cuda ? 77 : 1;
+        ggml_backend_ptr backend(ggml_backend_dev_init(ggml_backend_reg_dev_get(registry, 0), nullptr));
+        check(bool(backend), "backend initialization");
+        for (int count : {1, 4, 32}) {
+            const int length = cuda ? 4096 : 256;
+            auto reference = run(backend.get(), GGML_TYPE_F16, length, count, cuda);
+            auto q8 = run(backend.get(), GGML_TYPE_Q8_0, length, count, cuda);
+            auto fp8 = run(backend.get(), GGML_TYPE_F8_E4M3, length, count, cuda);
+            check(fp8.bytes == size_t(length)*256*4*2 && fp8.bytes*2 == reference.bytes && fp8.bytes*17 == q8.bytes*16, "storage");
+            double error = 0, norm = 0;
+            for (size_t i = 0; i < reference.output.size(); i++) {
+                double delta = fp8.output[i] - reference.output[i];
+                error += delta*delta;
+                norm += double(reference.output[i])*reference.output[i];
+            }
+            const double nrmse = std::sqrt(error/norm);
+            std::printf("%s length=%d q=%d fp16_ms=%.4f q8_ms=%.4f fp8_ms=%.4f fp8_bytes=%zu relative_rmse=%.5f\n",
+                ggml_backend_name(backend.get()), length, count, reference.milliseconds, q8.milliseconds, fp8.milliseconds, fp8.bytes, nrmse);
+            check(std::isfinite(nrmse) && nrmse < 0.07, "FP8 attention accuracy");
+        }
+        return 0;
+    } catch (const std::exception & err) { std::fprintf(stderr, "%s\n", err.what()); return 1; }
+}
