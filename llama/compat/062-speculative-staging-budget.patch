+    require(!llama_set_nextn_device(context.get(), true) && !llama_get_nextn_device_owner(context.get()),
+            "zero device budget allocated optional transport");
+    device_budget("1");
+    require(llama_set_nextn_device(context.get(), true), "one MiB transport budget rejected tiny context");
+    auto owner = llama_get_nextn_device_owner(context.get());
+    require(owner && owner->max_bytes == 1024*1024, "context ignored selected transport budget");
+    common_batch large(context.get());
+    for (int i = 0; i < 64; ++i) { large.add(3 + i%9, i, 0, true); }
+    require(llama_process(context.get(), LLAMA_PROCESS_TYPE_DECODE, large.get()) == 0, "prefill bank decode failed");
