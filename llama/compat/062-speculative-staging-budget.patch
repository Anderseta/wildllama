+    auto * const allocation = row.rows.get();
+    row = {};
+    common_batch small(context.get()); small.add(7, 64, 0, true);
+    require(llama_process(context.get(), LLAMA_PROCESS_TYPE_DECODE, small.get()) == 0, "small bank-reuse decode failed");
+    row = llama_get_nextn_device_row(context.get(), 0);
+    require(row && row.rows.get() == allocation && row.rows->tensor->ne[1] == 64,
+            "fixture did not reuse the oversized prefill allocation");
+    const auto before = owner->materialized_bytes;
+    const float * host = llama_get_embeddings_nextn(context.get());
+    require(host && owner->materialized_bytes - before == 32*sizeof(float),
+            "one active row materialized the whole oversized bank");
+    std::vector<float> direct(32);
+    require(llama_nextn_device_read(row, direct.data()) && std::equal(direct.begin(), direct.end(), host),
+            "bounded materialization changed hidden-state values");
+    require(owner->bytes <= owner->max_bytes, "transport allocation exceeded selected aggregate quota");
+    device_budget(nullptr);
 }
 
