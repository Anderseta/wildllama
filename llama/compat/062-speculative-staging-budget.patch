diff --git a/common/speculative-input.h b/common/speculative-input.h
new file mode 100644
--- /dev/null
+++ b/common/speculative-input.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <cstddef>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+// Encoder chunks retain their original row order and shape. Only their host
+// concatenation workspace is chunked, rather than duplicating a full prefill.
+inline bool common_speculative_pack_features(
+        std::vector<float> & destination, const float * const * layers, size_t layer_count,
+        size_t width, size_t first, size_t count, size_t rows) {
+    if (!layers || !layer_count || !width || !count || first > rows || count > rows - first ||
+        layer_count > std::numeric_limits<size_t>::max()/width ||
+        rows > std::numeric_limits<size_t>::max()/width/sizeof(float)) { return false; }
+    const size_t row_width = layer_count*width;
+    if (count > std::numeric_limits<size_t>::max()/row_width/sizeof(float)) { return false; }
+    for (size_t layer = 0; layer < layer_count; ++layer) { if (!layers[layer]) { return false; } }
+    destination.resize(count*row_width);
+    for (size_t row = 0; row < count; ++row) {
+        for (size_t layer = 0; layer < layer_count; ++layer) {
+            std::memcpy(destination.data() + row*row_width + layer*width,
+                    layers[layer] + (first + row)*width, width*sizeof(float));
+        }
+    }
+    return true;
+}
diff --git a/tests/test-speculative-input.cpp b/tests/test-speculative-input.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-speculative-input.cpp
@@ -0,0 +1,74 @@
+#include "speculative-input.h"
+#include "../src/llama-nextn-device.h"
+
+#include <array>
+#include <cstdio>
+#include <stdexcept>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+int main() {
+    try {
+        constexpr size_t width = 17, rows = 67, layers = 3;
+        std::array<std::vector<float>, layers> inputs;
+        std::array<const float *, layers> pointers;
+        for (size_t layer = 0; layer < layers; ++layer) {
+            inputs[layer].resize(width*rows);
+            for (size_t row = 0; row < rows; ++row) {
+                for (size_t column = 0; column < width; ++column) {
+                    inputs[layer][row*width + column] = float(10000*layer + 100*row + column);
+                }
+            }
+            pointers[layer] = inputs[layer].data();
+        }
+        // Independent full-prefill reference, indexed by logical feature rather
+        // than reproducing the chunk packer's memory-copy loop.
+        std::vector<float> reference(rows*layers*width);
+        for (size_t index = 0; index < reference.size(); ++index) {
+            const size_t row = index/(layers*width), feature = index%(layers*width);
+            reference[index] = float(10000*(feature/width) + 100*row + feature%width);
+        }
+        for (const size_t chunk : {size_t(1), size_t(2), size_t(7), size_t(64)}) {
+            std::vector<float> staged, replay;
+            staged.reserve(chunk*layers*width);
+            auto * const allocation = staged.data();
+            const size_t capacity = staged.capacity();
+            for (size_t first = 0; first < rows; first += chunk) {
+                require(common_speculative_pack_features(staged, pointers.data(), layers, width,
+                        first, std::min(chunk, rows - first), rows), "feature chunk rejected");
+                require(staged.data() == allocation && staged.capacity() == capacity && staged.size() <= chunk*layers*width,
+                        "chunk staging allocated a full-prefill workspace");
+                replay.insert(replay.end(), staged.begin(), staged.end());
+            }
+            require(replay == reference, "chunking changed feature values or row/layer order");
+            const auto sentinel = staged;
+            require(!common_speculative_pack_features(staged, pointers.data(), layers, width, rows, 1, rows) &&
+                    !common_speculative_pack_features(staged, pointers.data(), layers, SIZE_MAX, 0, 1, rows) &&
+                    staged == sentinel, "invalid chunk range or overflow mutated staged features");
+            auto missing = pointers; missing[1] = nullptr;
+            require(!common_speculative_pack_features(staged, missing.data(), layers, width, 0, 1, rows) &&
+                    staged == sentinel, "missing layer published partial staged input");
+        }
+        constexpr size_t mib = 1024*1024;
+        require(llama_nextn_device_budget(nullptr) == 32*mib && llama_nextn_device_budget("0") == 0 &&
+                llama_nextn_device_budget("1") == mib && llama_nextn_device_budget("32") == 32*mib,
+                "MTP device budget default or valid bounds changed");
+        for (const char * invalid : {"", "-1", "+1", " 1", "1 ", "1MiB", "33", "99999999999999999999"}) {
+            require(llama_nextn_device_budget(invalid) == 0, "invalid device budget enabled allocation");
+        }
+        size_t active = 99;
+        require(llama_nextn_capture_extent({-1, 1, 0, -1, 2}, 64, active) && active == 3,
+                "oversized prefill bank forced inactive rows into host materialization");
+        require(llama_nextn_capture_extent({-1, -1}, 64, active) && active == 0, "absent outputs materialized old rows");
+        active = 99;
+        require(!llama_nextn_capture_extent({0, 64}, 64, active) && active == 99 &&
+                !llama_nextn_capture_extent({-2}, 64, active) && active == 99,
+                "invalid row mapping accepted or partially published");
+        require(llama_nextn_capture_extent({2, 0, 1}, 3, active) && active == 3,
+                "permuted logical output lost a captured row");
+        std::puts("PASS: exact EAGLE3 chunk inputs with reusable ubatch workspace; strict 0..32MiB MTP budget; active mapped rows only");
+        return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr, "FAIL: %s\n", error.what()); return 1; }
+}
