 #include "ggml-cpp.h"
 
+#include <algorithm>
 #include <cstdint>
 #include <cstring>
 #include <limits>
 #include <memory>
 #include <vector>
 
+inline size_t llama_nextn_device_budget(const char * text) {
+    constexpr size_t mib = 1024u*1024u;
+    if (!text) { return 32u*mib; }
+    if (!*text) { return 0; }
+    size_t value = 0;
+    for (const char * p = text; *p; ++p) {
+        if (*p < '0' || *p > '9' || value > 32) { return 0; }
+        value = value*10 + size_t(*p - '0');
+    }
+    return value <= 32 ? value*mib : 0;
+}
+
+inline bool llama_nextn_capture_extent(const std::vector<int32_t> & row_ids, size_t capacity, size_t & rows) {
+    size_t extent = 0;
+    for (const int32_t row : row_ids) {
+        if (row < -1 || (row >= 0 && size_t(row) >= capacity)) { return false; }
+        if (row >= 0) { extent = std::max(extent, size_t(row) + 1); }
+    }
+    rows = extent;
+    return true;
+}
+
 // Own the transport backend as well as its buffers: a saved row cannot borrow
 // a stream or graph allocation that a context reset/unload may destroy.
 struct llama_nextn_device_owner {
     ggml_backend_ptr backend;
     size_t bytes = 0;
-    static constexpr size_t max_bytes = 32u*1024u*1024u;
+    size_t max_bytes = 32u*1024u*1024u;
     uint64_t captured_bytes = 0;
     uint64_t device_input_rows = 0;
     uint64_t host_input_rows = 0;
