+    common_params_sampling parameters;
+    parameters.samplers = {COMMON_SAMPLER_TYPE_TOP_K, COMMON_SAMPLER_TYPE_TEMPERATURE};
+    parameters.temp = .8f;
+    parameters.top_k = 16;
+    parameters.seed = 149;
