+struct block_targets {
+    const float * probabilities[GGML_CUDA_VERIFY_BLOCK_DRAFT_MAX + 1];
+    const int32_t * candidates[GGML_CUDA_VERIFY_BLOCK_DRAFT_MAX + 1];
+    uint32_t counts[GGML_CUDA_VERIFY_BLOCK_DRAFT_MAX + 1];
+};
+
+__global__ void verify_block(block_targets targets, ggml_cuda_verify_block_input input,
+        uint32_t vocabulary, ggml_cuda_verify_block_result * result) {
+    constexpr uint32_t width = GGML_CUDA_VERIFY_BLOCK_TARGET_MAX;
+    __shared__ double matching_proposal[GGML_CUDA_VERIFY_BLOCK_DRAFT_MAX + 1][width];
+
+    const uint32_t row = threadIdx.y;
+    if (row <= input.draft_count) {
+        for (uint32_t k = threadIdx.x; k < targets.counts[row]; k += blockDim.x) {
+            double q = 0.0;
+            if (row < input.draft_count) {
+                const auto & proposal = input.proposals[row];
+                const int32_t id = targets.candidates[row][k];
+                for (uint32_t j = 0; j < proposal.size; ++j) {
+                    if (id == proposal.ids[j]) {
+                        q = proposal.probabilities[j];
+                        break;
+                    }
+                }
+            }
+            matching_proposal[row][k] = q;
+        }
+    }
+    __syncthreads();
+    if (threadIdx.x || threadIdx.y) {
+        return;
+    }
+
+    // Keep the CPU verifier's serial accumulation and explicit rounding at
+    // the p/q residual boundary. The source p can differ by softmax rounding.
+    *result = {-1, -1, 0};
+    ggml_cuda_verify_block_result decision{-1, -1, 0};
+    double prefix = 1.0;
+    for (uint32_t i = 0; i <= input.draft_count; ++i) {
+        const auto * p = targets.probabilities[i];
+        const auto * ids = targets.candidates[i];
+        const auto count = targets.counts[i];
+        double sum = 0.0;
+        for (uint32_t k = 0; k < count; ++k) {
+            if (!isfinite(p[k]) || p[k] < 0 || (p[k] > 0 && (ids[k] < 0 || uint32_t(ids[k]) >= vocabulary))) {
+                return;
+            }
+            sum += p[k];
+        }
+        if (fabs(sum - 1.0) > 1e-4) {
+            return;
+        }
+        const double retain = 1.0 - prefix;
+        double total = retain;
+        double target_token = 0.0;
+        double draft_token = 0.0;
+        int32_t last_positive = -1;
+        for (uint32_t k = 0; k < count; ++k) {
+            const double probability = __ddiv_rn(double(p[k]), sum);
+            const double q = matching_proposal[i][k];
+            if (i < input.draft_count && ids[k] == input.proposals[i].token) {
+                target_token = probability;
+                draft_token = q;
+            }
+            const double weight = __dsub_rn(__dmul_rn(prefix, probability), q);
+            if (weight > 0.0) {
+                total += weight;
+                last_positive = ids[k];
+            }
+        }
+        if (last_positive >= 0) {
+            const double draw = __dmul_rn(input.draws[decision.draws_used++], total);
+            if (draw >= retain) {
+                double cumulative = retain;
+                decision.kept = i;
+                decision.correction = last_positive;
+                for (uint32_t k = 0; k < count; ++k) {
+                    const double probability = __ddiv_rn(double(p[k]), sum);
+                    const double weight = __dsub_rn(__dmul_rn(prefix, probability), matching_proposal[i][k]);
+                    if (weight > 0.0) {
+                        cumulative += weight;
+                        if (draw < cumulative) {
+                            decision.correction = ids[k];
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        if (i < input.draft_count) {
+            prefix = target_token > 0.0 ? fmin(1.0, __ddiv_rn(__dmul_rn(prefix, target_token), draft_token)) : 0.0;
+            if (prefix == 0.0) {
+                break;
+            }
+        }
+    }
+    *result = decision;
+}
+
+inline bool enqueue_block(void * opaque, const ggml_tensor * const * probabilities,
+        const ggml_tensor * const * candidates, const ggml_cuda_verify_block_input * input,
+        ggml_cuda_verify_block_result * result) {
+    auto * saved = static_cast<state *>(opaque);
+    if (!saved || !probabilities || !candidates || !input || !result ||
+            input->draft_count < 2 || input->draft_count > GGML_CUDA_VERIFY_BLOCK_DRAFT_MAX) {
+        return false;
+    }
+    const auto buft = ggml_backend_get_default_buffer_type(saved->backend);
+    auto valid_tensor = [buft](const ggml_tensor * tensor, ggml_type type) {
+        return tensor && tensor->type == type && tensor->data && tensor->buffer &&
+            ggml_backend_buffer_get_type(tensor->buffer) == buft && ggml_is_contiguous(tensor) &&
+            ggml_nelements(tensor) > 0 && ggml_nelements(tensor) <= GGML_CUDA_VERIFY_BLOCK_TARGET_MAX;
+    };
+    block_targets targets{};
+    for (uint32_t i = 0; i <= input->draft_count; ++i) {
+        if (!valid_tensor(probabilities[i], GGML_TYPE_F32) || !valid_tensor(candidates[i], GGML_TYPE_I32) ||
+                ggml_nelements(probabilities[i]) != ggml_nelements(candidates[i]) ||
+                !std::isfinite(input->draws[i]) || input->draws[i] < 0.0 || input->draws[i] >= 1.0) {
+            return false;
+        }
+        if (i < input->draft_count) {
+            const auto & q = input->proposals[i];
+            if (!q.size || q.size > GGML_CUDA_VERIFY_BLOCK_PROPOSAL_MAX ||
+                    q.token < 0 || uint32_t(q.token) >= saved->vocabulary) {
+                return false;
+            }
+            double sum = 0.0;
+            bool found = false;
+            for (uint32_t j = 0; j < q.size; ++j) {
+                if (q.ids[j] < 0 || uint32_t(q.ids[j]) >= saved->vocabulary ||
+                        !std::isfinite(q.probabilities[j]) || q.probabilities[j] < 0.0) {
+                    return false;
+                }
+                for (uint32_t k = 0; k < j; ++k) {
+                    if (q.ids[k] == q.ids[j]) {
+                        return false;
+                    }
+                }
+                found |= q.ids[j] == q.token && q.probabilities[j] > 0.0;
+                sum += q.probabilities[j];
+            }
+            if (!found || std::abs(sum - 1.0) > 1e-4) {
+                return false;
+            }
+        }
+        targets.probabilities[i] = static_cast<const float *>(probabilities[i]->data);
+        targets.candidates[i] = static_cast<const int32_t *>(candidates[i]->data);
+        targets.counts[i] = ggml_nelements(probabilities[i]);
+    }
+    auto * ctx = static_cast<ggml_backend_cuda_context *>(saved->backend->context);
+    ggml_cuda_set_device(ctx->device);
+    auto * device_result = reinterpret_cast<ggml_cuda_verify_block_result *>(saved->result);
+    verify_block<<<1, dim3(32, input->draft_count + 1), 0, ctx->stream()>>>(
+        targets, *input, saved->vocabulary, device_result);
+    return cudaGetLastError() == cudaSuccess &&
+        cudaMemcpyAsync(result, device_result, sizeof(*result), cudaMemcpyDeviceToHost, ctx->stream()) == cudaSuccess;
+}
