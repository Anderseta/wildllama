+static std::vector<llama_token> common_sampler_verify_block_device(
+        common_sampler * sampler, llama_context * ctx, const std::vector<int> & indexes,
+        const llama_tokens & draft, const std::vector<std::vector<llama_token_data>> & proposals) {
+    ggml_cuda_verify_block_input input{};
+    input.draft_count = draft.size();
+    const auto * vocab = llama_model_get_vocab(llama_get_model(ctx));
+    for (size_t i = 0; i < draft.size(); ++i) {
+        const auto & source = proposals[i];
+        if (source.empty() || source.size() > GGML_CUDA_VERIFY_BLOCK_PROPOSAL_MAX ||
+                (i + 1 < draft.size() && llama_vocab_is_eog(vocab, draft[i]))) {
+            return {};
+        }
+        auto & row = input.proposals[i];
+        row.size = source.size();
+        row.token = draft[i];
+        double sum = 0.0;
+        for (const auto & token : source) {
+            sum += token.p;
+        }
+        // The caller validated q. Match the CPU path's multiply-by-reciprocal.
+        const double scale = 1.0 / sum;
+        for (size_t j = 0; j < source.size(); ++j) {
+            row.ids[j] = source[j].id;
+            row.probabilities[j] = source[j].p * scale;
+        }
+    }
+    auto trial = sampler->rng;
+    std::uniform_real_distribution<double> uniform(0.0, 1.0);
+    for (size_t i = 0; i <= draft.size(); ++i) {
+        input.draws[i] = uniform(trial);
+    }
+    ggml_cuda_verify_block_result decision{};
+    if (!llama_verify_draft_block_device(ctx, indexes, input, decision)) {
+        return {};
+    }
+    std::vector<llama_token> result(draft.begin(), draft.begin() + decision.kept);
+    result.push_back(decision.correction);
+    for (int i = 0; i < decision.draws_used; ++i) {
+        (void) uniform(sampler->rng);
+    }
+    for (const auto token : result) {
+        common_sampler_accept(sampler, token, true);
+    }
+    ++sampler->verified_blocks;
+    LOG_DBG("MTP device block verification kept %d/%zu proposals\n", decision.kept, draft.size());
+    return result;
+}
