+    parameters.reasoning_budget_tokens = -1;
+    parameters.reasoning_budget_start = {7};
+    parameters.reasoning_budget_end = {{8}};
+    parameters.reasoning_budget_forced = {8};
+    auto config = llama_context_default_params();
+    config.n_ctx = 128;
+    config.n_batch = config.n_ubatch = 64;
+    config.n_seq_max = 1;
+    config.n_threads = config.n_threads_batch = 1;
+    config.n_outputs_max = config.n_outputs_max_per_seq = 4;
+    config.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
+
+    // Compare identical CUDA probability preparation with verification on the
+    // host and device. Keep each sampler alive across rounds to check RNG commit.
+    std::array<common_sampler_ptr, 2> samplers;
+    std::array<llama_context_ptr, 2> contexts;
+    for (size_t i = 0; i < contexts.size(); ++i) {
+        block_verification_env(i == 1);
+        samplers[i].reset(common_sampler_init(model.get(), parameters));
+        contexts[i].reset(llama_init_from_model(model.get(), config));
+        require(bool(contexts[i]) && bool(samplers[i]), "probability block fixture setup failed");
+        auto * distribution = common_sampler_get_thinking_prefilter(samplers[i].get());
+        require(llama_sampler_is_gpu_distribution(distribution) &&
+                llama_set_sampler(contexts[i].get(), 0, distribution), "GPU distribution attachment failed");
+        common_sampler_accept(samplers[i].get(), 7, true);
+    }
+    const llama_tokens draft{3, 4};
+    const std::vector<int> indexes{0, 1, 2};
+    const std::vector<std::vector<llama_token_data>> q{{{3, 0.f, .7f}, {5, 0.f, .3f}},
+                                                     {{4, 0.f, .8f}, {6, 0.f, .2f}}};
+    size_t raw_bytes = 0;
+    const int vocabulary = llama_vocab_n_tokens(llama_model_get_vocab(model.get()));
+    constexpr int verification_rounds = 12;
+    for (int round = 0; round <= verification_rounds; ++round) {
+        const bool forced = round == verification_rounds;
+        if (forced) {
+            for (auto & sampler : samplers) {
+                common_sampler_accept(sampler.get(), 7, true);
+                require(common_sampler_reasoning_budget_force(sampler.get()), "could not force unlimited reasoning budget");
+            }
+        }
+        for (auto & context : contexts) {
+            common_batch batch(context.get());
+            batch.add(7, round * 3, 0, true);
+            batch.add(draft[0], round * 3 + 1, 0, true);
+            batch.add(draft[1], round * 3 + 2, 0, true);
+            require(llama_process(context.get(), LLAMA_PROCESS_TYPE_DECODE, batch.get()) == 0,
+                    "probability block fixture decode failed");
+        }
+        const auto reference = common_sampler_sample_and_accept_n_rejection(
+            samplers[0].get(), contexts[0].get(), indexes, draft, q, false, true);
+        const auto actual = common_sampler_sample_and_accept_n_rejection(
+            samplers[1].get(), contexts[1].get(), indexes, draft, q, false, true);
+        require(actual == reference && !actual.empty(), "CUDA block changed correction or subsequent RNG");
+        const auto stats = llama_get_device_verification_stats(contexts[1].get());
+        require(stats.verified_batches == uint64_t(std::min(round + 1, verification_rounds)) && stats.deferred_bytes > 0 &&
+                stats.scratch_bytes > 0 && stats.scratch_bytes <= stats.allowance_bytes,
+                "probabilistic block never reached the bounded device path");
+        if (forced) {
+            require(actual == llama_tokens{8} && stats.materialized_bytes > raw_bytes,
+                    "manual reasoning stop bypassed the forced CPU path");
+        } else {
+            require(stats.materialized_bytes == raw_bytes, "GPU verification copied deferred rows to the host");
+        }
+        if (round == 0) {
+            const float * expected = llama_get_logits(contexts[0].get());
+            const float * materialized = llama_get_logits(contexts[1].get());
+            raw_bytes = indexes.size() * vocabulary * sizeof(float);
+            require(expected && materialized &&
+                    std::memcmp(expected, materialized, raw_bytes) == 0,
+                    "lazy raw logits getter changed the original logits");
+        }
+    }
+    const auto stats = llama_get_device_verification_stats(contexts[1].get());
+    std::printf("PROBABILISTIC_BLOCK hits=%llu scratch=%zu deferred=%llu materialized=%llu\n",
+        (unsigned long long) stats.verified_batches, stats.scratch_bytes,
+        (unsigned long long) stats.deferred_bytes, (unsigned long long) stats.materialized_bytes);
