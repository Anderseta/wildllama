+    if (!smpl) {
+        return true;
+    }
+    const auto * ctx = static_cast<const common_reasoning_budget_ctx *>(smpl->ctx);
+    // IDLE and DONE may activate a new reasoning block. COUNTING may end
+    // naturally and re-arm within the same proposed span.
+    if (ctx->budget <= 0 || size_t(ctx->budget) <= draft_tokens) {
+        return false;
+    }
+    switch (ctx->state) {
+        case REASONING_BUDGET_IDLE:
+        case REASONING_BUDGET_DONE:
+            return true;
+        case REASONING_BUDGET_COUNTING:
+            return ctx->remaining > 0 && size_t(ctx->remaining) > draft_tokens;
+        case REASONING_BUDGET_FORCING:
+        case REASONING_BUDGET_WAITING_UTF8:
+            return false;
+    }
+    return false;
+}
