+
+void llama_context::release_device_verifier_resources(bool preflight) {
+    release_device_verifier_local(preflight);
+    if (auto parent = device_verify_parent.lock()) {
+        if (parent->context) { parent->context->release_device_verifier_local(preflight); }
+    }
+}
+
+void llama_context::preflight_device_verifier(const llama_memory_context_i * memory_context) {
+    if (!device_verify_allowance && device_verify_parent.expired()) { return; }
+    const auto requirement = memory_context ? memory_context->allocation_requirement() : llama_memory_allocation::unknown;
+    device_verify_preflight_known = requirement != llama_memory_allocation::unknown;
+    if (requirement != llama_memory_allocation::stable) { release_device_verifier_resources(true); }
+}
+
+bool llama_context::link_device_verification_resources(llama_context * draft) {
+    if (draft == this || device_verify_draft_child) { return false; }
+    if (!device_verify_allowance) { return false; }
+    auto known = [](const llama_context * context) {
+        return context && context->memory && (typeid(*context->memory) == typeid(llama_kv_cache) ||
+            typeid(*context->memory) == typeid(llama_memory_hybrid) ||
+            typeid(*context->memory) == typeid(llama_memory_recurrent));
+    };
+    if (!known(this) || (draft && !known(draft))) {
+        release_device_verifier_local(); device_verify_cooperative = false; return false;
+    }
+    if (draft && draft->device_verify_draft_child) {
+        const auto parent = draft->device_verify_parent.lock();
+        if (parent && parent->context == this) { device_verify_cooperative = true; return true; }
+        if (parent && parent->context) { return false; }
+    }
+    if (device_verify_owner) {
+        const auto child = device_verify_owner->child.lock();
+        if (child && child->context && (!draft || child != draft->device_verify_owner)) { return false; }
+    }
+    if (draft && draft->device_verify_owner) {
+        const auto nested = draft->device_verify_owner->child.lock();
+        if (nested && nested->context) { return false; }
+    }
+    try {
+        if (!device_verify_owner) { device_verify_owner = std::make_shared<llama_device_verification_owner>(); }
+        // Allocate both lifetime tokens before changing either context's linkage.
+        if (draft && !draft->device_verify_owner) {
+            draft->device_verify_owner = std::make_shared<llama_device_verification_owner>();
+        }
+        release_device_verifier_local();
+        device_verify_owner->context = this;
+        if (draft) {
+            draft->release_device_verifier_local();
+            draft->device_verify_owner->context = draft;
+            draft->device_verify_parent = device_verify_owner;
+            draft->device_verify_draft_child = true;
+            device_verify_owner->child = draft->device_verify_owner;
+        }
+        device_verify_cooperative = true;
+        return true;
+    } catch (const std::bad_alloc &) { return false; }
+}
