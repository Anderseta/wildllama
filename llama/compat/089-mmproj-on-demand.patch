diff --git a/tools/mtmd/mtmd-on-demand.h b/tools/mtmd/mtmd-on-demand.h
new file mode 100644
--- /dev/null
+++ b/tools/mtmd/mtmd-on-demand.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <memory>
+#include <mutex>
+
+// A failed factory is never cached. Reset detaches ownership without invalidating
+// an in-flight encoder: its shared lease outlives cancellation/idle cleanup.
+template <class T> class mtmd_on_demand {
+    std::mutex mutex;
+    std::shared_ptr<T> value;
+public:
+    template <class Factory> std::shared_ptr<T> acquire(Factory factory) {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (!value) { value = factory(); }
+        return value;
+    }
+    bool reset() {
+        std::shared_ptr<T> old;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            old.swap(value);
+        }
+        return bool(old);
+    }
+};
diff --git a/tests/test-mtmd-on-demand.cpp b/tests/test-mtmd-on-demand.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-mtmd-on-demand.cpp
@@ -0,0 +1,58 @@
+#include "../tools/mtmd/mtmd-on-demand.h"
+
+#include <atomic>
+#include <cstdlib>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+
+#define CHECK(x) do { if (!(x)) { std::abort(); } } while (0)
+
+struct resource {
+    std::atomic<int> & live;
+    explicit resource(std::atomic<int> & count) : live(count) { ++live; }
+    ~resource() { --live; }
+};
+
+int main() {
+    mtmd_on_demand<resource> lifecycle;
+    std::atomic<int> live{0}, loads{0};
+    auto factory = [&] { ++loads; return std::make_shared<resource>(live); };
+    CHECK(live == 0 && !lifecycle.reset()); // text-only never invokes a factory
+
+    std::vector<std::shared_ptr<resource>> leases(16);
+    std::vector<std::thread> workers;
+    for (int i = 0; i < 16; ++i) {
+        workers.emplace_back([&, i] { leases[i] = lifecycle.acquire(factory); });
+    }
+    for (auto & worker : workers) { worker.join(); }
+    CHECK(loads == 1 && live == 1);
+    for (const auto & lease : leases) { CHECK(lease == leases.front()); }
+
+    CHECK(lifecycle.reset()); // cancellation detaches the owner safely
+    CHECK(live == 1);         // an in-flight encoder cannot be destroyed
+    CHECK(!lifecycle.reset());
+    leases.clear();
+    CHECK(live == 0);
+
+    // An image in a later request reloads, and its embeddings can outlive it.
+    std::vector<float> embeddings;
+    {
+        auto lease = lifecycle.acquire(factory);
+        embeddings = {1.0f, 2.0f, 3.0f};
+        CHECK(loads == 2 && live == 1);
+    }
+    CHECK(lifecycle.reset() && live == 0 && embeddings[1] == 2.0f);
+
+    bool failed = false;
+    try {
+        lifecycle.acquire([]() -> std::shared_ptr<resource> { throw std::runtime_error("load failed"); });
+    } catch (const std::runtime_error &) { failed = true; }
+    CHECK(failed && !lifecycle.reset() && live == 0);
+    {
+        auto retry = lifecycle.acquire(factory);
+        CHECK(loads == 3 && live == 1);
+    }
+    CHECK(lifecycle.reset() && live == 0);
+    return 0;
+}
