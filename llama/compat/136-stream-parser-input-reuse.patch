+static void verify_session_buffers() {
+    common_chat_session session;
+    common_chat_input prefix;
+    prefix.append(std::string(2048, 'x'), 17);
+    prefix.append("\xc3", 18);
+    session.feed(prefix);
+    common_chat_session copy = session;
+    common_chat_input next;
+    next.append("\xa7", 19);
+    const auto & finished = session.finish(next);
+    require(finished.content == std::string(2048, 'x') + "\xc3\xa7", "split UTF-8 lost after finish");
+    copy.feed(next);
+    require(copy.finish(common_chat_input("!")).content == finished.content + "!", "copied session shares input");
+}
