index 0000000..041514d
--- /dev/null
+++ b/ggml/src/ggml-gdn-compact.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "ggml-backend.h"
+
+constexpr int ggml_gdn_compact_width = 128;
+constexpr int ggml_gdn_compact_heads = 48;
+constexpr int ggml_gdn_compact_key_heads = 16;
+constexpr int ggml_gdn_compact_state = ggml_gdn_compact_width * ggml_gdn_compact_width * ggml_gdn_compact_heads;
+constexpr int ggml_gdn_compact_record = 1 + ggml_gdn_compact_heads * (2 * ggml_gdn_compact_width + 1);
+constexpr int ggml_gdn_compact_prefill = 64;
+
+inline bool ggml_gdn_is_compact(const ggml_tensor * op) {
+    return op->op_params[1] == 1 && op->src[6] && op->src[7];
+}
+
+struct ggml_backend_gdn_compact_v1 {
+    bool (*supports)(ggml_backend_dev_t);
+    // Inference has been drained. Materialize logical snapshot one in the
+    // rejected newest slot for the canonical checkpoint writer.
+    bool (*materialize)(ggml_backend_dev_t, ggml_tensor * const *, ggml_tensor * const *, size_t);
+};
+
+using ggml_backend_gdn_compact_proc = const ggml_backend_gdn_compact_v1 * (*)();
