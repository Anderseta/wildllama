 #include <charconv>
 #include <cstddef>
@@ -59,6 +60,67 @@
 
 constexpr int HTTP_POLLING_SECONDS = 1;
 
+struct server_cuda_wait_trace {
+    enum phase { prefill, forward, target_readback, draft, draft_catchup, verify, rollback, phase_count };
+    using snapshot_fn = void (*)(uint64_t *, uint64_t *);
+
+    struct totals {
+        uint64_t calls = 0;
+        uint64_t us = 0;
+    };
+    std::array<totals, phase_count> waits{};
+    snapshot_fn snapshot = nullptr;
+
+    void setup() {
+        const char * env = std::getenv("WILDLLAMA_CUDA_SYNC_TRACE");
+        if (!env || std::atoi(env) == 0) {
+            return;
+        }
+        if (auto * cuda = ggml_backend_reg_by_name("CUDA")) {
+            snapshot = reinterpret_cast<snapshot_fn>(
+                ggml_backend_reg_get_proc_address(cuda, "ggml_backend_cuda_host_wait_snapshot"));
+        }
+    }
+
+    struct scope {
+        const snapshot_fn snapshot;
+        totals & destination;
+        totals initial{};
+
+        scope(server_cuda_wait_trace & owner, phase value)
+            : snapshot(owner.snapshot), destination(owner.waits[value]) {
+            if (snapshot) {
+                snapshot(&initial.calls, &initial.us);
+            }
+        }
+
+        ~scope() {
+            if (snapshot) {
+                totals current;
+                snapshot(&current.calls, &current.us);
+                destination.calls += current.calls - initial.calls;
+                destination.us += current.us - initial.us;
+            }
+        }
+        scope(const scope &) = delete;
+        scope & operator=(const scope &) = delete;
+    };
+
+    void flush() {
+        constexpr const char * names[phase_count] = {
+            "prefill", "forward", "target_readback", "draft", "draft_catchup", "verify", "rollback",
+        };
+        for (size_t i = 0; i < waits.size(); ++i) {
+            if (waits[i].calls != 0) {
+                SRV_INF("CUDA host wait by phase: phase=%s calls=%" PRIu64 " wall_us=%" PRIu64 "\n",
+                        names[i], waits[i].calls, waits[i].us);
+            }
+        }
+        waits = {};
+        snapshot = nullptr;
+    }
+};
