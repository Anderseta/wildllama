+    require(cache.spill(*state) && state->is_cold() && state->backing->path != path,
+            "missing backing was reused instead of rewriting valid RAM");
+    require(cache.materialize(state) && state->data.main == expected.main, "replacement backing changed bytes");
+    {
+        std::fstream out(state->backing->path,std::ios::binary|std::ios::in|std::ios::out);
+        out.seekp(100); const char corrupt = 42; out.write(&corrupt,1);
+    }
+    require(cache.spill(*state) && state->is_cold(), "corruption test eviction failed");
+    require(!cache.materialize(state) && state->data.main.empty() && state->data.drft.empty() && state->data.spec.empty(),
+            "corrupt retained backing published partial state");
+    cache.states.clear();
+    require(cache.pager.used() == 0, "warm/cold backing lifetime leaked disk quota");
+    std::puts("PASS: four prefixes through two tickets; 8 exact warm/cold cycles without rewrites; warm scoring; missing/corrupt backing and quotas");
