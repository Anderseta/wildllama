+static void warm_disk_backing(const std::filesystem::path & directory) {
+    require(directory.is_absolute(), "state test directory must be explicit and absolute");
+    server_prompt_cache cache(1, 0);
+    cache.limit_size = 64*1024;
+    constexpr uint64_t disk_limit = 2*1024*1024;
+    require(cache.pager.configure(directory, disk_limit), "state cache pager configure failed");
+    cache.writer.set_enabled(true);
+    for (int i = 0; i < 4; ++i) {
+        auto prompt = make_prompt({llama_token(i+1),2,3,4});
+        common_prompt_checkpoint checkpoint {};
+        checkpoint.n_tokens = 2; checkpoint.pos_min = 0; checkpoint.pos_max = 1;
+        checkpoint.data_tgt.assign(31,uint8_t(i+21));
+        checkpoint.data_dft.assign(19,uint8_t(i+23));
+        checkpoint.data_spec.assign(13,uint8_t(i+29));
+        prompt.checkpoints.push_back(std::move(checkpoint));
+        require(cache.alloc(prompt, make_data(14*1024,uint8_t(i+10))), "prewrite test cache insertion failed");
+    }
+    cache.queue_writebacks();
+    size_t pending = 0;
+    for (auto & state : cache.states) { if (state.writeback) { ++pending; state.writeback->wait(); } }
+    require(pending == 2, "initial prewrites bypassed the two-request bound");
+    cache.collect_writebacks();
+    size_t warm = 0;
+    for (const auto & state : cache.states) {
+        require(!state.writeback, "completed prewrite retained a writer ticket");
+        if (state.backing) { require(!state.is_cold(), "completed prewrite discarded hot RAM"); ++warm; }
+    }
+    require(warm == 2 && cache.size() <= cache.limit_size, "warm backing escaped RAM accounting");
+    cache.queue_writebacks();
+    pending = 0;
+    for (auto & state : cache.states) { if (state.writeback) { ++pending; state.writeback->wait(); } }
+    require(pending == 2, "completed prewrites blocked subsequent prefixes");
+    cache.collect_writebacks();
+    for (const auto & state : cache.states) {
+        require(state.backing && !state.writeback && !state.is_cold(), "prewrite collection lost a complete warm snapshot");
+    }
+    auto state = cache.states.begin();
+    const auto expected = state->data;
+    const auto checkpoint = state->prompt.checkpoints.front();
+    const auto path = state->backing->path;
+    const auto used = cache.pager.used();
+    cache.prompt_us_per_token = 10000;
+    cache.restore_us_per_byte = 0.001;
+    cache.disk_restore_us_per_byte = 1e8;
+    require(cache.find_best(make_prompt({}),server_tokens({1,2,3,4,99},false)) == state,
+            "warm backed snapshot was scored as an SSD read");
+    for (int round = 0; round < 8; ++round) {
+        require(cache.spill(*state) && state->is_cold() && state->data.main.capacity() == 0,
+                "backed eviction did not release RAM capacity");
+        require(cache.pager.used() == used && state->backing->path == path, "backed eviction rewrote snapshot");
+        require(cache.materialize(state) && !state->is_cold() && state->backing->path == path &&
+                state->data.main == expected.main && state->data.drft == expected.drft && state->data.spec == expected.spec &&
+                state->prompt.checkpoints.front().data_tgt == checkpoint.data_tgt &&
+                state->prompt.checkpoints.front().data_dft == checkpoint.data_dft &&
+                state->prompt.checkpoints.front().data_spec == checkpoint.data_spec,
+                "warm/cold round trip changed target/draft/spec/checkpoint bytes");
+        require(cache.size() <= cache.limit_size && cache.pager.used() <= disk_limit, "warm/cold round trip exceeded quota");
+    }
+    std::filesystem::remove(path);
