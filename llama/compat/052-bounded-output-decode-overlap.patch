+++ b/tools/server/server-decode-overlap.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+
+// Inference-thread-owned transaction for one ordinary, already-accepted token.
+// No device tensors or speculative token IDs are owned by this metadata.
+class server_decode_overlap {
+public:
+    struct checkpoint {
+        int32_t slot = -1;
+        int32_t task = -1;
+        int32_t position = -1;
+        size_t prompt_tokens = 0;
+    };
+
+    bool pending() const { return active; }
+    const checkpoint & owner() const { return saved; }
+    uint64_t queued = 0;
+    uint64_t consumed = 0;
+    uint64_t discarded = 0;
+
+    bool begin(checkpoint value) {
+        if (active || value.slot < 0 || value.task < 0 || value.position < 0) { return false; }
+        saved = value;
+        active = true;
+        ++queued;
+        return true;
+    }
+
+    bool matches(int32_t slot, int32_t task) const {
+        return active && saved.slot == slot && saved.task == task;
+    }
+
+    void commit(int32_t slot, int32_t task) {
+        if (!matches(slot, task)) { throw std::logic_error("decode-overlap owner changed"); }
+        active = false;
+        ++consumed;
+    }
+
+    template<class Cleanup>
+    void discard(Cleanup && cleanup) {
+        if (!active) { return; }
+        // Keep ownership if a drain/rollback throws; never silently forget live
+        // work or publish it as consumed after a failed cleanup.
+        cleanup(saved);
+        active = false;
+        ++discarded;
+    }
+
+private:
+    bool active = false;
+    checkpoint saved = {};
+};
