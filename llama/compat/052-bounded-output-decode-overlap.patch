+#include "../tools/server/server-decode-overlap.h"
+
+#include <cstdio>
+#include <stdexcept>
+
+static void require(bool condition, const char * message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+int main() {
+    try {
+        server_decode_overlap state;
+        const server_decode_overlap::checkpoint a{0, 41, 73, 73};
+        require(!state.begin({-1, 41, 73, 73}), "invalid owner admitted");
+        require(state.begin(a) && state.pending(), "ordinary step not owned");
+        require(!state.begin({0, 42, 74, 74}), "more than one step queued");
+        bool rejected = false;
+        try { state.commit(0, 42); } catch (const std::logic_error &) { rejected = true; }
+        require(rejected && state.pending() && state.consumed == 0, "cross-request commit accepted");
+        bool drained = false;
+        try {
+            state.discard([&](const auto & owner) {
+                require(owner.position == 73 && owner.prompt_tokens == 73, "rollback checkpoint changed");
+                drained = true;
+                throw std::runtime_error("injected drain failure");
+            });
+        } catch (const std::runtime_error &) {}
+        require(drained && state.pending() && state.discarded == 0, "failed drain forgot live work");
+        bool rolled_back = false;
+        state.discard([&](const auto & owner) {
+            require(drained && owner.task == 41, "rollback was not bound to drained owner");
+            rolled_back = true;
+        });
+        require(rolled_back && !state.pending() && state.discarded == 1, "cancel rollback not completed");
+        state.discard([](const auto &) { throw std::runtime_error("double rollback"); });
+        require(state.begin(a), "new request remained blocked after cleanup");
+        state.commit(0, 41);
+        require(!state.pending() && state.consumed == 1 && state.queued == 2 && state.discarded == 1,
+                "logical step counted twice or lost");
+        static_assert(sizeof(server_decode_overlap) < 128, "transaction metadata is unbounded");
+        std::puts("DECODE_OVERLAP_TRANSACTION one_step_bound=1 owner_isolation=1 failed_drain_retains=1 cancel_rollback=1 no_duplicate_commit=1 PASS");
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "decode overlap: FAIL: %s\n", error.what());
+        return 1;
+    }
+}
