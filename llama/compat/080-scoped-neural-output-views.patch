+        });
+    }
+    return sampler->iface == &llama_sampler_empty_i || sampler->iface == &llama_sampler_top_k_i ||
+        sampler->iface == &llama_sampler_temp_i || sampler->iface == &llama_sampler_temp_ext_i ||
+        sampler->iface == &llama_sampler_dist_i || sampler->iface == &llama_sampler_greedy_i;
