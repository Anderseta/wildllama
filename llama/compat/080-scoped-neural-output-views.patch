new file mode 100644
--- /dev/null
+++ b/common/speculative-output.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include "sampling.h"
+#include "../src/llama-ext.h"
+
+// One completed neural forward, consumed by builtin host-only draft samplers.
+// Create after the submitted hook and destroy before the next context mutation
+// or submit. It never caches readiness across generations or changes public
+// getter synchronization, and it owns no tensor/staging storage.
+class common_speculative_output {
+    llama_context * context;
+    bool completed = false;
+    bool supported = true;
+
+    void complete() {
+        if (!completed) { llama_synchronize(context); completed = true; }
+    }
+
+public:
+    explicit common_speculative_output(llama_context * context) : context(context) {}
+    common_speculative_output(const common_speculative_output &) = delete;
+    common_speculative_output & operator=(const common_speculative_output &) = delete;
+
+    llama_token sample(common_sampler * sampler, int32_t index) {
+        if (!supported || !common_sampler_draft_host_only(sampler)) {
+            // Custom apply/accept can submit arbitrary work. Never carry its
+            // synchronization assumption into another sampled row or getter.
+            completed = false;
+            supported = false;
+            return common_sampler_sample(sampler, context, index, true);
+        }
+        complete();
+        return common_sampler_sample_draft_synchronized(sampler, context, index);
+    }
+
+    const float * nextn(int32_t index) {
+        if (!supported) { return llama_get_embeddings_nextn_ith(context, index); }
+        complete();
+        return llama_get_embeddings_nextn_ith_synchronized(context, index);
+    }
+
+    const float * nextn() {
+        if (!supported) { return llama_get_embeddings_nextn(context); }
+        complete();
+        return llama_get_embeddings_nextn_synchronized(context);
+    }
+};
