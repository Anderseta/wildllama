+bool llama_sampler_draft_host_only(const llama_sampler * sampler) {
+    if (!sampler || !sampler->iface) { return false; }
+    if (sampler->iface == &llama_sampler_chain_i) {
+        const auto & children = static_cast<const llama_sampler_chain *>(sampler->ctx)->samplers;
