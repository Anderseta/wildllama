new file mode 100644
--- /dev/null
+++ b/tests/test-neural-output.cpp
@@ -0,0 +1,257 @@
+// Nonzero model-free Qwen/MTP fixture; no trained weights or downloads.
+#define main neural_output_unused_mtp_main
+#include "test-mtp-state.cpp"
+#undef main
+#include "speculative-output.h"
+#include "../src/llama-context.h"
+#include "../src/llama-sampler.h"
+#include "../ggml/src/ggml-backend-impl.h"
+#include "ggml-cuda.h"
+#include <array>
+#include <chrono>
+
+// Instrument real scheduler backend synchronization only inside this fixture.
+// Production builds need no counter, dirty flag, callback or extra buffer.
+struct sync_counter {
+    using callback = decltype(((ggml_backend_t) nullptr)->iface.synchronize);
+    struct entry { ggml_backend_t backend; callback original; uint64_t count = 0; };
+    std::vector<entry> entries;
+    static sync_counter * active;
+    static void synchronize(ggml_backend_t backend) {
+        for (auto & entry : active->entries) {
+            if (entry.backend != backend) { continue; }
+            ++entry.count;
+            if (entry.original) { entry.original(backend); }
+            return;
+        }
+        throw std::runtime_error("unknown instrumented backend");
+    }
+    explicit sync_counter(llama_context * context) {
+        require(!active, "nested fixture synchronization observer");
+        auto * scheduler = context->get_sched();
+        const int count = ggml_backend_sched_get_n_backends(scheduler);
+        entries.reserve(count);
+        for (int i = 0; i < count; ++i) {
+            auto * backend = ggml_backend_sched_get_backend(scheduler, i);
+            entries.push_back({backend, backend->iface.synchronize});
+        }
+        active = this;
+        for (auto & entry : entries) { entry.backend->iface.synchronize = synchronize; }
+    }
+    ~sync_counter() {
+        for (auto & entry : entries) { entry.backend->iface.synchronize = entry.original; }
+        active = nullptr;
+    }
+    uint64_t count() const {
+        uint64_t total = 0;
+        for (const auto & entry : entries) { total += entry.count; }
+        return total;
+    }
+};
+sync_counter * sync_counter::active = nullptr;
+
+struct observed_row {
+    llama_token token;
+    std::vector<llama_token_data> candidates;
+    int64_t selected;
+    std::vector<float> hidden;
+};
+
+static std::vector<observed_row> read_rows(llama_context * context, common_sampler * sampler,
+        bool scoped, int rows, int hidden_rows) {
+    common_speculative_output output(context);
+    std::vector<observed_row> result;
+    result.reserve(rows);
+    for (int row = 0; row < rows; ++row) {
+        observed_row saved;
+        saved.token = scoped ? output.sample(sampler, row) : common_sampler_sample(sampler, context, row, true);
+        const auto * candidates = common_sampler_get_candidates(sampler, true);
+        saved.candidates.assign(candidates->data, candidates->data + candidates->size);
+        saved.selected = candidates->selected;
+        common_sampler_accept(sampler, saved.token, true);
+        if (row < hidden_rows) {
+            const auto * hidden = scoped ? output.nextn(row) : llama_get_embeddings_nextn_ith(context, row);
+            require(hidden != nullptr, "fixture hidden row missing");
+            saved.hidden.assign(hidden, hidden + 32);
+        }
+        result.push_back(std::move(saved));
+    }
+    return result;
+}
+
+static void equal(const std::vector<observed_row> & a, const std::vector<observed_row> & b) {
+    require(a.size() == b.size(), "output count changed");
+    for (size_t row = 0; row < a.size(); ++row) {
+        require(a[row].token == b[row].token && a[row].selected == b[row].selected &&
+            a[row].candidates.size() == b[row].candidates.size() && a[row].hidden.size() == b[row].hidden.size(),
+            "sampled token or candidate shape/index changed");
+        for (size_t i = 0; i < a[row].candidates.size(); ++i) {
+            const auto & x = a[row].candidates[i]; const auto & y = b[row].candidates[i];
+            require(x.id == y.id && !std::memcmp(&x.logit, &y.logit, sizeof(float)) &&
+                !std::memcmp(&x.p, &y.p, sizeof(float)), "candidate fields changed");
+        }
+        require(a[row].hidden.empty() || !std::memcmp(a[row].hidden.data(), b[row].hidden.data(), a[row].hidden.size()*sizeof(float)),
+            "NextN hidden values changed");
+    }
+}
+
+static common_sampler_ptr sampler(llama_model * model) {
+    common_params_sampling params;
+    params.samplers = {COMMON_SAMPLER_TYPE_TOP_K, COMMON_SAMPLER_TYPE_TEMPERATURE};
+    params.top_k = 10; params.temp = .8f; params.seed = 12345; params.no_perf = true;
+    common_sampler_ptr result(common_sampler_init(model, params));
+    require(bool(result) && common_sampler_draft_host_only(result.get()), "builtin sampler not eligible");
+    return result;
+}
+
+static void decode_rows(llama_context * context, int salt = 0) {
+    llama_memory_clear(llama_get_memory(context), true);
+    common_batch batch(context);
+    for (int row = 0; row < 16; ++row) { batch.add(3 + (row + salt)%50, row, 0, true); }
+    require(llama_process(context, LLAMA_PROCESS_TYPE_DECODE, batch.get()) == 0, "fixture decode failed");
+    llama_synchronize(context);
+}
+
+static void verify(llama_context * context, llama_model * model) {
+    decode_rows(context);
+    auto reference = sampler(model), candidate = sampler(model);
+    uint64_t old_calls = 0, new_calls = 0;
+    {
+        sync_counter counter(context);
+        const auto old = read_rows(context, reference.get(), false, 3, 2);
+        old_calls = counter.count();
+        const auto current = read_rows(context, candidate.get(), true, 3, 2);
+        new_calls = counter.count() - old_calls;
+        equal(old, current);
+        require(old_calls == 5*counter.entries.size() && new_calls == counter.entries.size(),
+            "neural step did not reduce five fences to one");
+        // Public getters keep their original completion boundary.
+        const auto before = counter.count();
+        require(llama_get_embeddings_nextn_ith(context, 0) != nullptr, "public NextN view missing");
+        require(counter.count() - before == counter.entries.size(), "public getter lost synchronization");
+    }
+    // Same subsequent RNG/history after the identical logical sample/accepts.
+    equal(read_rows(context, reference.get(), false, 16, 0), read_rows(context, candidate.get(), true, 16, 0));
+    decode_rows(context, 9);
+    // A new scope must fence the new generation, not retain the previous view.
+    {
+        sync_counter counter(context);
+        common_speculative_output output(context);
+        output.sample(candidate.get(), 0);
+        require(counter.count() == counter.entries.size(), "new generation reused an old completion assumption");
+    }
+
+    struct custom_state { unsigned calls = 0; } state;
+    llama_sampler_i iface{};
+    iface.name = [](const llama_sampler *) { return "top-k"; };
+    iface.apply = [](llama_sampler * s, llama_token_data_array *) { ++static_cast<custom_state *>(s->ctx)->calls; };
+    auto custom = sampler(model);
+    auto * unknown = llama_sampler_init(&iface, &state);
+    require(!llama_sampler_draft_host_only(unknown), "custom name impersonated a builtin");
+    llama_sampler_chain_add(common_sampler_get(custom.get()), unknown);
+    require(!common_sampler_draft_host_only(custom.get()), "custom chain admitted");
+    {
+        sync_counter counter(context);
+        common_speculative_output output(context);
+        output.sample(candidate.get(), 0);
+        output.sample(custom.get(), 1);
+        output.nextn(1);
+        output.sample(candidate.get(), 2);
+        require(counter.count() == 4*counter.entries.size() && state.calls == 1,
+            "custom sampler did not keep conservative public fences");
+    }
+    std::printf("NEURAL_OUTPUT exact=1 old_backend_fences=%llu scoped_backend_fences=%llu public_getter_fences=preserved custom_fallback=1\n",
+        (unsigned long long) old_calls, (unsigned long long) new_calls);
+}
+
+static void benchmark(llama_context * context, llama_model * model) {
+    decode_rows(context);
+    for (const int rows : {1, 3, 16}) {
+        const int hidden = rows == 1 ? 1 : rows == 3 ? 2 : 0;
+        auto reference = sampler(model), candidate = sampler(model);
+        std::array<std::vector<double>, 2> times;
+        for (int cycle = 0; cycle < 4; ++cycle) for (const bool scoped : {false, true, true, false}) {
+            const auto begin = std::chrono::steady_clock::now();
+            for (int repeat = 0; repeat < 16; ++repeat) {
+                read_rows(context, scoped ? candidate.get() : reference.get(), scoped, rows, hidden);
+            }
+            times[scoped].push_back(std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-begin).count()/16);
+        }
+        for (auto & control : times) { std::sort(control.begin(), control.end()); }
+        // Both controls consumed the same number of uniforms; check the next stream too.
+        equal(read_rows(context, reference.get(), false, 16, 0), read_rows(context, candidate.get(), true, 16, 0));
+        std::printf("NEURAL_OUTPUT_ABBA rows=%d hidden=%d baseline_fences=%d scoped_fences=1 baseline_us=%.6f scoped_us=%.6f exact_rng=1 inference_measured=0\n",
+            rows, hidden, rows+hidden, (times[0][3]+times[0][4])/2, (times[1][3]+times[1][4])/2);
+    }
+}
+
+static void lazy_device_hidden(llama_context * context, llama_model * model) {
+#ifdef _WIN32
+    require(_putenv_s("WILDLLAMA_MTP_DEVICE_STATE_MIB", "1") == 0, "cannot set fixture transport bound");
+#else
+    require(setenv("WILDLLAMA_MTP_DEVICE_STATE_MIB", "1", 1) == 0, "cannot set fixture transport bound");
+#endif
+    require(llama_set_nextn_device(context, true), "cannot enable tiny NextN device transport");
+    decode_rows(context, 17);
+    const auto row = llama_get_nextn_device_row(context, 1);
+    require(bool(row), "device transport did not retain its output row");
+    std::array<float, 32> expected{};
+    require(llama_nextn_device_read(row, expected.data()), "cannot read reference hidden row");
+    auto owner = llama_get_nextn_device_owner(context);
+    const auto before = owner->materialized_bytes;
+    auto selected = sampler(model);
+    {
+        common_speculative_output output(context);
+        output.sample(selected.get(), 1);
+        require(owner->materialized_bytes == before, "sampling eagerly downloaded device hidden state");
+        const auto * actual = output.nextn(1);
+        require(actual && !std::memcmp(actual, expected.data(), sizeof(expected)) && owner->materialized_bytes > before,
+            "synchronized view skipped required device materialization or changed hidden values");
+        const auto after = owner->materialized_bytes;
+        output.nextn(1);
+        require(owner->materialized_bytes == after, "warm hidden getter recopied device state");
+    }
+    require(llama_set_nextn_device(context, false), "cannot disable fixture device transport");
+    std::puts("PASS: lazy NextN transport remains lazy and performs required exact host materialization");
+}
+
+int main(int argc, char ** argv) {
+    try {
+        const bool gpu = argc > 1 && std::strcmp(argv[1], "--cuda") == 0;
+#ifdef GGML_TEST_CPU_BACKEND_PATH
+        if (!gpu) { require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH) != nullptr, "cannot load CPU fixture backend"); }
+        else { ggml_backend_load_all(); }
+#else
+        ggml_backend_load_all();
+#endif
+        llama_backend_init();
+        if (gpu && !ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU)) {
+            std::puts("SKIP: CUDA required"); return 77;
+        }
+        {
+            auto model = tiny_model(gpu, 32, gpu ? 96 : 0);
+            auto params = llama_context_default_params();
+            params.n_ctx = 128; params.n_batch = params.n_ubatch = 64; params.n_rs_seq = 2;
+            params.n_outputs_max = params.n_outputs_max_per_seq = 16;
+            params.n_threads = params.n_threads_batch = 1;
+            params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
+            llama_context_ptr context(llama_init_from_model(model.get(), params));
+            require(bool(context), "cannot initialize neural output context");
+            llama_set_embeddings_nextn(context.get(), true, true);
+            verify(context.get(), model.get());
+            if (argc > 2 && std::strcmp(argv[2], "--bench") == 0) { benchmark(context.get(), model.get()); }
+            if (gpu) {
+                lazy_device_hidden(context.get(), model.get());
+                llama_gpu_memory_stats memory{};
+                require(llama_model_get_gpu_memory_stats(model.get(), &memory) && memory.enabled &&
+                    memory.limit_bytes == 96*1024*1024 && memory.managed_peak_bytes <= memory.limit_bytes,
+                    "small CUDA fixture exceeded managed96 MiB quota");
+                std::printf("NEURAL_OUTPUT_CUDA peak=%llu limit=%llu\n",
+                    (unsigned long long) memory.managed_peak_bytes, (unsigned long long) memory.limit_bytes);
+            }
+        }
+        llama_backend_free();
+        std::puts("PASS: scoped neural output fences, exact tokens/candidates/hidden/RNG and custom/public contracts");
+        return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr, "FAIL: %s\n", error.what()); return 1; }
+}
