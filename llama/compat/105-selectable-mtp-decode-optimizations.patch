+    const auto * vocab = llama_model_get_vocab(llama_get_model(ctx));
+    const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+    if (count != uint32_t(sampler->params.top_k) + 1 || output.candidates_count != count ||
+            !output.raw_logits || !output.candidates) {
+        return false;
+    }
+    for (uint32_t i = 0; i < count; ++i) {
+        const llama_token token = output.candidates[i];
+        if (token < 0 || token >= n_vocab || !std::isfinite(output.sampled_logits[i]) ||
+                output.sampled_logits[i] != output.raw_logits[token]) {
+            return false;
+        }
+    }
+    // The CPU comparator has no tie-break for NaNs or equal logits. Keep that
+    // exact behavior on the original row, including ties at the selection edge.
+    if (std::any_of(output.raw_logits, output.raw_logits + n_vocab, [](float logit) { return std::isnan(logit); })) {
