diff --git a/common/sampling-block-verification.h b/common/sampling-block-verification.h
new file mode 100644
index 0000000..f638061
--- /dev/null
+++ b/common/sampling-block-verification.h
@@ -0,0 +1,15 @@
+#pragma once
+
+#include <algorithm>
+
+// Sun et al., Block Verification, Appendix A (arXiv:2403.10444v3).
+// At each position, a correction replaces any earlier result. Its complement
+// retains the earlier result. The final row has q = 0, so the same rule also
+// covers full acceptance followed by one token drawn from the target.
+inline double common_block_residual(double prefix, double target, double draft) {
+    return std::max(0.0, prefix * target - draft);
+}
+
+inline double common_block_extend(double prefix, double target, double draft) {
+    return std::min(1.0, prefix * target / draft);
+}
