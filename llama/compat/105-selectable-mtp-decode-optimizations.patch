+static void block_verification(llama_model * model, common_params_sampling params) {
+    params.logit_bias = {{0, -INFINITY}, {1, -INFINITY}, {2, -INFINITY}};
+    auto context = fixture_context(model);
+    common_batch batch(context.get());
+    batch.add(3 + 'x', 0, 0, true);
+    batch.add(3 + 'y', 1, 0, true);
+    batch.add(3 + 'z', 2, 0, true);
+    require(llama_process(context.get(), LLAMA_PROCESS_TYPE_DECODE, batch.get()) == 0, "block decode failed");
+    common_sampler_ptr sampler(common_sampler_init(model, params));
+    common_sampler_ptr preview(common_sampler_clone(sampler.get()));
+    llama_tokens draft;
+    std::vector<std::vector<llama_token_data>> q;
+    for (int i = 0; i < 2; ++i) {
+        draft.push_back(common_sampler_sample(preview.get(), context.get(), i));
+        const auto * row = common_sampler_get_candidates(preview.get(), false);
+        q.emplace_back(row->data, row->data + row->size);
+        common_sampler_accept(preview.get(), draft.back(), true);
+    }
+    const std::vector<int> rows{0, 1, 2};
+    auto accepted = common_sampler_sample_and_accept_n_rejection(sampler.get(), context.get(), rows, draft, q, false, true);
+    require(accepted.size() == 3 && std::equal(draft.begin(), draft.end(), accepted.begin()),
+            "identical distributions must accept the complete block");
+    require(common_sampler_get_verified_blocks(sampler.get()) == 1, "complete block verifier did not run");
+    require(common_sampler_last(sampler.get()) == accepted.back(), "bonus token was not committed");
+    common_sampler_ptr mismatch(common_sampler_init(model, params));
+    draft[0] = 0;
+    q[0] = {{0, 0.0f, 1.0f}};
+    accepted = common_sampler_sample_and_accept_n_rejection(mismatch.get(), context.get(), rows, draft, q, false, true);
+    require(accepted.size() == 1 && accepted.front() > 2 && common_sampler_last(mismatch.get()) == accepted.front(),
+            "a zero-probability prefix must commit only the correction");
+    require(common_sampler_get_verified_blocks(mismatch.get()) == 1, "correction verifier did not run");
