+static void test_selective_catchup(llama_model * model) {
+    const auto set_mode = [](const char * mode) {
+#ifdef _WIN32
+        require(_putenv_s("WILDLLAMA_MTP_SELECTIVE_CATCHUP", mode) == 0, "cannot set selective catch-up mode");
+#else
+        require(setenv("WILDLLAMA_MTP_SELECTIVE_CATCHUP", mode, 1) == 0, "cannot set selective catch-up mode");
+#endif
+    };
+    const llama_tokens prompt = {3, 4, 5, 6};
+    const auto draft = [](session & current, llama_token last, llama_pos pos) {
+        llama_tokens proposals;
+        auto & params = common_speculative_get_draft_params(current.spec.get(), 0);
+        params.drafting = true;
+        params.pos0 = pos;
+        params.id_last = last;
+        params.result = &proposals;
+        common_speculative_draft(current.spec.get());
+        params.result = nullptr;
+        require(proposals.size() == 2, "unexpected selective catch-up proposal width");
+        return proposals;
+    };
+
+    for (int32_t keep = 1; keep <= 3; ++keep) {
+        set_mode("0");
+        session eager(model);
+        set_mode("1");
+        session selective(model);
+        eager.prefill(prompt);
+        selective.prefill(prompt);
+        const auto proposals = draft(eager, 7, 4);
+        require(draft(selective, 7, 4) == proposals, "selective mode changed the initial draft");
+
+        for (auto * current : {&eager, &selective}) {
+            auto * draft_memory = llama_get_memory(current->draft.get());
+            require(llama_memory_seq_rm(draft_memory, 0, 4, -1), "cannot discard speculative KV");
+            common_batch verify(current->target.get());
+            verify.add(7, 4, 0, true);
+            verify.add(proposals[0], 5, 0, true);
+            verify.add(proposals[1], 6, 0, true);
+            require(llama_process(current->target.get(), LLAMA_PROCESS_TYPE_DECODE, verify.get()) == 0,
+                    "selective catch-up target verification failed");
+            const bool deferred = current == &selective;
+            require(common_speculative_mtp_can_defer_catchup(current->spec.get(), verify) == deferred,
+                    "selective catch-up ignored its option or rejected an eligible batch");
+            require(deferred ? common_speculative_mtp_process_prefix(current->spec.get(), verify, keep) :
+                               common_speculative_process(current->spec.get(), verify), "MTP prefix processing failed");
+            if (deferred) {
+                require(llama_memory_seq_pos_max(draft_memory, 0) == 3 + keep,
+                        "selective catch-up evaluated rejected tokens");
+            }
+            common_speculative_accept(current->spec.get(), 0, keep - 1);
+            current->rewind(4 + keep);
+        }
+
+        std::vector<uint8_t> eager_carry, selective_carry;
+        require(common_speculative_get_state(eager.spec.get(), 0, eager_carry) &&
+                common_speculative_get_state(selective.spec.get(), 0, selective_carry) &&
+                eager_carry == selective_carry, "accepted MTP carry differs between catch-up modes");
+        require(draft(eager, 8, 4 + keep) == draft(selective, 8, 4 + keep),
+                "selective catch-up changed proposals after rollback");
+    }
+    set_mode("0");
+}
