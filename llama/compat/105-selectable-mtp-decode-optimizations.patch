+static std::vector<llama_token> common_sampler_verify_block(
+        common_sampler * sampler, llama_context * ctx, const std::vector<int> & indexes,
+        const llama_tokens & draft, const std::vector<std::vector<llama_token_data>> & proposals,
+        bool grammar_first) {
+    if (draft.size() < 2 || draft.size() > 4 || !common_sampler_can_verify_block(sampler, grammar_first)) {
+        return {};
+    }
+    for (size_t i = 0; i < draft.size(); ++i) {
+        const auto & q = proposals[i];
+        double sum = 0.0;
+        for (const auto & token : q) {
+            if (!std::isfinite(token.p) || token.p < 0.0f) {
+                return {};
+            }
+            sum += token.p;
+        }
+        if (std::abs(sum - 1.0) > 1e-4 || prob_of(q.data(), q.size(), draft[i]) <= 0.0f) {
+            return {};
+        }
+    }
+
+    common_sampler_ptr prefix_sampler(common_sampler_clone(sampler));
+    auto rng = sampler->rng;
+    std::uniform_real_distribution<double> uniform(0.0, 1.0);
+    const llama_vocab * vocab = llama_model_get_vocab(llama_get_model(ctx));
+    const std::vector<llama_token_data> bonus_q;
+    std::vector<std::pair<llama_token, double>> residual;
+    size_t kept = 0;
+    llama_token correction = LLAMA_TOKEN_NULL;
+    double prefix = 1.0;
+    llama_synchronize_sampler_outputs(ctx);
+    for (size_t i = 0; i <= draft.size(); ++i) {
+        common_sampler_sample_synchronized(prefix_sampler.get(), ctx, indexes[i], grammar_first);
+        const auto * p = common_sampler_get_candidates(prefix_sampler.get(), false);
+        const auto & q = i < draft.size() ? proposals[i] : bonus_q;
+        double p_sum = 0.0;
+        for (size_t k = 0; k < p->size; ++k) {
+            p_sum += p->data[k].p;
+        }
+        if (!std::isfinite(p_sum) || std::abs(p_sum - 1.0) > 1e-4) {
+            return {};
+        }
+        double q_sum = 0.0;
+        for (const auto & token : q) {
+            q_sum += token.p;
+        }
+        const double q_scale = q_sum > 0.0 ? 1.0 / q_sum : 0.0;
+        const common_sampling_probability_index q_index(q.data(), q.size(), p->size, prefix_sampler->residual_order);
+        residual.clear();
+        double total = 1.0 - prefix;
+        double target_token = 0.0;
+        for (size_t k = 0; k < p->size; ++k) {
+            const auto & token = p->data[k];
+            const double probability = token.p / p_sum;
+            if (i < draft.size() && token.id == draft[i]) {
+                target_token = probability;
+            }
+            const double weight = common_block_residual(prefix, probability, q_index.probability(token.id) * q_scale);
+            if (weight > 0.0) {
+                total += weight;
+                residual.emplace_back(token.id, total);
+            }
+        }
+        if (!residual.empty()) {
+            const double draw = uniform(rng) * total;
+            if (draw >= 1.0 - prefix) {
+                const auto selected = std::upper_bound(residual.begin(), residual.end(), draw,
+                        [](double value, const auto & token) { return value < token.second; });
+                correction = (selected == residual.end() ? residual.back() : *selected).first;
+                kept = i;
+            }
+        }
+        if (i == draft.size()) {
+            break;
+        }
+        prefix = common_block_extend(prefix, target_token, q_index.probability(draft[i]) * q_scale);
+        if (prefix == 0.0) {
+            break;
+        }
+        common_sampler_accept(prefix_sampler.get(), draft[i], true);
+        if (llama_vocab_is_eog(vocab, draft[i]) && i + 1 < draft.size()) {
+            // A drafter that supplies positions beyond EOG is not eligible.
+            return {};
+        }
+    }
+    if (correction == LLAMA_TOKEN_NULL) {
+        return {};
+    }
+    sampler->rng = rng;
+    ++sampler->verified_blocks;
+    std::vector<llama_token> result(draft.begin(), draft.begin() + kept);
+    result.push_back(correction);
+    for (llama_token token : result) {
+        common_sampler_accept(sampler, token, true);
+    }
+    LOG_DBG("MTP block verification kept %zu/%zu proposals\n", kept, draft.size());
+    return result;
+}
