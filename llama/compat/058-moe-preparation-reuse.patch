+
+// Frozen token-major construction from the pre-058 provider. It uses the same
+// existing device workspace and operation/precision order, without a template.
+llama_moe_expert_graph::graph legacy_token(llama_moe_expert_graph::work & item,
+        const ggml_tensor * input, ggml_tensor * output, const ggml_tensor * weight,
+        size_t row, size_t rows, size_t k, size_t begin, size_t window,
+        ggml_backend_buffer_t workspace, size_t output_bytes, llama_moe_prepare::precision math = {}) {
+    item.ctx.reset(ggml_init({llama_moe_prepare::metadata_bytes(), nullptr, true}));
+    auto * ctx = item.ctx.get(); require(ctx, "legacy metadata allocation failed");
+    auto * source = llama_moe_expert_graph::alias(ctx, input);
+    auto * target = llama_moe_expert_graph::alias(ctx, output);
+    auto * bank = llama_moe_expert_graph::alias(ctx, weight);
+    auto * view = ggml_view_3d(ctx, source, input->ne[0], input->ne[1], int64_t(window),
+        input->nb[1], input->nb[2], begin*input->nb[2]);
+    llama_moe_expert_graph::view(view);
+    llama_moe_expert_graph::graph result;
+    result.slots = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, int64_t(k), int64_t(window));
+    llama_moe_expert_graph::allocate(workspace, result.slots, output_bytes);
+    result.part = ggml_mul_mat_id(ctx, bank, view, result.slots);
+    math.apply(result.part);
+    llama_moe_expert_graph::allocate(workspace, result.part, 0);
+    auto * destination = ggml_view_3d(ctx, target, rows, int64_t(k), int64_t(window), output->nb[1], output->nb[2],
+        begin*output->nb[2] + row*output->nb[0]);
+    llama_moe_expert_graph::view(destination);
+    result.scatter = ggml_cpy(ctx, result.part, destination);
+    llama_moe_expert_graph::view(result.scatter);
+    result.value = ggml_new_graph_custom(ctx, 32, false);
+    ggml_build_forward_expand(result.value, result.scatter);
+    return result;
+}
