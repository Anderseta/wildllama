+struct execution { std::vector<float> output; size_t builds = 0, reuses = 0, keys = 0, metadata = 0, ids = 0; };
+void same_graph_metadata(ggml_cgraph * reference, ggml_cgraph * actual) {
+    require(ggml_graph_n_nodes(reference) == ggml_graph_n_nodes(actual), "cached graph changed its operation count");
+    for (int i = 0; i < ggml_graph_n_nodes(reference); ++i) {
+        const auto * a = ggml_graph_node(reference,i), * b = ggml_graph_node(actual,i);
+        require(a->op == b->op && a->type == b->type && a->data == b->data && a->buffer == b->buffer &&
+                a->extra == b->extra && a->view_offs == b->view_offs &&
+                std::memcmp(a->ne,b->ne,sizeof(a->ne)) == 0 && std::memcmp(a->nb,b->nb,sizeof(a->nb)) == 0 &&
+                std::memcmp(a->op_params,b->op_params,sizeof(a->op_params)) == 0,
+                "cached graph metadata differs from fresh construction");
+    }
+}
+execution execute(fixture & f, bool prepared, size_t limit, int mode) {
+    f.clear_outputs();
+    const auto base = ggml_backend_buffer_get_base(f.workspace.get());
+    const auto bytes = ggml_backend_buffer_get_size(f.workspace.get());
+    llama_moe_work_batch<llama_moe_expert_graph::work> legacy(limit);
+    llama_moe_prepare::batch cache;
+    cache.set_limit(limit);
+    std::set<const void *> keys;
+    auto drain = [&] { ggml_backend_synchronize(f.backend); };
+    auto flush = [&] { if (prepared) { cache.flush(drain); } else { legacy.flush(drain); } };
+    try {
+        for (size_t i = 0; i < 48; ++i) {
+            const bool expert = mode == 2 ? (i/8)%2 != 0 : mode != 0;
+            const size_t window = i%9 == 8 ? 3 : 4;
+            const size_t entries = expert ? 4 + (i/8)%3 : fixture::k*window;
+            auto * reusable = prepared ? &cache.next(drain) : nullptr;
+            auto & item = reusable ? reusable->item(f.ids_bytes/sizeof(int32_t), expert) : legacy.next(drain);
+            fill(item, expert, entries, i, f.down);
+            const size_t row = (i%2)*fixture::rows, input = i%2, bank = (i/2)%2, output = (i/4)%2;
+            llama_moe_expert_graph::graph graph;
+            if (expert) {
+                graph = reusable ? reusable->expert(f.backend, f.inputs[input], f.outputs[output], f.banks[bank], row,
+                    fixture::rows, fixture::k, fixture::tokens, f.workspace.get()) :
+                    llama_moe_expert_graph::build(item, f.inputs[input], f.outputs[output], f.banks[bank], row,
+                        fixture::rows, fixture::k, fixture::tokens, f.workspace.get());
+            } else {
+                const size_t begin = (i*4)%(fixture::tokens - window + 1);
+                graph = reusable ? reusable->token(f.backend, f.inputs[input], f.outputs[output], f.banks[bank], row,
+                    fixture::rows, fixture::k, fixture::tokens, begin, window, f.workspace.get(), f.output_bytes, f.ids_bytes) :
+                    legacy_token(item, f.inputs[input], f.outputs[output], f.banks[bank], row, fixture::rows, fixture::k,
+                        begin, window, f.workspace.get(), f.output_bytes);
+            }
+            if (reusable) {
+                llama_moe_expert_graph::work probe;
+                probe.input_rows = item.input_rows; probe.slot_ids = item.slot_ids; probe.output_rows = item.output_rows;
+                llama_moe_expert_graph::graph reference;
+                if (expert) {
+                    reference = llama_moe_expert_graph::build(probe,f.inputs[input],f.outputs[output],f.banks[bank],row,
+                        fixture::rows,fixture::k,fixture::tokens,f.workspace.get());
+                } else {
+                    reference = legacy_token(probe,f.inputs[input],f.outputs[output],f.banks[bank],row,fixture::rows,fixture::k,
+                        (i*4)%(fixture::tokens-window+1),window,f.workspace.get(),f.output_bytes);
+                }
+                same_graph_metadata(reference.value,graph.value);
+            }
+            require(ggml_backend_supports_op(f.backend, graph.part) && ggml_backend_supports_op(f.backend, graph.scatter),
+                    "requested fixture operation unavailable");
+            require(graph.value->uid == 0, "child graph bypasses CUDA property invalidation");
+            keys.insert(graph.value->nodes[0]);
+            if (reusable) { reusable->mark_pending(); }
+            if (expert) {
+                ggml_backend_tensor_set_async(f.backend, graph.input_ids, item.input_rows.data(), 0, entries*sizeof(int32_t));
+                ggml_backend_tensor_set_async(f.backend, graph.output_ids, item.output_rows.data(), 0, entries*sizeof(int32_t));
+            }
+            ggml_backend_tensor_set_async(f.backend, graph.slots, item.slot_ids.data(), 0, entries*sizeof(int32_t));
+            require(ggml_backend_graph_compute_async(f.backend, graph.value) == GGML_STATUS_SUCCESS, "fixture compute failed");
+            require(ggml_backend_buffer_get_base(f.workspace.get()) == base &&
+                    ggml_backend_buffer_get_size(f.workspace.get()) == bytes, "existing GPU workspace changed");
+        }
+        flush();
+    } catch (...) { flush(); throw; }
+    const auto stats = cache.stats();
+    if (prepared) {
+        require(stats.reuses > 0 && stats.key_changes == 0 && keys.size() <= limit, "template or bounded stable graph key was not exercised");
+        require(cache.arena_bytes() <= 4*llama_moe_prepare::metadata_bytes() &&
+                cache.ids_bytes() <= 12*f.ids_bytes, "retained CPU storage exceeded its fixed bounds");
+    }
+    return {f.read_outputs(), stats.builds, stats.reuses, keys.size(), cache.arena_bytes(), cache.ids_bytes()};
+}
+
+void exact(ggml_backend_t backend, const char * name) {
+    size_t cases = 0, total_reuses = 0, metadata_peak = 0, ids_peak = 0, ids_limit = 0, workspace = 0;
+    for (auto type : {GGML_TYPE_F32, GGML_TYPE_Q8_0}) for (bool down : {false,true}) {
+        fixture data(backend, down, type);
+        for (size_t limit : {size_t(1),size_t(4)}) for (int mode : {0,1,2}) {
+            const auto before = execute(data, false, limit, mode), after = execute(data, true, limit, mode);
+            require(before.output.size() == after.output.size() &&
+                    std::memcmp(before.output.data(), after.output.data(), before.output.size()*sizeof(float)) == 0,
+                    "prepared execution changed output bits");
+            total_reuses += after.reuses; ++cases;
+            metadata_peak = std::max(metadata_peak, after.metadata); ids_peak = std::max(ids_peak, after.ids);
+            ids_limit = std::max(ids_limit, 12*data.ids_bytes); workspace = std::max(workspace, data.workspace_bytes);
+        }
+    }
+    std::printf("MOE_PREPARE_EXACT backend=%s cases=%zu F32_Q8=1 token_expert_mixed=1 up_down=1 rebind_data_offsets=1 partial_windows=1 guards=1 graph_metadata_exact=1 bits_exact=1 actual_reuses=%zu PASS\n", name, cases, total_reuses);
+    std::printf("MOE_PREPARE_MEMORY metadata_peak=%zu metadata_limit=%zu ids_peak=%zu ids_limit=%zu existing_workspace=%zu additional_gpu_workspace=0 PASS\n",
+        metadata_peak,4*llama_moe_prepare::metadata_bytes(),ids_peak,ids_limit,workspace);
+}
+
+void invalidation(ggml_backend_t backend) {
+    fixture f(backend, false, GGML_TYPE_F32), other(backend, false, GGML_TYPE_F32);
+    ggml_backend_ptr second(ggml_backend_dev_init(ggml_backend_get_device(backend), nullptr));
+    require(bool(second), "second metadata-only backend unavailable");
+    llama_moe_prepare::work cache;
+    auto & ids = cache.item(f.ids_bytes/sizeof(int32_t)).slot_ids;
+    ids.assign(fixture::k*4, 0);
+    auto prepare = [&](ggml_backend_t selected, ggml_tensor * input, ggml_tensor * output,
+                       ggml_tensor * weight, ggml_backend_buffer_t workspace, llama_moe_prepare::precision math = {}) {
+        return cache.token(selected,input,output,weight,0,fixture::rows,fixture::k,fixture::tokens,0,
+            ids.size()/fixture::k,workspace,f.output_bytes,f.ids_bytes,math);
+    };
+    prepare(backend,f.inputs[0],f.outputs[0],f.banks[0],f.workspace.get());
+    const auto first = cache.graph_key();
+    prepare(backend,f.inputs[1],f.outputs[1],f.banks[1],f.workspace.get());
+    require(cache.stats().builds == 1 && cache.stats().reuses == 1, "data-pointer rebinding rebuilt metadata");
+    ids.assign(fixture::k*3,0);
+    prepare(backend,f.inputs[0],f.outputs[0],f.banks[0],f.workspace.get());
+    const size_t saved_stride = f.inputs[0]->nb[1]; f.inputs[0]->nb[1] += sizeof(float);
+    prepare(backend,f.inputs[0],f.outputs[0],f.banks[0],f.workspace.get()); f.inputs[0]->nb[1] = saved_stride;
+    prepare(backend,other.inputs[0],f.outputs[0],f.banks[0],f.workspace.get());
+    int extra = 0; void * saved_extra = f.inputs[0]->extra; f.inputs[0]->extra = &extra;
+    prepare(backend,f.inputs[0],f.outputs[0],f.banks[0],f.workspace.get()); f.inputs[0]->extra = saved_extra;
+    prepare(second.get(),f.inputs[0],f.outputs[0],f.banks[0],f.workspace.get());
+    prepare(backend,f.inputs[0],f.outputs[0],f.banks[0],other.workspace.get());
+    llama_moe_prepare::precision math; math.source_set = true; math.source = GGML_PREC_F32;
+    const auto graph = prepare(backend,f.inputs[0],f.outputs[0],f.banks[0],f.workspace.get(),math);
+    require(cache.stats().builds == 8 && graph.value->uid == 0, "structural backend/precision/workspace invalidation was skipped");
+    require(cache.graph_key() == first && cache.stats().key_changes == 0, "rebuild created another CUDA graph key");
+    math.accumulator_bf16 = true;
+    const auto precision_graph = prepare(backend,f.inputs[0],f.outputs[0],f.banks[0],f.workspace.get(),math);
+    llama_moe_expert_graph::work reference; reference.slot_ids = ids;
+    const auto precision_reference = legacy_token(reference,f.inputs[0],f.outputs[0],f.banks[0],0,
+        fixture::rows,fixture::k,0,3,f.workspace.get(),f.output_bytes,math);
+    require(cache.stats().builds == 9 && std::memcmp(precision_graph.part->op_params,
+        precision_reference.part->op_params,sizeof(precision_graph.part->op_params)) == 0,
+        "source/accumulator precision parameters changed");
+    ids[0] = -1; rejects([&] { prepare(backend,f.inputs[0],f.outputs[0],f.banks[0],f.workspace.get()); });
+    ids[0] = int32_t(fixture::slots); rejects([&] { prepare(backend,f.inputs[0],f.outputs[0],f.banks[0],f.workspace.get()); });
+    ids[0] = 0;
+    rejects([&] { cache.token(backend,f.inputs[0],f.outputs[0],f.banks[0],0,fixture::rows,fixture::k,
+        fixture::tokens,fixture::tokens,3,f.workspace.get(),f.output_bytes,f.ids_bytes); });
+    rejects([&] { cache.token(backend,f.inputs[0],f.outputs[0],f.banks[0],fixture::no,fixture::rows,fixture::k,
+        fixture::tokens,0,3,f.workspace.get(),f.output_bytes,f.ids_bytes); });
+    std::printf("MOE_PREPARE_INVALIDATION shape=1 strides=1 buffer=1 extra=1 backend=1 precision=1 workspace=1 ids=1 uid_zero=1 stable_first_node=1 PASS\n");
+}
+
+void ownership(ggml_backend_t backend) {
+    fixture f(backend,false,GGML_TYPE_F32);
+    llama_moe_prepare::batch pool;
+    pool.set_limit(1);
+    auto drain = [&] { ggml_backend_synchronize(backend); };
+    auto & work = pool.next(drain);
+    auto & item = work.item(f.ids_bytes/sizeof(int32_t)); item.slot_ids.assign(fixture::k*4,0);
+    auto graph = work.token(backend,f.inputs[0],f.outputs[0],f.banks[0],0,fixture::rows,fixture::k,
+        fixture::tokens,0,4,f.workspace.get(),f.output_bytes,f.ids_bytes);
+    const auto * retained = item.slot_ids.data(); const auto key = work.graph_key();
+    work.mark_pending();
+    ggml_backend_tensor_set_async(backend,graph.slots,retained,0,item.slot_ids.size()*sizeof(int32_t));
+    rejects([&] { pool.flush([] { throw std::runtime_error("injected drain failure"); }); });
+    require(pool.size() == 1 && work.is_pending() && retained[0] == 0 && work.graph_key() == key,
+            "failed fence freed or changed queued metadata/source bytes");
+    rejects([&] { work.item(f.ids_bytes/sizeof(int32_t)); });
+    rejects([&] { work.invalidate(); }); rejects([&] { pool.invalidate(); }); rejects([&] { pool.set_limit(4); });
+    pool.flush(drain);
+    auto & again = pool.next(drain); require(&again == &work, "drained work slot was replaced");
+    auto & reused = again.item(f.ids_bytes/sizeof(int32_t)); reused.slot_ids.assign(fixture::k*4,1);
+    auto next = again.token(backend,f.inputs[1],f.outputs[1],f.banks[1],fixture::rows,fixture::rows,
+        fixture::k,fixture::tokens,4,4,f.workspace.get(),f.output_bytes,f.ids_bytes);
+    require(again.graph_key() == key && again.stats().reuses == 1, "successful fence did not permit template reuse");
+    again.mark_pending();
+    ggml_backend_tensor_set_async(backend,next.slots,reused.slot_ids.data(),0,reused.slot_ids.size()*sizeof(int32_t));
+    require(ggml_backend_graph_compute_async(backend,next.value) == GGML_STATUS_SUCCESS, "recovered graph compute failed");
+    pool.flush(drain); pool.invalidate();
+    require(pool.size() == 0 && !again.is_pending() && !again.graph_key(), "unload cleanup retained pending graph");
+    require(pool.arena_bytes() <= 4*llama_moe_prepare::metadata_bytes() && pool.ids_bytes() <= 12*f.ids_bytes,
+            "bounded retained CPU storage grew after error cleanup");
+    std::printf("MOE_PREPARE_OWNERSHIP slots=4 failed_drain_retained=1 mutation_blocked=1 reuse_after_fence=1 unload_retry=1 graph_keys_bounded=1 additional_gpu_buffers=0 PASS\n");
+}
+
+double median(std::vector<double> values) {
+    std::sort(values.begin(), values.end()); return (values[values.size()/2-1]+values[values.size()/2])/2;
+}
+void samples(const char * name, const std::vector<double> & values) {
+    std::printf(",\"%s\":[",name);
+    for (size_t i = 0; i < values.size(); ++i) { std::printf("%s%.6f",i ? "," : "",values[i]); }
+    std::printf("]");
+}
+void benchmark(ggml_backend_t backend) {
+    fixture f(backend,false,GGML_TYPE_F32);
+    for (bool expert : {false,true}) for (size_t count : {size_t(6),size_t(12)}) {
+        // The expert fixture's original workspace must hold its gathered rows.
+        if (expert && llama_moe_expert_graph::carve(fixture::ni,fixture::rows,count,
+                ggml_backend_buft_get_alignment(ggml_backend_buffer_get_type(f.workspace.get()))).bytes > f.workspace_bytes) { continue; }
+        llama_moe_expert_graph::work old;
+        fill(old,expert,count,0,false);
+        llama_moe_prepare::work reused;
+        auto & current = reused.item(f.ids_bytes/sizeof(int32_t),expert); fill(current,expert,count,0,false);
+        auto build = [&](bool optimized) {
+            if (expert) {
+                if (optimized) { reused.expert(backend,f.inputs[0],f.outputs[0],f.banks[0],0,fixture::rows,
+                    fixture::k,fixture::tokens,f.workspace.get()); }
+                else { llama_moe_expert_graph::build(old,f.inputs[0],f.outputs[0],f.banks[0],0,fixture::rows,
+                    fixture::k,fixture::tokens,f.workspace.get()); }
+            } else {
+                if (optimized) { reused.token(backend,f.inputs[0],f.outputs[0],f.banks[0],0,fixture::rows,fixture::k,
+                    fixture::tokens,0,count/fixture::k,f.workspace.get(),f.output_bytes,f.ids_bytes); }
+                else { legacy_token(old,f.inputs[0],f.outputs[0],f.banks[0],0,fixture::rows,fixture::k,0,
+                    count/fixture::k,f.workspace.get(),f.output_bytes); }
+            }
+        };
+        for (int warm = 0; warm < 100; ++warm) { build(false); build(true); }
+        std::vector<double> before, after;
+        constexpr int loops = 4096;
+        for (int cycle = 0; cycle < 8; ++cycle) for (bool optimized : {false,true,true,false}) {
+            const auto begin = std::chrono::steady_clock::now();
+            for (int i = 0; i < loops; ++i) { build(optimized); }
+            const auto end = std::chrono::steady_clock::now();
+            (optimized ? after : before).push_back(std::chrono::duration<double,std::micro>(end-begin).count()/loops);
+        }
+        std::printf("MOE_PREPARE_BENCH mode=%s entries=%zu cycles=8 loops=%d legacy_us=%.6f reused_us=%.6f ratio=%.6f builds=%zu reuses=%zu gpu_allocations=0 scope=CPU_metadata_only\n",
+            expert ? "expert" : "token",count,loops,median(before),median(after),median(after)/median(before),
+            reused.stats().builds,reused.stats().reuses);
+        std::printf("MOE_PREPARE_BENCH_JSON {\"mode\":\"%s\",\"entries\":%zu,\"cycles\":8,\"loops\":%d,\"legacy_us\":%.6f,\"reused_us\":%.6f,\"ratio\":%.6f,\"builds\":%zu,\"reuses\":%zu,\"gpu_allocations\":0",
+            expert ? "expert" : "token",count,loops,median(before),median(after),median(after)/median(before),
+            reused.stats().builds,reused.stats().reuses);
+        samples("legacy_samples_us",before); samples("reused_samples_us",after); std::printf("}\n");
+    }
+}
+}
+
+int main(int argc, char ** argv) {
+    try {
+        bool cuda = false, bench = false;
+        for (int i = 1; i < argc; ++i) {
+            const std::string argument(argv[i]);
+            require(argument == "--cuda" || argument == "--bench", "use --cuda and/or --bench");
+            cuda |= argument == "--cuda"; bench |= argument == "--bench";
+        }
+        require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH), "explicit CPU backend unavailable");
+        if (cuda) {
+#ifdef GGML_TEST_CUDA_BACKEND_PATH
+            require(ggml_backend_load(GGML_TEST_CUDA_BACKEND_PATH), "explicit CUDA backend unavailable");
+#else
+            std::puts("SKIP: CUDA not built"); return 77;
+#endif
+        }
+        auto * device = ggml_backend_dev_by_type(cuda ? GGML_BACKEND_DEVICE_TYPE_GPU : GGML_BACKEND_DEVICE_TYPE_CPU);
+        require(device && (!cuda || std::string(ggml_backend_reg_name(ggml_backend_dev_backend_reg(device))) == "CUDA"),
+                "requested isolated backend unavailable");
+        ggml_backend_ptr backend(ggml_backend_dev_init(device,nullptr)); require(bool(backend), "backend initialization failed");
+        exact(backend.get(),cuda ? "CUDA" : "CPU"); invalidation(backend.get()); ownership(backend.get());
+        if (bench) { benchmark(backend.get()); }
+        std::printf("MOE_PREPARE backend=%s zero_model_files=1 synthetic_weights=1 no_new_gpu_workspace=1 PASS\n",cuda ? "CUDA" : "CPU");
+        return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr,"FAIL: %s\n",error.what()); return 1; }
+}
