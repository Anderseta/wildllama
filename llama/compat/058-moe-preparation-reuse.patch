+struct fixture {
+    static constexpr size_t ni = 256, no = 64, rows = 32, slots = 4, k = 3, tokens = 64;
+    static constexpr float guard = -12345.0f;
+    ggml_backend_t backend;
+    ggml_context_ptr ctx{ggml_init({64*ggml_tensor_overhead(), nullptr, true})};
+    ggml_backend_buffer_ptr permanent, workspace;
+    ggml_tensor * inputs[2], * banks[2], * storage[2], * outputs[2];
+    size_t output_bytes = 0, ids_bytes = 0, workspace_bytes = 0;
+    bool down;
+    ggml_type type;
+
+    fixture(ggml_backend_t backend, bool down, ggml_type type) : backend(backend), down(down), type(type) {
+        require(bool(ctx), "fixture metadata allocation failed");
+        for (size_t index = 0; index < 2; ++index) {
+            inputs[index] = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_F32, ni, down ? k : 1, tokens);
+            banks[index] = ggml_new_tensor_3d(ctx.get(), type, ni, rows, slots);
+            storage[index] = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, no + 2, k*tokens);
+        }
+        permanent.reset(ggml_backend_alloc_ctx_tensors(ctx.get(), backend));
+        require(bool(permanent), "fixture buffer allocation failed");
+        ggml_backend_buffer_set_usage(permanent.get(), GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+        for (size_t index = 0; index < 2; ++index) {
+            outputs[index] = ggml_view_3d(ctx.get(), storage[index], no, k, tokens,
+                (no+2)*sizeof(float), k*(no+2)*sizeof(float), sizeof(float));
+            llama_moe_expert_graph::view(outputs[index]);
+            std::vector<float> values(ggml_nelements(inputs[index]));
+            for (size_t i = 0; i < values.size(); ++i) { values[i] = float(int((i*7 + index*5)%23) - 11)/32.0f; }
+            ggml_backend_tensor_set(inputs[index], values.data(), 0, values.size()*sizeof(float));
+            values.resize(ni*rows*slots);
+            for (size_t i = 0; i < values.size(); ++i) { values[i] = float(int((i*3 + index*7)%17) - 8)/64.0f; }
+            std::vector<uint8_t> encoded(ggml_nbytes(banks[index]));
+            if (type == GGML_TYPE_F32) { std::memcpy(encoded.data(), values.data(), encoded.size()); }
+            else { require(ggml_quantize_chunk(type, values.data(), encoded.data(), 0, rows*slots, ni, nullptr) == encoded.size(),
+                           "fixture quantization size mismatch"); }
+            ggml_backend_tensor_set(banks[index], encoded.data(), 0, encoded.size());
+        }
+        const size_t alignment = ggml_backend_buft_get_alignment(ggml_backend_buffer_get_type(permanent.get()));
+        output_bytes = llama_moe_expert_graph::align(rows*k*tokens*sizeof(float), alignment);
+        ids_bytes = llama_moe_expert_graph::align(k*tokens*sizeof(int32_t), alignment);
+        workspace_bytes = output_bytes + ids_bytes;
+        workspace.reset(ggml_backend_buft_alloc_buffer(ggml_backend_buffer_get_type(permanent.get()), workspace_bytes));
+        require(bool(workspace), "existing fixture workspace allocation failed");
+        ggml_backend_buffer_set_usage(workspace.get(), GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+    }
+
+    void clear_outputs() {
+        std::vector<float> values((no+2)*k*tokens, guard);
+        for (auto * tensor : storage) { ggml_backend_tensor_set(tensor, values.data(), 0, values.size()*sizeof(float)); }
+    }
+    std::vector<float> read_outputs() {
+        std::vector<float> result;
+        for (auto * tensor : storage) {
+            std::vector<float> values(ggml_nelements(tensor));
+            ggml_backend_tensor_get(tensor, values.data(), 0, values.size()*sizeof(float));
+            for (size_t i = 0; i < k*tokens; ++i) {
+                require(values[i*(no+2)] == guard && values[i*(no+2)+no+1] == guard, "output row guard changed");
+            }
+            result.insert(result.end(), values.begin(), values.end());
+        }
+        return result;
+    }
+};
+
+void fill(llama_moe_expert_graph::work & item, bool expert, size_t count, size_t iteration, bool down) {
+    item.slot_ids.resize(count);
+    for (size_t i = 0; i < count; ++i) { item.slot_ids[i] = int32_t((i + iteration*3)%fixture::slots); }
+    if (expert) {
+        item.input_rows.resize(count); item.output_rows.resize(count);
+        for (size_t i = 0; i < count; ++i) {
+            item.input_rows[i] = int32_t((iteration*11 + i*7)%(fixture::tokens*(down ? fixture::k : 1)));
+            item.output_rows[i] = int32_t((iteration*7 + i*13)%(fixture::tokens*fixture::k));
+        }
+    }
+}
