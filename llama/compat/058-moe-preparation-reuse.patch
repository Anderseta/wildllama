diff --git a/src/llama-moe-prepare.h b/src/llama-moe-prepare.h
new file mode 100644
--- /dev/null
+++ b/src/llama-moe-prepare.h
@@ -0,0 +1,409 @@
+#pragma once
+
+#include "llama-moe-expert-graph.h"
+#include "../ggml/src/ggml-impl.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <vector>
+
+// CPU metadata only. All result/index tensors use the caller's pre-existing
+// dynamic-prefill workspace; this helper has no device allocator or gallocr.
+namespace llama_moe_prepare {
+
+inline size_t metadata_bytes() {
+    return 32*ggml_tensor_overhead() + ggml_graph_overhead_custom(32, false);
+}
+
+inline ggml_backend_buffer_t buffer_of(const ggml_tensor * tensor) {
+    auto * buffer = tensor->buffer;
+    for (const auto * root = tensor; !buffer && root->view_src;) {
+        root = root->view_src;
+        buffer = root->buffer;
+    }
+    if (!buffer || !tensor->data) { throw std::runtime_error("MoE preparation source is not allocated"); }
+    return buffer;
+}
+
+struct tensor_key {
+    ggml_type type = GGML_TYPE_F32;
+    std::array<int64_t, GGML_MAX_DIMS> ne{};
+    std::array<size_t, GGML_MAX_DIMS> nb{};
+    ggml_backend_buffer_t buffer = nullptr;
+    ggml_backend_buffer_type_t buft = nullptr;
+    void * base = nullptr;
+    void * extra = nullptr;
+    size_t bytes = 0;
+    int usage = 0;
+
+    static tensor_key capture(const ggml_tensor * tensor) {
+        if (!tensor) { throw std::invalid_argument("MoE preparation tensor is missing"); }
+        tensor_key result;
+        result.type = tensor->type;
+        std::copy(tensor->ne, tensor->ne + GGML_MAX_DIMS, result.ne.begin());
+        std::copy(tensor->nb, tensor->nb + GGML_MAX_DIMS, result.nb.begin());
+        result.buffer = buffer_of(tensor);
+        result.buft = ggml_backend_buffer_get_type(result.buffer);
+        result.base = ggml_backend_buffer_get_base(result.buffer);
+        result.bytes = ggml_backend_buffer_get_size(result.buffer);
+        result.usage = int(ggml_backend_buffer_get_usage(result.buffer));
+        result.extra = tensor->extra;
+        return result;
+    }
+
+    bool operator==(const tensor_key & other) const {
+        return type == other.type && ne == other.ne && nb == other.nb &&
+            buffer == other.buffer && buft == other.buft && base == other.base &&
+            extra == other.extra && bytes == other.bytes && usage == other.usage;
+    }
+};
+
+struct precision {
+    bool source_set = false;
+    ggml_prec source = GGML_PREC_DEFAULT;
+    bool accumulator_bf16 = false;
+
+    bool operator==(const precision & other) const {
+        return source_set == other.source_set && source == other.source &&
+            accumulator_bf16 == other.accumulator_bf16;
+    }
+    void apply(ggml_tensor * part) const {
+        if (source_set) { ggml_prec_set_src(part, source, 1); }
+        if (accumulator_bf16) { ggml_prec_set_acc(part, GGML_PREC_BF16); }
+    }
+};
+
+enum class kind { token_major, expert_major };
+
+struct key {
+    kind mode = kind::token_major;
+    tensor_key input, output, weight;
+    ggml_backend_t backend = nullptr;
+    ggml_backend_buffer_t workspace = nullptr;
+    ggml_backend_buffer_type_t workspace_buft = nullptr;
+    void * workspace_base = nullptr;
+    size_t workspace_bytes = 0;
+    size_t workspace_alignment = 0;
+    int workspace_usage = 0;
+    size_t output_bytes = 0;
+    size_t ids_bytes = 0;
+    size_t rows = 0, k = 0, tokens = 0, window_tokens = 0, entries = 0;
+    precision math;
+
+    bool operator==(const key & other) const {
+        return mode == other.mode && input == other.input && output == other.output &&
+            weight == other.weight && backend == other.backend && workspace == other.workspace &&
+            workspace_buft == other.workspace_buft && workspace_alignment == other.workspace_alignment &&
+            workspace_usage == other.workspace_usage &&
+            workspace_base == other.workspace_base && workspace_bytes == other.workspace_bytes &&
+            output_bytes == other.output_bytes && ids_bytes == other.ids_bytes && rows == other.rows &&
+            k == other.k && tokens == other.tokens && window_tokens == other.window_tokens &&
+            entries == other.entries && math == other.math;
+    }
+};
+
+struct statistics {
+    size_t builds = 0, reuses = 0, invalidations = 0, key_changes = 0;
+};
+
+class work {
+    struct alignas(GGML_MEM_ALIGN) metadata_word { unsigned char bytes[GGML_MEM_ALIGN]; };
+    struct storage {
+        // Destruction order matters: item.ctx is freed before its backing arena.
+        std::vector<metadata_word> arena;
+        llama_moe_expert_graph::work item;
+        llama_moe_expert_graph::graph graph;
+        key signature;
+        ggml_tensor * source = nullptr, * target = nullptr, * bank = nullptr;
+        ggml_tensor * source_view = nullptr, * destination = nullptr;
+        bool valid = false;
+        size_t ids_capacity = 0;
+    };
+    std::unique_ptr<storage> state;
+    bool pending = false;
+    const void * first_node = nullptr;
+    statistics counters;
+
+    storage & available() {
+        if (pending) { throw std::logic_error("MoE preparation work is still pending"); }
+        if (!state) { state = std::make_unique<storage>(); }
+        return *state;
+    }
+
+    static void alias_data(ggml_tensor * alias, const ggml_tensor * current) {
+        alias->buffer = buffer_of(current);
+        alias->data = current->data;
+        alias->extra = current->extra;
+    }
+
+    static void rebind_view(ggml_tensor * view, size_t offset) {
+        // GGML flattens nested views to the alias root. Refresh both the
+        // absolute offset and data, including CPY/SET_ROWS result views.
+        view->view_offs = offset;
+        if (view->op == GGML_OP_VIEW) { std::memcpy(view->op_params, &offset, sizeof(offset)); }
+        view->buffer = nullptr;
+        view->data = nullptr;
+        view->extra = nullptr;
+        llama_moe_expert_graph::view(view);
+    }
+
+    key signature(kind mode, ggml_backend_t backend, const ggml_tensor * input,
+                  const ggml_tensor * output, const ggml_tensor * weight,
+                  size_t rows, size_t k, size_t tokens, size_t window_tokens,
+                  size_t entries, ggml_backend_buffer_t workspace,
+                  size_t output_bytes, size_t ids_bytes, precision math) {
+        if (!backend || !workspace) { throw std::invalid_argument("MoE preparation backend/workspace is missing"); }
+        key result;
+        result.mode = mode;
+        result.input = tensor_key::capture(input);
+        result.output = tensor_key::capture(output);
+        result.weight = tensor_key::capture(weight);
+        result.backend = backend;
+        result.workspace = workspace;
+        result.workspace_buft = ggml_backend_buffer_get_type(workspace);
+        result.workspace_base = ggml_backend_buffer_get_base(workspace);
+        result.workspace_bytes = ggml_backend_buffer_get_size(workspace);
+        result.workspace_alignment = ggml_backend_buft_get_alignment(result.workspace_buft);
+        result.workspace_usage = int(ggml_backend_buffer_get_usage(workspace));
+        result.output_bytes = output_bytes;
+        result.ids_bytes = ids_bytes;
+        result.rows = rows; result.k = k; result.tokens = tokens;
+        result.window_tokens = window_tokens; result.entries = entries;
+        result.math = math;
+        return result;
+    }
+
+    static void validate_slots(const std::vector<int32_t> & ids, const ggml_tensor * weight) {
+        for (const int32_t id : ids) {
+            if (id < 0 || id >= weight->ne[2]) {
+                throw std::invalid_argument("MoE preparation contains an out-of-range resident slot");
+            }
+        }
+    }
+
+    void begin_build(storage & data) {
+        data.valid = false;
+        data.item.ctx.reset();
+        data.graph = {};
+        data.source = data.target = data.bank = data.source_view = data.destination = nullptr;
+        if (data.arena.empty()) {
+            data.arena.resize((metadata_bytes() + sizeof(metadata_word) - 1)/sizeof(metadata_word));
+        }
+    }
+
+    void publish(storage & data, const key & desired) {
+        // Nonzero graph UIDs bypass CUDA's source-pointer/property scan. This
+        // template deliberately rebinds addresses, so it must keep the scan.
+        data.graph.value->uid = 0;
+        const void * next_node = data.graph.value->nodes[0];
+        if (first_node && first_node != next_node) { ++counters.key_changes; }
+        first_node = next_node;
+        data.signature = desired;
+        data.valid = true;
+        ++counters.builds;
+    }
+
+public:
+    work() = default;
+    ~work() { GGML_ASSERT(!pending && "drain MoE preparation before destroying its async sources"); }
+    work(const work &) = delete;
+    work & operator=(const work &) = delete;
+    work(work &&) = delete;
+    work & operator=(work &&) = delete;
+
+    llama_moe_expert_graph::work & item(size_t ids_capacity, bool expert_major=false) {
+        auto & data = available();
+        if (!ids_capacity) { throw std::invalid_argument("MoE preparation ID capacity is zero"); }
+        // reserve() on an existing vector can choose a geometric capacity.
+        // Fresh vectors keep each retained capacity within the supplied
+        // existing workspace's ID allowance. Token-major only needs slot IDs.
+        for (auto * values : {&data.item.input_rows, &data.item.slot_ids, &data.item.output_rows}) {
+            if ((expert_major || values == &data.item.slot_ids) && values->capacity() < ids_capacity) {
+                std::vector<int32_t> replacement;
+                replacement.reserve(ids_capacity);
+                values->swap(replacement);
+            }
+        }
+        data.ids_capacity = std::max(data.ids_capacity, ids_capacity);
+        return data.item;
+    }
+
+    const llama_moe_expert_graph::work & item() const {
+        if (!state) { throw std::logic_error("MoE preparation work has not been initialized"); }
+        return state->item;
+    }
+
+    llama_moe_expert_graph::graph token(ggml_backend_t backend, const ggml_tensor * input,
+            ggml_tensor * output, const ggml_tensor * weight, size_t output_row, size_t rows,
+            size_t k, size_t tokens, size_t begin, size_t window_tokens,
+            ggml_backend_buffer_t workspace, size_t output_bytes, size_t ids_bytes, precision math = {}) {
+        auto & data = available();
+        if (!input || !output || !weight || !rows || !k || !tokens || !window_tokens ||
+            input->type != GGML_TYPE_F32 || output->type != GGML_TYPE_F32 ||
+            input->ne[0] <= 0 || output->ne[0] <= 0 || weight->ne[3] != 1 ||
+            begin > tokens || window_tokens > tokens - begin ||
+            input->ne[0] != weight->ne[0] || weight->ne[1] != int64_t(rows) || weight->ne[2] <= 0 ||
+            input->ne[2] != int64_t(tokens) || input->ne[3] != 1 ||
+            (input->ne[1] != 1 && input->ne[1] != int64_t(k)) ||
+            output->ne[1] != int64_t(k) || output->ne[2] != int64_t(tokens) || output->ne[3] != 1 ||
+            output_row > size_t(output->ne[0]) || rows > size_t(output->ne[0]) - output_row) {
+            throw std::invalid_argument("invalid token-major preparation geometry");
+        }
+        const size_t count = llama_moe_expert_graph::product(k, window_tokens);
+        if (count != data.item.slot_ids.size() || count > data.ids_capacity ||
+            llama_moe_expert_graph::product(count, sizeof(int32_t)) > ids_bytes ||
+            llama_moe_expert_graph::product(llama_moe_expert_graph::product(rows, count), sizeof(float)) > output_bytes ||
+            !workspace || llama_moe_expert_graph::sum(output_bytes, ids_bytes) > ggml_backend_buffer_get_size(workspace)) {
+            throw std::length_error("token-major preparation exceeds existing workspace");
+        }
+        validate_slots(data.item.slot_ids, weight);
+        const auto desired = signature(kind::token_major, backend, input, output, weight, rows, k, tokens,
+            window_tokens, count, workspace, output_bytes, ids_bytes, math);
+        const size_t input_offset = llama_moe_expert_graph::product(begin, input->nb[2]);
+        const size_t output_offset = llama_moe_expert_graph::sum(
+            llama_moe_expert_graph::product(begin, output->nb[2]),
+            llama_moe_expert_graph::product(output_row, output->nb[0]));
+        if (data.valid && data.signature == desired) {
+            data.valid = false;
+            alias_data(data.source, input); alias_data(data.target, output); alias_data(data.bank, weight);
+            rebind_view(data.source_view, input_offset);
+            rebind_view(data.destination, output_offset);
+            rebind_view(data.graph.scatter, output_offset);
+            data.graph.value->uid = 0;
+            data.valid = true;
+            ++counters.reuses;
+            return data.graph;
+        }
+        begin_build(data);
+        data.item.ctx.reset(ggml_init({metadata_bytes(), data.arena.data(), true}));
+        auto * ctx = data.item.ctx.get();
+        if (!ctx) { throw std::runtime_error("token-major preparation metadata allocation failed"); }
+        data.source = llama_moe_expert_graph::alias(ctx, input);
+        data.target = llama_moe_expert_graph::alias(ctx, output);
+        data.bank = llama_moe_expert_graph::alias(ctx, weight);
+        data.source_view = ggml_view_3d(ctx, data.source, input->ne[0], input->ne[1], int64_t(window_tokens),
+            input->nb[1], input->nb[2], input_offset);
+        llama_moe_expert_graph::view(data.source_view);
+        data.graph.slots = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, int64_t(k), int64_t(window_tokens));
+        llama_moe_expert_graph::allocate(workspace, data.graph.slots, output_bytes);
+        data.graph.part = ggml_mul_mat_id(ctx, data.bank, data.source_view, data.graph.slots);
+        math.apply(data.graph.part);
+        llama_moe_expert_graph::allocate(workspace, data.graph.part, 0);
+        data.destination = ggml_view_3d(ctx, data.target, rows, int64_t(k), int64_t(window_tokens),
+            output->nb[1], output->nb[2], output_offset);
+        llama_moe_expert_graph::view(data.destination);
+        data.graph.scatter = ggml_cpy(ctx, data.graph.part, data.destination);
+        llama_moe_expert_graph::view(data.graph.scatter);
+        data.graph.value = ggml_new_graph_custom(ctx, 32, false);
+        ggml_build_forward_expand(data.graph.value, data.graph.scatter);
+        publish(data, desired);
+        return data.graph;
+    }
+
+    llama_moe_expert_graph::graph expert(ggml_backend_t backend, const ggml_tensor * input,
+            ggml_tensor * output, const ggml_tensor * weight, size_t output_row, size_t rows,
+            size_t k, size_t tokens, ggml_backend_buffer_t workspace, precision math = {}) {
+        auto & data = available();
+        const size_t entries = data.item.slot_ids.size();
+        // This is the same validation used by the original builder, including
+        // every changing gather/scatter/slot index, on both hits and misses.
+        llama_moe_expert_graph::validate(data.item, input, output, weight, output_row, rows, k, tokens, workspace);
+        if (entries > data.ids_capacity) { throw std::length_error("expert-major preparation exceeds retained ID capacity"); }
+        const auto desired = signature(kind::expert_major, backend, input, output, weight, rows, k, tokens,
+            0, entries, workspace, 0, 0, math);
+        const size_t output_offset = llama_moe_expert_graph::product(output_row, sizeof(float));
+        if (data.valid && data.signature == desired) {
+            data.valid = false;
+            alias_data(data.source, input); alias_data(data.target, output); alias_data(data.bank, weight);
+            rebind_view(data.source_view, 0);
+            rebind_view(data.destination, output_offset);
+            rebind_view(data.graph.scatter, output_offset);
+            data.graph.value->uid = 0;
+            data.valid = true;
+            ++counters.reuses;
+            return data.graph;
+        }
+        begin_build(data);
+        data.graph = llama_moe_expert_graph::build(data.item, input, output, weight, output_row, rows,
+            k, tokens, workspace, data.arena.data(), metadata_bytes());
+        math.apply(data.graph.part);
+        data.source_view = data.graph.gather->src[0];
+        data.source = data.source_view->view_src;
+        data.bank = data.graph.part->src[0];
+        data.destination = data.graph.scatter->src[2];
+        data.target = data.destination->view_src;
+        publish(data, desired);
+        return data.graph;
+    }
+
+    void mark_pending() {
+        if (pending || !state || !state->valid) { throw std::logic_error("invalid pending MoE preparation work"); }
+        pending = true;
+    }
+    void drained() noexcept { pending = false; }
+    bool is_pending() const { return pending; }
+    void invalidate() {
+        if (pending) { throw std::logic_error("drain MoE preparation before invalidation"); }
+        if (!state) { return; }
+        auto & data = *state;
+        data.item.ctx.reset(); data.graph = {}; data.valid = false;
+        data.source = data.target = data.bank = data.source_view = data.destination = nullptr;
+        ++counters.invalidations;
+    }
+    statistics stats() const { return counters; }
+    size_t arena_bytes() const { return state ? state->arena.capacity()*sizeof(metadata_word) : 0; }
+    size_t ids_bytes() const {
+        return state ? (state->item.input_rows.capacity() + state->item.slot_ids.capacity() +
+                        state->item.output_rows.capacity())*sizeof(int32_t) : 0;
+    }
+    const void * graph_key() const { return state && state->valid ? state->graph.value->nodes[0] : nullptr; }
+};
+
+// A specialized retained pool: the older llama_moe_work_batch keeps its original
+// destroy-after-drain semantics. This pool never hands out a pending slot.
+class batch {
+    std::array<work, 4> slots;
+    size_t used = 0, limit = 4;
+public:
+    ~batch() { GGML_ASSERT(used == 0 && "drain MoE preparation before destroying its async sources"); }
+    void set_limit(size_t value) {
+        if (used || !value || value > slots.size()) { throw std::logic_error("invalid retained MoE batch limit/state"); }
+        limit = value;
+    }
+    template<class Synchronize> work & next(Synchronize && synchronize) {
+        if (used == limit) { flush(synchronize); }
+        return slots[used++];
+    }
+    template<class Synchronize> void flush(Synchronize && synchronize) {
+        if (!used) { return; }
+        synchronize();
+        for (size_t i = 0; i < used; ++i) { slots[i].drained(); }
+        used = 0;
+    }
+    void invalidate() {
+        if (used) { throw std::logic_error("drain MoE preparation before invalidation"); }
+        for (auto & slot : slots) { slot.invalidate(); }
+    }
+    size_t size() const { return used; }
+    statistics stats() const {
+        statistics result;
+        for (const auto & slot : slots) {
+            const auto value = slot.stats();
+            result.builds += value.builds; result.reuses += value.reuses; result.invalidations += value.invalidations;
+            result.key_changes += value.key_changes;
+        }
+        return result;
+    }
+    size_t arena_bytes() const {
+        size_t result = 0; for (const auto & slot : slots) { result += slot.arena_bytes(); } return result;
+    }
+    size_t ids_bytes() const {
+        size_t result = 0; for (const auto & slot : slots) { result += slot.ids_bytes(); } return result;
+    }
+};
+
+} // namespace llama_moe_prepare
