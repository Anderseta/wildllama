diff --git a/ggml/src/ggml-cuda/fattn-vec-gqa.h b/ggml/src/ggml-cuda/fattn-vec-gqa.h
new file mode 100644
index 0000000..234aac8
--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-vec-gqa.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// The experimental pair kernel preserves the vector kernel's independent
+// arithmetic for each query head. Keep unsupported layouts on the old path.
+struct ggml_cuda_fattn_vec_gqa_shape {
+    int64_t dimension, queries, query_heads, kv_heads, sequences, kv_tokens;
+    size_t q_stride, k_stride, v_stride;
+    bool q_f32, kv_q8, dense_mask, sinks;
+    float max_bias, softcap;
+};
+
+inline bool ggml_cuda_fattn_vec_gqa_eligible(bool enabled, const ggml_cuda_fattn_vec_gqa_shape & s) {
+    return enabled && s.dimension == 256 && s.queries == 1 && s.sequences == 1 &&
+        s.query_heads > 0 && s.kv_heads > 0 && s.query_heads % s.kv_heads == 0 &&
+        (s.query_heads/s.kv_heads) % 2 == 0 && s.kv_tokens > 0 && s.kv_tokens % 256 == 0 &&
+        s.q_f32 && s.kv_q8 && s.dense_mask && !s.sinks && s.max_bias == 0.0f && s.softcap == 0.0f &&
+        s.q_stride >= 256*sizeof(float) && s.q_stride % 16 == 0 &&
+        s.k_stride >= 8*34 && s.v_stride >= 8*34;
+}
+
+// Host tests use the exact canonical row mapping written by the kernel. Split-K
+// metadata and output values must agree so the existing merge stays unchanged.
+inline size_t ggml_cuda_fattn_vec_gqa_row(int sequence, int query, int head,
+        int queries, int heads, int splits, int split) {
+    return ((size_t(sequence)*queries + query)*heads + head)*splits + split;
+}
diff --git a/tests/test-fattn-vec-gqa.cpp b/tests/test-fattn-vec-gqa.cpp
new file mode 100644
index 0000000..c666447
--- /dev/null
+++ b/tests/test-fattn-vec-gqa.cpp
@@ -0,0 +1,70 @@
+#include "../ggml/src/ggml-cuda/fattn-vec-gqa.h"
+
+#include <cstdio>
+#include <stdexcept>
+#include <vector>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+int main() {
+    try {
+        const ggml_cuda_fattn_vec_gqa_shape good{
+            256, 1, 8, 2, 1, 1024, 1024, 272, 272, true, true, true, false, 0, 0};
+        require(ggml_cuda_fattn_vec_gqa_eligible(true, good), "supported pair layout rejected");
+        require(!ggml_cuda_fattn_vec_gqa_eligible(false, good), "default unexpectedly enabled");
+        for (int field = 0; field < 15; ++field) {
+            auto bad = good;
+            switch (field) {
+                case 0: bad.dimension = 128; break;
+                case 1: bad.queries = 2; break;
+                case 2: bad.sequences = 2; break;
+                case 3: bad.kv_heads = 0; break;
+                case 4: bad.query_heads = 7; break;
+                case 5: bad.query_heads = 6; break;
+                case 6: bad.kv_tokens = 1023; break;
+                case 7: bad.q_stride = 1028; break;
+                case 8: bad.k_stride = 271; break;
+                case 9: bad.v_stride = 271; break;
+                case 10: bad.q_f32 = false; break;
+                case 11: bad.kv_q8 = false; break;
+                case 12: bad.dense_mask = false; break;
+                case 13: bad.sinks = true; break;
+                case 14: bad.max_bias = 1; break;
+            }
+            require(!ggml_cuda_fattn_vec_gqa_eligible(true, bad), "unsupported pair layout admitted");
+        }
+        auto softcap = good; softcap.softcap = 1;
+        require(!ggml_cuda_fattn_vec_gqa_eligible(true, softcap), "softcap admitted");
+
+        size_t checked = 0;
+        for (int heads : {2, 4, 6, 8, 12, 16, 32}) {
+            for (int kv_heads : {1, 2, 4}) {
+                if (heads % kv_heads || (heads/kv_heads) % 2) { continue; }
+                for (int splits : {1, 2, 3, 4, 8, 16}) {
+                    std::vector<int> visits(size_t(heads)*splits);
+                    for (int group = 0; group < heads/2; ++group) {
+                        const int head_base = 2*group;
+                        require(head_base/(heads/kv_heads) == (head_base+1)/(heads/kv_heads),
+                            "pair crosses KV-head boundary");
+                        for (int j = 0; j < 2; ++j) {
+                            for (int split = 0; split < splits; ++split) {
+                                const auto row = ggml_cuda_fattn_vec_gqa_row(0, 0, head_base+j, 1, heads, splits, split);
+                                require(row == size_t(head_base+j)*splits + split,
+                                    "pair scratch does not match legacy split-K merge");
+                                require(++visits.at(row) == 1, "overlapping pair rows");
+                                ++checked;
+                            }
+                        }
+                    }
+                    for (int visits_per_row : visits) { require(visits_per_row == 1, "missing pair row"); }
+                }
+            }
+        }
+        std::printf("PASS GQA Q8 policy/default/fallback and canonical row mapping: %zu rows\n", checked);
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what()); return 1;
+    }
+}
