+// Standalone CUDA fixture: includes the production kernels, compares the pair
+// specialization with the legacy per-head kernel and its existing split merge.
+#include "../ggml/src/ggml-cuda/fattn-vec.cuh"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+// CUDA_CHECK uses this module-private diagnostic symbol. Keep the standalone
+// fixture independent of the production CUDA DLL and report failures to main.
+[[noreturn]] void ggml_cuda_error(const char * stmt, const char * func, const char * file, int line, const char * msg) {
+    throw std::runtime_error(std::string("CUDA fixture: ")+stmt+" in "+func+" at "+file+":"+
+        std::to_string(line)+": "+msg);
+}
+
+template<class T> struct device_buffer {
+    T * data = nullptr;
+    explicit device_buffer(size_t count) { CUDA_CHECK(cudaMalloc((void **)&data, count*sizeof(T))); }
+    ~device_buffer() { if (data) { cudaFree(data); } }
+    device_buffer(const device_buffer &) = delete;
+    device_buffer & operator=(const device_buffer &) = delete;
+};
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+template<int heads_per_block>
+static std::vector<float> run(const std::vector<float> & q, const std::vector<block_q8_0> & k,
+        const std::vector<block_q8_0> & v, const std::vector<half> & mask,
+        int heads, int kv_heads, int tokens, int splits, int q_stride, int kv_stride,
+        int head_stride, int kv_max) {
+    device_buffer<float> dq(q.size()), output(size_t(heads)*256*splits), final(size_t(heads)*256);
+    device_buffer<block_q8_0> dk(k.size()), dv(v.size());
+    device_buffer<half> dm(mask.size());
+    device_buffer<float2> meta(size_t(heads)*splits);
+    device_buffer<int> max_rows(1);
+    CUDA_CHECK(cudaMemcpy(dq.data, q.data(), q.size()*sizeof(float), cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaMemcpy(dk.data, k.data(), k.size()*sizeof(block_q8_0), cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaMemcpy(dv.data, v.data(), v.size()*sizeof(block_q8_0), cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaMemcpy(dm.data, mask.data(), mask.size()*sizeof(half), cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaMemcpy(max_rows.data, &kv_max, sizeof(kv_max), cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaMemset(output.data, 0xff, size_t(heads)*256*splits*sizeof(float)));
+    CUDA_CHECK(cudaMemset(meta.data, 0xff, size_t(heads)*splits*sizeof(float2)));
+    const int row_bytes = kv_stride*sizeof(block_q8_0);
+    const int head_bytes = head_stride*sizeof(block_q8_0);
+    const dim3 grid(1, splits, heads/heads_per_block), block(32, 4, 1);
+    flash_attn_ext_vec<256, 1, heads_per_block, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, false><<<grid, block>>>(
+        (const char *)dq.data, (const char *)dk.data, (const char *)dv.data, (const char *)dm.data,
+        nullptr, max_rows.data, output.data, meta.data,
+        1.0f/16, 0, 1, 1, 1, 0,
+        256, init_fastdiv_values(1), heads, 1, 256*sizeof(float), q_stride*sizeof(float), q.size()*sizeof(float),
+        256, tokens, kv_heads, 1, row_bytes, head_bytes, k.size()*sizeof(block_q8_0),
+        row_bytes, head_bytes, v.size()*sizeof(block_q8_0),
+        tokens, 1, 1, tokens*sizeof(half), tokens*sizeof(half), tokens*sizeof(half));
+    CUDA_CHECK(cudaGetLastError());
+    const float * result = output.data;
+    if (splits > 1) {
+        flash_attn_combine_results<256><<<dim3(1, heads, 1), dim3(256, 1, 1), splits*sizeof(float2)>>>(
+            output.data, meta.data, final.data, splits);
+        CUDA_CHECK(cudaGetLastError());
+        result = final.data;
+    }
+    std::vector<float> host(size_t(heads)*256);
+    CUDA_CHECK(cudaMemcpy(host.data(), result, host.size()*sizeof(float), cudaMemcpyDeviceToHost));
+    return host;
+}
+
+static void check(int heads, int kv_heads, int tokens, int splits, bool padded, bool clipped) {
+    const int q_stride = 256 + (padded ? 16 : 0);
+    const int kv_stride = 8 + (padded ? 2 : 0);
+    const int head_stride = (tokens + (padded ? 7 : 0))*kv_stride;
+    const int visible = clipped ? tokens/2 - 17 : tokens;
+    const int kv_max = clipped ? ((visible + 255)/256)*256 : tokens;
+    std::vector<float> q(size_t(heads)*q_stride, 1234);
+    std::vector<block_q8_0> k(size_t(kv_heads)*head_stride), v(k.size());
+    std::vector<half> mask(tokens);
+    for (int head = 0; head < heads; ++head) {
+        for (int d = 0; d < 256; ++d) { q[head*q_stride+d] = std::sin(float(13*head+d)*.031f); }
+    }
+    for (int head = 0; head < kv_heads; ++head) {
+        for (int row = 0; row < tokens; ++row) {
+            for (int b = 0; b < 8; ++b) {
+                const size_t index = size_t(head)*head_stride + row*kv_stride + b;
+                const half scale = __float2half(.003f + .0001f*((row+head+b)%11));
+                std::memcpy(&k[index].d, &scale, sizeof(scale));
+                std::memcpy(&v[index].d, &scale, sizeof(scale));
+                for (int d = 0; d < 32; ++d) {
+                    k[index].qs[d] = int8_t((row*7+head*13+b*3+d*11)%127-63);
+                    v[index].qs[d] = int8_t((row*3+head*19+b*17+d*5)%125-62);
+                }
+            }
+        }
+    }
+    for (int row = 0; row < tokens; ++row) {
+        mask[row] = __float2half(row >= visible || row%17 == 3 ? -INFINITY : 0.0f);
+    }
+    const auto legacy = run<1>(q,k,v,mask,heads,kv_heads,tokens,splits,q_stride,kv_stride,head_stride,kv_max);
+    const auto pair = run<2>(q,k,v,mask,heads,kv_heads,tokens,splits,q_stride,kv_stride,head_stride,kv_max);
+    float max_error = 0;
+    for (size_t i = 0; i < pair.size(); ++i) {
+        require(std::isfinite(legacy[i]) && std::isfinite(pair[i]), "nonfinite attention output");
+        max_error = std::max(max_error, std::abs(legacy[i]-pair[i]));
+        require(std::abs(legacy[i]-pair[i]) <= 2e-6f + 2e-5f*std::abs(legacy[i]), "attention mismatch");
+    }
+    for (int head = 0; head < heads; ++head) {
+        const auto begin = size_t(head)*256;
+        require(std::max_element(legacy.begin()+begin, legacy.begin()+begin+256)-legacy.begin() ==
+                std::max_element(pair.begin()+begin, pair.begin()+begin+256)-pair.begin(), "attention argmax changed");
+    }
+    std::printf("GQA_Q8_REFERENCE heads=%d kv_heads=%d tokens=%d splits=%d padded=%d clipped=%d max_error=%.9g PASS\n",
+        heads,kv_heads,tokens,splits,int(padded),int(clipped),double(max_error));
+}
+
+int main() {
+    try {
+        int devices = 0;
+        const auto status = cudaGetDeviceCount(&devices);
+        if (status == cudaErrorNoDevice || status == cudaErrorInsufficientDriver ||
+                (status == cudaSuccess && devices == 0)) {
+            std::puts("SKIP: no CUDA device/driver available"); return 77;
+        }
+        CUDA_CHECK(status);
+        const std::pair<int,int> shapes[] = {{4,1}, {6,1}, {8,2}, {12,2}};
+        for (const auto & shape : shapes) {
+            for (int splits : {1,4,16}) {
+                check(shape.first,shape.second,2048,splits,false,false);
+                check(shape.first,shape.second,2048,splits,true,true);
+            }
+        }
+        std::puts("PASS grouped Q8 attention matches legacy heads, dense masks, padded strides, bounded live KV and split-K");
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr,"FAIL: %s\n",error.what()); return 1;
+    }
+}
