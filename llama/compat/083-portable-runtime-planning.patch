diff --git a/ggml/src/ggml-cuda/unary.cu b/ggml/src/ggml-cuda/unary.cu
--- a/ggml/src/ggml-cuda/unary.cu
+++ b/ggml/src/ggml-cuda/unary.cu
@@ -814,3 +814,41 @@
         default: GGML_ABORT("unsupported fused bias activation");
     }
 }
+
+template <float (*op)(float)>
+static __global__ void affine_gate_f32(const float * input, const float * bias, const float * factor,
+        float * output, int count, bool bias_vector, bool factor_vector, uint3 columns) {
+    ggml_cuda_pdl_lc();
+    const int64_t i = int64_t(blockDim.x) * blockIdx.x + threadIdx.x;
+    if (i >= count) { return; }
+    const int column = bias_vector || factor_vector ? fastmodulo(int(i), columns) : 0;
+    ggml_cuda_pdl_sync();
+    const float sum = __fadd_rn(input[i], bias[bias_vector ? column : i]);
+    const float activated = op(sum);
+    output[i] = __fmul_rn(activated, factor[factor_vector ? column : i]);
+}
+
+template <float (*op)(float)>
+static void affine_gate_f32_launch(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * add, const ggml_tensor * unary, ggml_tensor * output) {
+    const auto * input = add->src[0];
+    const auto * bias = add->src[1];
+    const auto * factor = output->src[0] == unary ? output->src[1] : output->src[0];
+    const int count = int(ggml_nelements(output));
+    const dim3 blocks((int64_t(count) + CUDA_GLU_BLOCK_SIZE - 1) / CUDA_GLU_BLOCK_SIZE);
+    const ggml_cuda_kernel_launch_params launch_params{ blocks, dim3(CUDA_GLU_BLOCK_SIZE), 0, ctx.stream() };
+    ggml_cuda_kernel_launch(affine_gate_f32<op>, launch_params,
+        (const float *) input->data, (const float *) bias->data, (const float *) factor->data,
+        (float *) output->data, count, ggml_nelements(bias) != count, ggml_nelements(factor) != count,
+        init_fastdiv_values(int(input->ne[0])));
+}
+
+void ggml_cuda_op_affine_gate_fused(ggml_backend_cuda_context & ctx,
+        ggml_tensor * add, ggml_tensor * unary, ggml_tensor * output) {
+    switch (ggml_get_unary_op(unary)) {
+        case GGML_UNARY_OP_SOFTPLUS: affine_gate_f32_launch<op_softplus>(ctx, add, unary, output); break;
+        case GGML_UNARY_OP_SIGMOID: affine_gate_f32_launch<op_sigmoid>(ctx, add, unary, output); break;
+        case GGML_UNARY_OP_SILU: affine_gate_f32_launch<op_silu>(ctx, add, unary, output); break;
+        default: GGML_ABORT("unsupported fused affine gate");
+    }
+}
