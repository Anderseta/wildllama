+// Verify that each generating sequence, including every speculative proposal,
+// remains wholly inside the first ordinary logical decode. Prompt slicing may
+// only consume the capacity AFTER these spans. No token or sequence is moved.
+class server_prefill_batch_contract {
+public:
+    server_prefill_batch_contract(uint32_t capacity, uint32_t rows, bool neural)
+        : capacity(capacity), rows(rows) {
+        valid = capacity && rows <= capacity;
+        mix(neural ? 1 : 0);
+    }
+    void sequence(uint32_t id, uint64_t begin, uint64_t count) {
+        if (!valid || !count || begin != covered || begin > rows || count > uint64_t(rows) - begin) {
+            valid = false;
+            return;
+        }
+        covered += uint32_t(count);
+        mix(id); mix(uint32_t(count));
+    }
+    bool complete() const { return valid && covered == rows; }
+    uint64_t workload() const { return fingerprint; }
+private:
+    void mix(uint32_t value) { fingerprint = (fingerprint ^ value) * UINT64_C(1099511628211); }
+    uint64_t fingerprint = UINT64_C(1469598103934665603);
+    uint32_t capacity = 0, rows = 0, covered = 0;
+    bool valid = false;
+};
