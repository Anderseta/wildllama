new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-cuda/affine-gate.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include "affine-fusion.h"
+
+inline bool ggml_cuda_affine_gate_unary(ggml_unary_op op) {
+    return op == GGML_UNARY_OP_SOFTPLUS || op == GGML_UNARY_OP_SIGMOID || op == GGML_UNARY_OP_SILU;
+}
+
+inline bool ggml_cuda_affine_gate_shape(const ggml_tensor * tensor, int64_t & count) {
+    if (!tensor || tensor->type != GGML_TYPE_F32) { return false; }
+    count = 1;
+    for (const auto dimension : tensor->ne) {
+        if (dimension <= 0 || dimension > INT32_MAX / count) { return false; }
+        count *= dimension;
+    }
+    return ggml_is_contiguous(tensor);
+}
+
+inline bool ggml_cuda_affine_gate_operand(const ggml_tensor * tensor, const ggml_tensor * input) {
+    int64_t count = 0;
+    return ggml_cuda_affine_gate_shape(tensor, count) &&
+        (ggml_are_same_shape(tensor, input) || ggml_cuda_column_vector(tensor, input->ne[0]));
+}
+
+inline bool ggml_cuda_match_affine_gate(const ggml_cgraph * graph, int i, bool allocated) {
+    if (!graph || i < 0 || graph->n_nodes < 3 || i > graph->n_nodes - 3) { return false; }
+    const auto * add = graph->nodes[i];
+    const auto * unary = graph->nodes[i + 1];
+    const auto * output = graph->nodes[i + 2];
+    if (!add || !unary || !output || add->op != GGML_OP_ADD || unary->op != GGML_OP_UNARY ||
+        output->op != GGML_OP_MUL || unary->src[0] != add ||
+        (output->src[0] != unary && output->src[1] != unary) ||
+        !ggml_cuda_affine_gate_unary(ggml_get_unary_op(unary))) { return false; }
+    const auto * input = add->src[0];
+    const auto * bias = add->src[1];
+    const auto * factor = output->src[0] == unary ? output->src[1] : output->src[0];
+    int64_t count = 0;
+    if (!ggml_cuda_affine_gate_shape(input, count) ||
+        !ggml_cuda_affine_gate_operand(bias, input) || !ggml_cuda_affine_gate_operand(factor, input)) { return false; }
+    for (const auto * tensor : { add, unary, output }) {
+        int64_t tensor_count = 0;
+        if (!ggml_cuda_affine_gate_shape(tensor, tensor_count) || !ggml_are_same_shape(input, tensor)) { return false; }
+    }
+    if (!ggml_can_fuse_subgraph(graph, i, { GGML_OP_ADD, GGML_OP_UNARY, GGML_OP_MUL }, { i + 2 })) { return false; }
+    if (!allocated) { return true; }
+    for (const auto * tensor : { input, bias, factor, output }) {
+        if (!tensor->data || (reinterpret_cast<uintptr_t>(tensor->data) % alignof(float)) != 0) { return false; }
+    }
+    // Keep allocator lifetimes unchanged; only exact element aliases are safe.
+    for (const auto * source : { input, bias, factor }) {
+        if (!ggml_cuda_residual_norm_disjoint(output, source) && !ggml_cuda_same_element_storage(output, source)) { return false; }
+    }
+    return true;
+}
