diff --git a/tests/test-affine-gate.cpp b/tests/test-affine-gate.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-affine-gate.cpp
@@ -0,0 +1,251 @@
+#include "ggml-cpp.h"
+#include "../ggml/include/ggml-cuda.h"
+#include "../ggml/src/ggml-cuda/affine-gate.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+static ggml_context_ptr context() {
+    return ggml_context_ptr(ggml_init({64 * ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true}));
+}
+
+struct gate_graph {
+    ggml_context_ptr ctx = context();
+    ggml_cgraph * graph = ggml_new_graph(ctx.get());
+    ggml_tensor * input;
+    ggml_tensor * bias;
+    ggml_tensor * factor;
+    ggml_tensor * add;
+    ggml_tensor * unary;
+    ggml_tensor * output;
+
+    gate_graph(int width, int rows, ggml_unary_op activation, bool bias_vector, bool factor_vector) {
+        input = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, width, rows);
+        bias = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, width, bias_vector ? 1 : rows);
+        factor = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, width, factor_vector ? 1 : rows);
+        add = ggml_add(ctx.get(), input, bias);
+        unary = ggml_unary(ctx.get(), add, activation);
+        output = ggml_mul(ctx.get(), unary, factor);
+        ggml_set_input(input);
+        ggml_set_input(bias);
+        ggml_set_input(factor);
+        ggml_set_output(output);
+        ggml_build_forward_expand(graph, output);
+    }
+
+    void addresses() {
+        uintptr_t address = 0x10000000;
+        for (auto * tensor : { input, bias, factor, add, unary, output }) {
+            tensor->data = reinterpret_cast<void *>(address);
+            address += 0x10000000;
+        }
+    }
+};
+
+static void host_contracts() {
+    for (const auto activation : { GGML_UNARY_OP_SOFTPLUS, GGML_UNARY_OP_SIGMOID, GGML_UNARY_OP_SILU }) {
+        for (const int width : { 1, 31, 64, 128, 257, 4096 }) {
+            for (const int rows : { 1, 2, 19 }) {
+                for (bool bias_vector : { false, true }) for (bool factor_vector : { false, true }) {
+                    gate_graph f(width, rows, activation, bias_vector, factor_vector);
+                    require(ggml_cuda_match_affine_gate(f.graph, 0, false), "supported affine gate rejected");
+                    require(!ggml_cuda_match_affine_gate(f.graph, 0, true), "unallocated gate admitted");
+                    f.addresses();
+                    require(ggml_cuda_match_affine_gate(f.graph, 0, true), "disjoint gate rejected");
+                    std::swap(f.output->src[0], f.output->src[1]);
+                    require(ggml_cuda_match_affine_gate(f.graph, 0, true), "commuted multiplication rejected");
+                    std::swap(f.output->src[0], f.output->src[1]);
+                    const auto saved_output = f.output->data;
+                    for (const auto * source : { f.input, f.bias, f.factor }) {
+                        f.output->data = source->data;
+                        require(ggml_cuda_match_affine_gate(f.graph, 0, true) == ggml_are_same_shape(source, f.output),
+                            "broadcast or exact alias admission mismatch");
+                        f.output->data = static_cast<char *>(source->data) +
+                            (ggml_nelements(source) > 1 ? sizeof(float) : 1);
+                        require(!ggml_cuda_match_affine_gate(f.graph, 0, true), "shifted alias admitted");
+                    }
+                    f.output->data = saved_output;
+                    for (auto * intermediate : { f.add, f.unary }) {
+                        intermediate->flags |= GGML_TENSOR_FLAG_OUTPUT;
+                        require(!ggml_cuda_match_affine_gate(f.graph, 0, false), "observable intermediate elided");
+                        intermediate->flags &= ~GGML_TENSOR_FLAG_OUTPUT;
+                    }
+                }
+            }
+        }
+    }
+    gate_graph f(64, 3, GGML_UNARY_OP_SOFTPLUS, true, true);
+    f.addresses();
+    require(!ggml_cuda_match_affine_gate(nullptr, 0, false) &&
+        !ggml_cuda_match_affine_gate(f.graph, -1, false) &&
+        !ggml_cuda_match_affine_gate(f.graph, 1, false), "invalid graph index admitted");
+    for (auto * tensor : { f.input, f.bias, f.factor, f.add, f.unary, f.output }) {
+        const auto type = tensor->type;
+        tensor->type = GGML_TYPE_F16;
+        require(!ggml_cuda_match_affine_gate(f.graph, 0, false), "changed precision admitted");
+        tensor->type = type;
+        const auto stride = tensor->nb[1];
+        tensor->nb[1] += sizeof(float);
+        if (tensor->ne[1] > 1) {
+            require(!ggml_cuda_match_affine_gate(f.graph, 0, false), "strided tensor admitted");
+        }
+        tensor->nb[1] = stride;
+    }
+    const auto factor_dim = f.factor->ne[0];
+    f.factor->ne[0] = 1;
+    require(!ggml_cuda_match_affine_gate(f.graph, 0, false), "unsupported factor broadcast admitted");
+    f.factor->ne[0] = factor_dim;
+    ggml_set_op_params_i32(f.unary, 0, GGML_UNARY_OP_TANH);
+    require(!ggml_cuda_match_affine_gate(f.graph, 0, false), "unsupported activation admitted");
+    ggml_set_op_params_i32(f.unary, 0, GGML_UNARY_OP_SOFTPLUS);
+    const auto old_dim = f.input->ne[3];
+    f.input->ne[3] = INT64_MAX;
+    require(!ggml_cuda_match_affine_gate(f.graph, 0, false), "overflowing element count admitted");
+    f.input->ne[3] = old_dim;
+    f.unary->src[0] = f.input;
+    require(!ggml_cuda_match_affine_gate(f.graph, 0, false), "disconnected activation admitted");
+    f.unary->src[0] = f.add;
+    f.factor->data = reinterpret_cast<void *>(0x10000001);
+    require(!ggml_cuda_match_affine_gate(f.graph, 0, true), "misaligned operand admitted");
+}
+
+struct runtime_graph {
+    gate_graph tensors;
+    ggml_backend_ptr sentinel;
+    ggml_backend_sched_ptr scheduler;
+    bool cuda;
+
+    runtime_graph(ggml_backend_t backend, int width, int rows, ggml_unary_op activation,
+            bool bias_vector, bool factor_vector, int keep) :
+        tensors(width, rows, activation, bias_vector, factor_vector),
+        cuda(ggml_backend_dev_type(ggml_backend_get_device(backend)) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+        if (keep & 1) { ggml_set_output(tensors.add); }
+        if (keep & 2) { ggml_set_output(tensors.unary); }
+        std::vector<ggml_backend_t> backends{ backend };
+        if (cuda) {
+            sentinel.reset(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr));
+            require(sentinel != nullptr, "CPU scheduler sentinel unavailable");
+            backends.push_back(sentinel.get());
+        }
+        scheduler.reset(ggml_backend_sched_new(backends.data(), nullptr, backends.size(), 64, false, true));
+        require(scheduler != nullptr, "scheduler initialization failed");
+        if (cuda) { ggml_backend_sched_set_gpu_exclusive(scheduler.get(), true); }
+        for (int i = 0; i < ggml_graph_n_nodes(tensors.graph); ++i) {
+            ggml_backend_sched_set_tensor_backend(scheduler.get(), ggml_graph_node(tensors.graph, i), backend);
+        }
+        require(ggml_backend_sched_alloc_graph(scheduler.get(), tensors.graph), "small gate graph allocation failed");
+    }
+
+    std::vector<float> run(int iteration) {
+        static const float edge[] = { -100.0f, -20.000002f, -20.0f, -0.0f, 0.0f, 19.999998f, 20.0f, 20.000002f, 100.0f };
+        for (auto * tensor : { tensors.input, tensors.bias, tensors.factor }) {
+            std::vector<float> data(ggml_nelements(tensor));
+            for (size_t i = 0; i < data.size(); ++i) {
+                data[i] = std::sin(float(i) * .07f + iteration * .3f) * 3.0f;
+                if (tensor == tensors.input && i % 13 < std::size(edge)) { data[i] = edge[i % 13]; }
+                if (tensor == tensors.factor) { data[i] = std::cos(float(i) * .13f + iteration) * -2.0f; }
+            }
+            ggml_backend_tensor_set(tensor, data.data(), 0, ggml_nbytes(tensor));
+        }
+        require(ggml_backend_sched_graph_compute(scheduler.get(), tensors.graph) == GGML_STATUS_SUCCESS,
+            "gate compute failed");
+        if (cuda) {
+            const auto stats = ggml_backend_sched_get_gpu_stats(scheduler.get());
+            require(stats.cpu_heavy_ops_submitted == 0, "gate arithmetic fell back to CPU");
+        }
+        std::vector<float> result(ggml_nelements(tensors.output));
+        ggml_backend_tensor_get(tensors.output, result.data(), 0, ggml_nbytes(tensors.output));
+        return result;
+    }
+};
+
+int main(int argc, char ** argv) {
+    try {
+        host_contracts();
+        if (argc < 2 || std::string(argv[1]) == "--host-only") {
+            std::puts("PASS affine gate host admission, precision, observable outputs, broadcasting, aliases and overflow");
+            return 0;
+        }
+        require(std::string(argv[1]) == "--cuda" || std::string(argv[1]) == "--cpu", "use --host-only, --cpu or --cuda");
+        const bool use_cuda = std::string(argv[1]) == "--cuda";
+        if (use_cuda) {
+            ggml_backend_load_all();
+        } else {
+#ifdef GGML_TEST_CPU_BACKEND_PATH
+            require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH) != nullptr, "CPU backend cannot be loaded");
+#else
+            const char * cpu_path = std::getenv("GGML_TEST_CPU_BACKEND_PATH");
+            require(cpu_path && ggml_backend_load(cpu_path), "set GGML_TEST_CPU_BACKEND_PATH to the CPU backend file");
+#endif
+        }
+        ggml_backend_ptr backend;
+        uint64_t (*counter)() = nullptr;
+        decltype(&ggml_backend_cuda_get_memory_stats) get_stats = nullptr;
+        if (use_cuda) {
+            auto * registry = ggml_backend_reg_by_name("CUDA");
+            if (!registry || !ggml_backend_reg_dev_count(registry)) { std::puts("SKIP no CUDA backend"); return 77; }
+            auto * device = ggml_backend_reg_dev_get(registry, 0);
+            auto set_limit = reinterpret_cast<bool (*)(ggml_backend_dev_t, size_t, bool)>(
+                ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_set_memory_limit"));
+            get_stats = reinterpret_cast<decltype(get_stats)>(
+                ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_get_memory_stats"));
+            counter = reinterpret_cast<decltype(counter)>(
+                ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_test_affine_gate_fusions"));
+            require(set_limit && get_stats && counter, "gate counter or managed CUDA quota API unavailable");
+            require(set_limit(device, 128 * 1024 * 1024, true), "cannot set 128 MiB test quota");
+            backend.reset(ggml_backend_dev_init(device, nullptr));
+        } else {
+            backend.reset(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr));
+        }
