+#include "../tools/server/server-prefill-budget.h"
+
+#include <cstdio>
+#include <stdexcept>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+static uint64_t workload(uint32_t first, uint32_t second, uint32_t first_rows, uint32_t second_rows) {
+    server_prefill_batch_contract value(512, first_rows + second_rows, true);
+    value.sequence(first, 0, first_rows);
+    value.sequence(second, first_rows, second_rows);
+    require(value.complete(), "two independent verification spans were rejected");
+    return value.workload();
+}
+
+int main() {
+    try {
+        server_prefill_batch_contract empty(512, 0, false);
+        require(empty.complete(), "empty generating batch prevented ordinary prompt admission");
+        server_prefill_batch_contract full(512, 512, true);
+        full.sequence(0, 0, 256); full.sequence(1, 256, 256);
+        require(full.complete(), "full verification batch was rejected");
+        for (uint32_t capacity : {1u, 32u, 128u, 512u, UINT32_MAX}) {
+            for (uint32_t rows : {1u, 2u, 31u, 127u, 511u, UINT32_MAX}) {
+                server_prefill_batch_contract value(capacity, rows, true);
+                value.sequence(7, 0, rows);
+                require(value.complete() == (rows <= capacity), "logical batch boundary was not preserved");
+            }
+        }
+        server_prefill_batch_contract gap(512, 8, true);
+        gap.sequence(0, 0, 3); gap.sequence(1, 4, 4);
+        require(!gap.complete(), "unowned gap between verification spans was admitted");
+        server_prefill_batch_contract overlap(512, 8, true);
+        overlap.sequence(0, 0, 4); overlap.sequence(1, 3, 4);
+        require(!overlap.complete(), "overlapping sequence outputs were admitted");
+        server_prefill_batch_contract truncated(512, 8, true);
+        truncated.sequence(0, 0, 7);
+        require(!truncated.complete(), "unaccounted generated row was admitted");
+        server_prefill_batch_contract overflow(512, 8, true);
+        overflow.sequence(0, 0, UINT64_MAX);
+        require(!overflow.complete(), "overflowed proposal span was admitted");
+        server_prefill_batch_contract zero(512, 8, true);
+        zero.sequence(0, 0, 0);
+        require(!zero.complete(), "zero-length sequence was admitted");
+        const auto a = workload(0, 1, 2, 6);
+        require(a == workload(0, 1, 2, 6) && a != workload(0, 1, 6, 2) && a != workload(0, 2, 2, 6),
+            "equal row totals concealed changed sequence ownership/proposal shapes");
+
+        server_prefill_budget budget;
+        budget.reset(100);
+        budget.select_workload(a);
+        budget.observe(200, 8, 0, true); budget.observe(200, 8, 0, true);
+        budget.observe(500, 8, 64, true); budget.observe(500, 8, 64, true);
+        auto plan = budget.plan(512, 8, 1, true);
+        require(plan.deferred, "warm verification contention did not engage adaptation");
+        uint32_t consumed = 0;
+        for (int i = 0; i < 20; ++i) {
+            budget.select_workload(a);
+            plan = budget.plan(512, 8, 1, true);
+            if (!plan.deferred) {
+                require(plan.prompt_rows >= 32 && plan.prompt_rows <= 504, "prompt slice crossed intact verification span");
+                consumed += plan.prompt_rows;
+            }
+        }
+        require(consumed == 10 * 32, "verification fairness starved or duplicated pending prompt rows");
+        budget.select_workload(workload(0, 1, 6, 2));
+        plan = budget.plan(512, 8, 1, true);
+        require(!plan.deferred && !plan.chunked && budget.pure_latency_us() == 0,
+            "changed proposal lengths reused a different workload's learned latency");
+        budget.select_workload(workload(0, 2, 6, 2));
+        require(!budget.under_pressure(), "canceled/replaced sequence retained stale pressure");
+        std::puts("PREFILL_BATCH_CONTRACT whole_verification_spans=1 contiguous_ownership=1 overflow_safe=1 proposal_shape_reset=1 cancellation_owner_reset=1 prompt_progress=1 logical_limits_preserved=1 PASS");
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        return 1;
+    }
+}
