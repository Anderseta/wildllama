diff --git a/src/llama-execution-plan.h b/src/llama-execution-plan.h
new file mode 100644
--- /dev/null
+++ b/src/llama-execution-plan.h
@@ -0,0 +1,133 @@
+#pragma once
+
+#include "llama-graph-variant-policy.h"
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+// Backend-independent selection of already-supported exact graph plans. This
+// learns host graph-preparation cost from real work; it does not time GPU work,
+// run a second inference, alter kernels, pad batches, or grant extra memory.
+namespace llama_execution_plan {
+using shape = llama_graph_variant_policy::prefill_shape;
+
+class policy {
+    struct observation {
+        shape key = {};
+        uint64_t last = 0;
+        uint32_t uses = 0;
+        uint32_t preparation_us = 0;
+        uint64_t last_prepared = 0;
+        bool occupied = false;
+    };
+    std::array<observation, 16> observations = {};
+    uint64_t clock = 0;
+    size_t last_observation = 0;
+
+    const observation * find(const shape & key) const {
+        for (const auto & item : observations) {
+            if (item.occupied && item.key == key) { return &item; }
+        }
+        return nullptr;
+    }
+
+    static bool valid(const shape & key) {
+        return key.tokens && key.tokens <= llama_graph_variant_policy::max_tokens &&
+            key.outputs <= key.tokens && key.sequences && key.sequences <= key.tokens;
+    }
+
+    uint64_t value(const observation & item, size_t bytes) const {
+        // Cost saved per bounded unit of retained memory. Aging is in workload
+        // observations, not wall time, so a sleeping laptop does not lose its
+        // useful plan. Long-running contexts cannot overflow these products.
+        const uint64_t age = (clock - item.last) / 8;
+        const uint64_t pages = bytes / 65536 + (bytes % 65536 != 0);
+        // Successful retained hits do not refresh an old timing sample. Decay
+        // confidence separately so a one-off startup/driver stall cannot pin
+        // a plan forever merely because its shape stays frequent.
+        const uint64_t sample_age = (clock - item.last_prepared) / 32;
+        const uint64_t divisor = std::max<uint64_t>(1, std::min<uint64_t>(pages, 1 << 16)) *
+            (1 + std::min<uint64_t>(age, 1 << 16)) *
+            (1 + std::min<uint64_t>(sample_age, 1 << 16));
+        return uint64_t(item.preparation_us) * std::min<uint32_t>(item.uses, 1024) / divisor;
+    }
+
+public:
+    uint64_t preserved = 0;
+    uint64_t selections = 0;
+
+    void clear() { *this = {}; }
+
+    void observe(const shape & key) {
+        if (!valid(key)) { return; }
+        if (clock == std::numeric_limits<uint64_t>::max()) { clear(); }
+        ++clock;
+        auto & recent = observations[last_observation];
+        if (recent.occupied && recent.key == key) {
+            recent.last = clock;
+            recent.uses = std::min<uint32_t>(recent.uses + 1, 1024);
+            return;
+        }
+        observation * selected = nullptr;
+        for (auto & item : observations) {
+            if (item.occupied && item.key == key) { selected = &item; break; }
+            if (!selected || !item.occupied || (selected->occupied && item.last < selected->last)) {
+                selected = &item;
+            }
+        }
+        if (!selected->occupied || !(selected->key == key)) { *selected = {key, 0, 0, 0, 0, true}; }
+        selected->last = clock;
+        selected->uses = std::min<uint32_t>(selected->uses + 1, 1024);
+        last_observation = size_t(selected - observations.data());
+    }
+
+    // Only successful original graph construction supplies this measurement.
+    // No synchronization/event is inserted to obtain it. The bounded EWMA
+    // prevents a single slow driver/host episode from dominating indefinitely.
+    void prepared(const shape & key, int64_t elapsed_us) {
+        if (elapsed_us <= 0 || elapsed_us > 60 * 1000000) { return; }
+        for (auto & item : observations) {
+            if (!item.occupied || !(item.key == key)) { continue; }
+            const auto sample = uint32_t(elapsed_us);
+            item.preparation_us = item.preparation_us ?
+                uint32_t((uint64_t(item.preparation_us) * 3 + sample) / 4) : sample;
+            item.last_prepared = clock;
+            return;
+        }
+    }
+
+    // Prefer the original LRU decision when measurements are missing. Where
+    // both plans have been observed, keep a frequently reused expensive plan
+    // instead of replacing it for a one-off shape. This changes retention only;
+    // the complete native can_reuse check still decides actual compatibility.
+    bool replace(const shape & candidate, const shape & resident, size_t resident_bytes) {
+        ++selections;
+        const auto * next = find(candidate);
+        const auto * old = find(resident);
+        if (!next || !old || !old->preparation_us || old->uses < 3 || clock - old->last > 32) { return true; }
+        if (next->uses < 2) { ++preserved; return false; }
+        if (!next->preparation_us) { return true; }
+        // Candidate size is unknown until preflight. Compare at the resident's
+        // current charge; never pretend this predicts a device allocation.
+        if (value(*next, resident_bytes) < value(*old, resident_bytes)) {
+            ++preserved; return false;
+        }
+        return true;
+    }
+
+    // Among inactive owners, select the lowest measured rebuild saving per
+    // byte. Unknown measurements preserve the caller's original LRU ordering.
+    bool prefer_victim(const shape & candidate, size_t candidate_bytes,
+                       const shape & previous, size_t previous_bytes) const {
+        const auto * a = find(candidate);
+        const auto * b = find(previous);
+        return a && b && a->preparation_us && b->preparation_us &&
+            value(*a, candidate_bytes) < value(*b, previous_bytes);
+    }
+};
+
+static_assert(sizeof(policy) <= 2048, "execution planning must remain bounded host metadata");
+}
