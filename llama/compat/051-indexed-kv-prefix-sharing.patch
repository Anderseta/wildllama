diff --git a/src/llama-kv-cell-range.h b/src/llama-kv-cell-range.h
new file mode 100644
--- /dev/null
+++ b/src/llama-kv-cell-range.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include "llama.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+
+// Remove only indexed memberships in [p0,p1), preserving the legacy lowest
+// physically freed cell as the next placement hint. Erase invalidates only the
+// current std::set iterator, so advance before the cell updates its own index.
+template <typename Cells>
+uint32_t llama_kv_seq_rm_indexed(Cells & cells, llama_seq_id sequence,
+        llama_pos p0, llama_pos p1, uint32_t * visited = nullptr) {
+    if (p0 < 0) { p0 = 0; }
+    if (p1 < 0) { p1 = std::numeric_limits<llama_pos>::max(); }
+    const auto & positions = cells.seq_pos_get(sequence);
+    auto position = positions.lower_bound({p0, 0});
+    uint32_t first_free = cells.size();
+    while (position != positions.end() && position->first < p1) {
+        const uint32_t index = position->second;
+        ++position;
+        if (visited) { ++*visited; }
+        if (cells.seq_rm(index, sequence)) { first_free = std::min(first_free, index); }
+    }
+    return first_free;
+}
diff --git a/src/llama-prefix-retention-policy.h b/src/llama-prefix-retention-policy.h
new file mode 100644
--- /dev/null
+++ b/src/llama-prefix-retention-policy.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+// Extra alias bookkeeping is optional. Keep the original four-entry/logical
+// token admission available, and bound newly admitted alias metadata separately.
+// Charges include a conservative set-node/allocator allowance, not process RSS.
+struct llama_prefix_retention_policy {
+    static constexpr uint32_t max_entries = 32;
+    static constexpr uint32_t legacy_entries = 4;
+    static constexpr size_t metadata_limit = 1024 * 1024;
+    static constexpr size_t registry_charge = 1024;
+    static constexpr size_t state_charge = 128;
+    static constexpr size_t reference_charge = 128;
+};
+
+inline size_t llama_prefix_extra_metadata_bytes(uint64_t references, uint32_t entries) {
+    using limits = llama_prefix_retention_policy;
+    if (entries > limits::max_entries || references >
+            (std::numeric_limits<size_t>::max() - limits::registry_charge -
+             size_t(entries) * limits::state_charge) / limits::reference_charge) {
+        return std::numeric_limits<size_t>::max();
+    }
+    return limits::registry_charge + size_t(entries) * limits::state_charge +
+        size_t(references) * limits::reference_charge;
+}
+
+inline bool llama_prefix_extra_metadata_admit(uint64_t references, uint32_t entries) {
+    return llama_prefix_extra_metadata_bytes(references, entries) <=
+        llama_prefix_retention_policy::metadata_limit;
+}
