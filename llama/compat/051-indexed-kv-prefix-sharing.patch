+static void benchmark_indexed_prefix(llama_model * model) {
+    constexpr int loops = 256, warmups = 32;
+    for (uint32_t capacity : {256u, 16384u, 65536u}) {
+        auto ctx = make_context(model, true, capacity), reference = make_context(model);
+        const auto prompt = pattern(64);
+        decode(ctx.get(), prompt, 0); decode(reference.get(), prompt, 0);
+        auto retain = [&] {
+            auto handle = llama_memory_prefix_retain(ctx.get(), 0, 1024);
+            require(handle && handle->valid() && handle->n_tokens() == 64, "benchmark retain failed");
+        };
+        for (int i = 0; i < warmups; ++i) { retain(); }
+        const auto retain_start = std::chrono::steady_clock::now();
+        for (int i = 0; i < loops; ++i) { retain(); }
+        const double retain_us = std::chrono::duration<double, std::micro>(
+            std::chrono::steady_clock::now()-retain_start).count()/loops;
+        auto handle = llama_memory_prefix_retain(ctx.get(), 0, 1024);
+        require(handle && handle->valid(), "benchmark restore handle missing");
+        for (int i = 0; i < warmups; ++i) {
+            require(llama_memory_prefix_restore(ctx.get(), handle, 0), "benchmark restore warmup failed");
+        }
+        const auto restore_start = std::chrono::steady_clock::now();
+        for (int i = 0; i < loops; ++i) {
+            require(llama_memory_prefix_restore(ctx.get(), handle, 0), "benchmark restore failed");
+        }
+        const double restore_us = std::chrono::duration<double, std::micro>(
+            std::chrono::steady_clock::now()-restore_start).count()/loops;
+        require(llama_n_ctx(ctx.get()) == capacity && handle->n_tokens() == 64,
+            "benchmark changed context/prefix capacity");
+        equal_logits(decode(ctx.get(), {189}, 64), decode(reference.get(), {189}, 64));
+        std::printf("PREFIX_INDEX_BENCH capacity=%u prefix=64 loops=%d retain_release_us=%.6f restore_us=%.6f logits_preserved=1\n",
+            capacity, loops, retain_us, restore_us);
+    }
+}
