+static void bounded_shared_registry(llama_model * model) {
+    auto ctx = make_context(model), reference = make_context(model);
+    const auto initial = pattern(8);
+    decode(ctx.get(), initial, 0);
+    std::vector<std::shared_ptr<llama_memory_prefix>> handles;
+    auto first = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    require(first && first->valid(), "initial indexed prefix missing");
+    auto duplicate = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    require(duplicate.get() == first.get(), "identical physical mapping duplicated alias metadata");
+    handles.push_back(std::move(first)); duplicate.reset();
+    for (int i = 1; i < 32; ++i) {
+        decode(ctx.get(), {llama_token(90+i)}, 7+i);
+        auto handle = llama_memory_prefix_retain(ctx.get(), 0, 64);
+        require(handle && handle->valid() && handle->n_tokens() == uint32_t(8+i),
+            "shared physical prefixes were charged repeatedly or old four-entry cap retained");
+        handles.push_back(std::move(handle));
+    }
+    decode(ctx.get(), {155}, 39);
+    require(!llama_memory_prefix_retain(ctx.get(), 0, 64), "32-alias registry bound exceeded");
+    handles.front().reset();
+    auto recycled = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    require(recycled && recycled->valid(), "released alias slot was not reused");
+    require(!llama_memory_prefix_retain(ctx.get(), 0, 39), "dedup bypassed per-prefix token bound");
+    require(llama_memory_prefix_restore(ctx.get(), handles[12], 0), "overlapping middle prefix restore failed");
+    // Match the original arithmetic schedule: CUDA prefill GEMM and successive
+    // one-token GEMV are not interchangeable floating-point reference paths.
+    decode(reference.get(), initial, 0);
+    for (int i = 1; i <= 12; ++i) { decode(reference.get(), {llama_token(90+i)}, 7+i); }
+    const auto * cache = dynamic_cast<const llama_kv_cache *>(llama_get_memory(ctx.get()));
+    const auto * reference_cache = dynamic_cast<const llama_kv_cache *>(llama_get_memory(reference.get()));
+    require(cache && reference_cache, "shared-registry metadata proof requires ordinary KV");
+    const auto & cells = cache->get_cells(0);
+    const auto & reference_cells = reference_cache->get_cells(0);
+    require(cells.size() == 256 && reference_cells.size() == 256 &&
+        cells.seq_pos_get(0) == reference_cells.seq_pos_get(0), "shared-registry restore changed physical prefix mapping");
+    for (const auto & position : cells.seq_pos_get(0)) {
+        const auto index = position.second;
+        const auto & actual = cells.ext_get(index); const auto & expected = reference_cells.ext_get(index);
+        require(cells.pos_get(index) == reference_cells.pos_get(index) &&
+            cells.get_shift(index) == reference_cells.get_shift(index) &&
+            actual.x == expected.x && actual.y == expected.y && actual.tok == expected.tok,
+            "shared-registry restore changed prefix token/spatial/shift metadata");
+    }
+    equal_logits(decode(ctx.get(), {177}, 20), decode(reference.get(), {177}, 20), "shared-registry-restore");
+    require(llama_n_ctx(ctx.get()) == 256, "extended alias sharing changed logical context");
+    ctx.reset();
+    for (const auto & handle : handles) { require(!handle || !handle->valid(), "alias survived owner destruction"); }
+    require(!recycled->valid(), "recycled alias survived owner destruction");
+    std::puts("PREFIX_SHARED_REGISTRY aliases=32 initial_physical_cells=39 final_physical_cells=40 duplicate_alias_avoided=1 slot_recycled=1 logits_preserved=1 PASS");
+}
