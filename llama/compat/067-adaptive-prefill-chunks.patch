+static void chunks() {
+    server_prefill_budget value;
+    auto plan = value.plan(512, 1, 1, true);
+    require(!plan.deferred && !plan.chunked && plan.prompt_rows == 511,
+            "cold controller changed prompt batch size");
+    value.observe(1000, 1, 0, true); value.observe(1000, 1, 0, true);
+    value.observe(10000, 1, 511, true); value.observe(10000, 1, 511, true);
+    plan = value.plan(512, 1, 1, true);
+    require(!plan.deferred && plan.chunked && plan.prompt_rows == 32,
+            "learned prompt slice did not replace an avoidable whole-round deferral");
+    uint32_t processed = 0;
+    for (int i = 0; i < 24; ++i) {
+        plan = value.plan(512, 1, 1, true);
+        require(!plan.deferred && plan.chunked && plan.prompt_rows >= 32 && plan.prompt_rows <= 511,
+                "bounded affordable prompt slices did not make progress every round");
+        processed += plan.prompt_rows;
+        value.observe(1000 + int64_t(plan.prompt_rows) * 18, 1, plan.prompt_rows, true);
+    }
+    require(processed == 24 * 32 && value.stats().chunked_admissions == 25,
+            "prompt-row conservation or chunk accounting changed");
+    plan = value.plan(512, 1, 0, true);
+    require(!plan.deferred && !plan.chunked && plan.prompt_rows == 511,
+            "finished contention retained a prompt slice");
+    // A stricter-than-generation objective cannot be met by any prompt size.
+    // Keep the throughput floor and old alternating fairness fallback.
+    value.reset(100);
+    value.observe(200, 1, 0, true); value.observe(200, 1, 0, true);
+    value.observe(500, 1, 64, true); value.observe(500, 1, 64, true);
+    plan = value.plan(512, 1, 1, true);
+    require(plan.deferred && plan.prompt_rows == 0, "unreachable objective was treated as satisfied");
+    plan = value.plan(512, 1, 1, true);
+    require(!plan.deferred && plan.chunked && plan.prompt_rows == 32,
+            "unreachable objective starved prompt progress or dropped throughput floor");
+    plan = value.plan(512, 1, 1, false, true);
+    require(!plan.deferred && !plan.chunked && plan.prompt_rows == 511 && !value.under_pressure(),
+            "transient reservation used a stale prompt-row estimate");
+    value.observe(200, 1, 0, true); value.observe(200, 1, 0, true);
+    value.observe(500, 1, 64, true); value.observe(500, 1, 64, true);
+    value.reservation_changed();
+    plan = value.plan(512, 1, 1, true);
+    require(!plan.deferred && !plan.chunked, "changed reservation retained the old prompt-row model");
+    value.observe(500, 1, 64, true); value.observe(500, 1, 64, true);
+    plan = value.plan(512, 2, 1, true);
+    require(!plan.deferred && !plan.chunked && plan.prompt_rows == 510,
+            "changed generation rows reused the old prompt-row model");
+    plan = value.plan(1, 1, 1, true);
+    require(!plan.deferred && !plan.chunked && plan.prompt_rows == 0, "full generation batch admitted prompt rows");
+    // Exercise extreme legal sizes without overflowing latency arithmetic.
+    value.reset(60000000);
+    value.observe(1, 1, 0, true); value.observe(1, 1, 0, true);
+    value.observe(60000000, 1, 1, true); value.observe(60000000, 1, 1, true);
+    plan = value.plan(UINT32_MAX, 1, 1, true);
+    require(!plan.deferred && !plan.chunked && plan.prompt_rows == UINT32_MAX - 1,
+            "samples inside the maximum target spuriously triggered adaptation");
+    value.reset(1000);
+    value.observe(1, 1, 0, true); value.observe(1, 1, 0, true);
+    value.observe(60000000, 1, 1, true); value.observe(60000000, 1, 1, true);
+    for (int i = 0; i < 3; ++i) {
+        plan = value.plan(UINT32_MAX, 1, 1, true);
+        require(plan.prompt_rows <= UINT32_MAX - 1 && (plan.deferred || plan.prompt_rows == 32),
+                "extreme latency/capacity overflowed bounded prompt admission");
+    }
+    std::puts("ADAPTIVE_PREFILL_CHUNKS measured_row_cost=1 power_of_two_slices=1 throughput_floor=32 bounded_progress=1 configured_batch_unchanged=1 isolated_unchanged=1 unreachable_target_fair=1 reservation_reset=1 row_change_reset=1 arithmetic_bounded=1 PASS");
+}
