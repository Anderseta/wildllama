+    require(cache.alloc(make_prompt({1,3}), make_data(300)), "second fixture snapshot failed");
+    cache.adaptive_ram = true;
+    // OS availability rises when old snapshots are released. Only 512 bytes
+    // remain available to this optional cache above the 512 MiB reserve.
+    cache.memory_probe = [&]() { return server_prefix_ram_info{512*mib + 512 - cache.size(), gib, true}; };
