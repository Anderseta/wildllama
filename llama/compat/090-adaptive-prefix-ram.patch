diff --git a/tools/server/server-prefix-ram-budget.h b/tools/server/server-prefix-ram-budget.h
new file mode 100644
--- /dev/null
+++ b/tools/server/server-prefix-ram-budget.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <limits>
+
+struct server_prefix_ram_info {
+    size_t available = 0;
+    size_t total = 0;
+    bool known = false;
+};
+
+// This is an admission ceiling for optional cached snapshots, not a process
+// memory limit. Live model/KV state is never discarded by this policy.
+inline size_t server_prefix_ram_budget(size_t configured, size_t held,
+        server_prefix_ram_info memory) {
+    const size_t unlimited = std::numeric_limits<size_t>::max();
+    const size_t ceiling = configured ? configured : unlimited;
+    if (!memory.known || !memory.total || memory.available > memory.total) { return ceiling; }
+    constexpr size_t mib = 1024ull * 1024ull;
+    const size_t reserve = std::min(size_t(2048 * mib), std::max(size_t(512 * mib), memory.total / 20));
+    size_t effective;
+    if (memory.available >= reserve) {
+        const size_t extra = memory.available - reserve;
+        effective = extra > unlimited - held ? unlimited : held + extra;
+    } else {
+        const size_t shortfall = reserve - memory.available;
+        effective = held > shortfall ? held - shortfall : 0;
+    }
+    return std::min(ceiling, effective);
+}
+
+server_prefix_ram_info server_prefix_system_ram();
