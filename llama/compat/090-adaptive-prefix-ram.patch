+
+server_prefix_ram_info server_prefix_system_ram() {
+#ifdef _WIN32
+    MEMORYSTATUSEX status = {};
+    status.dwLength = sizeof(status);
+    if (GlobalMemoryStatusEx(&status)) {
+        return { size_t(status.ullAvailPhys), size_t(status.ullTotalPhys), true };
+    }
+#elif defined(__linux__)
+    // MemFree alone ignores reclaimable page cache and would over-evict.
+    if (FILE * file = std::fopen("/proc/meminfo", "r")) {
+        unsigned long long available = 0, total = 0;
+        bool have_available = false;
+        char line[256];
+        while (std::fgets(line, sizeof(line), file)) {
+            if (std::sscanf(line, "MemAvailable: %llu kB", &available) == 1) { have_available = true; }
+            std::sscanf(line, "MemTotal: %llu kB", &total);
+        }
+        std::fclose(file);
+        if (have_available && total && total <= SIZE_MAX / 1024 && available <= total) {
+            return { size_t(available * 1024), size_t(total * 1024), true };
+        }
+    }
+#elif defined(__APPLE__)
+    uint64_t total = 0;
+    size_t length = sizeof(total);
+    vm_statistics64_data_t statistics = {};
+    mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+    vm_size_t page_size = 0;
+    const mach_port_t host = mach_host_self();
+    const bool ok = sysctlbyname("hw.memsize", &total, &length, nullptr, 0) == 0 &&
+        host_page_size(host, &page_size) == KERN_SUCCESS &&
+        host_statistics64(host, HOST_VM_INFO64, reinterpret_cast<host_info64_t>(&statistics), &count) == KERN_SUCCESS;
+    mach_port_deallocate(mach_task_self(), host);
+    if (ok && total && total <= SIZE_MAX) {
+        const uint64_t pages = uint64_t(statistics.free_count) + statistics.inactive_count;
+        if (page_size && pages <= total / page_size) {
+            return { size_t(pages * page_size), size_t(total), true };
+        }
+    }
+#endif
+    return {};
+}
 
