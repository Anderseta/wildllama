+    require(server_prefix_ram_budget(8*gib, 0, {2*gib, gib, true}) == 8*gib, "invalid probe changed ceiling");
+    require(server_prefix_ram_budget(8*gib, unlimited, {unlimited, unlimited, true}) == 8*gib,
+            "budget arithmetic overflowed");
