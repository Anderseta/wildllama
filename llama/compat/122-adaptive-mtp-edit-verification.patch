diff --git a/common/mtp-edit-lookup.h b/common/mtp-edit-lookup.h
new file mode 100644
index 0000000..91f19e9
--- /dev/null
+++ b/common/mtp-edit-lookup.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Immutable, request-local source. A collision can only miss an opportunity:
+// check every anchor token before using its continuation as a draft.
+class common_mtp_edit_lookup {
+    using tokens = std::vector<int32_t>;
+    static constexpr size_t anchor = 6;
+    static constexpr size_t slots = 8192;
+    static constexpr size_t limit = 32768;
+    std::vector<uint16_t> offsets;
+    tokens source;
+
+    template<class At> static size_t bucket(At at) {
+        uint32_t hash = 2166136261u;
+        for (size_t i = 0; i < anchor; ++i) { hash = (hash ^ uint32_t(at(i))) * 16777619u; }
+        return hash % slots;
+    }
+
+public:
+    void begin(const tokens & prompt) {
+        offsets.clear();
+        source.clear();
+        if (prompt.size() < anchor + 2) { return; }
+        const size_t count = std::min(limit, prompt.size());
+        source.assign(prompt.end() - count, prompt.end());
+        offsets.assign(slots, 0);
+        for (size_t end = anchor; end + 2 <= count; ++end) {
+            offsets[bucket([&](size_t i) { return source[end - anchor + i]; })] = uint16_t(end);
+        }
+    }
+
+    bool propose(const tokens & history, int32_t last, size_t maximum, tokens & result) const {
+        if (maximum < 2 || offsets.empty() || history.size() < anchor - 1 || !result.empty()) { return false; }
+        const auto at = [&](size_t i) {
+            return i == anchor - 1 ? last : history[history.size() - (anchor - 1) + i];
+        };
+        const size_t end = offsets[bucket(at)];
+        if (end == 0) { return false; }
+        for (size_t i = 0; i < anchor; ++i) {
+            if (source[end - anchor + i] != at(i)) { return false; }
+        }
+        const size_t count = std::min(maximum, source.size() - end);
+        result.assign(source.begin() + end, source.begin() + end + count);
+        return true;
+    }
+};
