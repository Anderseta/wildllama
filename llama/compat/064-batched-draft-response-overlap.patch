+        ticket.discard([&](const auto &,size_t){++cleaned;});
+        require(cleaned==32 && !ticket.pending() && ticket.discarded==1,"rollback repeated or dropped a sequence");
+        require(ticket.begin(owners.data(),2),"drained ticket not reusable");
+        ticket.commit([](const auto &){return true;});
+        require(ticket.consumed==1 && !ticket.pending(),"batch was not consumed once");
+
+        server_response_overlap responses;
+        std::vector<server_response_overlap::entry> published;
+        for(size_t i=0;i<128;++i) {
+            require(responses.add({int32_t(i%2),int32_t(100+i%2),int32_t(i),i,1,int64_t(i/2+2)}),"bounded partial rejected early");
+        }
+        require(!responses.add({0,100,1000,128,1,70}),"partial entry cap ignored");
+        bool injected=false;
+        try {responses.flush([&](const auto & value){
+            if(value.token==17 && !injected) {injected=true;throw std::runtime_error("injected publish failure");}
+            published.push_back(value);
+        });} catch(const std::runtime_error &) {}
+        require(published.size()==17 && responses.count()==111,"failed publish lost or duplicated its tail");
+        responses.flush([&](const auto & value){published.push_back(value);});
+        require(responses.empty() && published.size()==128,"retry failed to publish complete tail");
+        for(size_t i=0;i<published.size();++i) {
+            const auto & value=published[i];
+            require(value.token==int32_t(i) && value.offset==i && value.decoded==int64_t(i/2+2) &&
+                value.task==100+value.slot,"partial order, captured count or task identity changed");
+        }
+        require(responses.add({0,100,2,0,65536,2}),"text span limit rejected");
+        require(!responses.add({0,100,3,65536,1,3}),"text span cap ignored");
+        responses.flush([](const auto &){});
+        require(!responses.add({0,100,3,0,65537,3}),"oversized partial admitted");
+        // Withheld stop/UTF-8 suffixes remain owned by the slot. Descriptors
+        // reference only ranges already selected for publication.
+        std::string generated="O";
+        require(responses.add({0,100,4,0,1,2}),"ASCII partial rejected");
+        generated.push_back(char(0xc3)); // incomplete byte: no published span
+        generated.push_back(char(0xa1));
+        require(responses.add({0,100,5,1,2,4}),"completed UTF-8 span rejected");
+        generated+="<STOP"; // withheld delimiter subsequently removed
+        generated.resize(3);
+        std::string text;
+        std::vector<int64_t> counts;
+        responses.flush([&](const auto & value){text+=generated.substr(value.offset,value.size);counts.push_back(value.decoded);});
+        require(text==std::string("O\xc3\xa1") && counts==std::vector<int64_t>{2,4},"withheld suffix corrupted captured UTF-8/count spans");
+
+        server_prepared_draft prepared;
+        prepared.mark(100,31,7);
+        require(prepared.matches(100,31,7) && !prepared.matches(101,31,7),"prepared draft crossed request identity");
+        require(prepared.consume(100,31,7) && !prepared.consume(100,31,7),"prepared draft accounted twice");
+        prepared.mark(100,31,7);
+        require(!prepared.consume(100,32,7) && !prepared.matches(100,31,7),"changed prompt reused stale draft");
+        prepared.mark(100,31,7);prepared.clear();
+        require(!prepared.consume(100,31,7),"reset retained early draft");
