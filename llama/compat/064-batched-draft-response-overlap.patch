+#include "../tools/server/server-batch-overlap.h"
+#include <cstdio>
+#include <stdexcept>
+#include <vector>
+#include <string>
+
+static void require(bool valid,const char * message) {if(!valid) {throw std::runtime_error(message);}}
+
+int main() {
+    try {
+        server_batch_overlap ticket;
+        std::array<server_batch_overlap::checkpoint,32> owners{};
+        for(size_t i=0;i<owners.size();++i) {owners[i]={int32_t(i),int32_t(100+i),int32_t(40+i),40+i};}
+        require(!ticket.begin(owners.data(),33) && !ticket.pending(),"oversized ticket admitted");
+        owners[1].slot=0;
+        require(!ticket.begin(owners.data(),2),"duplicate sequence admitted"); owners[1].slot=1;
+        require(ticket.begin(owners.data(),owners.size()),"32-sequence ticket rejected");
+        require(ticket.matches(31,131) && !ticket.matches(31,132),"cross-request ownership changed");
+        bool denied=false;
+        try {ticket.commit([](const auto & owner){return owner.slot!=12;});} catch(const std::logic_error &) {denied=true;}
+        require(denied && ticket.count()==32 && ticket.consumed==0,"failed validation consumed live work");
