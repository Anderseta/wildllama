+        try {ticket.discard([&](const auto & owner,size_t index){
+            require(owner.slot==int32_t(index),"rollback reordered per-slot checkpoints");
+            if(index==12) {throw std::runtime_error("injected drain failure");} ++cleaned;
+        });} catch(const std::runtime_error &) {}
