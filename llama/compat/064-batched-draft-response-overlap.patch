+#pragma once
+
+#include "server-decode-overlap.h"
+#include <array>
+#include <algorithm>
+#include <stdexcept>
+
+class server_batch_overlap {
+public:
+    static constexpr size_t limit = 32;
+    using checkpoint = server_decode_overlap::checkpoint;
+    bool pending() const { return count_ != 0; }
+    size_t count() const { return count_; }
+    const checkpoint & owner(size_t index) const { return owners.at(index); }
+    bool matches(int32_t slot, int32_t task) const {
+        for (size_t i=0; i<count_; ++i) { if (owners[i].slot==slot && owners[i].task==task) { return true; } }
+        return false;
+    }
+    bool begin(const checkpoint * values, size_t count) {
+        if (pending() || !values || !count || count>limit) { return false; }
+        for (size_t i=0; i<count; ++i) {
+            if (values[i].slot<0 || values[i].task<0 || values[i].position<0) { return false; }
+            for (size_t j=0; j<i; ++j) { if (values[i].slot==values[j].slot) { return false; } }
+        }
+        std::copy_n(values,count,owners.begin()); count_=count; ++queued;
+        return true;
+    }
+    template<class Validate> void commit(Validate validate) {
+        if (!pending()) { throw std::logic_error("batch overlap has no owner"); }
+        for(size_t i=0;i<count_;++i) { if(!validate(owners[i])) { throw std::logic_error("batch overlap owner changed"); } }
+        count_=0; ++consumed;
+    }
+    template<class Cleanup> void discard(Cleanup cleanup) {
+        // Keep uncompleted ownership on failure, rather than forgetting live KV.
+        while (count_) { cleanup(owners[count_-1],count_-1); --count_; }
+        ++discarded;
+    }
+    uint64_t queued=0,consumed=0,discarded=0;
+private:
+    size_t count_=0;
+    std::array<checkpoint,limit> owners{};
+};
+
+// Offsets refer to already accepted text owned by a live slot. There are no
+// borrowed sampler outputs or unverified tokens in this bounded queue.
+class server_response_overlap {
+public:
+    struct entry {
+        int32_t slot,task,token;
+        size_t offset,size;
+        int64_t decoded;
+    };
+    static constexpr size_t limit=128, text_limit=64*1024;
+    bool empty() const { return count_==0; }
+    bool add(entry value) {
+        if(count_==limit || value.size>text_limit-text_bytes_) { return false; }
+        entries[count_++]=value; text_bytes_+=value.size; return true;
+    }
+    template<class Publish> void flush(Publish publish) {
+        // Remove only after publication: a throwing publisher retains its
+        // unsent tail for the enclosing error/reset path.
+        while (sent_<count_) { publish(entries[sent_]); ++sent_; }
+        count_=sent_=text_bytes_=0;
+    }
+    size_t count() const { return count_-sent_; }
+private:
+    size_t count_=0,sent_=0,text_bytes_=0;
+    std::array<entry,limit> entries{};
+};
+
+class server_prepared_draft {
+public:
+    void mark(int32_t task,int32_t position,int32_t token) { task_=task;position_=position;token_=token; }
+    bool matches(int32_t task,int32_t position,int32_t token) const {
+        return task_>=0 && task_==task && position_==position && token_==token;
+    }
+    bool consume(int32_t task,int32_t position,int32_t token) {
+        const bool ready=matches(task,position,token);clear();return ready;
+    }
+    void clear() {task_=-1;}
+private:
+    int32_t task_=-1,position_=0,token_=0;
+};
