+static llama_kv_cache * cache(llama_context * ctx) {
+    auto * memory = llama_get_memory(ctx);
+    if (auto * kv = dynamic_cast<llama_kv_cache *>(memory)) { return kv; }
+    auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory);
+    require(hybrid, "unexpected compute-growth memory type"); return hybrid->get_mem_attn();
+}
+
+static std::vector<float> decode(llama_context * ctx, int position, int count) {
+    auto b = llama_batch_init(count, 0, 1); b.n_tokens = count;
+    for (int i = 0; i < count; ++i) {
+        b.token[i] = 3 + ((position + i) * 13) % 256; b.pos[i] = position + i;
+        b.n_seq_id[i] = 1; b.seq_id[i][0] = 0; b.logits[i] = i + 1 == count;
+    }
+    const int status = llama_decode(ctx, b); llama_batch_free(b);
+    require(status == 0, "compute-growth decode failed"); llama_synchronize(ctx);
+    if (gpu) {
+        llama_gpu_execution_stats stats{};
+        require(llama_gpu_execution_stats_get(ctx, &stats) && stats.gpu_heavy_ops_submitted > 0 && stats.cpu_heavy_ops_submitted == 0,
+            "compute-growth fixture silently used CPU heavy arithmetic");
+    }
+    const auto * values = llama_get_logits_ith(ctx, -1); require(values, "compute-growth logits missing");
+    return {values, values + 259};
+}
+static void identical(const std::vector<float> & a, const std::vector<float> & b) {
+    require(a.size() == b.size() && std::memcmp(a.data(), b.data(), a.size() * sizeof(float)) == 0,
+        "compute reservation changed actual continuation logits");
+    for (float value : b) { require(std::isfinite(value), "compute-growth produced nonfinite logits"); }
+}
+static std::vector<uint8_t> state(llama_context * ctx) {
+    std::vector<uint8_t> result(llama_state_seq_get_size(ctx, 0));
+    require(llama_state_seq_get_data(ctx, result.data(), result.size(), 0) == result.size(), "cannot save compute-growth state");
+    return result;
+}
+
+static void growth_cases(bool hybrid, bool paged, ggml_type type) {
+    auto weights = model(hybrid);
+    auto reference = context(weights.get(), false, paged, type), candidate = context(weights.get(), true, paged, type);
+    require(cache(reference.get())->get_compute_reservation() == 1536, "disabled path lost full reservation");
+    require(cache(candidate.get())->get_compute_reservation() == 256, "initial compute floor was not bounded");
+    for (const auto & span : {std::pair<int, int>{0, 128}, {128, 128}, {256, 128}, {384, 128}, {512, 512}}) {
+        identical(decode(reference.get(), span.first, span.second), decode(candidate.get(), span.first, span.second));
+    }
+    require(cache(candidate.get())->get_compute_reservation() == 1024, "compute high-water mark did not grow before all planned microbatches");
+    const auto saved = state(candidate.get());
+    const auto after_restore = decode(reference.get(), 1024, 1);
+    identical(after_restore, decode(candidate.get(), 1024, 1));
+    require(cache(candidate.get())->get_compute_reservation() == 1536, "compute growth did not clamp to logical capacity");
+    auto restored = context(weights.get(), true, paged, type);
+    require(llama_state_seq_set_data(restored.get(), saved.data(), saved.size(), 0) == saved.size(), "cannot restore compute-growth history");
+    identical(after_restore, decode(restored.get(), 1024, 1));
+    identical(decode(candidate.get(), 1025, 1), decode(restored.get(), 1025, 1));
+    require(llama_n_ctx(candidate.get()) == 1536 && llama_n_ctx(restored.get()) == 1536, "compute growth changed logical context");
+    if (gpu) {
+        llama_gpu_memory_stats stats{};
+        require(llama_model_get_gpu_memory_stats(weights.get(), &stats) && stats.enabled &&
+            stats.limit_bytes == 192 * 1024 * 1024 && stats.managed_peak_bytes <= stats.limit_bytes,
+            "compute growth bypassed managed VRAM quota");
+    }
+    std::printf("COMPUTE_GROWTH model=%s paged=%d type=%s initial=256 final=1536 exact_logits=1 PASS\n",
+        hybrid ? "hybrid" : "dense", paged, ggml_type_name(type));
+}
+
+static void independent_and_fallback() {
+    auto weights = model(false);
+    environment("WILDLLAMA_KV_CACHE_INITIAL_TOKENS", "0");
+    { auto ctx = context(weights.get(), true, false, GGML_TYPE_F16, 16384);
+      require(cache(ctx.get())->get_compute_reservation() == 8192, "compute growth wrongly requires physical KV growth"); }
+    environment("WILDLLAMA_KV_CACHE_INITIAL_TOKENS", "256");
+    { auto ctx = context(weights.get(), true, false, GGML_TYPE_F16, 1536, false, false);
+      require(cache(ctx.get())->get_compute_reservation() == 1536, "unsupported non-FA layout did not retain full reservation"); }
+}
+
+struct fallback_log {
+    bool bounded = false;
+    bool auto_fallback = false;
+    bool mode_fallback = false;
+    static void write(enum ggml_log_level, const char * text, void * opaque) {
+        auto & record = *static_cast<fallback_log *>(opaque);
+        record.bounded |= std::strstr(text, "compute growth: reserving 256 KV rows") != nullptr;
+        record.auto_fallback |= std::strstr(text, "restoring full reservation after automatic Flash Attention fallback") != nullptr;
+        record.mode_fallback |= std::strstr(text, "restoring full reservation after mode or ownership change") != nullptr;
+        std::fputs(text, stderr);
+    }
+};
+
+static void capability_transitions() {
+    if (!gpu) {
+        // Real optimizer initialization turns FA off after this context already
+        // used its bounded reservation. Full graph reservation must be restored
+        // even though the old FA eligibility predicate is now false.
+        auto weights = model(false);
+        auto ctx = context(weights.get(), true, false, GGML_TYPE_F16);
+        decode(ctx.get(), 0, 128);
+        require(cache(ctx.get())->get_compute_reservation() == 256, "training transition fixture was not bounded");
+        const auto before = state(ctx.get());
+        fallback_log record;
+        llama_log_set(fallback_log::write, &record);
+        struct reset_log { ~reset_log() { llama_log_set(nullptr, nullptr); } } restore_log;
+        llama_opt_params options{};
+        options.n_ctx_train = 1536;
+        options.param_filter = [](const ggml_tensor *, void *) { return false; };
+        options.get_opt_pars = ggml_opt_get_default_optimizer_params;
+        options.optimizer_type = GGML_OPT_OPTIMIZER_TYPE_SGD;
+        llama_opt_init(ctx.get(), weights.get(), options);
+        require(record.mode_fallback && cache(ctx.get())->get_compute_reservation() == 1536,
+            "losing FA after context initialization kept the bounded reservation");
+        require(state(ctx.get()) == before, "full reservation fallback changed existing KV state");
+        std::puts("COMPUTE_GROWTH_FALLBACK optimizer_FA_off=1 prior_state=exact full_reservation=1536 PASS");
+    } else {
+        // Head40 is supported by the pinned CUDA tile kernel. Head48 is not;
+        // its ordinary unfused GEMM path is supported. Strict GPU mode makes
+        // the automatic FA probe reject its CPU-only fusion before execution.
+        auto weights = model(false, false, 48);
+        fallback_log record;
+        llama_log_set(fallback_log::write, &record);
+        struct reset_log { ~reset_log() { llama_log_set(nullptr, nullptr); } } restore_log;
+        auto automatic = context(weights.get(), true, false, GGML_TYPE_F16, 1536, false, true, nullptr, true);
+        require(record.bounded && record.auto_fallback && cache(automatic.get())->get_compute_reservation() == 1536,
+            "automatic FA fallback was not exercised or retained a bounded dummy context");
+        auto conventional = context(weights.get(), false, false, GGML_TYPE_F16, 1536, false, false);
+        float maximum_error = 0;
+        for (int position = 0; position < 384; position += 128) {
+            const auto expected = decode(conventional.get(), position, 128);
+            const auto actual = decode(automatic.get(), position, 128);
+            require(expected.size() == actual.size(), "auto-FA fallback changed vocabulary size");
+            // Auto FA allocated ordinary V storage before its probe disabled
+            // the fusion; explicit FA-off uses transposed V storage. Both keep
+            // F16 bytes, but different GEMM layouts need a numerical gate.
+            for (size_t i = 0; i < expected.size(); ++i) {
+                require(std::isfinite(expected[i]) && std::isfinite(actual[i]), "auto-FA fallback produced nonfinite logits");
+                maximum_error = std::max(maximum_error, std::fabs(expected[i] - actual[i]) / std::max(1.f, std::fabs(expected[i])));
+            }
+            require(maximum_error <= 2e-4f &&
+                std::max_element(expected.begin(), expected.end()) - expected.begin() ==
+                    std::max_element(actual.begin(), actual.end()) - actual.begin(),
+                "auto-FA fallback changed greedy continuation or exceeded numerical gate");
+        }
+        require(llama_memory_seq_pos_max(llama_get_memory(automatic.get()), 0) == 383,
+            "auto-FA fallback could not continue past its old compute floor");
+        std::printf("COMPUTE_GROWTH_FALLBACK automatic_FA_unsupported_head=48 actual_probe=1 unfused_CUDA_scaled_error=%.9g greedy=identical full_reservation=1536 PASS\n", maximum_error);
+    }
+}
+
+static void quota_denial(bool hybrid) {
+    if (!gpu) { return; }
+    auto weights = model(hybrid);
+    auto candidate = context(weights.get(), true, false, GGML_TYPE_F16);
+    decode(candidate.get(), 0, 256);
+    require(cache(candidate.get())->get_compute_reservation() == 256, "denial fixture already crossed initial compute floor");
+    const auto before = state(candidate.get());
+    llama_gpu_memory_stats stats{};
+    require(llama_model_get_gpu_memory_stats(weights.get(), &stats) && stats.enabled &&
+        stats.limit_bytes > stats.managed_used_bytes + 4096, "bounded compute denial quota unavailable");
+    auto * device = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+    ggml_backend_buffer_ptr filler(ggml_backend_buft_alloc_buffer(ggml_backend_dev_buffer_type(device),
+        size_t(stats.limit_bytes - stats.managed_used_bytes - 1024)));
+    require(bool(filler), "cannot allocate bounded compute denial control");
+    auto b = llama_batch_init(512, 0, 1); b.n_tokens = 512;
+    for (int i = 0; i < 512; ++i) {
+        b.token[i] = 3 + ((256 + i) * 13) % 256; b.pos[i] = 256 + i;
+        b.n_seq_id[i] = 1; b.seq_id[i][0] = 0; b.logits[i] = i == 511;
+    }
+    for (int attempt = 0; attempt < 2; ++attempt) {
+        require(llama_decode(candidate.get(), b) == -2, "compute growth unexpectedly bypassed managed quota");
+        require(state(candidate.get()) == before, "denied compute preflight changed attention/recurrent state");
+        require(llama_memory_seq_pos_max(llama_get_memory(candidate.get()), 0) == 255, "denied compute preflight advanced sequence");
+    }
+    llama_batch_free(b);
+    filler.reset();
+    decode(candidate.get(), 256, 512);
+    require(llama_memory_seq_pos_max(llama_get_memory(candidate.get()), 0) == 767, "compute retry failed after quota release");
+    require(llama_model_get_gpu_memory_stats(weights.get(), &stats) && stats.managed_peak_bytes <= stats.limit_bytes,
+        "compute denial/retry exceeded managed VRAM quota");
+    std::printf("COMPUTE_GROWTH_DENIAL model=%s repeated_denial=2 prior_state=exact retry_after_release=1 PASS\n", hybrid ? "hybrid" : "dense");
+}
+
+static void draft_ownership() {
+    auto weights = model(true, true);
+    environment("WILDLLAMA_PAGED_DRAFT", "0");
+    auto target = context(weights.get(), true, false, GGML_TYPE_F16);
+    auto conventional = context(weights.get(), true, false, GGML_TYPE_F16, 1536, true, true, target.get());
+    require(!cache(conventional.get())->get_cells(0).get_page_pool().enabled(), "disabled draft flag admitted a hybrid MTP cache");
+    environment("WILDLLAMA_PAGED_DRAFT", "1");
+    auto draft = context(weights.get(), true, false, GGML_TYPE_F16, 1536, true, true, target.get());
+    require(cache(draft.get())->get_cells(0).get_page_pool().enabled(), "independent MTP draft page flag did not admit its attention-only owner");
+    auto target_after_flag = context(weights.get(), true, false, GGML_TYPE_F16);
+    require(!cache(target_after_flag.get())->get_cells(0).get_page_pool().enabled(), "draft flag incorrectly enabled target paging");
+    environment("WILDLLAMA_PAGED_DRAFT", "0");
+
+    auto make_spec = [&](llama_context * head) {
+        common_params_speculative cfg;
+        cfg.types = {COMMON_SPECULATIVE_TYPE_DRAFT_MTP}; cfg.draft.ctx_tgt = target.get(); cfg.draft.ctx_dft = head;
+        cfg.draft.n_max = 2; cfg.draft.n_min = 0; cfg.draft.p_min = 0; cfg.draft.backend_sampling = false;
+        common_speculative_ptr result(common_speculative_init(cfg, 1));
+        require(bool(result), "cannot initialize tiny MTP catch-up"); return result;
+    };
+    auto ordinary_spec = make_spec(conventional.get()), paged_spec = make_spec(draft.get());
+    for (int position = 0; position < 260; ++position) {
+        common_batch b(target.get()); b.add(3 + (position * 13) % 256, position, 0, true);
+        require(llama_process(target.get(), LLAMA_PROCESS_TYPE_DECODE, b.get()) == 0, "tiny MTP target decode failed");
+        require(common_speculative_process(ordinary_spec.get(), b) && common_speculative_process(paged_spec.get(), b),
+            "tiny MTP head catch-up failed");
+    }
+    require(cache(draft.get())->get_compute_reservation() == 512, "MTP head did not grow its compute reservation");
+    require(cache(draft.get())->paged_reads_confirmed(), "MTP head graph did not prove paged reads");
+    llama_tokens ordinary_tokens, paged_tokens;
+    auto propose = [&](common_speculative * spec, llama_tokens & tokens) {
+        auto & p = common_speculative_get_draft_params(spec, 0);
+        p.drafting = true; p.n_max = 2; p.pos0 = 260; p.id_last = 7; p.result = &tokens;
+        common_speculative_draft(spec);
+    };
+    propose(ordinary_spec.get(), ordinary_tokens); propose(paged_spec.get(), paged_tokens);
+    require(ordinary_tokens.size() == 2 && ordinary_tokens == paged_tokens,
+        "paged MTP attention changed tiny greedy proposals");
+    std::puts("COMPUTE_GROWTH_MTP draft_flag_independent=1 attention_only_owner=1 actual_paged_reads=1 catchup_growth=1 greedy_proposals=identical PASS");
+}
+
+int main(int argc, char ** argv) {
+    try {
+        std::setvbuf(stdout, nullptr, _IONBF, 0); gpu = argc == 2 && std::strcmp(argv[1], "--cuda") == 0;
+        require(argc == 1 || gpu, "use test-compute-growth [--cuda]");
+#ifdef GGML_TEST_CPU_BACKEND_PATH
+        require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH), "cannot load isolated CPU backend");
+#endif
+        if (gpu) {
+#ifdef GGML_TEST_CUDA_BACKEND_PATH
+            require(ggml_backend_load(GGML_TEST_CUDA_BACKEND_PATH), "cannot load isolated CUDA backend");
+#else
+            std::puts("SKIP: CUDA backend not built"); return 77;
+#endif
+        }
+        environment("WILDLLAMA_KV_CACHE_INITIAL_TOKENS", "256"); environment("WILDLLAMA_KV_CACHE_PAGING", "0");
+        environment("WILDLLAMA_GRAPH_VARIANTS_MIB", "0"); environment("WILDLLAMA_PAGED_DRAFT", "0");
+        llama_backend_init();
+        for (bool hybrid : {false, true}) {
+            for (bool paged : {false, true}) {
+                for (auto type : {GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_Q8_0}) { growth_cases(hybrid, paged, type); }
+            }
+        }
+        independent_and_fallback(); capability_transitions(); draft_ownership(); quota_denial(false); quota_denial(true);
+        llama_backend_free();
+        std::printf("COMPUTE_GROWTH backend=%s model_cases=12 pretrained_models=0 downloads=0 PASS\n", gpu ? "CUDA" : "CPU"); return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr, "FAIL: %s\n", error.what()); return 1; }
+}
