diff --git a/common/checkpoint-buffer.h b/common/checkpoint-buffer.h
new file mode 100644
index 0000000..5ab887c
--- /dev/null
+++ b/common/checkpoint-buffer.h
@@ -0,0 +1,88 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include <limits>
+#include <memory>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+// Completed host checkpoints share their byte storage. Mutable vector borrows
+// are scoped to capture/restore and pager handoffs on the context owner thread;
+// they must not survive publication or another copy of this buffer.
+class common_checkpoint_buffer {
+    std::shared_ptr<std::vector<uint8_t>> storage;
+public:
+    common_checkpoint_buffer() = default;
+    common_checkpoint_buffer(std::initializer_list<uint8_t> bytes) { assign(bytes); }
+
+    const std::vector<uint8_t> & get() const noexcept {
+        static const std::vector<uint8_t> empty;
+        return storage ? *storage : empty;
+    }
+    operator const std::vector<uint8_t> &() const noexcept { return get(); }
+    size_t size() const noexcept { return get().size(); }
+    size_t capacity() const noexcept { return storage ? storage->capacity() : 0; }
+    bool empty() const noexcept { return get().empty(); }
+    const uint8_t * data() const noexcept { return get().data(); }
+    const void * identity() const noexcept { return storage.get(); }
+    bool shared() const noexcept { return storage && !storage.unique(); }
+
+    std::vector<uint8_t> & mutable_buffer() {
+        if (!storage) { storage = std::make_shared<std::vector<uint8_t>>(); }
+        else if (!storage.unique()) {
+            auto replacement = std::make_shared<std::vector<uint8_t>>(*storage);
+            storage = std::move(replacement);
+        }
+        return *storage;
+    }
+    // Capture replaces every byte, so detaching need not copy the old payload.
+    uint8_t * overwrite(size_t bytes) {
+        if (!storage || !storage.unique()) {
+            auto replacement = std::make_shared<std::vector<uint8_t>>(bytes);
+            storage = std::move(replacement);
+        } else { storage->resize(bytes); }
+        return storage->data();
+    }
+    void assign(size_t count, uint8_t value) {
+        if (!storage || !storage.unique()) {
+            auto replacement = std::make_shared<std::vector<uint8_t>>(count, value);
+            storage = std::move(replacement);
+        } else { storage->assign(count, value); }
+    }
+    void assign(std::initializer_list<uint8_t> bytes) {
+        auto replacement = std::make_shared<std::vector<uint8_t>>(bytes);
+        storage = std::move(replacement);
+    }
+    common_checkpoint_buffer & operator=(std::initializer_list<uint8_t> bytes) { assign(bytes); return *this; }
+    void clear() noexcept {
+        if (storage && storage.unique()) { storage->clear(); }
+        else { storage.reset(); }
+    }
+    void release() noexcept { storage.reset(); }
+    friend bool operator==(const common_checkpoint_buffer & a, const common_checkpoint_buffer & b) {
+        return a.get() == b.get();
+    }
+};
+
+// Logical cache charges deliberately remain per-entry. Physical RAM admission
+// counts each shared host allocation once and includes retained empty capacity.
+// Failure to allocate the tiny identity set fails closed, never inventing room.
+class common_checkpoint_memory {
+    std::unordered_set<const void *> seen;
+    size_t held = 0;
+public:
+    void add(const common_checkpoint_buffer & buffer) noexcept {
+        if (!buffer.capacity() || held == std::numeric_limits<size_t>::max()) { return; }
+        try {
+            if (seen.insert(buffer.identity()).second) {
+                const size_t bytes = buffer.capacity();
+                held = bytes > std::numeric_limits<size_t>::max() - held ?
+                    std::numeric_limits<size_t>::max() : held + bytes;
+            }
+        } catch (...) { held = std::numeric_limits<size_t>::max(); }
+    }
+    size_t bytes() const noexcept { return held; }
+};
