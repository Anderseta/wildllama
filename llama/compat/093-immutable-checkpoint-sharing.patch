+static void shared_checkpoint_ownership() {
+    auto prompt = make_prompt({1,2,3});
+    common_prompt_checkpoint checkpoint {};
+    checkpoint.n_tokens = 2;
+    checkpoint.data_tgt.assign(4096, 31);
+    checkpoint.data_dft.assign(1024, 47);
+    checkpoint.data_spec = {11,13,17};
+    const auto * target = checkpoint.data_tgt.data();
+    prompt.checkpoints.push_back(checkpoint);
+    auto cloned = prompt.clone();
+    require(cloned.checkpoints.front().data_tgt.data() == target,
