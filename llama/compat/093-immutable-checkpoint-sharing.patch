diff --git a/tests/test-checkpoint-buffer.cpp b/tests/test-checkpoint-buffer.cpp
new file mode 100644
index 0000000..576d4c2
--- /dev/null
+++ b/tests/test-checkpoint-buffer.cpp
@@ -0,0 +1,83 @@
+#include "../common/checkpoint-buffer.h"
+#include "../common/state-transaction.h"
+#include "../tools/server/server-prefix-ram-budget.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <new>
+
+static bool fail_next_allocation = false;
+void * operator new(std::size_t size) {
+    if (fail_next_allocation) { fail_next_allocation = false; throw std::bad_alloc(); }
+    if (void * value = std::malloc(size ? size : 1)) { return value; }
+    throw std::bad_alloc();
+}
+void operator delete(void * value) noexcept { std::free(value); }
+void operator delete(void * value, std::size_t) noexcept { std::free(value); }
+
+#define CHECK(condition) do { if (!(condition)) { std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #condition); std::abort(); } } while (0)
+
+int main() {
+    common_checkpoint_buffer original {1,2,3,4};
+    const auto * bytes = original.data();
+    const auto capacity = original.capacity();
+    fail_next_allocation = true;
+    auto clone = original; // a completed checkpoint clone cannot allocate/copy payload
+    CHECK(fail_next_allocation && clone.data() == bytes && original.shared());
+    fail_next_allocation = false;
+    common_checkpoint_memory held;
+    held.add(original); held.add(clone);
+    CHECK(held.bytes() == capacity);
+    CHECK(original.size() + clone.size() == 8); // configured logical charge stays per entry
+
+    fail_next_allocation = true;
+    bool failed = false;
+    try { clone.mutable_buffer()[0] = 9; } catch (const std::bad_alloc &) { failed = true; }
+    CHECK(failed && clone.data() == bytes && original.data()[0] == 1);
+    clone.mutable_buffer()[0] = 9;
+    CHECK(original.data() == bytes && original.data()[0] == 1 && clone.data()[0] == 9);
+    CHECK(clone.data() != original.data());
+    common_checkpoint_memory detached;
+    detached.add(original); detached.add(clone);
+    CHECK(detached.bytes() == original.capacity() + clone.capacity());
+
+    auto overwritten = original;
+    auto * destination = overwritten.overwrite(3);
+    destination[0] = 8; destination[1] = 7; destination[2] = 6;
+    CHECK(original.data() == bytes && original.size() == 4 && original.data()[0] == 1);
+    auto released = original;
+    released.clear();
+    CHECK(released.empty() && released.capacity() == 0 && original.data() == bytes);
+    clone.clear();
+    CHECK(clone.empty() && clone.capacity() > 0); // unique scratch retains reusable capacity
+    clone.release();
+    CHECK(clone.capacity() == 0);
+
+    common_checkpoint_buffer draft {5,6}, spec {7};
+    const common_state_view checkpoint {original, draft, spec};
+    CHECK(checkpoint.main.data() == bytes);
+    int clears = 0;
+    CHECK(!common_state_restore(checkpoint,
+        [](const uint8_t *, size_t size) { return size; },
+        [](const uint8_t *, size_t size) { return size - 1; },
+        [](const auto &) { CHECK(false); }, [&] { ++clears; }));
+    CHECK(clears == 1 && original.data() == bytes && original.data()[0] == 1);
+    CHECK(common_state_restore(checkpoint,
+        [&](const uint8_t * source, size_t size) { CHECK(source == bytes); return size; },
+        [](const uint8_t *, size_t size) { return size; },
+        [&](const auto & value) { CHECK(value == spec.get()); }, [&] { ++clears; }));
+    CHECK(clears == 1);
+
+    // Unique-capacity accounting remains valid after last-owner changes, and a
+    // failed bookkeeping allocation cannot create fictitious RAM headroom.
+    common_checkpoint_memory refused;
+    fail_next_allocation = true;
+    refused.add(original);
+    CHECK(refused.bytes() == std::numeric_limits<size_t>::max());
+    CHECK(server_prefix_ram_budget(32, 0, {0, 1024, true}) == 0);
+    auto survivor = original;
+    original.release();
+    CHECK(survivor.data() == bytes && survivor.data()[0] == 1);
+    std::puts("PASS: zero-copy checkpoint clone, unique capacity, detach/failure isolation, overwrite, release and transactional restore");
+}
