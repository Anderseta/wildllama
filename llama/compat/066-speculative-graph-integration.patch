diff --git a/tests/test-speculative-graphs.cpp b/tests/test-speculative-graphs.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-speculative-graphs.cpp
@@ -0,0 +1,179 @@
+// Reuse the bounded nonzero fixtures and state transaction helpers. This target
+// always selects the CPU backend and never downloads or opens model files.
+#define main mtp_state_original_regression
+#include "test-mtp-state.cpp"
+#undef main
+
+#include "../src/llama-context.h"
+#include <cstdlib>
+
+static void graph_budget(const char * value) {
+#ifdef _WIN32
+    require(_putenv_s("WILDLLAMA_GRAPH_VARIANTS_MIB", value) == 0 &&
+            _putenv_s("WILDLLAMA_MTP_DEVICE_STATE", "0") == 0, "cannot set graph fixture options");
+#else
+    require(setenv("WILDLLAMA_GRAPH_VARIANTS_MIB", value, 1) == 0 &&
+            setenv("WILDLLAMA_MTP_DEVICE_STATE", "0", 1) == 0, "cannot set graph fixture options");
+#endif
+}
+
+struct graph_outcome {
+    std::vector<float> logits;
+    std::vector<llama_token> proposals;
+    std::vector<std::vector<uint8_t>> states;
+    uint64_t target_hits = 0;
+    uint64_t encoder_hits = 0;
+    uint64_t embedded_hits = 0;
+    uint64_t attempts = 0;
+    size_t peak_bytes = 0;
+};
+
+static graph_outcome real_rounds(llama_model * target, llama_model * head,
+                                 common_speculative_type type, const char * budget, bool backend = false) {
+    graph_budget(budget);
+    session run(target, 1, head, type);
+    struct optional_sampler {
+        llama_context * context;
+        llama_sampler * chain = nullptr;
+        ~optional_sampler() {
+            if (chain) { llama_set_sampler(context, 0, nullptr); llama_sampler_free(chain); }
+        }
+    } sampler{run.draft.get()};
+    if (backend) {
+        sampler.chain = llama_sampler_chain_init(llama_sampler_chain_default_params());
+        llama_sampler_chain_add(sampler.chain, llama_sampler_init_top_k(10));
+        require(llama_set_sampler(run.draft.get(), 0, sampler.chain), "cannot attach neural draft backend chain");
+    }
+    graph_outcome out;
+    const size_t limit = llama_graph_variant_policy::parse_budget(budget);
+    auto check_memory = [&] {
+        for (auto * context : {run.target.get(), run.draft.get()}) {
+            const auto stats = context->get_graph_variant_stats();
+            require(stats.arenas <= 4 && stats.compute_bytes <= limit &&
+                    stats.metadata_bytes <= limit - stats.compute_bytes,
+                    "speculative graph arenas exceeded the selected per-context allowance");
+            out.peak_bytes = std::max(out.peak_bytes, stats.compute_bytes + stats.metadata_bytes);
+            require(!llama_draft_response_overlap_supported(context) &&
+                    !llama_output_overlap_supported(context, true), "CPU graph was advertised as CUDA overlap");
+        }
+    };
+    for (int round = 0; round < 8; ++round) {
+        run.clear();
+        const int count = round%2 ? 6 : 4;
+        common_batch prefix(run.target.get());
+        for (int i = 0; i < count; ++i) { prefix.add(3 + (round + i)%11, i, 0, true); }
+        require(llama_process(run.target.get(), LLAMA_PROCESS_TYPE_DECODE, prefix.get()) == 0 &&
+                common_speculative_process(run.spec.get(), prefix), "graph fixture prefill failed");
+        const auto before = run.logits();
+        out.logits.insert(out.logits.end(), before.begin(), before.end());
+        check_memory();
+
+        llama_tokens proposed;
+        auto & dp = common_speculative_get_draft_params(run.spec.get(), 0);
+        dp.drafting = true; dp.n_max = round%2 ? 2 : 1; dp.pos0 = count; dp.id_last = 7;
+        dp.result = &proposed; dp.result_q = nullptr; dp.prompt = nullptr;
+        int callbacks = 0;
+        common_speculative_draft(run.spec.get(), [&] {
+            ++callbacks;
+            require(proposed.empty(), "first-submit hook ran after sampling a proposal");
+        });
+        require(callbacks == 1 && proposed.size() == size_t(dp.n_max), "neural submit hook/depth contract changed");
+        require(run.logits() == before, "draft graph reuse mutated the target logits");
+        out.proposals.insert(out.proposals.end(), proposed.begin(), proposed.end());
+        check_memory();
+
+        // Mirror the normal target verification and draft catch-up boundary.
+        const int trim = type == COMMON_SPECULATIVE_TYPE_DRAFT_EAGLE3 ? count - 1 : count;
+        require(llama_memory_seq_rm(llama_get_memory(run.draft.get()), 0, trim, -1), "draft trim failed");
+        common_batch verify(run.target.get()); verify.add(7, count, 0, true);
+        for (size_t i = 0; i < proposed.size(); ++i) { verify.add(proposed[i], count + 1 + int(i), 0, true); }
+        require(llama_process(run.target.get(), LLAMA_PROCESS_TYPE_DECODE, verify.get()) == 0 &&
+                common_speculative_process(run.spec.get(), verify), "graph fixture verification failed");
+        common_speculative_accept(run.spec.get(), 0, uint16_t(round%(proposed.size()+1)));
+        const auto verified = run.logits();
+        out.logits.insert(out.logits.end(), verified.begin(), verified.end());
+        std::vector<uint8_t> state;
+        require(common_speculative_get_state(run.spec.get(), 0, state), "verified carry state unavailable");
+        out.states.push_back(std::move(state));
+        check_memory();
+    }
+    const auto target_stats = run.target->get_graph_variant_stats();
+    const auto draft_stats = run.draft->get_graph_variant_stats();
+    out.target_hits = target_stats.retained_hits;
+    out.encoder_hits = draft_stats.encoder_hits;
+    out.embedded_hits = draft_stats.token_embedding_hits;
+    out.attempts = target_stats.build_attempts + draft_stats.build_attempts;
+    std::printf("SPEC_GRAPHS type=%s budget=%s target_hits=%llu encoder_hits=%llu token_embd_hits=%llu attempts=%llu peak_extra=%zu\n",
+            common_speculative_type_to_str(type).c_str(), budget,
+            (unsigned long long) out.target_hits, (unsigned long long) out.encoder_hits,
+            (unsigned long long) out.embedded_hits, (unsigned long long) out.attempts, out.peak_bytes);
+    return out;
+}
+
+static void callback_lifetime(llama_model * model) {
+    graph_budget("0");
+    session run(model);
+    auto prepare = [&] {
+        run.clear(); run.prefill({3,4,5,6});
+    };
+    prepare();
+    llama_tokens result;
+    auto configure = [&] (int maximum) {
+        result.clear();
+        auto & dp = common_speculative_get_draft_params(run.spec.get(), 0);
+        dp.drafting = true; dp.n_max = maximum; dp.pos0 = 4; dp.id_last = 7;
+        dp.prompt = nullptr; dp.result_q = nullptr; dp.result = &result;
+    };
+    configure(0);
+    int calls = 0;
+    common_speculative_draft(run.spec.get(), [&] { ++calls; });
+    require(calls == 0 && result.empty(), "zero-width draft invoked submit hook");
+    common_speculative_draft(nullptr, [&] { ++calls; });
+    configure(2);
+    bool threw = false;
+    try { common_speculative_draft(run.spec.get(), [&] { ++calls; throw std::runtime_error("hook injection"); }); }
+    catch (const std::runtime_error &) { threw = true; }
+    require(threw && calls == 1 && result.empty(), "throwing submit hook was swallowed or ran after sampling");
+    prepare(); configure(2);
+    common_speculative_draft(run.spec.get());
+    require(calls == 1 && result.size() == 2, "failed draft retained a dangling submit hook");
+}
+
+int main() {
+    try {
+#ifdef GGML_TEST_CPU_BACKEND_PATH
+        require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH) != nullptr, "CPU backend unavailable");
+#else
+        ggml_backend_load_all();
+#endif
+        llama_backend_init();
+        auto mtp = tiny_model();
+        auto target = tiny_dense_model();
+        auto eagle = tiny_eagle_fixture("eagle3");
+        for (const auto type : {COMMON_SPECULATIVE_TYPE_DRAFT_MTP, COMMON_SPECULATIVE_TYPE_DRAFT_EAGLE3}) {
+            auto * target_model = type == COMMON_SPECULATIVE_TYPE_DRAFT_MTP ? mtp.get() : target.get();
+            auto * draft_model = type == COMMON_SPECULATIVE_TYPE_DRAFT_MTP ? mtp.get() : eagle.get();
+            const auto reference = real_rounds(target_model, draft_model, type, "0");
+            for (const char * budget : {"1", "32"}) {
+                const auto retained = real_rounds(target_model, draft_model, type, budget);
+                require(retained.logits == reference.logits && retained.proposals == reference.proposals &&
+                        retained.states == reference.states, "speculative graph retention changed logits/proposals/accepted carry");
+                if (std::strcmp(budget, "32") == 0) {
+                    require(retained.target_hits > 0, "verification fixture did not actually reuse a retained arena");
+                    if (type == COMMON_SPECULATIVE_TYPE_DRAFT_EAGLE3) {
+                        require(retained.encoder_hits > 0 && retained.embedded_hits > 0,
+                                "EAGLE fixture did not actually reuse encoder and token/embedding decoder graphs");
+                    }
+                }
+            }
+        }
+        const auto backend_reference = real_rounds(target.get(), eagle.get(), COMMON_SPECULATIVE_TYPE_DRAFT_EAGLE3, "0", true);
+        const auto backend_retained = real_rounds(target.get(), eagle.get(), COMMON_SPECULATIVE_TYPE_DRAFT_EAGLE3, "32", true);
+        require(backend_reference.logits == backend_retained.logits && backend_reference.proposals == backend_retained.proposals &&
+                backend_reference.states == backend_retained.states && backend_retained.encoder_hits > 0 && backend_retained.embedded_hits > 0,
+                "encoder/decoder transitions corrupted attached sampler graph bindings");
+        callback_lifetime(mtp.get());
+        std::puts("PASS: real CPU MTP verification/EAGLE encoder+decoder graph reuse; exact logits/proposals/carry; bounded arenas; submit-hook lifetime");
+        return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr, "FAIL: %s\n", error.what()); return 1; }
+}
