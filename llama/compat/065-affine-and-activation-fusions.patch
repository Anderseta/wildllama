+static void affine_normalization(fixture & f, int width, int tokens, bool keep_norm) {
+    f.input = ggml_new_tensor_2d(f.inputs.get(), GGML_TYPE_F32, width, tokens);
+    auto * gamma = ggml_new_tensor_1d(f.inputs.get(), GGML_TYPE_F32, width);
+    f.gate = ggml_dup_tensor(f.inputs.get(), gamma);
+    ggml_set_input(f.input);
+    ggml_set_input(f.gate);
+    auto * norm = ggml_norm(f.compute.get(), f.input, 1e-5f);
+    auto * mul = ggml_mul(f.compute.get(), norm, gamma);
+    auto * output = ggml_add(f.compute.get(), mul, f.gate);
+    if (keep_norm) { f.add_output(norm); }
+    f.add_output(output);
+    f.allocate();
+    std::vector<float> values(width);
+    for (int i = 0; i < width; ++i) { values[i] = 0.7f + i*0.0003f; }
+    ggml_backend_tensor_set(gamma, values.data(), 0, ggml_nbytes(gamma));
+}
