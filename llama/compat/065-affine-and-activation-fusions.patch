+
+// Same activation functions and separately rounded F32 sum as the ordinary nodes.
+template <float (*op)(float)>
+static __global__ void bias_activation_f32(const float * input, const float * bias,
+        float * output, const int count, const bool broadcast, const uint3 bias_columns) {
+    ggml_cuda_pdl_lc();
+    const int i = blockDim.x*blockIdx.x + threadIdx.x;
+    if (i >= count) { return; }
+    ggml_cuda_pdl_sync();
+    const int bias_index = broadcast ? fastmodulo(i, bias_columns) : i;
+    output[i] = op(__fadd_rn(input[i], bias[bias_index]));
+}
+
+template <float (*op)(float)>
+static void bias_activation_f32_launch(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * input, const ggml_tensor * bias, ggml_tensor * output) {
+    const int count = int(ggml_nelements(output));
+    const bool broadcast = ggml_nelements(bias) != count;
+    const dim3 blocks((int64_t(count) + 255)/256);
+    const ggml_cuda_kernel_launch_params launch_params{ blocks, dim3(256), 0, ctx.stream() };
+    ggml_cuda_kernel_launch(bias_activation_f32<op>, launch_params,
+        (const float *) input->data, (const float *) bias->data, (float *) output->data,
+        count, broadcast, init_fastdiv_values(bias->ne[0]));
+}
+
+void ggml_cuda_op_bias_activation_fused(ggml_backend_cuda_context & ctx, ggml_tensor * add, ggml_tensor * output) {
+    const auto * input = add->src[0];
+    const auto * bias = add->src[1];
+    switch (ggml_get_unary_op(output)) {
+        case GGML_UNARY_OP_SILU:     bias_activation_f32_launch<op_silu>(ctx, input, bias, output); break;
+        case GGML_UNARY_OP_GELU:     bias_activation_f32_launch<op_gelu>(ctx, input, bias, output); break;
+        case GGML_UNARY_OP_GELU_ERF: bias_activation_f32_launch<op_gelu_erf>(ctx, input, bias, output); break;
+        case GGML_UNARY_OP_RELU:     bias_activation_f32_launch<op_relu>(ctx, input, bias, output); break;
+        default: GGML_ABORT("unsupported fused bias activation");
+    }
+}
