diff --git a/ggml/src/ggml-cuda/affine-fusion.h b/ggml/src/ggml-cuda/affine-fusion.h
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-cuda/affine-fusion.h
@@ -0,0 +1,68 @@
+#pragma once
+
+#include "residual-norm.h"
+
+inline bool ggml_cuda_same_element_storage(const ggml_tensor * a, const ggml_tensor * b) {
+    return a && b && a->data && a->data == b->data && a->type == b->type &&
+        ggml_are_same_shape(a, b) && ggml_is_contiguous(a) && ggml_is_contiguous(b);
+}
+
+inline bool ggml_cuda_column_vector(const ggml_tensor * tensor, int64_t width) {
+    return tensor && tensor->type == GGML_TYPE_F32 && ggml_is_contiguous(tensor) &&
+        tensor->ne[0] == width && tensor->ne[1] == 1 && tensor->ne[2] == 1 && tensor->ne[3] == 1;
+}
+
+inline bool ggml_cuda_affine_output_safe(const ggml_tensor * output, const ggml_tensor * input,
+        const ggml_tensor * weight, const ggml_tensor * bias) {
+    return (ggml_cuda_residual_norm_disjoint(output, input) || ggml_cuda_same_element_storage(output, input)) &&
+        ggml_cuda_residual_norm_disjoint(output, weight) && ggml_cuda_residual_norm_disjoint(output, bias);
+}
+
+inline bool ggml_cuda_match_norm_affine(const ggml_cgraph * graph, int i, bool allocated) {
+    if (i < 0 || graph->n_nodes < 3 || i > graph->n_nodes - 3 ||
+        !ggml_can_fuse_subgraph(graph, i, { GGML_OP_NORM, GGML_OP_MUL, GGML_OP_ADD }, { i + 2 })) { return false; }
+    const auto * norm = graph->nodes[i];
+    const auto * mul = graph->nodes[i + 1];
+    const auto * output = graph->nodes[i + 2];
+    if ((mul->src[0] != norm && mul->src[1] != norm) ||
+        (output->src[0] != mul && output->src[1] != mul)) { return false; }
+    const auto * input = norm->src[0];
+    const auto * weight = mul->src[0] == norm ? mul->src[1] : mul->src[0];
+    const auto * bias = output->src[0] == mul ? output->src[1] : output->src[0];
+    if (!input || input->ne[0] <= 0 || input->ne[0] > 16384 ||
+        ggml_nelements(input)/input->ne[0] > 512 ||
+        !ggml_cuda_column_vector(weight, input->ne[0]) || !ggml_cuda_column_vector(bias, input->ne[0]) ||
+        !std::isfinite(ggml_get_op_params_f32(norm, 0)) || ggml_get_op_params_f32(norm, 0) < 0.0f) { return false; }
+    for (const auto * tensor : { input, norm, mul, output }) {
+        if (tensor->type != GGML_TYPE_F32 || !ggml_is_contiguous(tensor) ||
+            !ggml_are_same_shape(input, tensor)) { return false; }
+    }
+    return !allocated || ggml_cuda_affine_output_safe(output, input, weight, bias);
+}
+
+inline bool ggml_cuda_bias_activation_supported(ggml_unary_op op) {
+    return op == GGML_UNARY_OP_SILU || op == GGML_UNARY_OP_GELU ||
+        op == GGML_UNARY_OP_GELU_ERF || op == GGML_UNARY_OP_RELU;
+}
+
+inline bool ggml_cuda_match_bias_activation(const ggml_cgraph * graph, int i, bool allocated) {
+    if (i < 0 || graph->n_nodes < 2 || i > graph->n_nodes - 2 ||
+        !ggml_can_fuse_subgraph(graph, i, { GGML_OP_ADD, GGML_OP_UNARY }, { i + 1 })) { return false; }
+    const auto * add = graph->nodes[i];
+    const auto * output = graph->nodes[i + 1];
+    const auto * input = add->src[0];
+    const auto * bias = add->src[1];
+    if (!input || !bias || output->src[0] != add ||
+        !ggml_cuda_bias_activation_supported(ggml_get_unary_op(output)) ||
+        input->ne[0] <= 0 || ggml_nelements(input) <= 0 || ggml_nelements(input) > INT32_MAX ||
+        !(ggml_cuda_column_vector(bias, input->ne[0]) ||
+          (bias->type == GGML_TYPE_F32 && ggml_is_contiguous(bias) && ggml_are_same_shape(input, bias)))) { return false; }
+    for (const auto * tensor : { input, add, output }) {
+        if (tensor->type != GGML_TYPE_F32 || !ggml_is_contiguous(tensor) ||
+            !ggml_are_same_shape(input, tensor)) { return false; }
+    }
+    if (!allocated) { return true; }
+    // Exact element-wise aliases are safe; shifted or broadcast aliases are not.
+    return (ggml_cuda_residual_norm_disjoint(output, input) || ggml_cuda_same_element_storage(output, input)) &&
+        (ggml_cuda_residual_norm_disjoint(output, bias) || ggml_cuda_same_element_storage(output, bias));
