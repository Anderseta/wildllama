+    ggml_set_input(f.input);
+    ggml_set_input(f.gate);
+    auto * add = ggml_add(f.compute.get(), f.input, f.gate);
+    auto * output = ggml_unary(f.compute.get(), add, op);
+    if (keep_add) { f.add_output(add); }
+    f.add_output(output);
+    f.allocate();
+}
